[
  {
    "id": "ddj-1",
    "text": "道可道，非常道；名可名，非常名。无名，天地之始；有名，万物之母。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第一章"
  },
  {
    "id": "ddj-2",
    "text": "天下皆知美之为美，斯恶已；皆知善之为善，斯不善已。故有无相生，难易相成，长短相形，高下相倾。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二章"
  },
  {
    "id": "ddj-3",
    "text": "不尚贤，使民不争；不贵难得之货，使民不为盗；不见可欲，使民心不乱。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三章"
  },
  {
    "id": "ddj-4",
    "text": "道冲，而用之或不盈。渊兮似万物之宗；挫其锐，解其纷，和其光，同其尘。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四章"
  },
  {
    "id": "ddj-5",
    "text": "天地不仁，以万物为刍狗；圣人不仁，以百姓为刍狗。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五章"
  },
  {
    "id": "ddj-6",
    "text": "谷神不死，是谓玄牝。玄牝之门，是谓天地根。绵绵若存，用之不勤。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六章"
  },
  {
    "id": "ddj-7",
    "text": "天长地久。天地所以能长且久者，以其不自生，故能长生。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七章"
  },
  {
    "id": "ddj-8",
    "text": "上善若水。水善利万物而不争，处众人之所恶，故几于道。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第八章"
  },
  {
    "id": "ddj-9",
    "text": "持而盈之，不如其已；揣而锐之，不可长保。金玉满堂，莫之能守；富贵而骄，自遗其咎。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第九章"
  },
  {
    "id": "ddj-10",
    "text": "载营魄抱一，能无离乎？专气致柔，能婴儿乎？涤除玄览，能无疵乎？",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十章"
  },
  {
    "id": "ddj-11",
    "text": "三十辐，共一毂，当其无，有车之用；埏埴以为器，当其无，有器之用；凿户牖以为室，当其无，有室之用。故有之以为利，无之以为用。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十一章"
  },
  {
    "id": "ddj-12",
    "text": "五色令人目盲，五音令人耳聋，五味令人口爽，驰骋畋猎令人心发狂，难得之货令人行妨。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十二章"
  },
  {
    "id": "ddj-13",
    "text": "宠辱若惊，贵大患若身。何谓宠辱若惊？宠为下，得之若惊，失之若惊。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十三章"
  },
  {
    "id": "ddj-14",
    "text": "视之不见名曰夷，听之不闻名曰希，搏之不得名曰微。此三者不可致诘，故混而为一。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十四章"
  },
  {
    "id": "ddj-15",
    "text": "古之善为士者，微妙玄通，深不可识。夫唯不可识，故强为之容：豫兮若冬涉川，犹兮若畏四邻，俨兮其若客。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十五章"
  },
  {
    "id": "ddj-16",
    "text": "致虚极，守静笃。万物并作，吾以观复。夫物芸芸，各复归其根；归根曰静，是谓复命。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十六章"
  },
  {
    "id": "ddj-17",
    "text": "太上，下知有之；其次，亲而誉之；其次，畏之；其次，侮之。信不足焉，有不信焉。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十七章"
  },
  {
    "id": "ddj-18",
    "text": "大道废，有仁义；智慧出，有大伪；六亲不和有孝慈；国家昏乱有忠臣。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十八章"
  },
  {
    "id": "ddj-19",
    "text": "绝圣弃智，民利百倍；绝仁弃义，民复孝慈；绝巧弃利，天下无诈伪。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第十九章"
  },
  {
    "id": "ddj-20",
    "text": "跂者不立，跨者不行。自见者不明，自是者不彰，自伐者无功，自矜者不长。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十章"
  },
  {
    "id": "ddj-21",
    "text": "孔德之容，惟道是从。道之为物，惟恍惟惚。惚兮恍兮，其中有象；恍兮惚兮，其中有物。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十一章"
  },
  {
    "id": "ddj-22",
    "text": "曲则全，枉则直，洼则盈，敝则新，少则得，多则惑。是以圣人抱一为天下式。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十二章"
  },
  {
    "id": "ddj-23",
    "text": "希言自然。故飘风不终朝，骤雨不终日。孰为此者？天地。天地尚不能久，而况于人乎？",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十三章"
  },
  {
    "id": "ddj-24",
    "text": "大成若缺，其用不弊；大盈若冲，其用不穷。大直若屈，大巧若拙，大辩若讷。躁胜寒，静胜热。清静为天下正。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十五章"
  },
  {
    "id": "ddj-25",
    "text": "有物混成，先天地生。寂兮寥兮，独立不改，周行而不殆，可以为天下母。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十五章"
  },
  {
    "id": "ddj-26",
    "text": "重为轻根，静为躁君。是以圣人终日行不离辎重。虽有荣观，燕处超然。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十六章"
  },
  {
    "id": "ddj-27",
    "text": "善行无辙迹，善言无瑕谪；善数不用筹策；善闭无关楗而不可解，善结无绳约而不可解。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十七章"
  },
  {
    "id": "ddj-28",
    "text": "知其雄，守其雌，为天下谿。为天下谿，常德不离，复归于婴儿。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十八章"
  },
  {
    "id": "ddj-29",
    "text": "将欲取天下而为之，吾见其不得已。天下神器，不可为也。为者败之，执者失之。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第二十九章"
  },
  {
    "id": "ddj-30",
    "text": "以道佐人主者，不以兵强天下。其事好还。师之所处，荆棘生焉；大军过后，必有凶年。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十章"
  },
  {
    "id": "ddj-31",
    "text": "夫佳兵者，不祥之器，物或恶之，故有道者不处。君子居则贵左，用兵则贵右。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十一章"
  },
  {
    "id": "ddj-32",
    "text": "道常无名。朴虽小，天下莫能臣也。侯王若能守之，万物将自宾。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十二章"
  },
  {
    "id": "ddj-33",
    "text": "知人者智，自知者明。胜人者有力，自胜者强。知足者富，强行者有志。不失其所者久，死而不亡者寿。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十三章"
  },
  {
    "id": "ddj-34",
    "text": "大道氤氲，其形如沛，其力如王。其物无方，其形无势，其音无强，其声无和。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十四章"
  },
  {
    "id": "ddj-35",
    "text": "天得一以清，地得一以宁，神得一以灵，谷得一以盈，万物得一以生，侯王得一以为天下贞。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十五章"
  },
  {
    "id": "ddj-36",
    "text": "将欲歙之，必固张之；将欲弱之，必固强之；将欲废之，必固兴之；将欲取之，必固与之。是谓微明。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十六章"
  },
  {
    "id": "ddj-37",
    "text": "道常无为而无不为。侯王若能守之，万物将自化。化而欲作，吾将镇之以无名之朴。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十七章"
  },
  {
    "id": "ddj-38",
    "text": "上德不德，是以有德；下德不失德，是以无德。上德无为而无以为，下德为之而有以为。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第三十八章"
  },
  {
    "id": "ddj-39",
    "text": "和大怨，必有余怨；安可以为善？是以圣人执左契，而不责于人。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十九章"
  },
  {
    "id": "ddj-40",
    "text": "反者道之动，弱者道之用。天下万物生于有，有生于无。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十章"
  },
  {
    "id": "ddj-41",
    "text": "上士闻道，勤而行之；中士闻道，若存若亡；下士闻道，大笑之。不笑不足以为道。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十一章"
  },
  {
    "id": "ddj-42",
    "text": "道生一，一生二，二生三，三生万物。万物负阴而抱阳，冲气以为和。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十二章"
  },
  {
    "id": "ddj-43",
    "text": "天下之至柔，驰骋天下之至坚。无有入无间，吾是以知无为之有益。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十三章"
  },
  {
    "id": "ddj-44",
    "text": "名与身孰亲？身与货孰多？得与亡孰病？是故甚爱必大费，多藏必厚亡。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十四章"
  },
  {
    "id": "ddj-45",
    "text": "大方无隅，大器晚成，大音希声，大象无形。道隐无名。夫唯道，善贷且成。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十一章"
  },
  {
    "id": "ddj-46",
    "text": "天下有道，却走马以粪；天下无道，戎马生于郊。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十六章"
  },
  {
    "id": "ddj-47",
    "text": "不出户，知天下；不窥牖，见天道。其出弥远，其知弥少。是以圣人不行而知，不见而明，不为而成。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十七章"
  },
  {
    "id": "ddj-48",
    "text": "为学日益，为道日损。损之又损，以至于无为。无为而无不为。取天下常以无事，及其有事，不足以取天下。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十八章"
  },
  {
    "id": "ddj-49",
    "text": "圣人无常心，以百姓心为心。善者，吾善之；不善者，吾亦善之；德善。信者，吾信之；不信者，吾亦信之；德信。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第四十九章"
  },
  {
    "id": "ddj-50",
    "text": "出生入死。生之徒，十有三；死之徒，十有三；人之生，动之死地，亦十有三。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十章"
  },
  {
    "id": "ddj-51",
    "text": "道生之，德畜之，物形之，势成之。是以万物莫不尊道而贵德。道之尊，德之贵，夫莫之命而常自然。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十一章"
  },
  {
    "id": "ddj-52",
    "text": "天下有始，以为天下母。既得其母，以知其子；既知其子，复守其母，没身不殆。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十二章"
  },
  {
    "id": "ddj-53",
    "text": "使我介然有知，行于大道，唯施是畏。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十三章"
  },
  {
    "id": "ddj-54",
    "text": "善建者不拔，善抱者不脱，子孙以祭祀不辍。修之于身，其德乃真；修之于家，其德乃余；修之于邦，其德乃丰；修之于天下，其德乃普。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十四章"
  },
  {
    "id": "ddj-55",
    "text": "含德之厚，比于赤子。毒虫不螫，猛兽不据，攫鸟不搏。骨弱筋柔而握固。未知牝牡之合而全作，精之至也。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十五章"
  },
  {
    "id": "ddj-56",
    "text": "知者不言，言者不知。塞其兑，闭其门，挫其锐，解其纷，和其光，同其尘，是谓玄同。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十六章"
  },
  {
    "id": "ddj-57",
    "text": "以正治国，以奇用兵，以无事取天下。吾何以知其然哉？以此：天下多忌讳，而民弥贫。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十七章"
  },
  {
    "id": "ddj-58",
    "text": "其政闷闷，其民淳淳；其政察察，其民缺缺。祸兮福之所倚，福兮祸之所伏。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十八章"
  },
  {
    "id": "ddj-59",
    "text": "治人事天，莫若啬。夫唯啬，是谓早服；早服谓之重积德。重积德则无不克，无不克则莫知其极。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第五十九章"
  },
  {
    "id": "ddj-60",
    "text": "治大国若烹小鲜。以道莅天下，其鬼不神；非其鬼不神，其神不伤人；夫两不相伤，故德交归焉。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十章"
  },
  {
    "id": "ddj-61",
    "text": "小国寡民，使有什伯之器而不用；使民重死而不远徙。虽有舟舆，无所乘之；虽有甲兵，无所陈之。使民复结绳而用之。甘其食，美其服，安其居，乐其俗。邻国相望，鸡犬之声相闻，民至老死不相往来。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第八十章"
  },
  {
    "id": "ddj-62",
    "text": "道者，万物之奥。善人之宝，不善人之保。美言可以市尊，美行可以加人。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十二章"
  },
  {
    "id": "ddj-63",
    "text": "为无为，事无事，味无味。大小多少，报怨以德。图难于其易，为大于其细；天下难事，必作于易；天下大事，必作于细。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十三章"
  },
  {
    "id": "ddj-64",
    "text": "其安易持，其未易谋；其脆易泮，其微易散。为之于未有，治之于未乱。合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十四章"
  },
  {
    "id": "ddj-65",
    "text": "古之善为道者，非以明民，将以愚之；民之难治，以其智多。故以智治国，国之贼；不以智治国，国之福。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十五章"
  },
  {
    "id": "ddj-66",
    "text": "江海所以能为百谷王者，以其善下之，故能为百谷王。是以圣人欲上民，必以言下之；欲先民，必以身后之。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十六章"
  },
  {
    "id": "ddj-67",
    "text": "我有三宝，持而保之：一曰慈，二曰俭，三曰不敢为天下先。慈故能勇，俭故能广，不敢为天下先，故能成器长。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十七章"
  },
  {
    "id": "ddj-68",
    "text": "善为士者不武，善战者不怒，善胜敌者不与，善用人者为之下。是谓不争之德，是谓用人之力，是谓配天古极。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十八章"
  },
  {
    "id": "ddj-69",
    "text": "吾言甚易知，甚易行。天下莫能知，莫能行。言有宗，事有君。夫唯无知，是以不我知。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十九章"
  },
  {
    "id": "ddj-70",
    "text": "知不知，尚；不知知，病。夫唯病病，是以不病。圣人不病，以其病病，是以不病。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十章"
  },
  {
    "id": "ddj-71",
    "text": "民不畏威，则大威至。无狎其所居，无厌其所生。夫唯不厌，是以不厌。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十二章"
  },
  {
    "id": "ddj-72",
    "text": "天之道，无亲，常与善人。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十三章"
  },
  {
    "id": "ddj-73",
    "text": "民不畏死，奈何以死惧之？若使民常畏死，而奇货居，孰能执之？",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十四章"
  },
  {
    "id": "ddj-74",
    "text": "民之饥，以其上食税之多，是以饥。民之难治，以其上之有为，是以难治。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十五章"
  },
  {
    "id": "ddj-75",
    "text": "人之生也柔弱，其死也坚强。草木之生也柔脆，其死也枯槁。故坚强者死之徒，柔弱者生之徒。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十六章"
  },
  {
    "id": "ddj-76",
    "text": "天之道，其犹张弓与？高者抑之，下者举之；有余者损之，不足者补之。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十七章"
  },
  {
    "id": "ddj-77",
    "text": "天下莫柔弱于水，而攻坚强者莫之能胜，以其无以易之。弱之胜强，柔之胜刚，天下莫不知，莫能行。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第七十八章"
  },
  {
    "id": "ddj-78",
    "text": "大国者下流，天下之交，天下之牝。牝常以静胜牡，以静为下。故大国以下小国，则取小国；小国以下大国，则取大国。故或下以取，或下而取。故大国不过欲兼畜人而已，皆以和为贵。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第六十一章"
  },
  {
    "id": "ddj-79",
    "text": "信言不美，美言不信。善者不辩，辩者不善。知者不博，博者不知。圣人不积，既以为人己愈有，既以与人己愈多。",
    "source": "《道德经》",
    "book": "道德经",
    "chapter": "第八十一章"
  }
]
