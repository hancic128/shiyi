[
  {
    "id": "ly-1",
    "text": "学而时习之，不亦说乎？有朋自远方来，不亦乐乎？人不知而不愠，不亦君子乎？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-2",
    "text": "为政以德，譬如北辰，居其所而众星共之。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-3",
    "text": "吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-4",
    "text": "温故而知新，可以为师矣。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-5",
    "text": "学而不思则罔，思而不学则殆。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-6",
    "text": "知之为知之，不知为不知，是知也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-7",
    "text": "学而不厌，诲人不倦。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-8",
    "text": "三人行，必有我师焉。择其善者而从之，其不善者而改之。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-9",
    "text": "知之者不如好之者，好之者不如乐之者。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "雍也"
  },
  {
    "id": "ly-10",
    "text": "饭疏食饮水，曲肱而枕之，乐亦在其中矣。不义而富且贵，于我如浮云。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-11",
    "text": "君子坦荡荡，小人长戚戚。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-12",
    "text": "仁者不忧，知者不惑，勇者不惧。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-13",
    "text": "逝者如斯夫，不舍昼夜。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-14",
    "text": "三军可夺帅也，匹夫不可夺志也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-15",
    "text": "岁寒，然后知松柏之后凋也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-16",
    "text": "士不可以不弘毅，任重而道远。仁以为己任，不亦重乎？死而后已，不亦远乎？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "泰伯"
  },
  {
    "id": "ly-17",
    "text": "不在其位，不谋其政。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "泰伯"
  },
  {
    "id": "ly-18",
    "text": "见贤思齐焉，见不贤而内自省也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-19",
    "text": "君子欲讷于言而敏于行。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-20",
    "text": "德不孤，必有邻。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-21",
    "text": "事父母几谏，见志不从，又敬又违。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-22",
    "text": "吾日三省吾身：为人谋而不忠乎？与朋友交而不信乎？传不习乎？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-23",
    "text": "道千乘之国，敬事而信，节用而爱人，使民以时。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-24",
    "text": "君子不重则不威，学则不固。主忠信。无友不如己者。过则勿惮改。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-25",
    "text": "贫而无谄，富而无骄，何如？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-26",
    "text": "不患人之不己知，患不知人也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-27",
    "text": "君子和而不同，小人同而不和。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-28",
    "text": "子曰：君子耻其言而过其行。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-29",
    "text": "其身正，不令而行；其身不正，虽令不从。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-30",
    "text": "苟正其身矣，于从政乎何有？不能正其身，如正人何？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-31",
    "text": "其言之不怍，则为之也难。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "乡党"
  },
  {
    "id": "ly-32",
    "text": "君子求诸己，小人求诸人。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-33",
    "text": "己所不欲，勿施于人。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-34",
    "text": "工欲善其事，必先利其器。居是邦也，事其大夫之贤者，友其士之仁者。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-35",
    "text": "人无远虑，必有近忧。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-36",
    "text": "朝闻道，夕死可矣。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-37",
    "text": "名不正，则言不顺；言不顺，则事不成。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-38",
    "text": "善人教民七年，亦可以即戎矣。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-39",
    "text": "往者不可谏，来者犹可追。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "微子"
  },
  {
    "id": "ly-40",
    "text": "贤贤易色；事父母能竭其力；事君能致其身；与朋友交，言而有信。虽曰未学，吾必谓之学矣。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-41",
    "text": "君子不器。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-42",
    "text": "巧言令色，鲜矣仁！",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-43",
    "text": "君子耻其言而过其行。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-44",
    "text": "君子以文会友，以友辅仁。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-45",
    "text": "君子成人之美，不成人之恶。小人反是。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-46",
    "text": "君子敬而无失，与人恭而有礼。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-47",
    "text": "质胜文则野，文胜质则史。文质彬彬，然后君子。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "雍也"
  },
  {
    "id": "ly-48",
    "text": "非礼勿视，非礼勿听，非礼勿言，非礼勿动。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-49",
    "text": "克己复礼为仁。一日克己复礼，天下归仁焉。为仁由己，而由人乎哉？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-50",
    "text": "己所不欲，勿施于人。在邦无怨，在家无怨。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "颜渊"
  },
  {
    "id": "ly-51",
    "text": "博学而笃志，切问而近思，仁在其中矣。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子张"
  },
  {
    "id": "ly-52",
    "text": "仕而优则学，学而优则仕。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子张"
  },
  {
    "id": "ly-53",
    "text": "哀哉，吾党二三子！",
    "source": "《论语》",
    "book": "论语",
    "chapter": "先进"
  },
  {
    "id": "ly-54",
    "text": "回也非助我者也，于吾言无所不说。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "先进"
  },
  {
    "id": "ly-55",
    "text": "子张曰：夫子之文章，可得而闻也；夫子之言性与天道，不可得而闻也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "公冶长"
  },
  {
    "id": "ly-56",
    "text": "君子怀德，小人怀土；君子怀刑，小人怀惠。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "里仁"
  },
  {
    "id": "ly-57",
    "text": "事君能致其身，与仁义也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-58",
    "text": "爱之，能勿劳乎？忠焉，能勿诲乎？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "宪问"
  },
  {
    "id": "ly-59",
    "text": "道之以政，齐之以刑，民免而无耻。道之以德，齐之以礼，有耻且格。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "为政"
  },
  {
    "id": "ly-60",
    "text": "由也兼人，故退之。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "先进"
  },
  {
    "id": "ly-61",
    "text": "君子泰而不骄，小人骄而不泰。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-62",
    "text": "上好礼，则民莫敢不敬；上好义，则民莫敢不服；上好信，则民莫敢不用情。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子路"
  },
  {
    "id": "ly-63",
    "text": "有君子之道四焉：其行己也恭，其事上也敬，其养民也惠，其使民也义。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "公冶长"
  },
  {
    "id": "ly-64",
    "text": "文莫吾犹人也，躬行君子则吾未之有得。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-65",
    "text": "朋友切切偲偲，兄弟怡怡。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-66",
    "text": "朽木不可雕也，粪土之墙不可杇也，于人乎何有？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "公冶长"
  },
  {
    "id": "ly-67",
    "text": "敏而好学，不耻下问，是以谓之文也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "公冶长"
  },
  {
    "id": "ly-68",
    "text": "君子哉若人！鲁无君子者，斯焉取斯？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "公冶长"
  },
  {
    "id": "ly-69",
    "text": "知者不惑，仁者不忧，勇者不惧。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-70",
    "text": "食不语，寝不言。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "乡党"
  },
  {
    "id": "ly-71",
    "text": "衣敝缊袍，与衣狐貉者立，而不耻者，其由也与？",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-72",
    "text": "君子疾没世而名不称焉。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子罕"
  },
  {
    "id": "ly-73",
    "text": "子贡问曰：有一言而可以终身行之者乎？子曰：其恕乎！己所不欲，勿施于人。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "卫灵公"
  },
  {
    "id": "ly-74",
    "text": "我非生而知之者，好古，敏以求之者也。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-75",
    "text": "发愤忘食，乐以忘忧，不知老之将至云尔。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "述而"
  },
  {
    "id": "ly-76",
    "text": "君子博学于文，约之以礼，亦可以弗畔矣夫。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "子张"
  },
  {
    "id": "ly-77",
    "text": "贤贤易色；事父母能竭其力；事君能致其身；与朋友交，言而有信。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "学而"
  },
  {
    "id": "ly-78",
    "text": "仁者乐山，智者乐水。",
    "source": "《论语》",
    "book": "论语",
    "chapter": "雍也"
  }
]
