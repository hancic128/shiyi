[
  {
    "id": "xqyj-1",
    "text": "填词一道，文人之末技也。然能抑而为此，犹觉愈于驰马试剑，纵酒呼卢。孔子有言：不有博弈者乎？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部结构第一"
  },
  {
    "id": "xqyj-2",
    "text": "曲与诗余，同是一种文字。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部词采第二"
  },
  {
    "id": "xqyj-3",
    "text": "作文之最乐者，莫如填词，其最苦者，亦莫如填词。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部音律第三"
  },
  {
    "id": "xqyj-4",
    "text": "自来作传奇者，止重填词，视宾白为末着，常有白雪阳春其调，而巴人下里其言者，予窃怪之。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部宾白第四"
  },
  {
    "id": "xqyj-5",
    "text": "插科打诨，填词之末技也，然欲雅俗同欢，智愚共赏，则当全在此处留神。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部科诨第五"
  },
  {
    "id": "xqyj-6",
    "text": "填词之设，专为登场；登场之道，盖亦难言之矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部选剧第一"
  },
  {
    "id": "xqyj-7",
    "text": "变调者，变古调为新调也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部变调第二"
  },
  {
    "id": "xqyj-8",
    "text": "声音之道，幽渺难知。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部授曲第三"
  },
  {
    "id": "xqyj-9",
    "text": "教习歌舞之家，演习声容之辈，咸谓唱曲难，说白易。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部教白第四"
  },
  {
    "id": "xqyj-10",
    "text": "戏场恶套，情事多端，不能枚纪。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部脱套第五"
  },
  {
    "id": "xqyj-11",
    "text": "食色，性也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部选姿第一"
  },
  {
    "id": "xqyj-12",
    "text": "妇人惟仙姿国色，无俟修容；稍去天工者，即不能免于人力矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部修容第二"
  },
  {
    "id": "xqyj-13",
    "text": "古云：三世长者知被服，五世长者知饮食。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部治服第三"
  },
  {
    "id": "xqyj-14",
    "text": "女子无才便是德。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部习技第四"
  },
  {
    "id": "xqyj-15",
    "text": "人之不能无屋，犹体之不能无衣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部房舍第一"
  },
  {
    "id": "xqyj-16",
    "text": "吾观今世之人，能变古法为今制者，其惟窗栏二事乎！",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部窗栏第二"
  },
  {
    "id": "xqyj-17",
    "text": "峻宇雕墙，家徒壁立，昔人贫富，皆于墙壁间辨之。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部墙壁第三"
  },
  {
    "id": "xqyj-18",
    "text": "堂联斋匾，非有成规。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部联匾第四"
  },
  {
    "id": "xqyj-19",
    "text": "幽斋磊石，原非得已。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部山石第五"
  },
  {
    "id": "xqyj-20",
    "text": "人无贵贱，家无贫富，饮食器皿，皆所必需。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部制度第一"
  },
  {
    "id": "xqyj-21",
    "text": "器玩未得，则讲购求；及其既得，则讲位置。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部位置第二"
  },
  {
    "id": "xqyj-22",
    "text": "吾观人之一身，眼耳鼻舌，手足躯骸，件件都不可少。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部蔬食第一"
  },
  {
    "id": "xqyj-23",
    "text": "食之养人，全赖五谷。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部谷食第二"
  },
  {
    "id": "xqyj-24",
    "text": "肉食者鄙，非鄙其食肉，鄙其不善谋也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部肉食第三"
  },
  {
    "id": "xqyj-25",
    "text": "草木之种类极杂，而别其大较有三，木本、藤本、草本是也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部木本第一"
  },
  {
    "id": "xqyj-26",
    "text": "藤本之花，必须扶植。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部藤本第二"
  },
  {
    "id": "xqyj-27",
    "text": "草本之花，经霜必死；其能死而不死，交春复发者，根在故也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部草本第三"
  },
  {
    "id": "xqyj-28",
    "text": "草木之类，各有所长，有以花胜者，有以叶胜者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部众卉第四"
  },
  {
    "id": "xqyj-29",
    "text": "树之不花者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部竹木第五"
  },
  {
    "id": "xqyj-30",
    "text": "造物生人一场，为时不满百岁。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部行乐第一"
  },
  {
    "id": "xqyj-31",
    "text": "食物本草一书，养生家必需之物。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部调饮啜第三"
  },
  {
    "id": "xqyj-32",
    "text": "行乐之地，首数房中。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部节色欲第四"
  },
  {
    "id": "xqyj-33",
    "text": "病之起也有因，病之伏也有在，绝其因而破其在，只在一字之和。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部却病第五"
  },
  {
    "id": "xqyj-34",
    "text": "病不服药，如得中医。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部疗病第六"
  },
  {
    "id": "xqyj-35",
    "text": "为之犹贤乎已。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部结构第一"
  },
  {
    "id": "xqyj-36",
    "text": "古今刻本中，诗余能佳而曲不能尽佳音，诗余可选而曲不可选也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部词采第二"
  },
  {
    "id": "xqyj-37",
    "text": "填词之乐，详后宾白之第二幅，上天入地，作佛成仙，无一不随意到，较之南面百城，洵有过焉者矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部音律第三"
  },
  {
    "id": "xqyj-38",
    "text": "原其所以轻此之故，殆有说焉。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部宾白第四"
  },
  {
    "id": "xqyj-39",
    "text": "文字佳，情节佳，而科诨不佳，非特俗人怕看，即雅人韵士，亦有瞌睡之时。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部科诨第五"
  },
  {
    "id": "xqyj-40",
    "text": "词曲佳而搬演不得其人，歌童好而教率不得其法，皆是暴殄天物，此等罪过，与裂缯毁璧等也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部选剧第一"
  },
  {
    "id": "xqyj-41",
    "text": "此事甚难，非其人不行，存此说以俟作者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部变调第二"
  },
  {
    "id": "xqyj-42",
    "text": "予作一生柳七，交无数周郎，虽未能如曲子相公身都通显，然论其生平制作，塞满人间，亦类此君之不可收拾。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部授曲第三"
  },
  {
    "id": "xqyj-43",
    "text": "宾白熟念即是，曲文念熟而后唱，唱必数十遍而始熟，是唱曲与说白之工，难易判如霄壤。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部教白第四"
  },
  {
    "id": "xqyj-44",
    "text": "以极鄙极欲之关目，一人作之，千万人效之，以致一定不移，守为成格，殊为怪也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部脱套第五"
  },
  {
    "id": "xqyj-45",
    "text": "不知子都之姣者，无目者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部选姿第一"
  },
  {
    "id": "xqyj-46",
    "text": "然予所谓修饰二字，无论妍媸美恶，均不可少。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部修容第二"
  },
  {
    "id": "xqyj-47",
    "text": "俗云：三代为宦，着衣吃饭。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部治服第三"
  },
  {
    "id": "xqyj-48",
    "text": "言虽近理，却非无故而云然。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部习技第四"
  },
  {
    "id": "xqyj-49",
    "text": "衣贵夏凉冬燠，房舍亦然。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部房舍第一"
  },
  {
    "id": "xqyj-50",
    "text": "窗栏之制，日新月异，皆从成法中变出。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部窗栏第二"
  },
  {
    "id": "xqyj-51",
    "text": "故富人润屋，贫士结庐，皆自墙壁始。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部墙壁第三"
  },
  {
    "id": "xqyj-52",
    "text": "不过前人赠人以言，多则书于卷轴，少则挥诸扇头；若止一二字、三四字，以及偶语一联，因其太少也，便面难书，方策不满，不得已而大书于木。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部联匾第四"
  },
  {
    "id": "xqyj-53",
    "text": "不能致身岩下，与木石居，故以一卷代山，一勺代水，所谓无聊之极思也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部山石第五"
  },
  {
    "id": "xqyj-54",
    "text": "一人之身，百工之所为备。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部制度第一"
  },
  {
    "id": "xqyj-55",
    "text": "位置器玩与位置人才同一理也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部位置第二"
  },
  {
    "id": "xqyj-56",
    "text": "其尽可不设而必欲赋之，遂为万古生人之累者，独是口腹二物。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部蔬食第一"
  },
  {
    "id": "xqyj-57",
    "text": "使天止生五谷而不产他物，则人身之肥而寿也，较此必有过焉，保无疾病相煎，寿夭不齐之患矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部谷食第二"
  },
  {
    "id": "xqyj-58",
    "text": "食肉之人之不善谋者，以肥腻之精液，结而为脂，蔽障胸臆，犹之茅塞其心，使之不复有窍也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部肉食第三"
  },
  {
    "id": "xqyj-59",
    "text": "木本坚而难痿，其岁较长者，根深故也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部木本第一"
  },
  {
    "id": "xqyj-60",
    "text": "扶植之具，莫妙于从前成法之用竹屏。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部藤本第二"
  },
  {
    "id": "xqyj-61",
    "text": "常闻有花不待时，先期使开之法，或用沸水浇根，或以硫磺代工，开则开矣，花一败而树随之，根亡故也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部草本第三"
  },
  {
    "id": "xqyj-62",
    "text": "花胜则叶无足取，且若赘疣，如葵花、蕙草之属是也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部众卉第四"
  },
  {
    "id": "xqyj-63",
    "text": "非尽不花，其见用于世者，在此不在彼，虽花而犹之弗花也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部竹木第五"
  },
  {
    "id": "xqyj-64",
    "text": "彼夭折之辈无论矣，姑就永年者道之，即使三万六千日尽是追欢取乐时，亦非无限光阴，终有报罢之日。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部行乐第一"
  },
  {
    "id": "xqyj-65",
    "text": "然则忧之未忘，其何能乐？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部止忧第二"
  },
  {
    "id": "xqyj-66",
    "text": "然翻阅一过，即当置之。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部调饮啜第三"
  },
  {
    "id": "xqyj-67",
    "text": "即有善御者，又未免溺之过度，因以伤身，精耗血枯，命随之绝。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部节色欲第四"
  },
  {
    "id": "xqyj-68",
    "text": "俗云：家不和，被邻欺。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部却病第五"
  },
  {
    "id": "xqyj-69",
    "text": "此八字金丹，救出世间几许危命！",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部疗病第六"
  },
  {
    "id": "xqyj-70",
    "text": "博弈虽戏具，犹贤于饱食终日，无所用心；填词虽小道，不又贤于博弈乎？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部结构第一"
  },
  {
    "id": "xqyj-71",
    "text": "诗余最短，每篇不过数十字，作者虽多，入选者不多，弃短取长，是以但见其美。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部词采第二"
  },
  {
    "id": "xqyj-72",
    "text": "至说其苦，亦有千态万状，拟之悲伤疾痛、桎梏幽囚诸逆境，殆有甚焉者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部音律第三"
  },
  {
    "id": "xqyj-73",
    "text": "元以填词擅长，名人所作，北曲多而南曲少。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部宾白第四"
  },
  {
    "id": "xqyj-74",
    "text": "作传奇者，全要善驱睡魔，睡魔一至，则后乎此者虽有钧天之乐，霓裳羽衣之舞，皆付之不见不闻，如对泥人作揖，土佛谈经矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部科诨第五"
  },
  {
    "id": "xqyj-75",
    "text": "方今贵戚通侯，恶谈杂技，单重声音，可谓雅人深致，崇尚得宜者矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部选剧第一"
  },
  {
    "id": "xqyj-76",
    "text": "才人所撰诗赋古文，与佳人所制锦绣花样，无不随时更变。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部变调第二"
  },
  {
    "id": "xqyj-77",
    "text": "然究竟于声音之道未尝尽解，所能解者，不过词学之章句，音理之皮毛，比之观场矮人，略高寸许，人赞美而我先之，我憎丑而人和之，举世不察，遂群然许为知音。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部授曲第三"
  },
  {
    "id": "xqyj-78",
    "text": "时论皆然，予独怪其非是。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部教白第四"
  },
  {
    "id": "xqyj-79",
    "text": "西子捧心，尚不可效，况效东施之颦乎？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部脱套第五"
  },
  {
    "id": "xqyj-80",
    "text": "古之大贤择言而发，其所以不拂人情，而数为是论者，以性所原有，不能强之使无耳。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部选姿第一"
  },
  {
    "id": "xqyj-81",
    "text": "俗云：三分人材，七分妆饰。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部修容第二"
  },
  {
    "id": "xqyj-82",
    "text": "古语今词，不谋而合，可见衣食二事之难也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部治服第三"
  },
  {
    "id": "xqyj-83",
    "text": "因聪明女子失节者多，不若无才之为贵。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部习技第四"
  },
  {
    "id": "xqyj-84",
    "text": "堂高数仞，榱题数尺，壮则壮矣，然宜于夏而不宜于冬。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部房舍第一"
  },
  {
    "id": "xqyj-85",
    "text": "腐草为萤，实具至理，如此则造物生人，不枉付心胸一片。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部窗栏第二"
  },
  {
    "id": "xqyj-86",
    "text": "墙壁者，内外攸分而人我相半者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部墙壁第三"
  },
  {
    "id": "xqyj-87",
    "text": "彼受之者，因其坚巨难藏，不便纳之笥中，欲举以示人，又不便出诸怀袖，亦不得已而悬之中堂，使人共见。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部联匾第四"
  },
  {
    "id": "xqyj-88",
    "text": "然能变城市为山林，招飞来峰使居平地，自是神仙妙术，假手于人以示奇者也，不得以小技目之。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部山石第五"
  },
  {
    "id": "xqyj-89",
    "text": "子舆氏尝言之矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部制度第一"
  },
  {
    "id": "xqyj-90",
    "text": "设官授职者，期于人地相宜；安器置物者，务在纵横得当。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部位置第二"
  },
  {
    "id": "xqyj-91",
    "text": "口腹具而生计繁矣，生计繁而诈伪奸险之事出矣，诈伪奸险之事出，而五刑不得不设。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部蔬食第一"
  },
  {
    "id": "xqyj-92",
    "text": "试观鸟之啄粟，鱼之饮水，皆止靠一物为生，未闻于一物之外，又有为之肴馔酒浆、诸饮杂食者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部谷食第二"
  },
  {
    "id": "xqyj-93",
    "text": "此非予之臆说，夫有所验之矣。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部肉食第三"
  },
  {
    "id": "xqyj-94",
    "text": "藤本之为根略浅，故弱而待扶，其岁犹以年纪。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部木本第一"
  },
  {
    "id": "xqyj-95",
    "text": "然则人之荣枯显晦，成败利钝，皆不足据，但询其根之无恙否耳。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部草本第三"
  },
  {
    "id": "xqyj-96",
    "text": "叶胜则可以无花，非无花也，叶即花也，天以花之丰神色泽归并于叶而生之者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部众卉第四"
  },
  {
    "id": "xqyj-97",
    "text": "花者，媚人之物，媚人者损己，故善花之树多不永年，不若椅桐梓漆之朴而能久。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部竹木第五"
  },
  {
    "id": "xqyj-98",
    "text": "况此百年以内，有无数忧愁困苦、疾病颠连、名缰利锁、惊风骇浪，阻人燕游，使徒有百岁之虚名，并无一岁二岁享生人应有之福之实际乎！",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部行乐第一"
  },
  {
    "id": "xqyj-99",
    "text": "尝有性不宜食而口偏嗜之，因惑本草之言，遂以疑虑致疾者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部调饮啜第三"
  },
  {
    "id": "xqyj-100",
    "text": "是善处不善处，其为无益于人者一也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部节色欲第四"
  },
  {
    "id": "xqyj-101",
    "text": "病有病魔，魔非善物，犹之穿窬之盗，起讼构难之人也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部却病第五"
  },
  {
    "id": "xqyj-102",
    "text": "进此说于初得病时，未有不怪其迂者，必俟刀圭药石无所不投，人力既穷，而沉疴如故，不得已而从事斯语，是可谓天人交迫，而使就中医者也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "颐养部疗病第六"
  },
  {
    "id": "xqyj-103",
    "text": "吾谓技无大小，贵在能精；才乏纤洪，利于善用。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部结构第一"
  },
  {
    "id": "xqyj-104",
    "text": "曲文最长，每折必须数曲，每部必须数十折，非八斗长才，不能始终如一。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部词采第二"
  },
  {
    "id": "xqyj-105",
    "text": "他种文字，随人长短，听我张弛，总无限定之资格。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部音律第三"
  },
  {
    "id": "xqyj-106",
    "text": "北曲之介白者，每折不过数言，即抹去宾白而止阅填词，亦皆一气呵成，无有断续，似并此数言亦可略而不备者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部宾白第四"
  },
  {
    "id": "xqyj-107",
    "text": "予尝以此告优人，谓戏文好处，全在下半本。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "词曲部科诨第五"
  },
  {
    "id": "xqyj-108",
    "text": "所可惜者：演剧之人美，而所演之剧难称尽美；崇雅之念真，而所崇之雅未必果真。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部选剧第一"
  },
  {
    "id": "xqyj-109",
    "text": "变则新，不变则腐；变则活，不变则板。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部变调第二"
  },
  {
    "id": "xqyj-110",
    "text": "噫，音岂易知者哉？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部授曲第三"
  },
  {
    "id": "xqyj-111",
    "text": "唱曲难而易，说白易而难，知其难者始易，视为易者必难。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部教白第四"
  },
  {
    "id": "xqyj-112",
    "text": "扫除恶习，拔去眼钉，亦高人造福之一事耳。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "演习部脱套第五"
  },
  {
    "id": "xqyj-113",
    "text": "人有美妻美妾而我好之，是谓拂人之性；好之不惟损德，且以杀身。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部选姿第一"
  },
  {
    "id": "xqyj-114",
    "text": "此为中人以下者言之也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部修容第二"
  },
  {
    "id": "xqyj-115",
    "text": "饮食载于他卷，兹不具论，请言被服一事。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部治服第三"
  },
  {
    "id": "xqyj-116",
    "text": "盖前人愤激之词，与男子因官得祸，遂以读书作宦为畏途，遗言戒子孙，使之勿读书、勿作宦者等也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "声容部习技第四"
  },
  {
    "id": "xqyj-117",
    "text": "登贵人之堂，令人不寒而粟，虽势使之然，亦廖廓有以致之；我有重裘，而彼难挟纩故也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部房舍第一"
  },
  {
    "id": "xqyj-118",
    "text": "但造房建宅与置立窗轩，同是一理，明于此而暗于彼，何其有聪明而不善扩乎？",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部窗栏第二"
  },
  {
    "id": "xqyj-119",
    "text": "俗云：一家筑墙，两家好看。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部墙壁第三"
  },
  {
    "id": "xqyj-120",
    "text": "此当日作始者偶然为之，非有成格定制，画一而不可移也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部联匾第四"
  },
  {
    "id": "xqyj-121",
    "text": "尽有丘壑填胸、烟云绕笔之韵士，命之画水题山，顷刻千岩万壑，及倩磊斋头片石，其技立穷，似向盲人问道者。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "居室部山石第五"
  },
  {
    "id": "xqyj-122",
    "text": "至于玩好之物，惟富贵者需之，贫贱之家，其制可以不问。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部制度第一"
  },
  {
    "id": "xqyj-123",
    "text": "设以刻刻需用者，而置之高阁，时时防坏者，而列于案头，是犹理繁治剧之材，处清静无为之地，黼黻皇猷之品，作驱驰孔道之官。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "器玩部位置第二"
  },
  {
    "id": "xqyj-124",
    "text": "君不能施其爱育，亲不能遂其恩私，造物好生，而亦不能不逆行其志者，皆当日赋形不善，多此二物之累也。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部蔬食第一"
  },
  {
    "id": "xqyj-125",
    "text": "人则不幸而为精腆所误，多食一物，多受一物之损伤，少静一时，少安一时之淡泊。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "饮馔部谷食第二"
  },
  {
    "id": "xqyj-126",
    "text": "草本之根愈浅，故经霜辄坏，为寿止能及岁。",
    "source": "《闲情偶寄》",
    "book": "闲情偶寄",
    "chapter": "种植部木本第一"
  }
]