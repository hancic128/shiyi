[
  {
    "id": "gy-1",
    "text": "征，正也，上讨下之称。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-2",
    "text": "夫义所以生利也，祥所以事神也，仁所以保民也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-3",
    "text": "六月乙酉，同盟于柯陵。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-4",
    "text": "是以用民无不听，求福无不丰。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-5",
    "text": "悼公先为穆子作肆夏、文王各三篇而不拜，至鹿鸣之三篇，乃后拜乐三也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-6",
    "text": "君加惠于臣，使不冻馁，则是君之赐也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-7",
    "text": "翼，晋国都也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-8",
    "text": "君若不图，难将至矣！",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-9",
    "text": "内，里、丕也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-10",
    "text": "成事，成反国之事。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-11",
    "text": "从而问之，冀芮之子也，与之归；既复命，而进之曰：臣得贤人，敢以告。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-12",
    "text": "冠，谓以士礼始冠。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-13",
    "text": "谷之不成，孤之咎也；成而焚之，二三子之虐也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-14",
    "text": "六年，鲁襄二十一年。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-15",
    "text": "邢侯闻之，逃。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  },
  {
    "id": "gy-16",
    "text": "宣王封之于郑。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十六"
  },
  {
    "id": "gy-17",
    "text": "是五王者，皆有元德也，而有奸子。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十七"
  },
  {
    "id": "gy-18",
    "text": "观射父，楚大夫。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十八"
  },
  {
    "id": "gy-19",
    "text": "句践，祝融之后、允常之子，芈姓也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十九"
  },
  {
    "id": "gy-20",
    "text": "夫虽无四方之忧，然谋\\臣与爪牙之士，不可不养而择也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十"
  },
  {
    "id": "gy-21",
    "text": "王不问，蠡不敢言。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十一"
  },
  {
    "id": "gy-22",
    "text": "犬戎，西戎之别名也，在荒服之中。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-23",
    "text": "王其不可以弃之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-24",
    "text": "在鲁成十七年。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-25",
    "text": "不咸，民不归也；不优，神弗福也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-26",
    "text": "称从者，谦也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-27",
    "text": "桓公使请诸鲁，如鲍叔之言。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-28",
    "text": "哀侯，晋昭侯之孙、鄂侯之子哀侯光也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-29",
    "text": "处五年，鲁僖之四年也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-30",
    "text": "佞，谓里、丕受惠公赂田而纳之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-31",
    "text": "十二年岁星一周，为一纪。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-32",
    "text": "今君之所闻也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-33",
    "text": "礼：既冠，奠贽于君，遂以贽见卿大夫。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-34",
    "text": "智武子，荀䓨也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-35",
    "text": "盈父栾黡娶范宣子之女曰叔祁，生盈。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-36",
    "text": "景伯如楚，故叔鱼摄其官也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  },
  {
    "id": "gy-37",
    "text": "幽王八年为司徒。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十六"
  },
  {
    "id": "gy-38",
    "text": "夫岂不欲其善，不能故也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十七"
  },
  {
    "id": "gy-39",
    "text": "重、黎，颛顼掌天地之臣。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十八"
  },
  {
    "id": "gy-40",
    "text": "世本亦云：越，芈姓也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十九"
  },
  {
    "id": "gy-41",
    "text": "譬如蓑笠，时雨既至必求之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十"
  },
  {
    "id": "gy-42",
    "text": "天道盈而不溢，盛而不骄。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十一"
  },
  {
    "id": "gy-43",
    "text": "谋\\父，字也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-44",
    "text": "下事见二十四年。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-45",
    "text": "案攷异卷一：公序本作公会尹子、单子、晋侯、齐国佐、邾人于柯陵，以伐郑。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-46",
    "text": "曹刿，鲁人也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-47",
    "text": "细，谓鹿鸣也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-48",
    "text": "初，襄公立，其政无常，鲍叔牙曰：乱将作矣。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-49",
    "text": "初，昭侯分国以封叔父桓叔为曲沃伯。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-50",
    "text": "善，善用众。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-51",
    "text": "见佞，谓惠公入而不与也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-52",
    "text": "是岁，桓公为淮之会，明年而卒。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-53",
    "text": "夫敬，德之恪也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-54",
    "text": "美哉，美成人也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-55",
    "text": "彘恭子，士鲂也，食邑于彘。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-56",
    "text": "黡卒，祁与其老州宾通，盈患之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-57",
    "text": "邢侯，楚申公巫臣之子，巫臣奔晋，晋与之邢。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  },
  {
    "id": "gy-58",
    "text": "东土，陕以东也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十六"
  },
  {
    "id": "gy-59",
    "text": "王卒使傅之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十七"
  },
  {
    "id": "gy-60",
    "text": "谓少皞之末，民神杂糅，不可方物，颛顼受之，乃命南正重司天以属神，火正黎司地以属民，是谓绝地与天相通之道也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十八"
  },
  {
    "id": "gy-61",
    "text": "鲁定十四年，吴伐越，越败之于檇李，阖庐伤而死。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十九"
  },
  {
    "id": "gy-62",
    "text": "会稽，山名，在今山阴南七里。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十"
  },
  {
    "id": "gy-63",
    "text": "人道好谦，倾危之中，当卑辞尊礼，玩好女乐，尊之以名。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十一"
  },
  {
    "id": "gy-64",
    "text": "明德，尚道化也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-65",
    "text": "案发正卷二：内传：郑伐滑一在僖二十年，一在僖二十四年，此是二十四年事，襄王之十七年也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-66",
    "text": "案公序本是也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-67",
    "text": "庄公，鲁桓公之子庄公同也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-68",
    "text": "皆昭令德以合好也，皆非使臣之所敢闻也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-69",
    "text": "奉公子小白出奔莒。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-70",
    "text": "沃盛彊，昭侯微弱。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-71",
    "text": "不顺，谓太子不顺也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-72",
    "text": "果，犹竟也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-73",
    "text": "谗谓易牙、竖貂之属。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-74",
    "text": "野馈曰馌，诗曰：馌彼南亩。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-75",
    "text": "赵朔将下军，栾书佐之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-76",
    "text": "悼公，周子也，时年十四。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-77",
    "text": "祁惧，愬诸宣子，曰：盈将为乱。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-78",
    "text": "雍子，故楚大夫，奔晋，晋与之鄐。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  },
  {
    "id": "gy-79",
    "text": "故，犹难也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十六"
  },
  {
    "id": "gy-80",
    "text": "士亹，楚大夫。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十七"
  },
  {
    "id": "gy-81",
    "text": "谓司民、司神之官各异。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十八"
  },
  {
    "id": "gy-82",
    "text": "后三年，夫差伐越，报檇李也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十九"
  },
  {
    "id": "gy-83",
    "text": "吴败越于夫椒，遂入越，越子保于会稽。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十"
  },
  {
    "id": "gy-84",
    "text": "时不至不可彊生，事不究不可彊成之属。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十一"
  },
  {
    "id": "gy-85",
    "text": "不示兵者，有大罪恶然后致诛，不以小小示威武也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-86",
    "text": "先是，郑伐滑，滑人听命，师还，又叛即卫，故郑公子士、泄堵寇帅师伐滑也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-87",
    "text": "单子系后人误增，下注云：单襄公时命事而不与会，故不书。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-88",
    "text": "初，齐襄公立，其政无常，鲍叔牙曰：君使民慢，乱将作矣。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-89",
    "text": "肆夏一名樊，韶夏一名遏，纳夏一名渠，此三夏曲也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-90",
    "text": "公孙无知杀襄公而立。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-91",
    "text": "后六年，晋潘父弑昭侯而纳桓叔，不克。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-92",
    "text": "信，言必行之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-93",
    "text": "丧田，里、丕不得其赂田。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-94",
    "text": "中道思其初时。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-95",
    "text": "以一命，命郤缺为卿，复与之冀。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-96",
    "text": "实之不知，华而不实也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-97",
    "text": "不成，谓秕也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-98",
    "text": "盈好施，士归之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-99",
    "text": "争鄐田之疆界也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  },
  {
    "id": "gy-100",
    "text": "申、吕，姜姓也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十六"
  },
  {
    "id": "gy-101",
    "text": "审，恭王名也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十七"
  },
  {
    "id": "gy-102",
    "text": "周礼，男亦曰巫。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十八"
  },
  {
    "id": "gy-103",
    "text": "越逆之，自江至于五湖，吴人大败之于夫椒，遂入越。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十九"
  },
  {
    "id": "gy-104",
    "text": "国子姓，言在众子同姓之列者。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十"
  },
  {
    "id": "gy-105",
    "text": "不骄，不自纵弛。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二十一"
  },
  {
    "id": "gy-106",
    "text": "时动，谓三时务农，一时讲武，守则有财，征则有威。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第一"
  },
  {
    "id": "gy-107",
    "text": "郑怨惠王之入而不与厉公爵，又怨襄王之与卫、滑，故不听王命而执王使也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第二"
  },
  {
    "id": "gy-108",
    "text": "是注无此二字矣。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第三"
  },
  {
    "id": "gy-109",
    "text": "奉公子小白奔莒。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第四"
  },
  {
    "id": "gy-110",
    "text": "周礼：钟师掌以钟鼓奏九夏。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第五"
  },
  {
    "id": "gy-111",
    "text": "管夷吾、邵忽奉公子纠奔鲁。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第六"
  },
  {
    "id": "gy-112",
    "text": "晋人立昭侯之子孝侯于翼，更为翼侯。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第七"
  },
  {
    "id": "gy-113",
    "text": "退，谓改悔也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第八"
  },
  {
    "id": "gy-114",
    "text": "见诈，谓惠公入而背之也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第九"
  },
  {
    "id": "gy-115",
    "text": "不见礼，故乞食。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十"
  },
  {
    "id": "gy-116",
    "text": "言，身之文也。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十一"
  },
  {
    "id": "gy-117",
    "text": "故兴王赏谏臣，逸王罚之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十二"
  },
  {
    "id": "gy-118",
    "text": "为民不从大夫之令，故求善君而谋\\之。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十三"
  },
  {
    "id": "gy-119",
    "text": "宣子执政，畏其多士，使城著，将逐之，箕遗、黄渊等知之而作乱。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十四"
  },
  {
    "id": "gy-120",
    "text": "在鲁昭十四年。",
    "source": "《国语》",
    "book": "国语",
    "chapter": "国语卷第十五"
  }
]