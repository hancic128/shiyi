[
  {
    "id": "xxyj-1",
    "text": "食中山之酒，一醉千日。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-2",
    "text": "语云，当为情死，不当为情怨。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-3",
    "text": "今天下皆妇人矣，封疆缩其地，而中庭之歌舞犹喧；战血枯其人，而满座之貂貚自若。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-4",
    "text": "天下有一言之微，而千古如新，一字之义，而百世如见者，安可泯灭之？",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-5",
    "text": "袁石公云：长安风雪夜，古庙冷铺中，乞儿丐僧，齁齁如雷吼，而白髭老贵人，拥锦下帷，求一合眼不得。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-6",
    "text": "结庐松竹之间，闲云封户；徙倚青林之下，花瓣沾衣。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-7",
    "text": "人生斯世，不能读尽天下秘书灵笈。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-8",
    "text": "今世之昏昏逐逐，无一日不醉，无一人不醉，趋名者醉于朝，趋利者醉于野，豪者醉于声色车马，而天下竟为昏迷不醒之天下矣，安得一服清凉散，人人解酲，集醒第一。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-9",
    "text": "明乎情者，原可死而不可怨者也。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-10",
    "text": "我辈书生，既无诛贼讨乱之柄，而一片报国之忱，惟于寸楮尺只字间见之；使天下之须眉而妇人者，亦耸然有起色。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-11",
    "text": "故风雷雨露，天之灵，山川名物，地之灵，语言文字，人之灵；毕三才之用，无非一灵以神其间，而又何可泯灭之？",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-12",
    "text": "松间明月，槛外青山，未常拒人，而人人自拒者何哉？",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-13",
    "text": "芳草盈阶，茶烟几缕；春光满眼，黄鸟一声。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-14",
    "text": "有目而昧，有口而哑，有耳而聋，而面上三斗俗尘，何时扫去？",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-15",
    "text": "倚才高而玩世，背后须防射影之虫；饰厚貌以欺人，面前恐有照胆之镜。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-16",
    "text": "虽然，既云情矣，此身已为情有，又何忍死耶？",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-17",
    "text": "忠孝吾家之宝，经史吾家之田。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-18",
    "text": "投刺空劳，原非生计；曳裾自屈，岂是交游。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-19",
    "text": "田园有真乐，不潇洒终为忙人；诵读有真趣，不玩味终为鄙夫；山水有真赏，不领会终为漫游；吟咏有真得，不解脱终为套语。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-20",
    "text": "此时可以诗，可以画，而正恐诗不尽言，画不尽意。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-21",
    "text": "虽然，今世且有焚香啜茗，清凉在口，尘俗在心，俨然自附于韵，亦何异三家村老妪，动口念阿弥，便云升天成佛也。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-22",
    "text": "怪小人之颠倒豪杰，不知惯颠倒方为小人；惜吾辈之受世折磨，不知惟折磨乃见吾辈。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-23",
    "text": "然不死终不透彻耳。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-24",
    "text": "闲到白头真是拙，醉逢青眼不知狂。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-25",
    "text": "事遇快意处当转，言遇快意处当住。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-26",
    "text": "居处寄吾生，但得其地，不在高广；衣服被吾体，但顺其时，不在纨绮；饮食充吾腹，但适其可，不在膏粱；宴乐修吾好，但致其诚，不在浮靡。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-27",
    "text": "花关曲折，云来不认湾头；草径幽深，落叶但敲门扇。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-28",
    "text": "陈慥家蓄数姬，每日晚藏花一枝，使诸姬射覆，中者留宿，时号花媒。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-29",
    "text": "花繁柳密处，拨得开，才是手段；风狂雨急时，立得定，方见脚根。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-30",
    "text": "韩翃之柳，崔护之花，汉宫之流叶，蜀女之飘梧，令后世有情之人咨嗟想慕，讬之语言，寄之歌咏；而奴无昆仑，客无黄衫，知己无押衙，同志无虞侯，则虽盟在海棠，终是陌路萧郎耳。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-31",
    "text": "兴之所到，不妨呕出惊人心，故不然，也须随场作戏。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-32",
    "text": "俭为贤德，不可着意求贤；贫是美称，只是难居其美。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-33",
    "text": "披卷有余闲，留客坐残良夜月；褰帷无别务，呼童耕破远山云。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-34",
    "text": "细草微风，两岸晚山迎短桌；垂杨残月，一江春水送行舟。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-35",
    "text": "雪后寻梅，霜前访菊；雨际护兰，风外听竹。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-36",
    "text": "澹泊之守，须从秾艳场中试来；镇定之操，还向纷纭境上勘过。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-37",
    "text": "几条杨柳，沾来多少啼痕；三迭阳关，唱彻古今离恨。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-38",
    "text": "放得俗人心下，方可为丈夫。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-39",
    "text": "志要高华，趣要淡泊。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-40",
    "text": "琴觞自对，鹿豕为群；任彼世态之炎凉，从他人情之反覆。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-41",
    "text": "草色伴河桥，锦缆晓牵三竺雨；花阴连野寺，布帆晴挂六桥烟。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-42",
    "text": "清斋幽闭，时时暮雨打梨花：冷句忽来，字字秋风吹木叶。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-43",
    "text": "市恩不如报德之为厚，要誉不如逃名之为适，矫情不如直节之为真。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-44",
    "text": "世无花月美人，不愿生此世界。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-45",
    "text": "放得丈夫心下，方名为仙佛。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-46",
    "text": "眼里无点灰尘，方可读书千卷；胸中没些渣滓，才能处世一番。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-47",
    "text": "家居苦事物之扰，惟田舍园亭，别是一番活计；焚香煮茗，把酒吟诗，不许胸中生冰炭。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-48",
    "text": "闲步畎亩间，垂柳飘风，新秧翻浪；耕夫荷农器，长歌相应；牧童稚子，倒骑牛背，短笛无腔，吹之不休，大有野趣。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-49",
    "text": "多方分别，是非之窦易开；一味圆融，人我之见不立。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-50",
    "text": "使人有面前之誉，不若使人无背后之毁；使人有乍交之欢，不若使人无久处之厌。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-51",
    "text": "荀令君至人家，坐处常三日香。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-52",
    "text": "放得仙佛心下，方名为得道。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-53",
    "text": "眉上几分愁，且去观棋酌酒；心中多少乐，只来种竹浇花。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-54",
    "text": "客寓多风雨之怀，独禅林道院，转添几种生机；染翰挥毫，翻经问偈，肯教眼底逐风尘。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-55",
    "text": "夜阑人静，携一童立于清溪之畔，孤鹤忽唳，鱼跃有声，清入肌骨。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-56",
    "text": "春云宜山，夏云宜树，秋云宜水，冬云宜野。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-57",
    "text": "攻人之恶毋太严，要思其堪受；教人以善莫过高，当原其可从。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-58",
    "text": "罄南山之竹，写意无穷；决东海之波，流情不尽；愁如云而长聚，泪若水以难干。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-59",
    "text": "吟诗劣于讲学，骂座恶于足恭。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-60",
    "text": "茅屋竹窗，贫中之趣，何须脚到李侯门；草帖画谱，闲里所需，直凭心游杨子宅。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-61",
    "text": "茅齐独坐茶频煮，七碗后，气爽神清；竹榻斜眠书漫抛，一枕余，心闲梦稳。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-62",
    "text": "垂柳小桥，纸窗竹屋，焚香燕坐，手握道书一卷。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-63",
    "text": "清疏畅快，月色最称风光；潇洒风流，花情何如柳态。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-64",
    "text": "不近人情，举世皆畏途；不察物情，一生俱梦境。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-65",
    "text": "弄绿绮之琴，焉得文君之听；濡彩毫之笔，难描京兆之眉；瞻云望月，无非凄怆之声；弄柳拈花，尽是销魂之处。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-66",
    "text": "两而揆之，宁为薄行狂夫，不作厚颜君子。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-67",
    "text": "好香用以熏德，好纸用以垂世，好笔用以生花，好墨用以焕彩，好茶用以涤烦，好酒用以消忧。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-68",
    "text": "带雨有时种竹，关门无事锄花；拈笔闲删旧句，汲泉几试新茶。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-69",
    "text": "客来则寻常茶具，本色清言，日暮乃归，不知马蹄为何物。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-70",
    "text": "春夜小窗兀坐，月上木兰有骨，凌冰怀人如玉。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-71",
    "text": "遇嘿嘿不语之士，切莫输心；见悻悻自好之徒，应须防口。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-72",
    "text": "悲火常烧心曲，愁云频压眉尖。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-73",
    "text": "观人题壁，便识文章。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-74",
    "text": "声色娱情，何若净几明窗，一坐息顷；利荣驰念，何若名山胜景，一登临时。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-75",
    "text": "余尝净一室，置一几，陈几种快意书，放一本旧法帖；古鼎焚香，素麈挥尘，意思小倦，暂休竹榻。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-76",
    "text": "清晨林鸟争鸣，唤醒一枕春梦。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-77",
    "text": "因想雪满山中高士卧，月明林下美人来，语此际光景颇似。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-78",
    "text": "结缨整冠之态，勿以施之焦头烂额之时；绳趋尺步之规，勿以用之救死扶伤之日。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-79",
    "text": "五更三四点，点点生愁；一日十二时，时时寄恨。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-80",
    "text": "宁为真士夫，不为假道学。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-81",
    "text": "竹篱茅舍，石屋花轩，松柏群吟，藤萝翳景；流水绕户，飞泉挂檐；烟霞欲栖，林壑将瞑。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-82",
    "text": "饷时而起，则啜苦茗，信手写汉书几行，随意观古画数幅。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-83",
    "text": "独黄鹂百舌，抑扬高下，最可人意。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-84",
    "text": "文房供具，藉以快目适玩，铺迭如市，颇损雅趣，其点缀之法，罗罗清疏，方能得致。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-85",
    "text": "议事者身在事外，宜悉利害之情；任事者身居事中，当忘利害之虑。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-86",
    "text": "燕约莺期，变作鸾悲凤泣；蜂媒蝶使，翻成绿惨红愁。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-87",
    "text": "宁为兰摧玉折，不作萧敷艾荣。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-88",
    "text": "中处野叟山翁四五，予以闲身，作此中主人。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-89",
    "text": "心目间，觉洒洒灵空，面上俗尘，当亦扑去三寸。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-90",
    "text": "高峰入云，清流见底。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-91",
    "text": "吾斋之中，不尚虚礼，凡入此斋，均为知己。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-92",
    "text": "俭，美德也，过则为悭吝，为鄙啬，反伤雅道；让，懿行也，过则为足恭，为曲谨，多出机心。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-93",
    "text": "花柳深藏淑女居，何殊弱水三千；雨云不入襄王梦，空忆十二巫山。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-94",
    "text": "随口利牙，不顾天荒地老；翻肠倒肚，那管鬼哭神愁。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-95",
    "text": "坐沉红烛，看遍青山，消我情肠，任他冷眼。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-96",
    "text": "但看花开落，不言人是非。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-97",
    "text": "两岸石壁，五色交辉，青林翠竹，四时俱备，晓雾将歇，猿鸟乱呜；日夕欲颓，池鳞竞跃，实欲界之仙都。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-98",
    "text": "随分款留，忘形笑语，不言是非，不侈荣利，闲谈古今，静玩山水，清茶好酒，以适幽趣，臭味之交，如斯而已。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-99",
    "text": "藏巧于拙，用晦而明，寓清于浊，以屈为伸。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-100",
    "text": "枕边梦去心亦去，醒后梦还心不还。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-101",
    "text": "身世浮名，余以梦蝶视之，断不受肉眼相看。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-102",
    "text": "问妇索酿，瓮有新刍；呼童煮茶，门临好客。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-103",
    "text": "莫恋浮名，梦幻泡影有限；且寻乐事，风花雪月无穷。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-104",
    "text": "自唐乐以来，未有能与其奇者。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-105",
    "text": "窗宜竹雨声，亭宜松风声，几宜洗砚声，榻宜翻书声，月宜琴声，雪宜茶声，春宜筝声，秋宜笛声，夜宜砧声。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-106",
    "text": "彼无望德，此无示恩，穷交所以能长；望不胜奢，欲不胜餍，利交所以必忤。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-107",
    "text": "万里关河，鸿雁来时悲信断；满腔愁绪，子规啼处忆人归。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-108",
    "text": "达人撒手悬崖，俗子沉身苦海。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-109",
    "text": "花前解佩，湖上停桡，弄月放歌，采莲高醉；晴云微袅，渔笛沧浪，华句一垂，江山共峙。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-110",
    "text": "白云在天，明月在地；焚香煮茗，阅偈翻经；俗念都捐，尘心顿尽。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-111",
    "text": "曲径烟深，路接杏花酒舍；澄江日落，门通杨柳渔家。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-112",
    "text": "鸡坛可以益学，鹤阵可以善兵。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-113",
    "text": "怨因德彰，故使人德我，不若德怨之两忘；仇因恩立，故使人知恩，不若恩仇之俱泯。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-114",
    "text": "千迭云山千迭愁，一天明月一天恨。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-115",
    "text": "销骨口中，生出莲花九品，铄金舌上，容他鹦鹉千言。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-116",
    "text": "胸中有灵丹一粒，方能点化俗情，摆脱世故。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-117",
    "text": "暑中尝默坐，澄心闭目，作水观久之，觉肌发洒洒，几阁间似有爽气。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-118",
    "text": "长松怪石，去墟落不下一二十里。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-119",
    "text": "翻经如壁观僧，饮酒如醉道士，横琴如黄葛野人，肃客如碧桃渔父。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-120",
    "text": "天薄我福，吾厚吾德以迓之；天劳我形，吾逸吾心以补之；天阨我遇，吾亨吾道以通之。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-121",
    "text": "豆蔻不消心上恨，丁香空结雨中愁。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-122",
    "text": "少言语以当贵，多著述以当富，载清名以当车，咀英华以当肉。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-123",
    "text": "独坐丹房，潇然无事，烹茶一壶，烧香一炷，看达摩面壁图。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  },
  {
    "id": "xxyj-124",
    "text": "胸中只摆脱一恋字，便十分爽净，十分自在；人生最苦处，只是此心；沾泥带水，明是知得，不能割断耳。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷五集素"
  },
  {
    "id": "xxyj-125",
    "text": "鸟径缘崖，涉水于草莽间。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷六集景"
  },
  {
    "id": "xxyj-126",
    "text": "竹径款扉，柳阴班席。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷七集韵"
  },
  {
    "id": "xxyj-127",
    "text": "澹泊之士，必为秾艳者所疑；检饰之人，必为放肆者所忌。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷一集醒"
  },
  {
    "id": "xxyj-128",
    "text": "月色悬空，皎皎明明，偏自照人孤另；蛩声泣露，啾啾唧唧，都来助我愁思。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷二集情"
  },
  {
    "id": "xxyj-129",
    "text": "竹外窥莺，树外窥水，峰外窥云，难道我有意无意；鸟来窥人，月来窥酒，雪来窥书，却看他有情无情。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷三集峭"
  },
  {
    "id": "xxyj-130",
    "text": "垂帘少顷，不觉心净神清，气柔息定，蒙蒙然如混沌境界，意者揖达摩与之乘槎而见麻姑也。",
    "source": "《小窗幽记》",
    "book": "小窗幽记",
    "chapter": "卷四集灵"
  }
]