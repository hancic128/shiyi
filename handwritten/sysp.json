[
  {
    "id": "sysp-1",
    "text": "大用外腓，真体内充。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "雄浑"
  },
  {
    "id": "sysp-2",
    "text": "反虚入浑，积健为雄。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "雄浑"
  },
  {
    "id": "sysp-3",
    "text": "具备万物，横绝太空。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "雄浑"
  },
  {
    "id": "sysp-4",
    "text": "荒荒油云，寥寥长风。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "雄浑"
  },
  {
    "id": "sysp-5",
    "text": "素处以默，妙机其微。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "冲淡"
  },
  {
    "id": "sysp-6",
    "text": "饮之太和，独鹤与飞。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "冲淡"
  },
  {
    "id": "sysp-7",
    "text": "犹之惠风，荏苒在衣。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "冲淡"
  },
  {
    "id": "sysp-8",
    "text": "遇之匪深，即之愈希。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "冲淡"
  },
  {
    "id": "sysp-9",
    "text": "采采流水，蓬蓬远春。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "纤秾"
  },
  {
    "id": "sysp-10",
    "text": "窈窕深谷，时见美人。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "纤秾"
  },
  {
    "id": "sysp-11",
    "text": "碧桃满树，风日水滨。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "纤秾"
  },
  {
    "id": "sysp-12",
    "text": "如将不尽，与古为新。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "纤秾"
  },
  {
    "id": "sysp-13",
    "text": "绿杉野屋，落日气清。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "沉着"
  },
  {
    "id": "sysp-14",
    "text": "脱巾独步，时闻鸟声。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "沉着"
  },
  {
    "id": "sysp-15",
    "text": "鸿雁不来，之子远行。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "沉着"
  },
  {
    "id": "sysp-16",
    "text": "如有佳语，大河前横。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "沉着"
  },
  {
    "id": "sysp-17",
    "text": "畸人乘真，手把芙蓉。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "高古"
  },
  {
    "id": "sysp-18",
    "text": "泛彼浩劫，窅然空踪。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "高古"
  },
  {
    "id": "sysp-19",
    "text": "月出东斗，好风相从。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "高古"
  },
  {
    "id": "sysp-20",
    "text": "黄唐在独，落落玄宗。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "高古"
  },
  {
    "id": "sysp-21",
    "text": "玉壶买春，赏雨茅屋。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "典雅"
  },
  {
    "id": "sysp-22",
    "text": "坐中佳士，左右修竹。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "典雅"
  },
  {
    "id": "sysp-23",
    "text": "白云初晴，幽鸟相逐。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "典雅"
  },
  {
    "id": "sysp-24",
    "text": "落花无言，人淡如菊。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "典雅"
  },
  {
    "id": "sysp-25",
    "text": "如矿出金，如铅出银。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "洗炼"
  },
  {
    "id": "sysp-26",
    "text": "超心炼冶，绝爱缁磷。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "洗炼"
  },
  {
    "id": "sysp-27",
    "text": "空潭泻春，古镜照神。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "洗炼"
  },
  {
    "id": "sysp-28",
    "text": "体素储洁，乘月返真。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "洗炼"
  },
  {
    "id": "sysp-29",
    "text": "行神如空，行气如虹。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "劲健"
  },
  {
    "id": "sysp-30",
    "text": "巫峡千寻，走云连风。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "劲健"
  },
  {
    "id": "sysp-31",
    "text": "饮真茹强，蓄素守中。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "劲健"
  },
  {
    "id": "sysp-32",
    "text": "天地与立，神化攸同。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "劲健"
  },
  {
    "id": "sysp-33",
    "text": "神存富贵，始轻黄金。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "绮丽"
  },
  {
    "id": "sysp-34",
    "text": "浓尽必枯，淡者屡深。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "绮丽"
  },
  {
    "id": "sysp-35",
    "text": "雾馀水畔，红杏在林。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "绮丽"
  },
  {
    "id": "sysp-36",
    "text": "金尊酒满，伴客弹琴。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "绮丽"
  },
  {
    "id": "sysp-37",
    "text": "俯拾即是，不取诸邻。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "自然"
  },
  {
    "id": "sysp-38",
    "text": "俱道适往，着手成春。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "自然"
  },
  {
    "id": "sysp-39",
    "text": "如逢花开，如瞻岁新。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "自然"
  },
  {
    "id": "sysp-40",
    "text": "幽人空山，过雨采苹。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "自然"
  },
  {
    "id": "sysp-41",
    "text": "不著一字，尽得风流。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "含蓄"
  },
  {
    "id": "sysp-42",
    "text": "语不涉己，若不堪忧。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "含蓄"
  },
  {
    "id": "sysp-43",
    "text": "是有真宰，与之沉浮。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "含蓄"
  },
  {
    "id": "sysp-44",
    "text": "浅深聚散，万取一收。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "含蓄"
  },
  {
    "id": "sysp-45",
    "text": "观花匪禁，吞吐大荒。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "豪放"
  },
  {
    "id": "sysp-46",
    "text": "由道反气，处得以狂。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "豪放"
  },
  {
    "id": "sysp-47",
    "text": "天风浪浪，海山苍苍。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "豪放"
  },
  {
    "id": "sysp-48",
    "text": "真力弥满，万象在旁。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "豪放"
  },
  {
    "id": "sysp-49",
    "text": "欲返不尽，相期与来。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "精神"
  },
  {
    "id": "sysp-50",
    "text": "明漪绝底，奇花初胎。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "精神"
  },
  {
    "id": "sysp-51",
    "text": "青春鹦鹉，杨柳楼台。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "精神"
  },
  {
    "id": "sysp-52",
    "text": "生气远出，不著死灰。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "精神"
  },
  {
    "id": "sysp-53",
    "text": "是有真迹，如不可知。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "缜密"
  },
  {
    "id": "sysp-54",
    "text": "意象欲生，造化已奇。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "缜密"
  },
  {
    "id": "sysp-55",
    "text": "水流花开，清露未晞。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "缜密"
  },
  {
    "id": "sysp-56",
    "text": "要路愈远，幽行为迟。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "缜密"
  },
  {
    "id": "sysp-57",
    "text": "惟性所宅，真取不羁。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "疏野"
  },
  {
    "id": "sysp-58",
    "text": "控物自富，与率为期。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "疏野"
  },
  {
    "id": "sysp-59",
    "text": "筑室松下，脱帽看诗。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "疏野"
  },
  {
    "id": "sysp-60",
    "text": "但知旦暮，不辨何时。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "疏野"
  },
  {
    "id": "sysp-61",
    "text": "娟娟群松，下有漪流。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "清奇"
  },
  {
    "id": "sysp-62",
    "text": "晴雪满竹，隔溪渔舟。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "清奇"
  },
  {
    "id": "sysp-63",
    "text": "可人如玉，步屧寻幽。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "清奇"
  },
  {
    "id": "sysp-64",
    "text": "如月之曙，如气之秋。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "清奇"
  },
  {
    "id": "sysp-65",
    "text": "登彼太行，翠绕羊肠。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "委曲"
  },
  {
    "id": "sysp-66",
    "text": "杳霭流玉，悠悠花香。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "委曲"
  },
  {
    "id": "sysp-67",
    "text": "力之于时，声之于羌。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "委曲"
  },
  {
    "id": "sysp-68",
    "text": "道不自器，与之圆方。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "委曲"
  },
  {
    "id": "sysp-69",
    "text": "取语甚直，计思匪深。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "实境"
  },
  {
    "id": "sysp-70",
    "text": "忽逢幽人，如见道心。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "实境"
  },
  {
    "id": "sysp-71",
    "text": "清涧之曲，碧松之阴。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "实境"
  },
  {
    "id": "sysp-72",
    "text": "情性所至，妙不自寻。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "实境"
  },
  {
    "id": "sysp-73",
    "text": "大风卷水，林木为摧。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "悲慨"
  },
  {
    "id": "sysp-74",
    "text": "适苦欲死，招憩不来。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "悲慨"
  },
  {
    "id": "sysp-75",
    "text": "百岁如流，富贵冷灰。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "悲慨"
  },
  {
    "id": "sysp-76",
    "text": "大道日丧，若为雄才。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "悲慨"
  },
  {
    "id": "sysp-77",
    "text": "绝伫灵素，少回清真。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "形容"
  },
  {
    "id": "sysp-78",
    "text": "如觅水影，如写阳春。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "形容"
  },
  {
    "id": "sysp-79",
    "text": "风云变态，花草精神。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "形容"
  },
  {
    "id": "sysp-80",
    "text": "离形得似，庶几斯人。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "形容"
  },
  {
    "id": "sysp-81",
    "text": "匪神之灵，匪几之微。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "超诣"
  },
  {
    "id": "sysp-82",
    "text": "如将白云，清风与归。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "超诣"
  },
  {
    "id": "sysp-83",
    "text": "远引若至，临之已非。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "超诣"
  },
  {
    "id": "sysp-84",
    "text": "乱山乔木，碧苔芳晖。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "超诣"
  },
  {
    "id": "sysp-85",
    "text": "落落欲往，矫矫不群。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "飘逸"
  },
  {
    "id": "sysp-86",
    "text": "缑山之鹤，华顶之云。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "飘逸"
  },
  {
    "id": "sysp-87",
    "text": "高人画中，令色氤氲。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "飘逸"
  },
  {
    "id": "sysp-88",
    "text": "如不可执，如将有闻。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "飘逸"
  },
  {
    "id": "sysp-89",
    "text": "生者百岁，相去几何。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "旷达"
  },
  {
    "id": "sysp-90",
    "text": "欢乐苦短，忧愁实多。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "旷达"
  },
  {
    "id": "sysp-91",
    "text": "何如尊酒，日往烟萝。",
    "source": "《二十四诗品》",
    "book": "二十四诗品",
    "chapter": "旷达"
  },
  {
    "id": "sysp-92",
    "text": "倒酒既尽，杖藜行歌。",
