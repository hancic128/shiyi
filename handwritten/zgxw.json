[
  {
    "id": "zgxw-1",
    "text": "昔时贤文，诲汝谆谆，集韵增文，多见多闻。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "昔时贤文"
  },
  {
    "id": "zgxw-2",
    "text": "观今宜鉴古，无古不成今。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "昔时贤文"
  },
  {
    "id": "zgxw-3",
    "text": "知己知彼，将心比心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "昔时贤文"
  },
  {
    "id": "zgxw-4",
    "text": "酒逢知己饮，诗向会人吟。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "昔时贤文"
  },
  {
    "id": "zgxw-5",
    "text": "相识满天下，知心能几人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "相识满天下"
  },
  {
    "id": "zgxw-6",
    "text": "相逢好似初相识，到老终无怨恨心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "相识满天下"
  },
  {
    "id": "zgxw-7",
    "text": "近水知鱼性，近山识鸟音。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "相识满天下"
  },
  {
    "id": "zgxw-8",
    "text": "易涨易退山溪水，易反易覆小人心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "相识满天下"
  },
  {
    "id": "zgxw-9",
    "text": "运去金成铁，时来铁似金，读书须用意，一字值千金。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "运去金成铁"
  },
  {
    "id": "zgxw-10",
    "text": "逢人且说三分话，未可全抛一片心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "运去金成铁"
  },
  {
    "id": "zgxw-11",
    "text": "有意栽花花不发，无心插柳柳成阴。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "运去金成铁"
  },
  {
    "id": "zgxw-12",
    "text": "画虎画皮难画骨，知人知面不知心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "运去金成铁"
  },
  {
    "id": "zgxw-13",
    "text": "钱财如粪土，仁义值千金。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "钱财如粪土"
  },
  {
    "id": "zgxw-14",
    "text": "流水下滩非有意，白云出岫本无心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "钱财如粪土"
  },
  {
    "id": "zgxw-15",
    "text": "当时若不登高望，谁信东流海洋深。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "钱财如粪土"
  },
  {
    "id": "zgxw-16",
    "text": "路遥知马力，事久见人心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "钱财如粪土"
  },
  {
    "id": "zgxw-17",
    "text": "两人一般心，无钱堪买金，一人一般心，有钱难买针。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "两人一般心"
  },
  {
    "id": "zgxw-18",
    "text": "相见易得好，久住难为人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "两人一般心"
  },
  {
    "id": "zgxw-19",
    "text": "马行无力皆因瘦，人不风流只为贫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "两人一般心"
  },
  {
    "id": "zgxw-20",
    "text": "饶人不是痴汉，痴汉不会饶人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "两人一般心"
  },
  {
    "id": "zgxw-21",
    "text": "是亲不是亲，非亲却是亲。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是亲不是亲"
  },
  {
    "id": "zgxw-22",
    "text": "美不美，乡中水，亲不亲，故乡人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是亲不是亲"
  },
  {
    "id": "zgxw-23",
    "text": "莺花犹怕春光老，岂可教人枉度春。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是亲不是亲"
  },
  {
    "id": "zgxw-24",
    "text": "相逢不饮空归去，洞口桃花也笑人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是亲不是亲"
  },
  {
    "id": "zgxw-25",
    "text": "红粉佳人休使老，风流浪子莫教贫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "红粉佳人休使"
  },
  {
    "id": "zgxw-26",
    "text": "在家不会迎宾客，出外方知少主人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "红粉佳人休使"
  },
  {
    "id": "zgxw-27",
    "text": "黄金无假，阿魏无真。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "红粉佳人休使"
  },
  {
    "id": "zgxw-28",
    "text": "客来主不顾，应恐是痴人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "红粉佳人休使"
  },
  {
    "id": "zgxw-29",
    "text": "贫居闹市无人问，富在深山有远亲。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "贫居闹市无人"
  },
  {
    "id": "zgxw-30",
    "text": "谁人背后无人说，哪个人前不说人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "贫居闹市无人"
  },
  {
    "id": "zgxw-31",
    "text": "有钱道真语，无钱语不真。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "贫居闹市无人"
  },
  {
    "id": "zgxw-32",
    "text": "不信但看筵中酒，杯杯先劝有钱人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "贫居闹市无人"
  },
  {
    "id": "zgxw-33",
    "text": "闹里有钱，静处安身。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "闹里有钱"
  },
  {
    "id": "zgxw-34",
    "text": "来如风雨，去似微尘。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "闹里有钱"
  },
  {
    "id": "zgxw-35",
    "text": "长江后浪推前浪，世上新人赶旧人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "闹里有钱"
  },
  {
    "id": "zgxw-36",
    "text": "近水楼台先得月，向阳花木早逢春。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "闹里有钱"
  },
  {
    "id": "zgxw-37",
    "text": "莫道君行早，更有早行人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "莫道君行早"
  },
  {
    "id": "zgxw-38",
    "text": "莫信直中直，须防仁不仁。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "莫道君行早"
  },
  {
    "id": "zgxw-39",
    "text": "山中有直树，世上无直人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "莫道君行早"
  },
  {
    "id": "zgxw-40",
    "text": "自恨枝无叶，莫怨太阳偏。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "莫道君行早"
  },
  {
    "id": "zgxw-41",
    "text": "大家都是命，半点不由人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "大家都是命"
  },
  {
    "id": "zgxw-42",
    "text": "一年之计在于春，一日之计在于寅，一家之计在于和，一生之计在于勤。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "大家都是命"
  },
  {
    "id": "zgxw-43",
    "text": "责人之心责己，恕己之心恕人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "大家都是命"
  },
  {
    "id": "zgxw-44",
    "text": "守口如瓶，防意如城。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "大家都是命"
  },
  {
    "id": "zgxw-45",
    "text": "宁可人负我，切莫我负人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "宁可人负我"
  },
  {
    "id": "zgxw-46",
    "text": "再三须慎意，第一莫欺心。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "宁可人负我"
  },
  {
    "id": "zgxw-47",
    "text": "虎生犹可近，人熟不堪亲。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "宁可人负我"
  },
  {
    "id": "zgxw-48",
    "text": "来说是非者，便是是非人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "宁可人负我"
  },
  {
    "id": "zgxw-49",
    "text": "远水难救近火，远亲不如近邻。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "远水难救近火"
  },
  {
    "id": "zgxw-50",
    "text": "有茶有酒多兄弟，急难何曾见一人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "远水难救近火"
  },
  {
    "id": "zgxw-51",
    "text": "人情似纸张张薄，世事如棋局局新。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "远水难救近火"
  },
  {
    "id": "zgxw-52",
    "text": "山中也有千年树，世上难逢百岁人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "远水难救近火"
  },
  {
    "id": "zgxw-53",
    "text": "力微休负重，言轻莫劝人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "力微休负重"
  },
  {
    "id": "zgxw-54",
    "text": "无钱休入众，遭难莫寻亲。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "力微休负重"
  },
  {
    "id": "zgxw-55",
    "text": "平生莫作皱眉事，世上应无切齿人。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "力微休负重"
  },
  {
    "id": "zgxw-56",
    "text": "士者国之宝，儒为席上珍。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "力微休负重"
  },
  {
    "id": "zgxw-57",
    "text": "求人须求大丈夫，济人须济急时无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "若要断酒法"
  },
  {
    "id": "zgxw-58",
    "text": "渴时一滴如甘露，醉后添杯不如无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "若要断酒法"
  },
  {
    "id": "zgxw-59",
    "text": "久住令人贱，频来亲也疏。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "若要断酒法"
  },
  {
    "id": "zgxw-60",
    "text": "酒中不语真君子，财上分明大丈夫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "酒中不语真君"
  },
  {
    "id": "zgxw-61",
    "text": "出家如初，成佛有余。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "酒中不语真君"
  },
  {
    "id": "zgxw-62",
    "text": "积金千两，不如明解经书。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "酒中不语真君"
  },
  {
    "id": "zgxw-63",
    "text": "养子不教如养驴，养女不教如养猪。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "酒中不语真君"
  },
  {
    "id": "zgxw-64",
    "text": "有田不耕仓廪虚，有书不读子孙愚。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有田不耕仓廪"
  },
  {
    "id": "zgxw-65",
    "text": "仓廪虚兮岁月乏，子孙愚兮礼义疏。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有田不耕仓廪"
  },
  {
    "id": "zgxw-66",
    "text": "同君一席话，胜读十年书。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有田不耕仓廪"
  },
  {
    "id": "zgxw-67",
    "text": "人不通今古，马牛如襟裾。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有田不耕仓廪"
  },
  {
    "id": "zgxw-68",
    "text": "茫茫四海人无数，哪个男儿是丈夫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "茫茫四海人无"
  },
  {
    "id": "zgxw-69",
    "text": "白酒酿成缘好客，黄金散尽为收书。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "茫茫四海人无"
  },
  {
    "id": "zgxw-70",
    "text": "救人一命，胜造七级浮屠。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "茫茫四海人无"
  },
  {
    "id": "zgxw-71",
    "text": "城门失火，殃及池鱼。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "茫茫四海人无"
  },
  {
    "id": "zgxw-72",
    "text": "庭前生瑞草，好事不如无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "庭前生瑞草"
  },
  {
    "id": "zgxw-73",
    "text": "欲求生富贵，须下死工夫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "庭前生瑞草"
  },
  {
    "id": "zgxw-74",
    "text": "百年成之不足，一旦败之有余。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "庭前生瑞草"
  },
  {
    "id": "zgxw-75",
    "text": "人心似铁，官法如炉。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "庭前生瑞草"
  },
  {
    "id": "zgxw-76",
    "text": "善化不足，恶化有余。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "善化不足"
  },
  {
    "id": "zgxw-77",
    "text": "水太清则无鱼，人至察则无徒。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "善化不足"
  },
  {
    "id": "zgxw-78",
    "text": "知者减半，省者全无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "善化不足"
  },
  {
    "id": "zgxw-79",
    "text": "在家由父，出家从夫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "善化不足"
  },
  {
    "id": "zgxw-80",
    "text": "痴人畏妇，贤女敬夫。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "痴人畏妇"
  },
  {
    "id": "zgxw-81",
    "text": "是非终日有，不听自然无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "痴人畏妇"
  },
  {
    "id": "zgxw-82",
    "text": "宁可正而不足，不可邪而有余。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "痴人畏妇"
  },
  {
    "id": "zgxw-83",
    "text": "宁可信其有，不可信其无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "痴人畏妇"
  },
  {
    "id": "zgxw-84",
    "text": "竹篱茅舍风光好，道院僧堂终不如。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "竹篱茅舍风光"
  },
  {
    "id": "zgxw-85",
    "text": "命里有时终须有，命里无时莫强求。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "竹篱茅舍风光"
  },
  {
    "id": "zgxw-86",
    "text": "道院迎仙客，书堂隐相儒。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "竹篱茅舍风光"
  },
  {
    "id": "zgxw-87",
    "text": "庭栽栖凤竹，池养化龙鱼。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "竹篱茅舍风光"
  },
  {
    "id": "zgxw-88",
    "text": "结交须胜己，似我不如无。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "结交须胜己"
  },
  {
    "id": "zgxw-89",
    "text": "但看三五日，相见不如初。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "结交须胜己"
  },
  {
    "id": "zgxw-90",
    "text": "人情似水分高下，世事如云任卷舒。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "结交须胜己"
  },
  {
    "id": "zgxw-91",
    "text": "会说说都是，不会说无礼。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "结交须胜己"
  },
  {
    "id": "zgxw-92",
    "text": "磨刀恨不利，刀利伤人指。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "磨刀恨不利"
  },
  {
    "id": "zgxw-93",
    "text": "求财恨不得，财多害自己。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "磨刀恨不利"
  },
  {
    "id": "zgxw-94",
    "text": "知足常足，终身不辱。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "磨刀恨不利"
  },
  {
    "id": "zgxw-95",
    "text": "知止常止，终身不耻。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "磨刀恨不利"
  },
  {
    "id": "zgxw-96",
    "text": "有福伤财，无福伤己。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有福伤财"
  },
  {
    "id": "zgxw-97",
    "text": "差之毫厘，失之千里。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有福伤财"
  },
  {
    "id": "zgxw-98",
    "text": "三思而行，再思可矣。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "有福伤财"
  },
  {
    "id": "zgxw-99",
    "text": "使口不如自走，求人不如求己。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "使口不如自走"
  },
  {
    "id": "zgxw-100",
    "text": "小时是兄弟，长大各乡里。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "使口不如自走"
  },
  {
    "id": "zgxw-101",
    "text": "妒财莫妒食，怨生莫怨死。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "使口不如自走"
  },
  {
    "id": "zgxw-102",
    "text": "人见白头嗔，我见白头喜。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "使口不如自走"
  },
  {
    "id": "zgxw-103",
    "text": "多少少年亡，不到白头死。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "多少少年亡"
  },
  {
    "id": "zgxw-104",
    "text": "墙有逢，壁有耳。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "多少少年亡"
  },
  {
    "id": "zgxw-105",
    "text": "好事不出门，恶事传千里。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "多少少年亡"
  },
  {
    "id": "zgxw-106",
    "text": "贼是小人，知过君子。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "多少少年亡"
  },
  {
    "id": "zgxw-107",
    "text": "君子固穷，小人穷斯滥也。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "君子固穷"
  },
  {
    "id": "zgxw-108",
    "text": "贫穷自在，富贵多忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "君子固穷"
  },
  {
    "id": "zgxw-109",
    "text": "不以我为德，反以我为仇。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "君子固穷"
  },
  {
    "id": "zgxw-110",
    "text": "宁向直中取，不可曲中求。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "君子固穷"
  },
  {
    "id": "zgxw-111",
    "text": "人无远虑，必有近忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人无远虑"
  },
  {
    "id": "zgxw-112",
    "text": "知我者为我心忧，不知我者谓我何求。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人无远虑"
  },
  {
    "id": "zgxw-113",
    "text": "晴天不肯去，只待雨淋头。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人无远虑"
  },
  {
    "id": "zgxw-114",
    "text": "成事莫说，覆水难收。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人无远虑"
  },
  {
    "id": "zgxw-115",
    "text": "是非只为多开口，烦恼皆因强出头。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是非只为多开"
  },
  {
    "id": "zgxw-116",
    "text": "忍得一时之气，免得百日之忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是非只为多开"
  },
  {
    "id": "zgxw-117",
    "text": "近来学得乌龟法，得缩头时且缩头。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是非只为多开"
  },
  {
    "id": "zgxw-118",
    "text": "惧法朝朝乐，欺公日日忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "是非只为多开"
  },
  {
    "id": "zgxw-119",
    "text": "人生一世，草生一春。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生一世"
  },
  {
    "id": "zgxw-120",
    "text": "黑发不知勤学早，看看又是白头翁。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生一世"
  },
  {
    "id": "zgxw-121",
    "text": "月到十五光明少，人到中年万事休。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生一世"
  },
  {
    "id": "zgxw-122",
    "text": "儿孙自有儿孙福，莫为儿孙作马牛。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生一世"
  },
  {
    "id": "zgxw-123",
    "text": "人生不满百，常怀千岁忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生不满百"
  },
  {
    "id": "zgxw-124",
    "text": "今朝有酒今朝醉，明日愁来明日忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生不满百"
  },
  {
    "id": "zgxw-125",
    "text": "路逢险处难回避，事到头来不自由。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生不满百"
  },
  {
    "id": "zgxw-126",
    "text": "药能医假病，酒不解真愁。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人生不满百"
  },
  {
    "id": "zgxw-127",
    "text": "人贫不语，水平不流。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人贫不语"
  },
  {
    "id": "zgxw-128",
    "text": "一家有女百家求，一马不行百马忧。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人贫不语"
  },
  {
    "id": "zgxw-129",
    "text": "有花方酌酒，无月不登楼。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人贫不语"
  },
  {
    "id": "zgxw-130",
    "text": "三杯通大道，一醉解千愁。",
    "source": "《增广贤文》",
    "book": "增广贤文",
    "chapter": "人贫不语"
  }
]