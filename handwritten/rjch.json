[
  {
    "id": "rjch-1",
    "text": "词以境界为最上。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第一则"
  },
  {
    "id": "rjch-2",
    "text": "有境界则自成高格，自有名句。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第一则"
  },
  {
    "id": "rjch-3",
    "text": "五代北宋之词所以独绝者在此。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第一则"
  },
  {
    "id": "rjch-4",
    "text": "有造境，有写境，此理想与写实二派之所由分。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第二则"
  },
  {
    "id": "rjch-5",
    "text": "然二者颇难分别。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第二则"
  },
  {
    "id": "rjch-6",
    "text": "因大诗人所造之境，必合乎自然，所写之境，亦必邻于理想故也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第二则"
  },
  {
    "id": "rjch-7",
    "text": "有有我之境，有无我之境。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-8",
    "text": "有我之境，以我观物，故物我皆著我之色彩。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-9",
    "text": "无我之境，以物观物，故不知何者为我，何者为物。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-10",
    "text": "古人为词，写有我之境者为多，然未始不能写无我之境，此在豪杰之士能自树立耳。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-11",
    "text": "玉勒雕鞍游冶处，楼高不见章台路。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-12",
    "text": "雨横风狂三月暮，门掩黄昏，无计留春住。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-13",
    "text": "泪眼问花花不语，乱红飞过秋千去。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-14",
    "text": "可堪孤馆闭春寒，杜鹃声里斜阳暮。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-15",
    "text": "驿寄梅花，鱼传尺素，砌成此恨无重数。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-16",
    "text": "郴江幸自郴山，为谁流下潇湘去！",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-17",
    "text": "问君何能尔，心远地自偏。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-18",
    "text": "采菊东篱下，悠然见南山。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-19",
    "text": "山气日夕佳，飞鸟相与还。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-20",
    "text": "此中有真意，欲辨已忘言。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-21",
    "text": "干坤展清眺，万景若相借。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-22",
    "text": "北风三日雪，太素秉元化。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-23",
    "text": "九山郁峥嵘，了不受陵跨。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-24",
    "text": "寒波澹澹起，白鸟悠悠下。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-25",
    "text": "怀归人自急，物态本闲暇。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-26",
    "text": "壶觞负吟啸，尘土足悲□。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-27",
    "text": "回首亭中人，平林淡如画。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第三则"
  },
  {
    "id": "rjch-28",
    "text": "无我之境，人惟于静中得之。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第四则"
  },
  {
    "id": "rjch-29",
    "text": "有我之境，于由动之静时得之。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第四则"
  },
  {
    "id": "rjch-30",
    "text": "故一优美，一宏壮也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第四则"
  },
  {
    "id": "rjch-31",
    "text": "自然中之物，互相限制。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第五则"
  },
  {
    "id": "rjch-32",
    "text": "然其写之于文学及美术中也，必遗其关系，限制之处。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第五则"
  },
  {
    "id": "rjch-33",
    "text": "故虽写实家，亦理想家也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第五则"
  },
  {
    "id": "rjch-34",
    "text": "又虽如何虚构之境，其材料必求之于自然，而其构造，亦必从自然之法则。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第五则"
  },
  {
    "id": "rjch-35",
    "text": "故虽理想家，亦写实家也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第五则"
  },
  {
    "id": "rjch-36",
    "text": "境非独谓景物也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第六则"
  },
  {
    "id": "rjch-37",
    "text": "喜怒哀乐，亦人心中之一境界。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第六则"
  },
  {
    "id": "rjch-38",
    "text": "故能写真景物，真感情者，谓之有境界。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第六则"
  },
  {
    "id": "rjch-39",
    "text": "否则谓之无境界。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第六则"
  },
  {
    "id": "rjch-40",
    "text": "绿扬烟外晓寒轻，红杏枝头春意闹。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-41",
    "text": "浮生长恨欢娱少，肯爱千金轻一笑。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-42",
    "text": "为君持酒劝斜阳，且向花间留晚照。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-43",
    "text": "送春春去几时回？",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-44",
    "text": "临晚镜，伤流景，往事后期空记省。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-45",
    "text": "沙上并禽池上暝，云破月来花弄影。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-46",
    "text": "重重帘幕密遮灯，风不定，人初静，明日落红应满径。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第七则"
  },
  {
    "id": "rjch-47",
    "text": "境界有大小，不以是而分优劣。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-48",
    "text": "澄江平少岸，幽树晚多花。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-49",
    "text": "细雨鱼儿出，微风燕子斜。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-50",
    "text": "城中十万户，此地两三家。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-51",
    "text": "落日照大旗，马鸣风萧萧。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-52",
    "text": "平沙列万幕，部伍各见招。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-53",
    "text": "中天悬明月，令严夜寂寥。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-54",
    "text": "悲笳数声动，壮士惨不骄。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-55",
    "text": "借问大将谁，恐是霍嫖姚。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-56",
    "text": "自在飞花轻似梦，无边丝雨细如愁，宝帘闲挂小银钩。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第八则"
  },
  {
    "id": "rjch-57",
    "text": "羚羊挂角，无迹可求。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第九则"
  },
  {
    "id": "rjch-58",
    "text": "故其妙处，透彻玲珑，不可凑泊。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第九则"
  },
  {
    "id": "rjch-59",
    "text": "然沧浪所谓兴趣，阮亭所谓神韵，犹不过道其面目，不若鄙人拈出境界二字，为探其本也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第九则"
  },
  {
    "id": "rjch-60",
    "text": "太白纯以气象胜。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-61",
    "text": "后世唯范文正之渔家傲，夏英公之喜迁莺，差足继武，然气象已不逮矣。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-62",
    "text": "秦楼月，年年柳色，灞陵伤别。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-63",
    "text": "乐游原上清秋节，咸阳古道音尘绝。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-64",
    "text": "音尘绝，西风残照，汉家陵阙。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-65",
    "text": "四面边声连角起。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-66",
    "text": "千嶂里，长烟落日孤城闭。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-67",
    "text": "浊酒一杯家万里，燕然未勒归无计。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-68",
    "text": "羌管悠悠霜满地。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-69",
    "text": "人不寐，将军白发征夫泪。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-70",
    "text": "帘卷未央楼。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-71",
    "text": "夜凉银汉截天流，宫阙锁清秋。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-72",
    "text": "瑶台树，金茎露。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-73",
    "text": "凤髓香盘烟雾。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-74",
    "text": "三千珠翠拥宸游，水殿按凉州。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十则"
  },
  {
    "id": "rjch-75",
    "text": "正中词品，若欲于其词句中求之，则和泪试严妆，殆近之欤？",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-76",
    "text": "花外漏声迢递。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-77",
    "text": "惊塞雁，起城乌。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-78",
    "text": "画屏金鹧鸪。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-79",
    "text": "香雾薄，透帘幕。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-80",
    "text": "惆怅谢家池阁。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-81",
    "text": "红烛背，绣帘垂。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-82",
    "text": "梦长君不知。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-83",
    "text": "残月出门时，美人和泪辞。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-84",
    "text": "琵琶金翠羽，弦上黄莺语。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-85",
    "text": "劝我早归家，绿窗人似花。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-86",
    "text": "红烛泪阑干，翠屏烟浪寒。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-87",
    "text": "锦壶催画箭，玉佩天涯远。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-88",
    "text": "和泪试严妆，落梅飞晓霜。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十二则"
  },
  {
    "id": "rjch-89",
    "text": "南唐中主词：菡萏香销翠叶残，西风愁起绿波闲。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-90",
    "text": "大有众芳芜秽，美人迟暮之感。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-91",
    "text": "故知解人正不易得。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-92",
    "text": "还与韶光共憔悴，不堪看。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-93",
    "text": "细雨梦回鸡塞远，小楼吹彻玉笙寒。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-94",
    "text": "多少泪珠何限恨，倚阑干。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十三则"
  },
  {
    "id": "rjch-95",
    "text": "温飞卿之词，句秀也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十四则"
  },
  {
    "id": "rjch-96",
    "text": "韦端己之词，骨秀也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十四则"
  },
  {
    "id": "rjch-97",
    "text": "李重光之词，神秀也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十四则"
  },
  {
    "id": "rjch-98",
    "text": "词至李后主而眼界始大，感慨遂深，遂变伶工之词而为士大夫之词。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-99",
    "text": "周介存置诸温韦之下，可为颠倒黑白矣。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-100",
    "text": "严妆佳，淡妆亦佳，粗服乱头，不掩国色。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-101",
    "text": "飞卿，严妆也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-102",
    "text": "端己，淡妆也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-103",
    "text": "后主则粗服乱头矣。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-104",
    "text": "胭脂泪，留人醉，几时重？",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-105",
    "text": "自是人生长恨水长东！",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-106",
    "text": "罗衾不耐五更寒。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-107",
    "text": "梦里不知身是客，一晌贪欢。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-108",
    "text": "独自莫凭栏，无限江山，别时容易见时难。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-109",
    "text": "流水落花春去也，天上人间。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十五则"
  },
  {
    "id": "rjch-110",
    "text": "词人者，不失其赤子之心者也。",
    "source": "《人间词话》",
    "book": "人间词话",
    "chapter": "第十六则"
  }
]