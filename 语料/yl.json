[
  {
    "id": "yl-1",
    "text": "主人玄冠，朝服，缁带，素𫖒，即位于门东，西面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-2",
    "text": "纳采，用雁。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-3",
    "text": "士相见之礼。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-4",
    "text": "乡饮酒之礼。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡饮酒礼第四"
  },
  {
    "id": "yl-5",
    "text": "主人戒宾，宾出迎，再拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-6",
    "text": "小臣戒与者。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-7",
    "text": "君有命戒射，宰戒百官有事于射者。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-8",
    "text": "君与卿图事，遂命使者，使者再拜稽首辞，君不许，乃退。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-9",
    "text": "公食大夫之礼。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-10",
    "text": "至于郊，王使人皮弁用璧劳。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-11",
    "text": "丧服，斩衰裳，苴绖杖，绞带，冠绳缨，菅屦者。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-12",
    "text": "死于适室，幠用敛衾。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-13",
    "text": "既夕哭，请启期，告于宾。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-14",
    "text": "特豕馈食，侧亨于庙门外之右，东面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-15",
    "text": "特牲馈食之礼。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-16",
    "text": "少牢馈食之礼。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  },
  {
    "id": "yl-17",
    "text": "有司彻，扫堂。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "有司第十七"
  },
  {
    "id": "yl-18",
    "text": "有司如主人服，即位于西方，东面，北上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-19",
    "text": "主人筵于户西，西上，右几。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-20",
    "text": "挚，冬用雉，夏用腒。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-21",
    "text": "主人就先生而谋宾、介。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡饮酒礼第四"
  },
  {
    "id": "yl-22",
    "text": "主人答再拜，乃请。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-23",
    "text": "膳宰具官馔于寝东。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-24",
    "text": "射人戒诸公、卿、大夫射，司士戒士射与赞者。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-25",
    "text": "既图事，戒上介，亦如之。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-26",
    "text": "使大夫戒，各以其爵。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-27",
    "text": "侯氏亦皮弁迎于帷门之外，再拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-28",
    "text": "诸侯为天子，君，父为长子，为人后者。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-29",
    "text": "复者一人以爵弁服，簪裳于衣，左何之，扱领于带；升自前东荣、中屋，北面招以衣，曰：皋某复！",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-30",
    "text": "夙兴，设盥于祖庙门外。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-31",
    "text": "鱼腊爨亚之，北上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-32",
    "text": "及筮日，主人冠端玄，即位于门外，西面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-33",
    "text": "筮旬有一日。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  },
  {
    "id": "yl-34",
    "text": "侑出，俟于庙门之外。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "有司第十七"
  },
  {
    "id": "yl-35",
    "text": "筮与席、所卦者，具馔于西塾。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-36",
    "text": "使者玄端至。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-37",
    "text": "左头奉之，曰：某也愿见，无由达。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-38",
    "text": "主人戒宾，宾拜辱；主人答拜，乃请宾。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡饮酒礼第四"
  },
  {
    "id": "yl-39",
    "text": "宾礼辞，许。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-40",
    "text": "设洗、篚于阼阶东南，当东霤。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-41",
    "text": "前射三日，宰夫戒宰及司马、射人宿视涤。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-42",
    "text": "宰命司马戒众介，众介皆逆命，不辞。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-43",
    "text": "上介出请，入告。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-44",
    "text": "使者不答拜，遂执玉，三揖。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-45",
    "text": "妻为夫，妾为君，女子子在室为父，布总，箭笄，髽，衰，三年。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-46",
    "text": "三，降衣于前。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-47",
    "text": "陈鼎皆如殡，东方之馔亦如之。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-48",
    "text": "饎爨在东壁，西面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-49",
    "text": "子姓兄弟如主人之服，立于主人之南，西面北上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-50",
    "text": "筮于庙门之外。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  },
  {
    "id": "yl-51",
    "text": "司宫筵于户西，南面；又筵于西序，东面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "有司第十七"
  },
  {
    "id": "yl-52",
    "text": "布席于门中，𫔶西阈外，西面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-53",
    "text": "摈者出请事，入告。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-54",
    "text": "某子以命命某见。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-55",
    "text": "主人再拜，宾答再拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-56",
    "text": "罍水在东，篚在洗西，南肆。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-57",
    "text": "司马命量人量侯道与所设乏以貍步，大侯九十，参七十，干五十，设乏各去其侯西十、北十。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-58",
    "text": "宰书币，命宰夫官具。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-59",
    "text": "宾出，拜辱。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-60",
    "text": "至于阶，使者不让，先升。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-61",
    "text": "子嫁，反在父之室，为父三年。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-62",
    "text": "受用箧，升自阼阶，以衣尸。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-63",
    "text": "夷床馔于阶间。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-64",
    "text": "设洗于西阶西南，水在洗西，篚在东。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-65",
    "text": "有司群执事，如兄弟服，东面北上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-66",
    "text": "主人朝服，西面于门东。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  },
  {
    "id": "yl-67",
    "text": "尸与侑，北面于庙门之外，西上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "有司第十七"
  },
  {
    "id": "yl-68",
    "text": "筮人执策，抽上韇，兼执之，进受命于主人。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-69",
    "text": "主人如宾服，迎于门外，再拜，宾不答拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-70",
    "text": "主人对曰：某子命某见，吾子有辱。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-71",
    "text": "主人再拜，宾答拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡饮酒礼第四"
  },
  {
    "id": "yl-72",
    "text": "主人退；宾送，再拜。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-73",
    "text": "设膳篚在其北，西面。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-74",
    "text": "遂命量人、巾车张三侯。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-75",
    "text": "及期，夕币。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-76",
    "text": "大夫不答拜，将命。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-77",
    "text": "侯氏升听命，降，再拜稽首，遂升受玉。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-78",
    "text": "公士、大夫之众臣，为其君布带、绳屦。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-79",
    "text": "复者降自后西荣。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-80",
    "text": "二烛俟于殡门外。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-81",
    "text": "尊于室中北墉下，当户，两甒醴、酒，酒在东。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-82",
    "text": "席于门中，𫔶西阈外。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-83",
    "text": "史朝服，左执筮，右取上韇，兼与筮执之，东面受命于主人。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  },
  {
    "id": "yl-84",
    "text": "主人出迎尸，宗人摈。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "有司第十七"
  },
  {
    "id": "yl-85",
    "text": "宰自右少退，赞命。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士冠礼第一"
  },
  {
    "id": "yl-86",
    "text": "至于庙门，揖入；三揖，至于阶，三让。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士昏礼第二"
  },
  {
    "id": "yl-87",
    "text": "请吾子之就家也，某将走见。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士相见礼第三"
  },
  {
    "id": "yl-88",
    "text": "主人退，宾拜辱。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡饮酒礼第四"
  },
  {
    "id": "yl-89",
    "text": "众宾之席，继而西。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "乡射礼第五"
  },
  {
    "id": "yl-90",
    "text": "司宫尊于东楹之西，两方壶，左玄酒，南上。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "燕礼第六"
  },
  {
    "id": "yl-91",
    "text": "大侯之崇，见鹄于参；参见鹄于干，干不及地，不系左下纲。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "大射仪第七"
  },
  {
    "id": "yl-92",
    "text": "使者朝服，帅众介夕。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "聘礼第八"
  },
  {
    "id": "yl-93",
    "text": "宾再拜稽首。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "公食大夫礼第九"
  },
  {
    "id": "yl-94",
    "text": "使者左还而立，侯氏还璧，使者受。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "觐礼第十"
  },
  {
    "id": "yl-95",
    "text": "疏衰裳齐，牡麻绖，冠布缨，削杖，布带，疏屦三年者，父卒则为母，继母如母，慈母如母，母为长子。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "丧服第十一"
  },
  {
    "id": "yl-96",
    "text": "楔齿用角柶。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士丧礼第十二"
  },
  {
    "id": "yl-97",
    "text": "丈夫髽，散带垂，即位如初。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "既夕礼第十三"
  },
  {
    "id": "yl-98",
    "text": "无禁，幂用𫄨布，加勺，南枋。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "士虞礼第十四"
  },
  {
    "id": "yl-99",
    "text": "筮人取筮于西塾，执之，东面受命主人。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "特牲馈食礼第十五"
  },
  {
    "id": "yl-100",
    "text": "主人曰：孝孙某，来日丁亥，用荐岁事于皇祖伯某，以某妃配某氏。",
    "source": "《仪礼》",
    "book": "仪礼",
    "chapter": "少牢馈食礼第十六"
  }
