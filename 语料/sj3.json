[
  {
    "id": "sj3-1",
    "text": "关关雎鸠，在河之洲。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·周南"
  },
  {
    "id": "sj3-2",
    "text": "维鹊有巢，维鸠居之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·召南"
  },
  {
    "id": "sj3-3",
    "text": "泛彼柏舟，亦泛其流。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·邶风"
  },
  {
    "id": "sj3-4",
    "text": "泛彼柏舟，在彼中河。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·鄘风"
  },
  {
    "id": "sj3-5",
    "text": "瞻彼淇奥，绿竹猗猗。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·卫风"
  },
  {
    "id": "sj3-6",
    "text": "彼黍离离，彼稷之苗。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·王风"
  },
  {
    "id": "sj3-7",
    "text": "缁衣之宜兮，敝予又改为兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·郑风"
  },
  {
    "id": "sj3-8",
    "text": "鸡既鸣矣，朝既盈矣。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·齐风"
  },
  {
    "id": "sj3-9",
    "text": "纠纠葛屦，可以履霜？",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·魏风"
  },
  {
    "id": "sj3-10",
    "text": "蟋蟀在堂，岁聿其莫。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·唐风"
  },
  {
    "id": "sj3-11",
    "text": "有车邻邻，有马白颠。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·秦风"
  },
  {
    "id": "sj3-12",
    "text": "子之汤兮，宛丘之上兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·陈风"
  },
  {
    "id": "sj3-13",
    "text": "羔裘逍遥，狐裘以朝。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·桧风"
  },
  {
    "id": "sj3-14",
    "text": "蜉蝣之羽，衣裳楚楚。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·曹风"
  },
  {
    "id": "sj3-15",
    "text": "七月流火，九月授衣。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·豳风"
  },
  {
    "id": "sj3-16",
    "text": "呦呦鹿鸣，食野之苹。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鹿鸣之什"
  },
  {
    "id": "sj3-17",
    "text": "南有嘉鱼，烝然罩罩。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·南有嘉鱼之什"
  },
  {
    "id": "sj3-18",
    "text": "鸿雁于飞，肃肃其羽。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鸿雁之什"
  },
  {
    "id": "sj3-19",
    "text": "节彼南山，维石岩岩。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·节南山之什"
  },
  {
    "id": "sj3-20",
    "text": "习习谷风，维风及雨。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·谷风之什"
  },
  {
    "id": "sj3-21",
    "text": "倬彼甫田，岁取十千。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·甫田之什"
  },
  {
    "id": "sj3-22",
    "text": "鱼在在藻，有颁其首。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鱼藻之什"
  },
  {
    "id": "sj3-23",
    "text": "文王在上，于昭于天。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·文王之什"
  },
  {
    "id": "sj3-24",
    "text": "厥初生民，时维姜嫄。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·生民之什"
  },
  {
    "id": "sj3-25",
    "text": "荡荡上帝，下民之辟。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·荡之什"
  },
  {
    "id": "sj3-26",
    "text": "于穆清庙，肃雍显相。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·清庙之什"
  },
  {
    "id": "sj3-27",
    "text": "嗟嗟臣工，敬尔在公。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·臣工之什"
  },
  {
    "id": "sj3-28",
    "text": "闵予小子，遭家不造，嬛嬛在疚。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·闵予小子之什"
  },
  {
    "id": "sj3-29",
    "text": "駉駉牡马，在坰之野。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "鲁颂·駉之什"
  },
  {
    "id": "sj3-30",
    "text": "奏鼓简简，衎我烈祖。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "商颂"
  },
  {
    "id": "sj3-31",
    "text": "窈窕淑女，君子好逑。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·周南"
  },
  {
    "id": "sj3-32",
    "text": "之子于归，百两御之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·召南"
  },
  {
    "id": "sj3-33",
    "text": "耿耿不寐，如有隐忧。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·邶风"
  },
  {
    "id": "sj3-34",
    "text": "髧彼两髦，实维我仪。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·鄘风"
  },
  {
    "id": "sj3-35",
    "text": "有匪君子，如切如磋，如琢如磨，瑟兮僴兮，赫兮咺兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·卫风"
  },
  {
    "id": "sj3-36",
    "text": "行迈靡靡，中心摇摇。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·王风"
  },
  {
    "id": "sj3-37",
    "text": "适子之馆兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·郑风"
  },
  {
    "id": "sj3-38",
    "text": "匪鸡则鸣，苍蝇之声。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·齐风"
  },
  {
    "id": "sj3-39",
    "text": "掺掺女手，可以缝裳？",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·魏风"
  },
  {
    "id": "sj3-40",
    "text": "今我不乐，日月其除。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·唐风"
  },
  {
    "id": "sj3-41",
    "text": "未见君子，寺人之令。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·秦风"
  },
  {
    "id": "sj3-42",
    "text": "洵有情兮，而无望兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·陈风"
  },
  {
    "id": "sj3-43",
    "text": "羔裘翱翔，狐裘在堂。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·桧风"
  },
  {
    "id": "sj3-44",
    "text": "心之忧矣，于我归处。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·曹风"
  },
  {
    "id": "sj3-45",
    "text": "一之日觱发，二之日栗烈。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·豳风"
  },
  {
    "id": "sj3-46",
    "text": "我有嘉宾，鼓瑟吹笙。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鹿鸣之什"
  },
  {
    "id": "sj3-47",
    "text": "君子有酒，嘉宾式燕以乐。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·南有嘉鱼之什"
  },
  {
    "id": "sj3-48",
    "text": "之子于征，劬劳于野。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鸿雁之什"
  },
  {
    "id": "sj3-49",
    "text": "赫赫师尹，民具尔瞻。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·节南山之什"
  },
  {
    "id": "sj3-50",
    "text": "将恐将惧，维予与女。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·谷风之什"
  },
  {
    "id": "sj3-51",
    "text": "我取其陈，食我农人。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·甫田之什"
  },
  {
    "id": "sj3-52",
    "text": "王在在镐，岂乐饮酒。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鱼藻之什"
  },
  {
    "id": "sj3-53",
    "text": "周虽旧邦，其命维新。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·文王之什"
  },
  {
    "id": "sj3-54",
    "text": "克禋克祀，以弗无子。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·生民之什"
  },
  {
    "id": "sj3-55",
    "text": "疾威上帝，其命多辟。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·荡之什"
  },
  {
    "id": "sj3-56",
    "text": "济济多士，秉文之德。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·清庙之什"
  },
  {
    "id": "sj3-57",
    "text": "王厘尔成，来咨来茹。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·臣工之什"
  },
  {
    "id": "sj3-58",
    "text": "于乎皇考，永世克孝。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·闵予小子之什"
  },
  {
    "id": "sj3-59",
    "text": "薄言駉者，有驈有皇，有骊有黄，以车彭彭。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "鲁颂·駉之什"
  },
  {
    "id": "sj3-60",
    "text": "汤孙奏假，绥我思成。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "商颂"
  },
  {
    "id": "sj3-61",
    "text": "参差荇菜，左右流之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·周南"
  },
  {
    "id": "sj3-62",
    "text": "维鹊有巢，维鸠方之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·召南"
  },
  {
    "id": "sj3-63",
    "text": "微我无酒，以敖以游。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·邶风"
  },
  {
    "id": "sj3-64",
    "text": "之死矢靡它。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·鄘风"
  },
  {
    "id": "sj3-65",
    "text": "有匪君子，终不可谖兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·卫风"
  },
  {
    "id": "sj3-66",
    "text": "知我者，谓我心忧；不知我者，谓我何求。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·王风"
  },
  {
    "id": "sj3-67",
    "text": "还予授子之粲兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·郑风"
  },
  {
    "id": "sj3-68",
    "text": "东方明矣，朝既昌矣。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·齐风"
  },
  {
    "id": "sj3-69",
    "text": "要之襋之，好人服之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·魏风"
  },
  {
    "id": "sj3-70",
    "text": "无已大康，职思其居。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·唐风"
  },
  {
    "id": "sj3-71",
    "text": "阪有漆，隰有栗。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·秦风"
  },
  {
    "id": "sj3-72",
    "text": "坎其击鼓，宛丘之下。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·陈风"
  },
  {
    "id": "sj3-73",
    "text": "羔裘如膏，日出有曜。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·桧风"
  },
  {
    "id": "sj3-74",
    "text": "蜉蝣之翼，采采衣服。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·曹风"
  },
  {
    "id": "sj3-75",
    "text": "无衣无褐，何以卒岁？",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·豳风"
  },
  {
    "id": "sj3-76",
    "text": "吹笙鼓簧，承筐是将。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鹿鸣之什"
  },
  {
    "id": "sj3-77",
    "text": "南有嘉鱼，烝然汕汕。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·南有嘉鱼之什"
  },
  {
    "id": "sj3-78",
    "text": "爰及矜人，哀此鳏寡。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鸿雁之什"
  },
  {
    "id": "sj3-79",
    "text": "忧心如惔，不敢戏谈。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·节南山之什"
  },
  {
    "id": "sj3-80",
    "text": "将安将乐，女转弃予。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·谷风之什"
  },
  {
    "id": "sj3-81",
    "text": "今适南亩，或耘或耔。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·甫田之什"
  },
  {
    "id": "sj3-82",
    "text": "鱼在在藻，有莘其尾。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鱼藻之什"
  },
  {
    "id": "sj3-83",
    "text": "有周不显，帝命不时。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·文王之什"
  },
  {
    "id": "sj3-84",
    "text": "履帝武敏歆，攸介攸止，载震载夙。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·生民之什"
  },
  {
    "id": "sj3-85",
    "text": "天生烝民，其命匪谌。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·荡之什"
  },
  {
    "id": "sj3-86",
    "text": "对越在天，骏奔走在庙。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·清庙之什"
  },
  {
    "id": "sj3-87",
    "text": "嗟嗟保介，维莫之春，亦又何求？",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·臣工之什"
  },
  {
    "id": "sj3-88",
    "text": "念兹皇祖，陟降庭止。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·闵予小子之什"
  },
  {
    "id": "sj3-89",
    "text": "思无疆，思马斯臧。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "鲁颂·駉之什"
  },
  {
    "id": "sj3-90",
    "text": "鞉鼓渊渊，嘒嘒管声。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "商颂"
  },
  {
    "id": "sj3-91",
    "text": "窈窕淑女，寤寐求之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·周南"
  },
  {
    "id": "sj3-92",
    "text": "之子于归，百两将之。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·召南"
  },
  {
    "id": "sj3-93",
    "text": "我心匪鉴，不可以茹。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·邶风"
  },
  {
    "id": "sj3-94",
    "text": "母也天只，不谅人只！",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·鄘风"
  },
  {
    "id": "sj3-95",
    "text": "瞻彼淇奥，绿竹青青。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·卫风"
  },
  {
    "id": "sj3-96",
    "text": "悠悠苍天，此何人哉？",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·王风"
  },
  {
    "id": "sj3-97",
    "text": "缁衣之好兮，敝予又改造兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·郑风"
  },
  {
    "id": "sj3-98",
    "text": "匪东方则明，月出之光。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·齐风"
  },
  {
    "id": "sj3-99",
    "text": "好人提提，宛然左辟，佩其象揥。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·魏风"
  },
  {
    "id": "sj3-100",
    "text": "好乐无荒，良士瞿瞿。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·唐风"
  },
  {
    "id": "sj3-101",
    "text": "既见君子，并坐鼓瑟。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·秦风"
  },
  {
    "id": "sj3-102",
    "text": "无冬无夏，值其鹭羽。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·陈风"
  },
  {
    "id": "sj3-103",
    "text": "庶见素冠兮，棘人栾栾兮。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·桧风"
  },
  {
    "id": "sj3-104",
    "text": "心之忧矣，于我归息。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·曹风"
  },
  {
    "id": "sj3-105",
    "text": "三之日于耜，四之日举趾。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "国风·豳风"
  },
  {
    "id": "sj3-106",
    "text": "人之好我，示我周行。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鹿鸣之什"
  },
  {
    "id": "sj3-107",
    "text": "君子有酒，嘉宾式燕以衎。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·南有嘉鱼之什"
  },
  {
    "id": "sj3-108",
    "text": "鸿雁于飞，集于中泽。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鸿雁之什"
  },
  {
    "id": "sj3-109",
    "text": "国既卒斩，何用不监！",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·节南山之什"
  },
  {
    "id": "sj3-110",
    "text": "习习谷风，维风及颓。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·谷风之什"
  },
  {
    "id": "sj3-111",
    "text": "黍稷薿薿，攸介攸止，烝我髦士。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·甫田之什"
  },
  {
    "id": "sj3-112",
    "text": "王在在镐，饮酒乐岂。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "小雅·鱼藻之什"
  },
  {
    "id": "sj3-113",
    "text": "文王陟降，在帝左右。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·文王之什"
  },
  {
    "id": "sj3-114",
    "text": "载生载育，时维后稷。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·生民之什"
  },
  {
    "id": "sj3-115",
    "text": "靡不有初，鲜克有终。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "大雅·荡之什"
  },
  {
    "id": "sj3-116",
    "text": "不显不承，无射于人斯。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·清庙之什"
  },
  {
    "id": "sj3-117",
    "text": "于皇来牟，将受厥明。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·臣工之什"
  },
  {
    "id": "sj3-118",
    "text": "维予小子，夙夜敬止。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "周颂·闵予小子之什"
  },
  {
    "id": "sj3-119",
    "text": "薄言駉者，有骓有駓，有骍有骐，以车伾々。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "鲁颂·駉之什"
  },
  {
    "id": "sj3-120",
    "text": "既和且平，依我磬声。",
    "source": "《诗经》",
    "book": "诗经",
    "chapter": "商颂"
  }
]