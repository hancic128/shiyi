[
  {
    "id": "kzjy-1",
    "text": "孔子初仕，为中都宰。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "相鲁第一"
  },
  {
    "id": "kzjy-2",
    "text": "孔子为鲁司寇，摄行相事，有喜色。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "始诛第二"
  },
  {
    "id": "kzjy-3",
    "text": "孔子闲居，曾参侍。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "王言解第三"
  },
  {
    "id": "kzjy-4",
    "text": "孔子侍坐于哀公，公曰：敢问人道孰为大？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "大婚解第四"
  },
  {
    "id": "kzjy-5",
    "text": "孔子在卫，冉求言于季孙曰：国有圣人而不能用，欲以求治，是犹却步而欲求及前人，不可得已。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "儒行解第五"
  },
  {
    "id": "kzjy-6",
    "text": "子之言礼，何其尊也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问礼第六"
  },
  {
    "id": "kzjy-7",
    "text": "孔子对曰：生今之世，志古之道；居今之俗，服古之服。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五仪解第七"
  },
  {
    "id": "kzjy-8",
    "text": "孔子北游于农山，子路、子贡、颜渊侍侧。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "致思第八"
  },
  {
    "id": "kzjy-9",
    "text": "孔子曰：君子有三恕。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "三恕第九"
  },
  {
    "id": "kzjy-10",
    "text": "公曰：寡人有问于子，而子无言，何也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-11",
    "text": "孔子谓南宫敬叔曰：吾闻老聃博古知今，通礼乐之原，明道德之归，则吾师也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观周第十一"
  },
  {
    "id": "kzjy-12",
    "text": "盖入室升堂者，七十有余人，其孰为贤？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "弟子行第十二"
  },
  {
    "id": "kzjy-13",
    "text": "孔子对曰：丘未之见也，抑有卫灵公乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "贤君第十三"
  },
  {
    "id": "kzjy-14",
    "text": "’三者之问一也，而夫子应之不同，然政在异端乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩政第十四"
  },
  {
    "id": "kzjy-15",
    "text": "孔子曰：行己有六本焉，然后为君子也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "六本第十五"
  },
  {
    "id": "kzjy-16",
    "text": "季桓子穿井，获如土缶，其中有羊焉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩物第十六"
  },
  {
    "id": "kzjy-17",
    "text": "哀公问政于孔子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "哀公问政第十七"
  },
  {
    "id": "kzjy-18",
    "text": "对曰：善则善矣。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "颜回第十八"
  },
  {
    "id": "kzjy-19",
    "text": "子路初见孔子，子曰：汝何好乐？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "子路初见第十九"
  },
  {
    "id": "kzjy-20",
    "text": "楚昭王聘孔子，孔子？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "在厄第二十"
  },
  {
    "id": "kzjy-21",
    "text": "子张问入官于孔子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "入官第二十一"
  },
  {
    "id": "kzjy-22",
    "text": "愿息而事君，可乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "困誓第二十二"
  },
  {
    "id": "kzjy-23",
    "text": "’请问：黄帝者，人也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝德第二十三"
  },
  {
    "id": "kzjy-24",
    "text": "孔子曰：昔丘也闻诸老聃曰：‘天有五行，木、火、金、水、土，分时化育，以成万物，其神谓之五帝。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝第二十四"
  },
  {
    "id": "kzjy-25",
    "text": "闵子骞为费宰，问政于孔子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "执辔第二十五"
  },
  {
    "id": "kzjy-26",
    "text": "孔子对曰：分于道，谓之命；形于一，谓之性；化于阴阳，象形而发，谓之生；化穷数尽，谓之死。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本命解第二十六"
  },
  {
    "id": "kzjy-27",
    "text": "孔子闲居，子张、子贡、言游侍，论及于礼。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "论礼第二十七"
  },
  {
    "id": "kzjy-28",
    "text": "孔子观于乡射，喟然叹曰：射之以乐也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观乡射第二十八"
  },
  {
    "id": "kzjy-29",
    "text": "孔子对曰：万物本于天，人本乎祖。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "郊问第二十九"
  },
  {
    "id": "kzjy-30",
    "text": "孔子曰：圣人之设防，贵其不犯也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五刑解第三十"
  },
  {
    "id": "kzjy-31",
    "text": "至刑无所用政，桀纣之世是也；至政无所用刑，成康之世是也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "刑政第三十一"
  },
  {
    "id": "kzjy-32",
    "text": "孔子为鲁司寇，与于蜡。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "礼运第三十二"
  },
  {
    "id": "kzjy-33",
    "text": "邾隐公既即位，将冠，使大夫因孟懿子问礼于孔子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "冠颂第三十三"
  },
  {
    "id": "kzjy-34",
    "text": "卫将军文子将立先君之庙于其家，使子羔访于孔子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "庙制第三十四"
  },
  {
    "id": "kzjy-35",
    "text": "孔子学琴于师襄子。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩乐解第三十五"
  },
  {
    "id": "kzjy-36",
    "text": "为玉之寡而珉之多欤？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问玉第三十六"
  },
  {
    "id": "kzjy-37",
    "text": "孔子曰：君子之行己，期于必达于己。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "屈节解第三十七"
  },
  {
    "id": "kzjy-38",
    "text": "颜回，鲁人，字子渊，少孔子三十岁。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "七十二弟子解第三十八"
  },
  {
    "id": "kzjy-39",
    "text": "孔子之先，宋之后也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本姓解第三十九"
  },
  {
    "id": "kzjy-40",
    "text": "孔子蚤晨作，负手曳杖，逍遥于门而歌曰：泰山其颓乎！",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "终记解第四十"
  },
  {
    "id": "kzjy-41",
    "text": "孔子在齐，齐侯出田，招虞人以弓。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "正论解第四十一"
  },
  {
    "id": "kzjy-42",
    "text": "夫子作春秋，云天王狩于河阳，何也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼子贡问第四十二"
  },
  {
    "id": "kzjy-43",
    "text": "孔子曰：寝苫枕干，不仕弗与共天下也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼子夏问第四十三"
  },
  {
    "id": "kzjy-44",
    "text": "孔子之母既丧，将合葬焉，曰：古者不祔葬，为不忍先死者之复见也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼公西赤问第四十四"
  },
  {
    "id": "kzjy-45",
    "text": "制为养生送死之节，长幼异食，强弱异任，男女别涂，路无拾遗，器不雕伪。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "相鲁第一"
  },
  {
    "id": "kzjy-46",
    "text": "孔子曰：然，有是言也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "始诛第二"
  },
  {
    "id": "kzjy-47",
    "text": "孔子曰：参乎，今之君子，唯士与大夫之言可闻也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "王言解第三"
  },
  {
    "id": "kzjy-48",
    "text": "孔子愀然作色而对曰：君之及此言也，百姓之惠也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "大婚解第四"
  },
  {
    "id": "kzjy-49",
    "text": "今孔子在卫，卫将用之。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "儒行解第五"
  },
  {
    "id": "kzjy-50",
    "text": "孔子对曰：丘也鄙人，不足以知大礼也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问礼第六"
  },
  {
    "id": "kzjy-51",
    "text": "舍此而为非者，不亦鲜乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五仪解第七"
  },
  {
    "id": "kzjy-52",
    "text": "孔子四望，喟然而叹曰：于斯致思，无所不至矣！",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "致思第八"
  },
  {
    "id": "kzjy-53",
    "text": "有君不能事，有臣而求其使，非恕也；有亲不能孝，有子而求其报，非恕也；有兄不能敬，有弟而求其顺，非恕也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "三恕第九"
  },
  {
    "id": "kzjy-54",
    "text": "对曰：以君之问不先其大者，故方思所以为对。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-55",
    "text": "对曰：谨受命。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观周第十一"
  },
  {
    "id": "kzjy-56",
    "text": "子贡对以不知。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "弟子行第十二"
  },
  {
    "id": "kzjy-57",
    "text": "公曰：吾闻其闺门之内无别，而子次之贤，何也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "贤君第十三"
  },
  {
    "id": "kzjy-58",
    "text": "孔子曰：各因其事也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩政第十四"
  },
  {
    "id": "kzjy-59",
    "text": "立身有义矣，而孝为本；丧纪有礼矣，而哀为本；战阵有列矣，而勇为本；治政有理矣，而农为本；居国有道矣，而嗣为本；生财有时矣，而力为本。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "六本第十五"
  },
  {
    "id": "kzjy-60",
    "text": "孔子曰：丘之所闻者，羊也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩物第十六"
  },
  {
    "id": "kzjy-61",
    "text": "孔子对曰：文武之政，布在方策。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "哀公问政第十七"
  },
  {
    "id": "kzjy-62",
    "text": "虽然，其马将必佚。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "颜回第十八"
  },
  {
    "id": "kzjy-63",
    "text": "对曰：好长剑。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "子路初见第十九"
  },
  {
    "id": "kzjy-64",
    "text": "拜礼焉，路出于陈蔡。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "在厄第二十"
  },
  {
    "id": "kzjy-65",
    "text": "孔子曰：安身取誉为难。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "入官第二十一"
  },
  {
    "id": "kzjy-66",
    "text": "孔子曰：诗云：‘温恭朝夕，执事有恪。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "困誓第二十二"
  },
  {
    "id": "kzjy-67",
    "text": "何以能至三百年乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝德第二十三"
  },
  {
    "id": "kzjy-68",
    "text": "’古之王者，易代而改号，取法五行，五行更王，终始相生，亦象其义。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝第二十四"
  },
  {
    "id": "kzjy-69",
    "text": "子曰：以德以法。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "执辔第二十五"
  },
  {
    "id": "kzjy-70",
    "text": "故命者，性之始也；死者，生之终也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本命解第二十六"
  },
  {
    "id": "kzjy-71",
    "text": "孔子曰：居，汝三人者，吾语汝以礼，周流无不遍也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "论礼第二十七"
  },
  {
    "id": "kzjy-72",
    "text": "循声而发，不失正鹄者，其唯贤者乎！",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观乡射第二十八"
  },
  {
    "id": "kzjy-73",
    "text": "郊之祭也，大报本反始也，故以配上帝。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "郊问第二十九"
  },
  {
    "id": "kzjy-74",
    "text": "制五刑而不用，所以为至治也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五刑解第三十"
  },
  {
    "id": "kzjy-75",
    "text": "孔子曰：圣人之治化也，必刑政相参焉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "刑政第三十一"
  },
  {
    "id": "kzjy-76",
    "text": "既宾事毕，乃出游于观之上，喟然而叹。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "礼运第三十二"
  },
  {
    "id": "kzjy-77",
    "text": "子曰：其礼如世子之冠，冠于阼者，以着代也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "冠颂第三十三"
  },
  {
    "id": "kzjy-78",
    "text": "子曰：公庙设于私家，非古礼之所及，吾弗知。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "庙制第三十四"
  },
  {
    "id": "kzjy-79",
    "text": "襄子曰：吾虽以击磬为官，然能于琴。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩乐解第三十五"
  },
  {
    "id": "kzjy-80",
    "text": "诗云：‘言念君子，温其如玉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问玉第三十六"
  },
  {
    "id": "kzjy-81",
    "text": "可以屈则屈，可以伸则伸。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "屈节解第三十七"
  },
  {
    "id": "kzjy-82",
    "text": "年二十九而发白，三十一早死。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "七十二弟子解第三十八"
  },
  {
    "id": "kzjy-83",
    "text": "微子启，帝乙之元子，纣之庶兄，以圻内诸侯，入为王卿士。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本姓解第三十九"
  },
  {
    "id": "kzjy-84",
    "text": "梁木其坏乎！",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "终记解第四十"
  },
  {
    "id": "kzjy-85",
    "text": "不进，公使执之。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "正论解第四十一"
  },
  {
    "id": "kzjy-86",
    "text": "孔子曰：以臣召君，不可以训，亦书其率诸侯事天子而已。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼子贡问第四十二"
  },
  {
    "id": "kzjy-87",
    "text": "遇于朝市，不返兵而斗。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼子夏问第四十三"
  },
  {
    "id": "kzjy-88",
    "text": "诗云：‘死则同穴。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "曲礼公西赤问第四十四"
  },
  {
    "id": "kzjy-89",
    "text": "为四寸之棺，五寸之椁，因丘陵为坟，不封、不树。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "相鲁第一"
  },
  {
    "id": "kzjy-90",
    "text": "不曰‘乐以贵下人’乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "始诛第二"
  },
  {
    "id": "kzjy-91",
    "text": "至于君子之言者，希也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "王言解第三"
  },
  {
    "id": "kzjy-92",
    "text": "固臣敢无辞而对：人道政为大。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "大婚解第四"
  },
  {
    "id": "kzjy-93",
    "text": "己有才而以资邻国，难以言智也，请以重币迎之。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "儒行解第五"
  },
  {
    "id": "kzjy-94",
    "text": "公曰：吾子言焉！",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问礼第六"
  },
  {
    "id": "kzjy-95",
    "text": "二三子各言尔志，吾将择焉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "致思第八"
  },
  {
    "id": "kzjy-96",
    "text": "士能明于三恕之本，则可谓端身矣。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "三恕第九"
  },
  {
    "id": "kzjy-97",
    "text": "公曰：其大何乎？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-98",
    "text": "遂言于鲁君曰：臣受先臣之命云：孔子、圣人之后也，灭于宋。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观周第十一"
  },
  {
    "id": "kzjy-99",
    "text": "文子曰：以吾子常与学，贤者也，不知何谓？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "弟子行第十二"
  },
  {
    "id": "kzjy-100",
    "text": "孔子曰：舜之为君也，其政好生而恶杀，其任授贤而替不肖。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-101",
    "text": "孔子曰：臣语其朝廷行事，不论其私家之际也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "贤君第十三"
  },
  {
    "id": "kzjy-102",
    "text": "孔子曰：丘闻之，民之所以生者，礼为大。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问礼第六"
  },
  {
    "id": "kzjy-103",
    "text": "德若天地而静虚，化若四时而变物。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-104",
    "text": "其祖弗父何，始有国而受厉公，及正考父，佐戴、武、宣，三命兹益恭。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观周第十一"
  },
  {
    "id": "kzjy-105",
    "text": "又有士曰林国者，见贤必进之，而退与分其禄，是以灵公无游放之士，灵公贤而尊之。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "贤君第十三"
  },
  {
    "id": "kzjy-106",
    "text": "定公色不悦，谓左右曰：君子固有诬人也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "颜回第十八"
  },
  {
    "id": "kzjy-107",
    "text": "孔子曰：吾非此之问也，徒谓以子之所能，而加之以学问，岂可及乎。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "子路初见第十九"
  },
  {
    "id": "kzjy-108",
    "text": "夫德法者，御民之具，犹御马之有衔勒也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "执辔第二十五"
  },
  {
    "id": "kzjy-109",
    "text": "有始则必有终矣。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本命解第二十六"
  },
  {
    "id": "kzjy-110",
    "text": "天垂象，圣人则之，郊所以明天道也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "郊问第二十九"
  },
  {
    "id": "kzjy-111",
    "text": "醮于客位，加其有成。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "冠颂第三十三"
  },
  {
    "id": "kzjy-112",
    "text": "孔子曰：天下有王，分地建国，设祖宗，乃为亲踈贵贱多少之数。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "庙制第三十四"
  },
  {
    "id": "kzjy-113",
    "text": "今子于琴已习，可以益矣。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩乐解第三十五"
  },
  {
    "id": "kzjy-114",
    "text": "夫政者，正也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "大婚解第四"
  },
  {
    "id": "kzjy-115",
    "text": "非礼则无以节事天地之神焉，非礼则无以辨君臣上下长幼之位焉，非礼则无以别男女父子兄弟婚姻亲族疏数之交焉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "问礼第六"
  },
  {
    "id": "kzjy-116",
    "text": "孔子曰：不必然也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五仪解第七"
  },
  {
    "id": "kzjy-117",
    "text": "是以四海承风，畅于异类，凤翔麟至，鸟兽驯德。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "好生第十"
  },
  {
    "id": "kzjy-118",
    "text": "𫗴于是，粥于是，以糊其口。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观周第十一"
  },
  {
    "id": "kzjy-119",
    "text": "是以难对也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "弟子行第十二"
  },
  {
    "id": "kzjy-120",
    "text": "又有士曰庆足者，卫国有大事，则必起而治之；国无事，则退而容贤，灵公悦而敬之。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "贤君第十三"
  },
  {
    "id": "kzjy-121",
    "text": "齐君为国，奢乎台榭，淫于苑囿，五官伎乐不解于时，一旦而赐人以千乘之家者三，故曰：政在节财。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩政第十四"
  },
  {
    "id": "kzjy-122",
    "text": "置本不固，无务农桑；亲戚不悦，无务外交；事不终始，无务多业；记闻而言，无务多说；比近不安，无务求远。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "六本第十五"
  },
  {
    "id": "kzjy-123",
    "text": "丘闻之，木石之怪夔蝄蜽，水之怪龙罔象，土之怪𫅗羊也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "辩物第十六"
  },
  {
    "id": "kzjy-124",
    "text": "天道敏生，人道敏政，地道敏树。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "哀公问政第十七"
  },
  {
    "id": "kzjy-125",
    "text": "后三日，牧来诉之曰：东野毕之马佚，两骖曳两服入于厩。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "颜回第十八"
  },
  {
    "id": "kzjy-126",
    "text": "孔子曰：夫人君而无谏臣则失正，士而无教友则失听。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "子路初见第十九"
  },
  {
    "id": "kzjy-127",
    "text": "陈蔡大夫相与谋曰：孔子圣贤，其所刺讥皆中诸侯之病，若用于楚，则陈蔡危矣。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "在厄第二十"
  },
  {
    "id": "kzjy-128",
    "text": "孔子曰：己有善勿专，教不能勿怠，已过勿发，失言勿椅，不善勿遂，行事勿留。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "入官第二十一"
  },
  {
    "id": "kzjy-129",
    "text": "’事君之难也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "困誓第二十二"
  },
  {
    "id": "kzjy-130",
    "text": "孔子曰：禹、汤、文、武、周公，不可胜以观也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝德第二十三"
  },
  {
    "id": "kzjy-131",
    "text": "故其为明王者，而死配五行。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五帝第二十四"
  },
  {
    "id": "kzjy-132",
    "text": "君者，人也；吏者，辔也；刑者，策也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "执辔第二十五"
  },
  {
    "id": "kzjy-133",
    "text": "人始生而有不具者五焉，目无见，不能食，行，不能言，不能化。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "本命解第二十六"
  },
  {
    "id": "kzjy-134",
    "text": "子贡退，言游进曰：敢问礼也，领恶而全好者与？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "论礼第二十七"
  },
  {
    "id": "kzjy-135",
    "text": "诗云：‘发彼有的，以祈尔爵。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "观乡射第二十八"
  },
  {
    "id": "kzjy-136",
    "text": "孔子曰：郊之祭也，迎长日之至也。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "郊问第二十九"
  },
  {
    "id": "kzjy-137",
    "text": "凡夫之为奸邪、窃盗、靡法妄行者，生于不足。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "五刑解第三十"
  },
  {
    "id": "kzjy-138",
    "text": "太上以德教民，而以礼齐之，其次以政焉。",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "刑政第三十一"
  },
  {
    "id": "kzjy-139",
    "text": "言偃侍，曰：夫子何叹也？",
    "source": "《孔子家语》",
    "book": "孔子家语",
    "chapter": "礼运第三十二"
  }
]