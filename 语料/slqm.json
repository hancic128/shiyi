[
  {
    "id": "slqm-1",
    "text": "云对雨，雪对风，晚照对晴空。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 东"
  },
  {
    "id": "slqm-2",
    "text": "春对夏，秋对冬，暮鼓对晨钟。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 冬"
  },
  {
    "id": "slqm-3",
    "text": "楼对阁，户对窗，巨海对长江。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 江"
  },
  {
    "id": "slqm-4",
    "text": "茶对酒，赋对诗，燕子对莺儿。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 支"
  },
  {
    "id": "slqm-5",
    "text": "来对往，密对稀，燕舞对莺飞。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 微"
  },
  {
    "id": "slqm-6",
    "text": "无对有，实对虚，作赋对观书。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 鱼"
  },
  {
    "id": "slqm-7",
    "text": "金对玉，宝对珠，玉兔对金乌。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 虞"
  },
  {
    "id": "slqm-8",
    "text": "岩对岫，涧对溪，远岸对危堤。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 齐"
  },
  {
    "id": "slqm-9",
    "text": "河对海，汉对淮，赤岸对朱崖。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 佳"
  },
  {
    "id": "slqm-10",
    "text": "增对损，闭对开，碧草对苍苔。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 灰"
  },
  {
    "id": "slqm-11",
    "text": "邪对正，假对真，獬豸对麒麟。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 真"
  },
  {
    "id": "slqm-12",
    "text": "家对国，武对文，四辅对三军。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 文"
  },
  {
    "id": "slqm-13",
    "text": "幽对显，寂对喧，柳岸对桃源。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 元"
  },
  {
    "id": "slqm-14",
    "text": "多对少，易对难，虎踞对龙蟠。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 寒"
  },
  {
    "id": "slqm-15",
    "text": "兴对废，附对攀，露草对霜菅，歌廉对借寇，习孔对希颜。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 删"
  },
  {
    "id": "slqm-16",
    "text": "晴对雨，地对天，天地对山川。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 先"
  },
  {
    "id": "slqm-17",
    "text": "恭对慢，吝对骄，水远对山遥。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 萧"
  },
  {
    "id": "slqm-18",
    "text": "风对雅，象对爻，巨蟒对长蛟。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 肴"
  },
  {
    "id": "slqm-19",
    "text": "琴对瑟，剑对刀，地迥对天高。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 豪"
  },
  {
    "id": "slqm-20",
    "text": "山对水，海对河，雪竹对烟萝。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 歌"
  },
  {
    "id": "slqm-21",
    "text": "松对柏，缕对麻，蚁阵对蜂衙。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 麻"
  },
  {
    "id": "slqm-22",
    "text": "高对下，短对长，柳影对花香。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 阳"
  },
  {
    "id": "slqm-23",
    "text": "深对浅，重对轻，有影对无声。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 庚"
  },
  {
    "id": "slqm-24",
    "text": "红对紫，白对青，渔火对禅灯。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 青"
  },
  {
    "id": "slqm-25",
    "text": "新对旧，降对升，白犬对苍鹰。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 蒸"
  },
  {
    "id": "slqm-26",
    "text": "荣对辱，喜对忧，夜宴对春游。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 尤"
  },
  {
    "id": "slqm-27",
    "text": "眉对目，口对心，锦瑟对瑶琴。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 侵"
  },
  {
    "id": "slqm-28",
    "text": "千对百，两对三，地北对天南。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 覃"
  },
  {
    "id": "slqm-29",
    "text": "悲对乐，爱对嫌，玉兔对银蟾。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 盐"
  },
  {
    "id": "slqm-30",
    "text": "清对浊，苦对咸，一启对三缄。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 咸"
  },
  {
    "id": "slqm-31",
    "text": "来鸿对去燕，宿鸟对鸣虫。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 东"
  },
  {
    "id": "slqm-32",
    "text": "观山对玩水，绿竹对苍松。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 冬"
  },
  {
    "id": "slqm-33",
    "text": "蓉裳对蕙帐，玉斝对银釭。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 江"
  },
  {
    "id": "slqm-34",
    "text": "栽花对种竹，落絮对游丝。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 支"
  },
  {
    "id": "slqm-35",
    "text": "风清对月朗，露重对烟微。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 微"
  },
  {
    "id": "slqm-36",
    "text": "绿窗对朱户，宝马对香车。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 鱼"
  },
  {
    "id": "slqm-37",
    "text": "孤舟对短棹，一雁对双凫。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 虞"
  },
  {
    "id": "slqm-38",
    "text": "鹤长对凫短，水雁对山鸡。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 齐"
  },
  {
    "id": "slqm-39",
    "text": "鹭飞对鱼跃，宝钿对金钗。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 佳"
  },
  {
    "id": "slqm-40",
    "text": "书签对笔架，两曜对三台。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 灰"
  },
  {
    "id": "slqm-41",
    "text": "韩卢对苏雁，陆橘对庄椿。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 真"
  },
  {
    "id": "slqm-42",
    "text": "九经对三史，菊馥对兰芬。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 文"
  },
  {
    "id": "slqm-43",
    "text": "莺朋对燕友，早暮对寒暄。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 元"
  },
  {
    "id": "slqm-44",
    "text": "龙舟对凤辇，白鹤对青鸾。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 寒"
  },
  {
    "id": "slqm-45",
    "text": "山垒垒，水潺潺，奉璧对探镮。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 删"
  },
  {
    "id": "slqm-46",
    "text": "山川对草木，赤壁对青田。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 先"
  },
  {
    "id": "slqm-47",
    "text": "松轩对竹槛，雪赋对风谣。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 萧"
  },
  {
    "id": "slqm-48",
    "text": "天文对地理，蟋蟀对螵蛸。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 肴"
  },
  {
    "id": "slqm-49",
    "text": "峨冠对博带，紫绶对绯袍。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 豪"
  },
  {
    "id": "slqm-50",
    "text": "新欢对旧恨，痛饮对高歌。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 歌"
  },
  {
    "id": "slqm-51",
    "text": "頳鳞对白鹭，冻雀对昏鸦，白堕酒，碧沉茶，品笛对吹笳。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 麻"
  },
  {
    "id": "slqm-52",
    "text": "词人对赋客，五帝对三王。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 阳"
  },
  {
    "id": "slqm-53",
    "text": "蜂腰对蝶翅，宿醉对余酲。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 庚"
  },
  {
    "id": "slqm-54",
    "text": "唐诗对汉史，释典对仙经。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 青"
  },
  {
    "id": "slqm-55",
    "text": "葛巾对藜杖，涧水对池冰。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 蒸"
  },
  {
    "id": "slqm-56",
    "text": "燕关对楚水，蜀犬对吴牛。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 尤"
  },
  {
    "id": "slqm-57",
    "text": "晓耕对寒钓，晚笛对秋砧。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 侵"
  },
  {
    "id": "slqm-58",
    "text": "佛堂对仙洞，道院对禅庵。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 覃"
  },
  {
    "id": "slqm-59",
    "text": "醉侯对诗史，眼底对眉尖。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 盐"
  },
  {
    "id": "slqm-60",
    "text": "烟蓑对雨笠，月榜对风帆。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 咸"
  },
  {
    "id": "slqm-61",
    "text": "三尺剑，六钧弓，岭北对江东。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 东"
  },
  {
    "id": "slqm-62",
    "text": "冯妇虎，叶公龙，舞蝶对鸣蛩。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 冬"
  },
  {
    "id": "slqm-63",
    "text": "青布幔，碧油幢，宝剑对金釭。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 江"
  },
  {
    "id": "slqm-64",
    "text": "四目颉，一足夔，鸲鹆对鹭鸶。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 支"
  },
  {
    "id": "slqm-65",
    "text": "霜菊瘦，雨梅肥，客路对渔矶。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 微"
  },
  {
    "id": "slqm-66",
    "text": "伯乐马，浩然驴，弋雁对求鱼。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 鱼"
  },
  {
    "id": "slqm-67",
    "text": "横醉眼，捻吟须，李白对杨朱。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 虞"
  },
  {
    "id": "slqm-68",
    "text": "星拱北，月流西，汉露对汤霓。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 齐"
  },
  {
    "id": "slqm-69",
    "text": "鱼圉圉，鸟喈喈，草履对芒鞋。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 佳"
  },
  {
    "id": "slqm-70",
    "text": "周召虎，宋桓魋，阆苑对蓬莱。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 灰"
  },
  {
    "id": "slqm-71",
    "text": "韩五鬼，李三人，北魏对西秦。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 真"
  },
  {
    "id": "slqm-72",
    "text": "歌北鄙，咏南薰，迩听对遥闻。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 文"
  },
  {
    "id": "slqm-73",
    "text": "鱼跃沼，鹤乘轩，醉胆对吟魂。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 元"
  },
  {
    "id": "slqm-74",
    "text": "风淅淅，露漙漙，绣毂对雕鞍。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 寒"
  },
  {
    "id": "slqm-75",
    "text": "礼由公旦作，诗本仲尼删。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 删"
  },
  {
    "id": "slqm-76",
    "text": "郏鄏鼎，武城弦，木笔对苔钱。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 先"
  },
  {
    "id": "slqm-77",
    "text": "乘五马，贯双雕，烛灭对香消。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 萧"
  },
  {
    "id": "slqm-78",
    "text": "龙夭矫，虎咆哮，北学对东胶。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 肴"
  },
  {
    "id": "slqm-79",
    "text": "煎异茗，酌香醪，虎兕对猿猱。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 豪"
  },
  {
    "id": "slqm-80",
    "text": "琴再抚，剑重磨，媚柳对枯荷。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 歌"
  },
  {
    "id": "slqm-81",
    "text": "秋凉梧堕叶，春暖杏开花。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 麻"
  },
  {
    "id": "slqm-82",
    "text": "深院落，小池塘，晚眺对晨妆。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 阳"
  },
  {
    "id": "slqm-83",
    "text": "天北缺，日东生，独卧对同行。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 庚"
  },
  {
    "id": "slqm-84",
    "text": "龟曳尾，鹤梳翎，月榭对风亭。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 青"
  },
  {
    "id": "slqm-85",
    "text": "张兔网，挂鱼罾，燕雀对鹍鹏。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 蒸"
  },
  {
    "id": "slqm-86",
    "text": "茶敌睡，酒消愁，青眼对白头。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 尤"
  },
  {
    "id": "slqm-87",
    "text": "松郁郁，竹森森，闵损对曾参。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 侵"
  },
  {
    "id": "slqm-88",
    "text": "山泼黛，水浮蓝，雪岭对云潭。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 覃"
  },
  {
    "id": "slqm-89",
    "text": "风飁飁，雨绵绵，李苦对瓜甜。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 盐"
  },
  {
    "id": "slqm-90",
    "text": "莺𪾢睆，燕呢喃，柳杞对松杉。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 咸"
  },
  {
    "id": "slqm-91",
    "text": "人间清暑殿，天上广寒宫。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 东"
  },
  {
    "id": "slqm-92",
    "text": "衔泥双紫燕，课蜜几黄蜂。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 冬"
  },
  {
    "id": "slqm-93",
    "text": "忠心安社稷，利口覆家邦。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 江"
  },
  {
    "id": "slqm-94",
    "text": "半池红菡萏，一架白荼蘼。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 支"
  },
  {
    "id": "slqm-95",
    "text": "晚霞舒锦绣，朝露缀珠玑。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 微"
  },
  {
    "id": "slqm-96",
    "text": "分金齐鲍叔，奉璧蔺相如。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 鱼"
  },
  {
    "id": "slqm-97",
    "text": "秋霜多过雁，夜月有啼乌。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 虞"
  },
  {
    "id": "slqm-98",
    "text": "桃林牛已放，虞坂马长嘶。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 齐"
  },
  {
    "id": "slqm-99",
    "text": "古贤崇笃厚，时辈喜诙谐。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 佳"
  },
  {
    "id": "slqm-100",
    "text": "薰风生殿阁，皓月照楼台。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 灰"
  },
  {
    "id": "slqm-101",
    "text": "蝉鸣哀暮夏，莺啭怨残春。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 真"
  },
  {
    "id": "slqm-102",
    "text": "召公周太保，李广汉将军。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 文"
  },
  {
    "id": "slqm-103",
    "text": "轻尘生范甑，积雪拥袁门。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 元"
  },
  {
    "id": "slqm-104",
    "text": "鱼游荷叶沼，鹭立蓼花滩。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 寒"
  },
  {
    "id": "slqm-105",
    "text": "驴困客方经灞水，鸡鸣人已出函关。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 删"
  },
  {
    "id": "slqm-106",
    "text": "金城三月柳，玉井九秋莲。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "一 先"
  },
  {
    "id": "slqm-107",
    "text": "明蟾常彻夜，骤雨不终朝。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "二 萧"
  },
  {
    "id": "slqm-108",
    "text": "筑台须垒土，成屋必诛茅。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "三 肴"
  },
  {
    "id": "slqm-109",
    "text": "武夫攻骑射，野妇务蚕缫。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "四 豪"
  },
  {
    "id": "slqm-110",
    "text": "荷盘从雨洗，柳线任风搓。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "五 歌"
  },
  {
    "id": "slqm-111",
    "text": "雨长苔痕侵壁砌，月移梅影上窗纱。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "六 麻"
  },
  {
    "id": "slqm-112",
    "text": "绛霄唐帝殿，绿野晋公堂。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "七 阳"
  },
  {
    "id": "slqm-113",
    "text": "寒冰三尺厚，秋月十分明。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "八 庚"
  },
  {
    "id": "slqm-114",
    "text": "一轮秋夜月，几点晓天星。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "九 青"
  },
  {
    "id": "slqm-115",
    "text": "炉中煎药火，窗下读书灯。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十 蒸"
  },
  {
    "id": "slqm-116",
    "text": "马迁修史记，孔子作春秋。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十一 尤"
  },
  {
    "id": "slqm-117",
    "text": "秦王亲击缶，虞帝自挥琴。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十二 侵"
  },
  {
    "id": "slqm-118",
    "text": "凤飞方翙翙，虎视已眈眈。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十三 覃"
  },
  {
    "id": "slqm-119",
    "text": "画堂施锦帐，酒市舞青帘。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十四 盐"
  },
  {
    "id": "slqm-120",
    "text": "情深悲素扇，泪痛湿青衫。",
    "source": "《声律启蒙》",
    "book": "声律启蒙",
    "chapter": "十五 咸"
  }
]