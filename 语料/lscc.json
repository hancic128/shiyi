[
  {
    "id": "lscc-1",
    "text": "一曰：孟春之月，日在营室，昏参中，旦尾中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟春纪第一"
  },
  {
    "id": "lscc-2",
    "text": "一曰：仲春之月，日在奎，昏弧中，旦建星中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲春纪第二"
  },
  {
    "id": "lscc-3",
    "text": "一曰：季春之月，日在胃，昏七星中，旦牵牛中，其日甲乙，其帝太皞，其神句芒，其虫鳞，其音角，律中姑洗，其数八，其味酸，其臭膻，其祀户，祭先脾。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季春纪第三"
  },
  {
    "id": "lscc-4",
    "text": "一曰：孟夏之月，日在毕，昏翼中，旦婺女中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟夏纪第四"
  },
  {
    "id": "lscc-5",
    "text": "一曰：仲夏之月，日在东井，昏亢中，旦危中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲夏纪第五"
  },
  {
    "id": "lscc-6",
    "text": "一曰：季夏之月，日在柳，昏心中，旦奎中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季夏纪第六"
  },
  {
    "id": "lscc-7",
    "text": "一曰：孟秋之月，日在翼，昏斗中，旦毕中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟秋纪第七"
  },
  {
    "id": "lscc-8",
    "text": "一曰：仲秋之月，日在角，昏牵牛中，旦觜嶲中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲秋纪第八"
  },
  {
    "id": "lscc-9",
    "text": "一曰：季秋之月，日在房，昏虚中，旦柳中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季秋纪第九"
  },
  {
    "id": "lscc-10",
    "text": "一曰：孟冬之月，日在尾，昏危中，旦七星中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟冬纪第十"
  },
  {
    "id": "lscc-11",
    "text": "一曰：仲冬之月，日在斗，昏东壁中，旦轸中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲冬纪第十一"
  },
  {
    "id": "lscc-12",
    "text": "一曰：季冬之月，日在婺女，昏娄中，旦氐中。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季冬纪第十二"
  },
  {
    "id": "lscc-13",
    "text": "一曰：天地有始，天微以成，地塞以形，天地合和，生之大经也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "有始览第一"
  },
  {
    "id": "lscc-14",
    "text": "一曰：凡为天下，治国家，必务本而后末。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孝行览第二"
  },
  {
    "id": "lscc-15",
    "text": "一曰：贤主愈大愈惧，愈强愈恐。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎大览第三"
  },
  {
    "id": "lscc-16",
    "text": "一曰：凡国之亡也，有道者必先去，古今一也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "先识览第四"
  },
  {
    "id": "lscc-17",
    "text": "一曰：凡人主必审分，然后治可以至，奸伪邪辟之涂可以息，恶气苛疾无自至。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审分览第五"
  },
  {
    "id": "lscc-18",
    "text": "一曰：人主出声应容，不可不审。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审应览第六"
  },
  {
    "id": "lscc-19",
    "text": "一曰：世之所不足者，理义也；所有馀者，妄苟也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "离俗览第七"
  },
  {
    "id": "lscc-20",
    "text": "一曰：凡人之性，爪牙不足以自守卫，肌肤不足以扞寒暑，筋骨不足以从利辟害，勇敢不足以却猛禁悍。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "恃君览第八"
  },
  {
    "id": "lscc-21",
    "text": "一曰：开春始雷，则蛰虫动矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "开春论第一"
  },
  {
    "id": "lscc-22",
    "text": "一曰：行不可不孰。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎行论第二"
  },
  {
    "id": "lscc-23",
    "text": "一曰：贤主所贵莫如士。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "贵直论第三"
  },
  {
    "id": "lscc-24",
    "text": "一曰：贤者之事也，虽贵不苟为，虽听不自阿，必中理然后动，必当义然后举。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "不苟论第四"
  },
  {
    "id": "lscc-25",
    "text": "一曰：事多似倒而顺，多似顺而倒。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "似顺论第五"
  },
  {
    "id": "lscc-26",
    "text": "一曰：士不偏不党。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "士容论第六"
  },
  {
    "id": "lscc-27",
    "text": "其日甲乙，其帝太皞，其神句芒，其虫鳞，其音角，律中太蔟，其数八，其味酸，其臭膻，其祀户，祭先脾。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟春纪第一"
  },
  {
    "id": "lscc-28",
    "text": "其日甲乙，其帝太皞，其神句芒，其虫鳞，其音角，律中夹钟，其数八，其味酸，其臭膻，其祀户，祭先脾。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲春纪第二"
  },
  {
    "id": "lscc-29",
    "text": "桐始华，田鼠化为𫛪，虹始见，萍始生。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季春纪第三"
  },
  {
    "id": "lscc-30",
    "text": "其日丙丁，其帝炎帝，其神祝融，其虫羽，其音征，律中仲吕，其数七，其性礼，其事视，其味苦，其臭焦，其祀灶，祭先肺。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟夏纪第四"
  },
  {
    "id": "lscc-31",
    "text": "其日丙丁，其帝炎帝，其神祝融，其虫羽，其音征，律中蕤宾，其数七，其味苦，其臭焦，其祀灶，祭先肺。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲夏纪第五"
  },
  {
    "id": "lscc-32",
    "text": "其日丙丁，其帝炎帝，其神祝融，其虫羽，其音征，律中林钟。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季夏纪第六"
  },
  {
    "id": "lscc-33",
    "text": "其日庚辛，其帝少皞，其神蓐收，其虫毛，其音商，律中夷则。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟秋纪第七"
  },
  {
    "id": "lscc-34",
    "text": "其日庚辛，其帝少皞，其神蓐收，其虫毛，其音商，律中南吕。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲秋纪第八"
  },
  {
    "id": "lscc-35",
    "text": "其日庚辛，其帝少皞，其神蓐收，其虫毛，其音商，律中无射。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季秋纪第九"
  },
  {
    "id": "lscc-36",
    "text": "其日壬癸，其帝颛顼，其神玄冥，其虫介，其音羽，律中应钟。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟冬纪第十"
  },
  {
    "id": "lscc-37",
    "text": "其日壬癸，其帝颛顼，其神玄冥，其虫介，其音羽，律中黄钟。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲冬纪第十一"
  },
  {
    "id": "lscc-38",
    "text": "其日壬癸，其帝颛顼，其神玄冥，其虫介，其音羽，律中大吕，其数六，其味咸，其臭朽，其祀行，祭先肾。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季冬纪第十二"
  },
  {
    "id": "lscc-39",
    "text": "以寒暑日月昼夜知之，以殊形殊能异宜说之。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "有始览第一"
  },
  {
    "id": "lscc-40",
    "text": "所谓本者，非耕耘种植之谓，务其人也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孝行览第二"
  },
  {
    "id": "lscc-41",
    "text": "凡大者，小邻国也；强者，胜其敌也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎大览第三"
  },
  {
    "id": "lscc-42",
    "text": "地从于城，城从于民，民从于贤。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "先识览第四"
  },
  {
    "id": "lscc-43",
    "text": "夫治身与治国，一理之术也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审分览第五"
  },
  {
    "id": "lscc-44",
    "text": "凡主有识，言不欲先。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审应览第六"
  },
  {
    "id": "lscc-45",
    "text": "民之情，贵所不足，贱所有馀，故布衣、人臣之行，洁白清廉中绳，愈穷愈荣，虽死，天下愈高之，所不足也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "离俗览第七"
  },
  {
    "id": "lscc-46",
    "text": "然且犹裁万物，制禽兽，服狡虫，寒暑燥湿弗能害，不唯先有其备，而以群聚邪！",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "恃君览第八"
  },
  {
    "id": "lscc-47",
    "text": "时雨降，则草木育矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "开春论第一"
  },
  {
    "id": "lscc-48",
    "text": "不孰，如赴深谿，虽悔无及。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎行论第二"
  },
  {
    "id": "lscc-49",
    "text": "所以贵士，为其直言也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "贵直论第三"
  },
  {
    "id": "lscc-50",
    "text": "此忠臣之行也，贤主之所说，而不肖主之所不说。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "不苟论第四"
  },
  {
    "id": "lscc-51",
    "text": "有知顺之为倒、倒之为顺者，则可与言化矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "似顺论第五"
  },
  {
    "id": "lscc-52",
    "text": "柔而坚，虚而实。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "士容论第六"
  },
  {
    "id": "lscc-53",
    "text": "东风解冻，蛰虫始振，鱼上冰，獭祭鱼，候雁北。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟春纪第一"
  },
  {
    "id": "lscc-54",
    "text": "始雨水，桃李华，苍庚鸣，鹰化为鸠。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲春纪第二"
  },
  {
    "id": "lscc-55",
    "text": "天子居青阳右个，乘鸾辂，驾苍龙，载青旗，衣青衣，服青玉，食麦与羊，其器疏以达。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季春纪第三"
  },
  {
    "id": "lscc-56",
    "text": "蝼蝈鸣，丘蚓出，王菩生，苦菜秀。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟夏纪第四"
  },
  {
    "id": "lscc-57",
    "text": "小暑至，螳螂生，鸡始鸣，反舌无声。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲夏纪第五"
  },
  {
    "id": "lscc-58",
    "text": "其数七，其味苦，其臭焦，其祀灶，祭先肺。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季夏纪第六"
  },
  {
    "id": "lscc-59",
    "text": "其数九，其味辛，其臭腥，其祀门，祭先肝。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟秋纪第七"
  },
  {
    "id": "lscc-60",
    "text": "其数六，其味咸，其臭朽，其祀行，祭先肾。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟冬纪第十"
  },
  {
    "id": "lscc-61",
    "text": "雁北乡，鹊始巢，雉雊鸡乳，天子居玄堂右个，乘玄骆，驾铁骊，载玄旗，衣黑衣，服玄玉，食黍与彘，其器宏以弇。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季冬纪第十二"
  },
  {
    "id": "lscc-62",
    "text": "夫物合而成，离而生。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "有始览第一"
  },
  {
    "id": "lscc-63",
    "text": "务其人，非贫而富之，寡而众之，务其本也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孝行览第二"
  },
  {
    "id": "lscc-64",
    "text": "胜其敌则多怨，小邻国则多患。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎大览第三"
  },
  {
    "id": "lscc-65",
    "text": "故贤主得贤者而民得，民得而城得，城得而地得。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "先识览第四"
  },
  {
    "id": "lscc-66",
    "text": "今以众地者，公作则迟，有所匿其力也；分地则速，无所匿迟也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审分览第五"
  },
  {
    "id": "lscc-67",
    "text": "人唱我和，人先我随，以其出为之入，以其言为之名，取其实以责其名，则说者不敢妄言，而人主之所执其要矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审应览第六"
  },
  {
    "id": "lscc-68",
    "text": "然而以理义斫削，神农、黄帝犹有可非，微独舜、汤。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "离俗览第七"
  },
  {
    "id": "lscc-69",
    "text": "群之可聚也，相与利之也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "恃君览第八"
  },
  {
    "id": "lscc-70",
    "text": "饮食居处适，则九窍百节千脉皆通利矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "开春论第一"
  },
  {
    "id": "lscc-71",
    "text": "君子计行虑义，小人计行其利，乃不利。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎行论第二"
  },
  {
    "id": "lscc-72",
    "text": "言直则枉者见矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "贵直论第三"
  },
  {
    "id": "lscc-73",
    "text": "非恶其声也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "不苟论第四"
  },
  {
    "id": "lscc-74",
    "text": "至长反短，至短反长，天之道也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "似顺论第五"
  },
  {
    "id": "lscc-75",
    "text": "其状朗然不儇，若失其一。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "士容论第六"
  },
  {
    "id": "lscc-76",
    "text": "天子居青阳左个，乘鸾辂，驾苍龙，载青旗，衣青衣，服青玉，食麦与羊，其器疏以达。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟春纪第一"
  },
  {
    "id": "lscc-77",
    "text": "天子居青阳太庙，乘鸾辂，驾苍龙，载青旗，衣青衣，服青玉，食麦与羊，其器疏以达。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲春纪第二"
  },
  {
    "id": "lscc-78",
    "text": "是月也，天子乃荐鞠衣于先帝，命舟牧覆舟，五覆五反，乃告舟备具于天子焉。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季春纪第三"
  },
  {
    "id": "lscc-79",
    "text": "天子居明堂左个，乘朱辂，驾赤骝，载赤旗，衣赤衣，服赤玉，食菽与鸡，其器高以觕。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟夏纪第四"
  },
  {
    "id": "lscc-80",
    "text": "天子居明堂太庙，乘朱辂、驾赤骝，载赤旗，衣朱衣，服赤玉，食菽与鸡，其器高以觕，养壮狡。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲夏纪第五"
  },
  {
    "id": "lscc-81",
    "text": "凉风至，白露降，寒蝉鸣，鹰乃祭鸟，始用刑戮。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟秋纪第七"
  },
  {
    "id": "lscc-82",
    "text": "凉风生，候雁来，玄鸟归，群鸟养羞。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲秋纪第八"
  },
  {
    "id": "lscc-83",
    "text": "候雁来，宾爵入大水为蛤。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季秋纪第九"
  },
  {
    "id": "lscc-84",
    "text": "水始冰，地始冻，雉入大水为蜃。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟冬纪第十"
  },
  {
    "id": "lscc-85",
    "text": "冰益壮，地始坼，鹖鴠不鸣，虎始交。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲冬纪第十一"
  },
  {
    "id": "lscc-86",
    "text": "命有司大傩，旁磔，出土牛，以送寒气。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季冬纪第十二"
  },
  {
    "id": "lscc-87",
    "text": "知合知成，知离知生，则天地平矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "有始览第一"
  },
  {
    "id": "lscc-88",
    "text": "务本莫贵于孝。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孝行览第二"
  },
  {
    "id": "lscc-89",
    "text": "多患多怨，国虽强大，恶得不惧？",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎大览第三"
  },
  {
    "id": "lscc-90",
    "text": "夫地得岂必足行其地、人说其民哉？",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "先识览第四"
  },
  {
    "id": "lscc-91",
    "text": "主亦有地，臣主同地，则臣有所匿其邪矣，主无所避其累矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审分览第五"
  },
  {
    "id": "lscc-92",
    "text": "孔思请行，鲁君曰：天下主亦犹寡人也，将焉之？",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审应览第六"
  },
  {
    "id": "lscc-93",
    "text": "飞兔、要褭，古之骏马也，材犹有短。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "离俗览第七"
  },
  {
    "id": "lscc-94",
    "text": "利之出于群也，君道立也。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "恃君览第八"
  },
  {
    "id": "lscc-95",
    "text": "王者厚其德，积众善，而凤皇圣人皆来至矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "开春论第一"
  },
  {
    "id": "lscc-96",
    "text": "有知不利之利者，则可与言理矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎行论第二"
  },
  {
    "id": "lscc-97",
    "text": "人主之患，欲闻枉而恶直言。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "贵直论第三"
  },
  {
    "id": "lscc-98",
    "text": "人主虽不肖，其说忠臣之声与贤主同，行其实则与贤主有异。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "不苟论第四"
  },
  {
    "id": "lscc-99",
    "text": "荆庄王欲伐陈，使人视之。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "似顺论第五"
  },
  {
    "id": "lscc-100",
    "text": "傲小物而志属于大，似无勇而未可恐猲，执固横敢而不可辱害。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "士容论第六"
  },
  {
    "id": "lscc-101",
    "text": "是月也，以立春。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟春纪第一"
  },
  {
    "id": "lscc-102",
    "text": "是月也，安萌牙，养幼少，存诸孤；择元日，命人社；命有司，省囹圄，去桎梏，无肆掠，止狱讼。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲春纪第二"
  },
  {
    "id": "lscc-103",
    "text": "天子焉始乘舟。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季春纪第三"
  },
  {
    "id": "lscc-104",
    "text": "是月也，以立夏。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟夏纪第四"
  },
  {
    "id": "lscc-105",
    "text": "是月也，命乐师修鞀鞞鼓，均琴瑟管箫，执干戚戈羽，调竽笙埙篪，饬锺磬柷敔。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲夏纪第五"
  },
  {
    "id": "lscc-106",
    "text": "天子居明堂右个，乘朱辂，驾赤骝，载赤旗，衣朱衣，服赤玉，食菽与鸡，其器高以觕。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季夏纪第六"
  },
  {
    "id": "lscc-107",
    "text": "天子居总章左个，乘戎路，驾白骆，载白旗，衣白衣，服白玉，食麻与犬，其器廉以深。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟秋纪第七"
  },
  {
    "id": "lscc-108",
    "text": "天子居总章太庙，乘戎路，驾白骆，载白旗，衣白衣，服白玉，食麻与犬，其器廉以深。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲秋纪第八"
  },
  {
    "id": "lscc-109",
    "text": "菊有黄华，豺则祭兽戮禽。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季秋纪第九"
  },
  {
    "id": "lscc-110",
    "text": "天子居玄堂左个，乘玄辂，驾铁骊，载玄旗，衣黑衣，服玄玉，食黍与彘，其器宏以弇。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孟冬纪第十"
  },
  {
    "id": "lscc-111",
    "text": "天子居玄堂太庙，乘玄辂，驾铁骊，载玄旗，衣黑衣，服玄玉，食黍与彘，其器宏以弇。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "仲冬纪第十一"
  },
  {
    "id": "lscc-112",
    "text": "征鸟厉疾，乃毕行山川之祀，及帝之大臣、天地之神祇。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "季冬纪第十二"
  },
  {
    "id": "lscc-113",
    "text": "平也者，皆当察其情，处其形。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "有始览第一"
  },
  {
    "id": "lscc-114",
    "text": "人主孝，则名章荣，下服听，天下誉；人臣孝，则事君忠，处官廉，临难死；士民孝，则耕芸疾，守战固，不罢北。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "孝行览第二"
  },
  {
    "id": "lscc-115",
    "text": "故贤主于安思危，于达思穷，于得思丧。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "慎大览第三"
  },
  {
    "id": "lscc-116",
    "text": "得其要而已矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "先识览第四"
  },
  {
    "id": "lscc-117",
    "text": "凡为善难，任善易。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审分览第五"
  },
  {
    "id": "lscc-118",
    "text": "孔思对曰：盖闻君子犹鸟也，骇则举。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "审应览第六"
  },
  {
    "id": "lscc-119",
    "text": "故以绳墨取木，则宫室不成矣。",
    "source": "《吕氏春秋》",
    "book": "吕氏春秋",
    "chapter": "离俗览第七"
  }
]