[
  {
    "id": "sqzf-1",
    "text": "孙子曰：兵者，国之大事，死生之地，存亡之道，不可不察也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-2",
    "text": "孙子曰：凡用兵之法，驰车千驷，革车千乘，带甲十万，千里馈粮，则内外之费，宾客之用，胶漆之材，车甲之奉，日费千金，然后十万之师举矣。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-3",
    "text": "孙子曰：凡用兵之法，全国为上，破国次之；全军为上，破军次之；全旅为上，破旅次之；全卒为上，破卒次之；全伍为上，破伍次之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-4",
    "text": "孙子曰：昔之善战者，先为不可胜，以待敌之可胜。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-5",
    "text": "孙子曰：凡治众如治寡，分数是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-6",
    "text": "孙子曰：凡先处战地而待敌者佚，后处战地而趋战者劳，故善战者，致人而不致于人。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-7",
    "text": "孙子曰：凡用兵之法，将受命于君，合军聚众，交和而舍，莫难于军争。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-8",
    "text": "孙子曰：凡用兵之法，将受命于君，合军聚众。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-9",
    "text": "孙子曰：凡处军相敌：绝山依谷，视生处高，战隆无登，此处山之军也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-10",
    "text": "孙子曰：地形有通者，有挂者，有支者，有隘者，有险者，有远者。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-11",
    "text": "孙子曰：用兵之法，有散地，有轻地，有争地，有交地，有衢地，有重地，有圮地，有围地，有死地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-12",
    "text": "孙子曰：凡火攻有五：一曰火人，二曰火积，三曰火辎，四曰火库，五曰火队。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-13",
    "text": "孙子曰：凡兴师十万，出征千里，百姓之费，公家之奉，日费千金；内外骚动，怠于道路，不得操事者，七十万家。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-14",
    "text": "故经之以五事，校之以计，而索其情：一曰道，二曰天，三曰地，四曰将，五曰法。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-15",
    "text": "其用战也胜，久则钝兵挫锐，攻城则力屈，久暴师则国用不足。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-16",
    "text": "是故百战百胜，非善之善者也；不战而屈人之兵，善之善者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-17",
    "text": "不可胜在己，可胜在敌。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-18",
    "text": "斗众如斗寡，形名是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-19",
    "text": "能使敌人自至者，利之也；能使敌人不得至者，害之也，故敌佚能劳之，饱能饥之，安能动之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-20",
    "text": "军争之难者，以迂为直，以患为利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-21",
    "text": "圮地无舍，衢地交合，绝地无留，围地则谋，死地则战，途有所不由，军有所不击，城有所不攻，地有所不争，君命有所不受。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-22",
    "text": "绝水必远水；客绝水而来，勿迎之于水内，令半济而击之，利；欲战者，无附于水而迎客；视生处高，无迎水流，此处水上之军也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-23",
    "text": "我可以往，彼可以来，曰通；通形者，先居高阳，利粮道，以战则利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-24",
    "text": "诸侯自战其地，为散地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-25",
    "text": "行火必有因，烟火必素具。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-26",
    "text": "相守数年，以争一日之胜，而爱爵禄百金，不知敌之情者，不仁之至也，非人之将也，非主之佐也，非胜之主也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-27",
    "text": "道者，令民与上同意也，故可与之死，可与之生，而不畏危也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-28",
    "text": "夫钝兵挫锐，屈力殚货，则诸侯乘其弊而起，虽有智者，不能善其后矣。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-29",
    "text": "故上兵伐谋，其次伐交，其次伐兵，其下攻城。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-30",
    "text": "故善战者，能为不可胜，不能使敌之必可胜。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-31",
    "text": "三军之众，可使必受敌而无败者，奇正是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-32",
    "text": "出其所不趋，趋其所不意。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-33",
    "text": "故迂其途，而诱之以利，后人发，先人至，此知迂直之计者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-34",
    "text": "故将通于九变之利者，知用兵矣；将不通九变之利，虽知地形，不能得地之利矣；治兵不知九变之术，虽知五利，不能得人之用矣。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-35",
    "text": "绝斥泽，惟亟去无留；若交军于斥泽之中，必依水草而背众树，此处斥泽之军也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-36",
    "text": "可以往，难以返，曰挂；挂形者，敌无备，出而胜之；敌若有备，出而不胜，难以返，不利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-37",
    "text": "入人之地不深者，为轻地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-38",
    "text": "发火有时，起火有日。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-39",
    "text": "故明君贤将，所以动而胜人，成功出于众者，先知也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-40",
    "text": "天者，阴阳、寒暑、时制也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-41",
    "text": "故兵闻拙速，未睹巧之久也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-42",
    "text": "攻城之法为不得已。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-43",
    "text": "故曰：胜可知，而不可为。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-44",
    "text": "兵之所加，如以碫投卵者，虚实是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-45",
    "text": "行千里而不劳者，行于无人之地也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-46",
    "text": "故军争为利，军争为危。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-47",
    "text": "是故智者之虑，必杂于利害，杂于利而务可信也，杂于害而患可解也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-48",
    "text": "平陆处易，而右背高，前死后生，此处平陆之军也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-49",
    "text": "我出而不利，彼出而不利，曰支；支形者，敌虽利我，我无出也；引而去之，令敌半出而击之，利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-50",
    "text": "我得则利，彼得亦利者，为争地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-51",
    "text": "时者，天之燥也；日者，月在箕、壁、翼、轸也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-52",
    "text": "先知者，不可取于鬼神，不可象于事，不可验于度，必取于人，知敌之情者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-53",
    "text": "地者，高下，远近，险易，广狭，死生也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-54",
    "text": "夫兵久而国利者，未之有也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-55",
    "text": "修橹轒辒，具器械，三月而后成，距堙，又三月而后已。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-56",
    "text": "不可胜者，守也；可胜者，攻也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-57",
    "text": "凡战者，以正合，以奇胜。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-58",
    "text": "攻而必取者，攻其所不守也；守而必固者，守其所不攻也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-59",
    "text": "举军而争利则不及，委军而争利则辎重捐。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-60",
    "text": "是故屈诸侯者以害，役诸侯者以业，趋诸侯者以利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-61",
    "text": "凡此四军之利，黄帝之所以胜四帝也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-62",
    "text": "隘形者，我先居之，必盈之以待敌；若敌先居之，盈而勿从，不盈而从之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-63",
    "text": "我可以往，彼可以来者，为交地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-64",
    "text": "凡此四宿者，风起之日也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-65",
    "text": "故用间有五：有因间，有内间，有反间，有死间，有生间。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-66",
    "text": "将者，智、信、仁、勇、严也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-67",
    "text": "故不尽知用兵之害者，则不能尽知用兵之利也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-68",
    "text": "将不胜其忿而蚁附之，杀士卒三分之一而城不拔者，此攻之灾也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-69",
    "text": "守则不足，攻则有余。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-70",
    "text": "故善出奇者，无穷如天地，不竭如江河。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-71",
    "text": "故善攻者，敌不知其所守；善守者，敌不知其所攻。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-72",
    "text": "是故卷甲而趋，日夜不处，倍道兼行，百里而争利，则擒三将军，劲者先，疲者后，其法十一而至；五十里而争利，则蹶上将军，其法半至；三十里而争利，则三分之二至。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-73",
    "text": "故用兵之法，无恃其不来，恃吾有以待之；无恃其不攻，恃吾有所不可攻也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-74",
    "text": "凡军好高而恶下，贵阳而贱阴，养生而处实，军无百疾，是谓必胜。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-75",
    "text": "险形者，我先居之，必居高阳以待敌；若敌先居之，引而去之，勿从也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-76",
    "text": "诸侯之地三属，先至而得天下之众者，为衢地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-77",
    "text": "凡火攻，必因五火之变而应之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-78",
    "text": "五间俱起，莫知其道，是谓神纪，人君之宝也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-79",
    "text": "法者，曲制、官道、主用也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-80",
    "text": "善用兵者，役不再籍，粮不三载，取用于国，因粮于敌，故军食可足也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-81",
    "text": "故善用兵者，屈人之兵而非战也，拔人之城而非攻也，毁人之国而非久也，必以全争于天下。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-82",
    "text": "善守者，藏于九地之下，善攻者，动于九天之上，故能自保而全胜也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-83",
    "text": "终而复始，日月是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-84",
    "text": "微乎微乎，至于无形。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-85",
    "text": "是故军无辎重则亡，无粮食则亡，无委积则亡。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-86",
    "text": "故将有五危，必死可杀，必生可虏，忿速可侮，廉洁可辱，爱民可烦。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-87",
    "text": "丘陵堤防，必处其阳，而右背之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-88",
    "text": "远形者，势均，难以挑战，战而不利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-89",
    "text": "入人之地深，背城邑多者，为重地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-90",
    "text": "火发于内，则早应之于外。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-91",
    "text": "因间者，因其乡人而用之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-92",
    "text": "凡此五者，将莫不闻，知之者胜，不知者不胜。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-93",
    "text": "国之贫于师者远输，远输则百姓贫；近师者贵卖，贵卖则百姓财竭，财竭则急于丘役。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-94",
    "text": "故兵不顿而利可全，此谋攻之法也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-95",
    "text": "见胜不过众人之所知，非善之善者也；战胜而天下曰善，非善之善者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-96",
    "text": "死而复生，四时是也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-97",
    "text": "神乎神乎，至于无声，故能为敌之司命。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-98",
    "text": "故不知诸侯之谋者，不能豫交；不知山林、险阻、沮泽之形者，不能行军；不用乡导者，不能得地利。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-99",
    "text": "凡此五者，将之过也，用兵之灾也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-100",
    "text": "此兵之利，地之助也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-101",
    "text": "故举秋毫不为多力，见日月不为明目，闻雷霆不为聪耳。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-102",
    "text": "凡此六者，地之道也；将之至任，不可不察也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-103",
    "text": "行山林、险阻、沮泽，凡难行之道者，为圮地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-104",
    "text": "火发兵静者，待而勿攻，极其火力，可从而从之，不可从而止。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-105",
    "text": "内间者，因其官人而用之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-106",
    "text": "故校之以计，而索其情，曰：主孰有道？",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-107",
    "text": "力屈财殚，中原内虚于家，百姓之费，十去其七；公家之费，破车罢马，甲胄矢弩，戟楯蔽橹，丘牛大车，十去其六。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-108",
    "text": "故用兵之法，十则围之，五则攻之，倍则分之，敌则能战之，少则能逃之，不若则能避之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-109",
    "text": "古之所谓善战者，胜于易胜者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-110",
    "text": "声不过五，五声之变，不可胜听也；色不过五，五色之变，不可胜观也；味不过五，五味之变，不可胜尝也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-111",
    "text": "进而不可御者，冲其虚也；退而不可追者，速而不可及也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-112",
    "text": "故兵以诈立，以利动，以分合为变者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-113",
    "text": "覆军杀将，必以五危，不可不察也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九变篇第八"
  },
  {
    "id": "sqzf-114",
    "text": "上雨，水沫至，欲涉者，待其定也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-115",
    "text": "故兵有走者，有弛者，有陷者，有崩者，有乱者，有北者。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-116",
    "text": "所由入者隘，所从归者迂，彼寡可以击吾之众者，为围地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-117",
    "text": "火可发于外，无待于内，以时发之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-118",
    "text": "反间者，因其敌间而用之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-119",
    "text": "吾以此知胜负矣。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-120",
    "text": "故智将务食于敌，食敌一钟，当吾二十钟；萁秆一石，当吾二十石。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-121",
    "text": "故小敌之坚，大敌之擒也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-122",
    "text": "故善战者之胜也，无智名，无勇功。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  },
  {
    "id": "sqzf-123",
    "text": "战势不过奇正，奇正之变，不可胜穷也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "兵势篇第五"
  },
  {
    "id": "sqzf-124",
    "text": "故我欲战，敌虽高垒深沟，不得不与我战者，攻其所必救也；我不欲战，虽画地而守之，敌不得与我战者，乖其所之也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "虚实篇第六"
  },
  {
    "id": "sqzf-125",
    "text": "故其疾如风，其徐如林，侵掠如火，不动如山，难知如阴，动如雷震。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军争篇第七"
  },
  {
    "id": "sqzf-126",
    "text": "凡地有绝涧、天井、天牢、天罗、天陷、天隙，必亟去之，勿近也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "行军篇第九"
  },
  {
    "id": "sqzf-127",
    "text": "凡此六者，非天之灾，将之过也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "地形篇第十"
  },
  {
    "id": "sqzf-128",
    "text": "疾战则存，不疾战则亡者，为死地。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "九地篇第十一"
  },
  {
    "id": "sqzf-129",
    "text": "火发上风，无攻下风。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "火攻篇第十二"
  },
  {
    "id": "sqzf-130",
    "text": "死间者，为诳事于外，令吾间知之，而传于敌间也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "用间篇第十三"
  },
  {
    "id": "sqzf-131",
    "text": "将听吾计，用之必胜，留之；将不听吾计，用之必败，去之。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "始计篇第一"
  },
  {
    "id": "sqzf-132",
    "text": "故杀敌者，怒也；取敌之利者，货也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "作战篇第二"
  },
  {
    "id": "sqzf-133",
    "text": "夫将者，国之辅也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "谋攻篇第三"
  },
  {
    "id": "sqzf-134",
    "text": "故其战胜不忒，不忒者，其所措必胜，胜已败者也。",
    "source": "《孙子兵法》",
    "book": "孙子兵法",
    "chapter": "军形篇第四"
  }
]