[
  {
    "id": "sbzf-1",
    "text": "昔者，梁君将攻邯郸，使将军庞涓，带甲八万至于茬丘。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "擒庞涓第一"
  },
  {
    "id": "sbzf-2",
    "text": "孙子见威王，曰：​夫兵者，非士恒势也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "见威王第二"
  },
  {
    "id": "sbzf-3",
    "text": "孙子答曰：以轻卒尝之，贱而勇者将之，期于北，毋期于得。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-4",
    "text": "孙子曰：明将之问也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "陈忌问垒第四"
  },
  {
    "id": "sbzf-5",
    "text": "孙子曰：兵之胜在于篡卒，其勇在于制，其巧在于势，其利在于信，其德在于道，其富在于亟归；其强在于休民，其伤在于数战。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-6",
    "text": "孙子曰：间于天地之间，莫贵于人。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "月战第六"
  },
  {
    "id": "sbzf-7",
    "text": "孙子曰：智不足，将兵，自恃也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "八阵第七"
  },
  {
    "id": "sbzf-8",
    "text": "孙子曰：凡地之道，阳为表，阴为里，直者为纲，术者为纪。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "地葆第八"
  },
  {
    "id": "sbzf-9",
    "text": "孙子曰：夫陷齿戴角，前爪后距，喜而合，怒而斗，天之道也，不可止也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "势备第九"
  },
  {
    "id": "sbzf-10",
    "text": "孙子曰：若欲知兵之情，弩矢其法也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵情第十"
  },
  {
    "id": "sbzf-11",
    "text": "孙子曰：用兵移民之道，权衡也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "行篡第十一"
  },
  {
    "id": "sbzf-12",
    "text": "孙子曰：明爵禄而……杀士则士……知之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "杀士第十二"
  },
  {
    "id": "sbzf-13",
    "text": "孙子曰：合军聚众，务在激气，复徙合军，务在治兵利气。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "延气第十三"
  },
  {
    "id": "sbzf-14",
    "text": "孙子曰：​……皆非强兵之急者也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "强兵第十五"
  },
  {
    "id": "sbzf-15",
    "text": "凡阵有十：有方阵，有圆阵，有疏阵，有数阵，有锥行之阵，有雁行之阵，有钩行之阵，有玄襄之阵，有火阵，有水阵。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "十阵第十六"
  },
  {
    "id": "sbzf-16",
    "text": "……之气不藏于心，三军之众□循之知不……将分□军以修□□□□寡而民……威□□其难将之□也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "略甲第十八"
  },
  {
    "id": "sbzf-17",
    "text": "兵有客之分，有主人之分。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "客主人分第十九"
  },
  {
    "id": "sbzf-18",
    "text": "善者，敌人军□人众，能使分离而不相救也，受敌而不相知也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "善者第二十"
  },
  {
    "id": "sbzf-19",
    "text": "兵有五名：一曰威强，二曰轩骄，三曰刚至，四曰忌，五曰重柔。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五名五恭第二十一"
  },
  {
    "id": "sbzf-20",
    "text": "欲以敌国之民之所不安，正俗所……难敌国兵之所长，耗兵也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵失第二十二"
  },
  {
    "id": "sbzf-21",
    "text": "将者，不可无义，无义则严不立，严不立则卒弗死。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将义第二十三"
  },
  {
    "id": "sbzf-22",
    "text": "……赤子，爱之若狡童，敬之若严师，用之若土芥，将军……不失，将军之智也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将德第二十四"
  },
  {
    "id": "sbzf-23",
    "text": "将败：一曰不能而自能。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将败第二十五"
  },
  {
    "id": "sbzf-24",
    "text": "将失：一曰，失所以往来，可败也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将失第二十六"
  },
  {
    "id": "sbzf-25",
    "text": "城在渒泽之中，无亢山名谷，而有付丘于其四方者，雄城也，不可攻也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "雄牝城第二十七"
  },
  {
    "id": "sbzf-26",
    "text": "救者至，又重败之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五度九夺滴二十八"
  },
  {
    "id": "sbzf-27",
    "text": "……积胜疏，盈胜虚，径胜行，疾胜徐，众胜寡，佚胜劳。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "积疏第二十九"
  },
  {
    "id": "sbzf-28",
    "text": "天地之理，至则反，盈则败，□□是也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "奇正第三十"
  },
  {
    "id": "sbzf-29",
    "text": "齐君闻之，使将军忌子，带甲八万至……竞。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "擒庞涓第一"
  },
  {
    "id": "sbzf-30",
    "text": "此先王之傅道也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "见威王第二"
  },
  {
    "id": "sbzf-31",
    "text": "为之微阵以触其侧。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-32",
    "text": "此者人之所过而不急也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "陈忌问垒第四"
  },
  {
    "id": "sbzf-33",
    "text": "孙子曰：德行者，兵之厚积也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-34",
    "text": "天时、地利、人和，三者不得，虽胜有殃。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "月战第六"
  },
  {
    "id": "sbzf-35",
    "text": "勇不足，将兵，自广也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "八阵第七"
  },
  {
    "id": "sbzf-36",
    "text": "纪纲则得，阵乃不惑，直者毛产，术者半死。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "地葆第八"
  },
  {
    "id": "sbzf-37",
    "text": "故无天兵者自为备，圣人之事也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "势备第九"
  },
  {
    "id": "sbzf-38",
    "text": "发者，主也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵情第十"
  },
  {
    "id": "sbzf-39",
    "text": "权衡，所以篡贤取良也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "行篡第十一"
  },
  {
    "id": "sbzf-40",
    "text": "知士可信，毋令人离之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "杀士第十二"
  },
  {
    "id": "sbzf-41",
    "text": "临境近敌，务在厉气。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "延气第十三"
  },
  {
    "id": "sbzf-42",
    "text": "为畏以山胠，秦怫以逶迤，便罢以雁行，险厄以杂管，还退以蓬错，绕山林以曲次，袭国邑以水则，辨夜退以明简，夜警以传节。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "官一第十四"
  },
  {
    "id": "sbzf-43",
    "text": "威王……□□。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "强兵第十五"
  },
  {
    "id": "sbzf-44",
    "text": "此皆有所利。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "十阵第十六"
  },
  {
    "id": "sbzf-45",
    "text": "彼见我惧，则遂分而不顾。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "十问第十七"
  },
  {
    "id": "sbzf-46",
    "text": "客之分众，主人之分少。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "客主人分第十九"
  },
  {
    "id": "sbzf-47",
    "text": "故沟深垒高不得以为固，车坚兵利不得以为威，士有勇力而不得以为强。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "善者第二十"
  },
  {
    "id": "sbzf-48",
    "text": "夫威强之兵，则屈软而侍之；轩骄之兵，则恭敬而久之；刚至之兵，则诱而取之；忌之兵，则薄其前，噪其旁，深沟高垒而难其粮；重柔之兵，则噪而恐之，振而捅之，出则击之，不出则回之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五名五恭第二十一"
  },
  {
    "id": "sbzf-49",
    "text": "欲强多国之所寡，以应敌国之所多，速屈之兵也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵失第二十二"
  },
  {
    "id": "sbzf-50",
    "text": "故义者，兵之首也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将义第二十三"
  },
  {
    "id": "sbzf-51",
    "text": "不轻寡，不劫于敌，慎终若始，将军……而不御，君令不入军门，将军之恒也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将德第二十四"
  },
  {
    "id": "sbzf-52",
    "text": "三曰贪于位。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将败第二十五"
  },
  {
    "id": "sbzf-53",
    "text": "二曰，收乱民而还用之，止北卒而还斗之，无资而有资，可败也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将失第二十六"
  },
  {
    "id": "sbzf-54",
    "text": "军食流水，生水也，不可攻也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "雄牝城第二十七"
  },
  {
    "id": "sbzf-55",
    "text": "故兵之大数，五十里不相救也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五度九夺滴二十八"
  },
  {
    "id": "sbzf-56",
    "text": "积故积之，疏故疏之，盈故盈之，虚故虚之，径故径之，行故行之，疾故疾之，​徐故徐之，众敌众之，寡故寡之，佚故佚之，劳故劳之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "积疏第二十九"
  },
  {
    "id": "sbzf-57",
    "text": "代兴代废，四时是也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "奇正第三十"
  },
  {
    "id": "sbzf-58",
    "text": "庞子攻卫□□□。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "擒庞涓第一"
  },
  {
    "id": "sbzf-59",
    "text": "战胜，则所以在亡国而继绝世也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "见威王第二"
  },
  {
    "id": "sbzf-60",
    "text": "威王曰：用众用寡有道乎？",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-61",
    "text": "此□之所以疾……志也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "陈忌问垒第四"
  },
  {
    "id": "sbzf-62",
    "text": "信者，兵明赏也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-63",
    "text": "是以必付与而战，不得已而后战。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "月战第六"
  },
  {
    "id": "sbzf-64",
    "text": "不知道，数战不足，将兵，幸也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "八阵第七"
  },
  {
    "id": "sbzf-65",
    "text": "凡战地也，日其精也，八风将来，必勿忘也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "地葆第八"
  },
  {
    "id": "sbzf-66",
    "text": "黄帝作剑，以阵象之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "势备第九"
  },
  {
    "id": "sbzf-67",
    "text": "矢，金在前，羽在后，故犀而善走。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵情第十"
  },
  {
    "id": "sbzf-68",
    "text": "阴阳，所以聚众合敌也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "行篡第十一"
  },
  {
    "id": "sbzf-69",
    "text": "必胜乃战，毋令人知之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "杀士第十二"
  },
  {
    "id": "sbzf-70",
    "text": "战日有期，务在断气。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "延气第十三"
  },
  {
    "id": "sbzf-71",
    "text": "厝入内寇以棺士，遇短兵以必舆，火输积以车。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "官一第十四"
  },
  {
    "id": "sbzf-72",
    "text": "孙子曰：​富国。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "强兵第十五"
  },
  {
    "id": "sbzf-73",
    "text": "方阵者，所以剸也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "十阵第十六"
  },
  {
    "id": "sbzf-74",
    "text": "因以乱毁其固。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "十问第十七"
  },
  {
    "id": "sbzf-75",
    "text": "客负倍主人半，然可敌也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "客主人分第十九"
  },
  {
    "id": "sbzf-76",
    "text": "故善者制险量阻，敦三军，利屈伸，敌人众能使寡，积粮盈军能使饥，安处不动能使劳，得天下能使离，三军和能使柴。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "善者第二十"
  },
  {
    "id": "sbzf-77",
    "text": "兵有五恭、五暴。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五名五恭第二十一"
  },
  {
    "id": "sbzf-78",
    "text": "恶战者，兵之王器也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-79",
    "text": "夫众且强，犹问用之，则安国之道也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-80",
    "text": "取众者，胜囗囗囗也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-81",
    "text": "命之曰赞师。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-82",
    "text": "用此者，所以应猝窘处隘塞死地之中也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "陈忌问垒第四"
  },
  {
    "id": "sbzf-83",
    "text": "知道，胜，得众，胜。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-84",
    "text": "故抚时而战，不复使其众。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "月战第六"
  },
  {
    "id": "sbzf-85",
    "text": "夫安万乘国，广万乘王，全万乘之民命者，唯知道。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "八阵第七"
  },
  {
    "id": "sbzf-86",
    "text": "绝水、迎陵、逆流、居杀地、迎众树者，钧举也，五者皆不胜。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "地葆第八"
  },
  {
    "id": "sbzf-87",
    "text": "羿作弓弩，以势象之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "势备第九"
  },
  {
    "id": "sbzf-88",
    "text": "前……今治卒则后重而前轻，阵之则辨，趣之敌则不听，人治卒不法矢也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵情第十"
  },
  {
    "id": "sbzf-89",
    "text": "正衡再累既忠，是谓不穷。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "行篡第十一"
  },
  {
    "id": "sbzf-90",
    "text": "当战毋忘旁毋……必审而行之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "杀士第十二"
  },
  {
    "id": "sbzf-91",
    "text": "今日将战，务在延气。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "延气第十三"
  },
  {
    "id": "sbzf-92",
    "text": "备固，不能难敌之器用，陵兵也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵失第二十二"
  },
  {
    "id": "sbzf-93",
    "text": "将者，不可不仁，不仁则军不克，军不克则军无功。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将义第二十三"
  },
  {
    "id": "sbzf-94",
    "text": "入军……将不两生，军不两存，将军之……将军之惠也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将德第二十四"
  },
  {
    "id": "sbzf-95",
    "text": "四曰贪于财。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将败第二十五"
  },
  {
    "id": "sbzf-96",
    "text": "三曰，是非争，谋事辩讼，可败也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "将失第二十六"
  },
  {
    "id": "sbzf-97",
    "text": "城前名谷，背亢山，雄城也，不可攻也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "雄牝城第二十七"
  },
  {
    "id": "sbzf-98",
    "text": "况近□□□□□数百里，此程兵之极也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "五度九夺滴二十八"
  },
  {
    "id": "sbzf-99",
    "text": "积疏相为变，盈虚相为变，径行相为变，疾徐相为变，众寡相为变，佚劳相为变。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "积疏第二十九"
  },
  {
    "id": "sbzf-100",
    "text": "有胜有不胜，五行是也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "奇正第三十"
  },
  {
    "id": "sbzf-101",
    "text": "将军忌子……卫□□，救与……救卫是失令。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "擒庞涓第一"
  },
  {
    "id": "sbzf-102",
    "text": "战不胜，则所以削地而危社稷也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "见威王第二"
  },
  {
    "id": "sbzf-103",
    "text": "毁卒乱行，以顺其志，则必战矣。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "威王问第三"
  },
  {
    "id": "sbzf-104",
    "text": "是吾所以取庞□而擒太子申也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "陈忌问垒第四"
  },
  {
    "id": "sbzf-105",
    "text": "左右和，胜。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "篡卒第五"
  },
  {
    "id": "sbzf-106",
    "text": "无方而战者小胜以付磨者也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "月战第六"
  },
  {
    "id": "sbzf-107",
    "text": "知道者，上知天之道，下知地之理，内得其民之心，外知敌之情，阵则知八阵之经，见胜而战，弗见而诤，此王者之将也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "八阵第七"
  },
  {
    "id": "sbzf-108",
    "text": "南阵之山，生山也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "地葆第八"
  },
  {
    "id": "sbzf-109",
    "text": "禹作舟车，以变象之。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "势备第九"
  },
  {
    "id": "sbzf-110",
    "text": "弩者，将也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "兵情第十"
  },
  {
    "id": "sbzf-111",
    "text": "称乡县衡，虽其宜也。",
    "source": "《孙膑兵法》",
    "book": "孙膑兵法",
    "chapter": "行篡第十一"
  }
]