[
  {
    "id": "zy-1",
    "text": "天命之谓性；率性之谓道；修道之谓教。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第一章"
  },
  {
    "id": "zy-2",
    "text": "仲尼曰：君子中庸；小人反中庸。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二章"
  },
  {
    "id": "zy-3",
    "text": "子曰：中庸其至矣乎！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三章"
  },
  {
    "id": "zy-4",
    "text": "子曰：道之不行也，我知之矣：知者过之；愚者不及也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第四章"
  },
  {
    "id": "zy-5",
    "text": "子曰：道其不行矣夫。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第五章"
  },
  {
    "id": "zy-6",
    "text": "子曰：舜其大知也与！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第六章"
  },
  {
    "id": "zy-7",
    "text": "子曰：人皆曰‘予知’，驱而纳诸罟擭陷阱之中，而莫之知辟也；人皆曰‘予知’，择乎中庸，而不能期月守也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第七章"
  },
  {
    "id": "zy-8",
    "text": "子曰：回之为人也：择乎中庸，得一善，则拳拳服膺而弗失之矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第八章"
  },
  {
    "id": "zy-9",
    "text": "子曰：天下国家可均也，爵禄可辞也，白刃可蹈也，中庸不可能也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第九章"
  },
  {
    "id": "zy-10",
    "text": "子曰：南方之强与，北方之强与，抑而强与？",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-11",
    "text": "子曰：素隐行怪，后世有述焉：吾弗为之矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十一章"
  },
  {
    "id": "zy-12",
    "text": "君子之道，费而隐。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十二章"
  },
  {
    "id": "zy-13",
    "text": "子曰：道不远人。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-14",
    "text": "君子素其位而行，不愿乎其外。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十四章"
  },
  {
    "id": "zy-15",
    "text": "君子之道，辟如行远必自迩，辟如登高必自卑。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十五章"
  },
  {
    "id": "zy-16",
    "text": "子曰：鬼神之为德，其盛矣乎。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-17",
    "text": "子曰：舜其大孝也与！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-18",
    "text": "子曰：无忧者，其惟文王乎。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-19",
    "text": "子曰：武王、周公，其达孝矣乎。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-20",
    "text": "子曰：文武之政，布在方策。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-21",
    "text": "自诚明，谓之性；自明诚，谓之教。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十一章"
  },
  {
    "id": "zy-22",
    "text": "唯天下至诚，为能尽其性；能尽其性，则能尽人之性；能尽人之性，则能尽物之性；能尽物之性，则可以赞天地之化育；可以赞天地之化育，则可以与天地参矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十二章"
  },
  {
    "id": "zy-23",
    "text": "唯天下至诚为能化。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十三章"
  },
  {
    "id": "zy-24",
    "text": "至诚之道可以前知。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十四章"
  },
  {
    "id": "zy-25",
    "text": "诚者自成也，而道自道也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十五章"
  },
  {
    "id": "zy-26",
    "text": "故至诚无息。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十六章"
  },
  {
    "id": "zy-27",
    "text": "大哉圣人之道！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十七章"
  },
  {
    "id": "zy-28",
    "text": "子曰：愚而好自用，贱而好自专。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十八章"
  },
  {
    "id": "zy-29",
    "text": "王天下有三重焉，其寡过矣乎！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十九章"
  },
  {
    "id": "zy-30",
    "text": "仲尼祖述尧舜，宪章文武。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十章"
  },
  {
    "id": "zy-31",
    "text": "唯天下至圣，为能聪明睿知足以有临也；宽裕温柔足以有容也；发强刚毅、足以有执也；齐庄中正足以有敬也；文理密察足以有别也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十一章"
  },
  {
    "id": "zy-32",
    "text": "唯天下至诚，为能经纶天下之大经，立天下之大本，知天地之化育。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十二章"
  },
  {
    "id": "zy-33",
    "text": "诗曰：衣锦尚䌹，恶其文之著也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十三章"
  },
  {
    "id": "zy-34",
    "text": "道也者，不可须臾离也；可离，非道也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第一章"
  },
  {
    "id": "zy-35",
    "text": "君子之中庸也，君子而时中。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二章"
  },
  {
    "id": "zy-36",
    "text": "民鲜能久矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三章"
  },
  {
    "id": "zy-37",
    "text": "道之不明也，我知之矣：贤者过之；不肖者不及也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第四章"
  },
  {
    "id": "zy-38",
    "text": "舜好问而好察迩言，隐恶而扬善，执其两端，用其中于民，其斯以为舜乎！",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第六章"
  },
  {
    "id": "zy-39",
    "text": "宽柔以教，不报无道，南方之强也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-40",
    "text": "君子遵道而行，半途而废：吾弗能已矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十一章"
  },
  {
    "id": "zy-41",
    "text": "夫妇之愚，可以与知焉，及其至也，虽圣人亦有所不知焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十二章"
  },
  {
    "id": "zy-42",
    "text": "人之为道而远人，不可以为道。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-43",
    "text": "素富贵，行乎富贵；素贫贱，行乎贫贱；素夷狄，行乎夷狄；素患难，行乎患难。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十四章"
  },
  {
    "id": "zy-44",
    "text": "诗曰：妻子好合，如鼓瑟琴。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十五章"
  },
  {
    "id": "zy-45",
    "text": "视之而弗见；听之而弗闻；体物而不可遗。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-46",
    "text": "德为圣人，尊为天子，富有四海之内。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-47",
    "text": "以王季为父，以武王为子。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-48",
    "text": "夫孝者，善继人之志，善述人之事者也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-49",
    "text": "其人存，则其政举；其人亡，则其政息。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-50",
    "text": "诚则明矣；明则诚矣。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十一章"
  },
  {
    "id": "zy-51",
    "text": "国家将兴，必有祯祥；国家将亡，必有妖孽。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十四章"
  },
  {
    "id": "zy-52",
    "text": "诚者，物之终始，不诚无物。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十五章"
  },
  {
    "id": "zy-53",
    "text": "不息则久，久则征。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十六章"
  },
  {
    "id": "zy-54",
    "text": "洋洋乎，发育万物，峻极于天。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十七章"
  },
  {
    "id": "zy-55",
    "text": "生乎今之世，反古之道。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十八章"
  },
  {
    "id": "zy-56",
    "text": "上焉者虽善，无征。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十九章"
  },
  {
    "id": "zy-57",
    "text": "上律天时，下袭水土。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十章"
  },
  {
    "id": "zy-58",
    "text": "溥博，渊泉，而时出之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十一章"
  },
  {
    "id": "zy-59",
    "text": "夫焉有所倚？",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十二章"
  },
  {
    "id": "zy-60",
    "text": "故君子之道，暗然而日章；小人之道，明然而日亡。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十三章"
  },
  {
    "id": "zy-61",
    "text": "是故君子戒慎乎其所不睹，恐惧乎其所不闻。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第一章"
  },
  {
    "id": "zy-62",
    "text": "人莫不饮食也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第四章"
  },
  {
    "id": "zy-63",
    "text": "衽金革，死而不厌，北方之强也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-64",
    "text": "君子依乎中庸，遁世不见知而不悔。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十一章"
  },
  {
    "id": "zy-65",
    "text": "夫妇之不肖，可以能行焉，及其至也，虽圣人亦有所不能焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十二章"
  },
  {
    "id": "zy-66",
    "text": "诗云：‘伐柯伐柯，其则不远。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-67",
    "text": "君子无入而不自得焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十四章"
  },
  {
    "id": "zy-68",
    "text": "兄弟既翕，和乐且耽。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十五章"
  },
  {
    "id": "zy-69",
    "text": "使天下之人，齐明盛服，以承祭祀。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-70",
    "text": "宗庙飨之，子孙保之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-71",
    "text": "父作之，子述之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-72",
    "text": "春秋，修其祖庙，陈其宗器，设其裳衣，荐其时食。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-73",
    "text": "人道敏政，地道敏树。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-74",
    "text": "见乎蓍龟，动乎四体。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十四章"
  },
  {
    "id": "zy-75",
    "text": "是故君子诚之为贵。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十五章"
  },
  {
    "id": "zy-76",
    "text": "悠远，则博厚。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十六章"
  },
  {
    "id": "zy-77",
    "text": "优优大哉，礼仪三百威仪三千。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十七章"
  },
  {
    "id": "zy-78",
    "text": "非天子不议礼，不制度，不考文。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十八章"
  },
  {
    "id": "zy-79",
    "text": "无征，不信。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十九章"
  },
  {
    "id": "zy-80",
    "text": "辟如天地之无不持载，无不覆帱。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十章"
  },
  {
    "id": "zy-81",
    "text": "溥博如天，渊泉如渊。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十一章"
  },
  {
    "id": "zy-82",
    "text": "苟不固聪明圣知，达天德者，其孰能知之？",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十二章"
  },
  {
    "id": "zy-83",
    "text": "君子之道，淡而不厌、简而文、温而理。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十三章"
  },
  {
    "id": "zy-84",
    "text": "莫见乎隐，莫显乎微。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第一章"
  },
  {
    "id": "zy-85",
    "text": "鲜能知味也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第四章"
  },
  {
    "id": "zy-86",
    "text": "故君子和而不流，强哉矫。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-87",
    "text": "唯圣者能之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十一章"
  },
  {
    "id": "zy-88",
    "text": "天地之大也，人犹有所憾。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十二章"
  },
  {
    "id": "zy-89",
    "text": "’执柯以伐柯，睨而视之，犹以为远。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-90",
    "text": "洋洋乎，如在其上，如在其左右。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-91",
    "text": "故大德，必得其位，必得其禄，必得其名，必得其寿。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-92",
    "text": "武王缵太王、王季、文王之绪。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-93",
    "text": "宗庙之礼，所以序昭穆也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-94",
    "text": "夫政也者，蒲卢也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-95",
    "text": "今天下，车同轨，书同文，行同伦。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十八章"
  },
  {
    "id": "zy-96",
    "text": "中立而不倚，强哉矫。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-97",
    "text": "故君子以人治人，改而止。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-98",
    "text": "在上位，不陵下；在下位，不援上；正己而不求于人则无怨。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十四章"
  },
  {
    "id": "zy-99",
    "text": "宜尔室家，乐尔妻帑。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十五章"
  },
  {
    "id": "zy-100",
    "text": "诗曰：‘神之格思，不可度思，矧可射思？",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-101",
    "text": "故天之生物必因其材而笃焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-102",
    "text": "壹戎衣，而有天下。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-103",
    "text": "序爵，所以辨贵贱也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-104",
    "text": "故为政在人。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-105",
    "text": "祸福将至，善必先知之；不善，必先知之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十四章"
  },
  {
    "id": "zy-106",
    "text": "诚者，非自成己而已也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十五章"
  },
  {
    "id": "zy-107",
    "text": "博厚，则高明。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十六章"
  },
  {
    "id": "zy-108",
    "text": "待其人而后行。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十七章"
  },
  {
    "id": "zy-109",
    "text": "虽有其位，苟无其德，不敢作礼乐焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十八章"
  },
  {
    "id": "zy-110",
    "text": "不信，民弗从。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十九章"
  },
  {
    "id": "zy-111",
    "text": "辟如四时之错行，如日月之代明。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十章"
  },
  {
    "id": "zy-112",
    "text": "见而民莫不敬，言而民莫不信，行而民莫不说。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十一章"
  },
  {
    "id": "zy-113",
    "text": "知远之近，知风之自，知微之显。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第三十三章"
  },
  {
    "id": "zy-114",
    "text": "故君子慎其独也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第一章"
  },
  {
    "id": "zy-115",
    "text": "国有道，不变塞焉，强哉矫。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十章"
  },
  {
    "id": "zy-116",
    "text": "故君子语大，天下莫能载焉，语小，天下莫能破焉。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十二章"
  },
  {
    "id": "zy-117",
    "text": "忠恕违道不远。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十三章"
  },
  {
    "id": "zy-118",
    "text": "上不怨天，下不尤人。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十四章"
  },
  {
    "id": "zy-119",
    "text": "诚之不可揜，如此夫。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十六章"
  },
  {
    "id": "zy-120",
    "text": "故栽者培之，倾者覆之。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十七章"
  },
  {
    "id": "zy-121",
    "text": "身不失天下之显名。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十八章"
  },
  {
    "id": "zy-122",
    "text": "序事，所以辨贤也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第十九章"
  },
  {
    "id": "zy-123",
    "text": "仁者，人也，亲亲为大。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十章"
  },
  {
    "id": "zy-124",
    "text": "故至诚如神。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十四章"
  },
  {
    "id": "zy-125",
    "text": "所以成物也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十五章"
  },
  {
    "id": "zy-126",
    "text": "博厚，所以载物也。",
    "source": "《中庸》",
    "book": "中庸",
    "chapter": "第二十六章"
  }
]