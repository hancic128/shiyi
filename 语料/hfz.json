[
  {
    "id": "hfz-1",
    "text": "臣闻：不知而言，不智；知而不言，不忠。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "初见秦第一"
  },
  {
    "id": "hfz-2",
    "text": "韩事秦三十余年，出则为扞蔽，入则为席荐。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "存韩第二"
  },
  {
    "id": "hfz-3",
    "text": "臣非非难言也，所以难言者：言顺比滑泽，洋洋𫄥𫄥然，则见以为华而不实。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难言第三"
  },
  {
    "id": "hfz-4",
    "text": "是以奸臣蕃息，主道衰亡。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "爱臣第四"
  },
  {
    "id": "hfz-5",
    "text": "道者，万物之始，是非之纪也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "主道第五"
  },
  {
    "id": "hfz-6",
    "text": "国无常强，无常弱。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "有度第六"
  },
  {
    "id": "hfz-7",
    "text": "明主之所导制其臣者，二柄而已矣。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "二柄第七"
  },
  {
    "id": "hfz-8",
    "text": "天有大命，人有大命。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "扬权第八"
  },
  {
    "id": "hfz-9",
    "text": "凡人臣之所道成奸者有八术：一曰同床，二曰在旁，三曰父兄，四曰养殃，五曰民萌，六曰流行，七曰威强，八曰四方。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八奸第九"
  },
  {
    "id": "hfz-10",
    "text": "十过：一曰行小忠，则大忠之贼也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "十过第十"
  },
  {
    "id": "hfz-11",
    "text": "智术之士，必远见而明察，不明察，不能烛私；能法之士，必强毅而劲直，不劲直，不能矫奸。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "孤愤第十一"
  },
  {
    "id": "hfz-12",
    "text": "凡说之难：非吾知之有以说之之难也，又非吾辩之能明吾意之难也，又非吾敢横失而能尽之难也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说难第十二"
  },
  {
    "id": "hfz-13",
    "text": "楚人和氏得玉璞楚山中，奉而献之厉王。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "和氏第十三"
  },
  {
    "id": "hfz-14",
    "text": "凡奸臣皆欲顺人主之心以取亲幸之势者也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "奸劫弑臣第十四"
  },
  {
    "id": "hfz-15",
    "text": "凡人主之国小而家大，权轻而臣重者，可亡也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "亡征第十五"
  },
  {
    "id": "hfz-16",
    "text": "人主有三守。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "三守第十六"
  },
  {
    "id": "hfz-17",
    "text": "人主之患在于信人，信人，则制于人。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "备内第十七"
  },
  {
    "id": "hfz-18",
    "text": "人主之过，在已任臣矣，又必反与其所不任者备之，此其说必与其所任者为仇，而主反制于其所不任者。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "南面第十八"
  },
  {
    "id": "hfz-19",
    "text": "凿龟数策，兆曰大吉，而以攻燕者，赵也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "饰邪第十九"
  },
  {
    "id": "hfz-20",
    "text": "德者，内也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "解老第二十"
  },
  {
    "id": "hfz-21",
    "text": "天下有道，无急患，则曰静，遽传不用。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "喻老第二十一"
  },
  {
    "id": "hfz-22",
    "text": "汤以伐桀，而恐天下言己为贪也，因乃让天下于务光。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说林上第二十二"
  },
  {
    "id": "hfz-23",
    "text": "伯乐教二人相踶马，相与之简子厩观马。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说林下第二十三"
  },
  {
    "id": "hfz-24",
    "text": "古之人目短于自见，故以镜观面；智短于自知，故以道正己。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "观行第二十四"
  },
  {
    "id": "hfz-25",
    "text": "安术有七，危道有六。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "安危第二十五"
  },
  {
    "id": "hfz-26",
    "text": "圣王之立法也，其赏足以劝善，其威足以胜暴，其备足以必完法。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "守道第二十六"
  },
  {
    "id": "hfz-27",
    "text": "闻古之善用人者，必循天顺人而明赏罚。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "用人第二十七"
  },
  {
    "id": "hfz-28",
    "text": "明君之所以立功成名者四：一曰天时，二曰人心，三曰技能，四曰势位。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "功名第二十八"
  },
  {
    "id": "hfz-29",
    "text": "故至安之世，法如朝露，纯朴不散，心无结怨，口无烦言。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "大体第二十九"
  },
  {
    "id": "hfz-30",
    "text": "主之所用也七术，所察也六微。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "内储说上七术第三十"
  },
  {
    "id": "hfz-31",
    "text": "六微：一曰权借在下，二曰利异外借，三曰托于似类，四曰利害有反，五曰参疑内争，六曰敌国废置。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "内储说下六微第三十一"
  },
  {
    "id": "hfz-32",
    "text": "明主之道，如有若之应密子也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说左上第三十二"
  },
  {
    "id": "hfz-33",
    "text": "以罪受诛，人不怨上，跀危坐子皋。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说左下第三十三"
  },
  {
    "id": "hfz-34",
    "text": "势不足以化则除之。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说右上第三十四"
  },
  {
    "id": "hfz-35",
    "text": "赏罚共则禁令不行。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说右下第三十五"
  },
  {
    "id": "hfz-36",
    "text": "晋文公将与楚人战，召舅犯问之，曰：吾将与楚人战，彼众我寡，为之奈何？",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难一第三十六"
  },
  {
    "id": "hfz-37",
    "text": "景公过晏子，曰：子宫小，近市，请徙子家豫章之圃。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难二第三十七"
  },
  {
    "id": "hfz-38",
    "text": "子思对曰：君子尊贤以崇德，举善以观民。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难三第三十八"
  },
  {
    "id": "hfz-39",
    "text": "卫孙文子聘于鲁，公登亦登。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难四第三十九"
  },
  {
    "id": "hfz-40",
    "text": "慎子曰：飞龙乘云，腾蛇游雾，云罢雾霁，而龙蛇与蚓蚁同矣，则失其所乘也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难势第四十"
  },
  {
    "id": "hfz-41",
    "text": "对曰：生于上之不明也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "问辩第四十一"
  },
  {
    "id": "hfz-42",
    "text": "令阳城义渠，明将也，而措于毛伯；公孙亶回，圣相也，而关于州部，何哉？",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "问田第四十二"
  },
  {
    "id": "hfz-43",
    "text": "应之曰：是不可程也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "定法第四十三"
  },
  {
    "id": "hfz-44",
    "text": "凡治之大者，非谓其赏罚之当也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说疑第四十四"
  },
  {
    "id": "hfz-45",
    "text": "圣人之所以为治道者三：一曰利，二曰威，三曰名。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "诡使第四十五"
  },
  {
    "id": "hfz-46",
    "text": "畏死远难，降北之民也，而世尊之曰贵生之士。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "六反第四十六"
  },
  {
    "id": "hfz-47",
    "text": "为故人行私谓之不弃，以公财分施谓之仁人，轻禄重身谓之君子，枉法曲亲谓之有行，弃官宠交谓之有侠，离世遁上谓之高傲，交争逆令谓之刚材，行惠取众谓之得民。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八说第四十七"
  },
  {
    "id": "hfz-48",
    "text": "凡治天下，必因人情。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八经第四十八"
  },
  {
    "id": "hfz-49",
    "text": "上古之世，人民少而禽兽众，人民不胜禽兽虫蛇。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "五蠹第四十九"
  },
  {
    "id": "hfz-50",
    "text": "世之显学，儒、墨也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "显学第五十"
  },
  {
    "id": "hfz-51",
    "text": "天下皆以孝悌忠顺之道为是也，而莫知察孝悌忠顺之道而审行之，是以天下乱。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "忠孝第五十一"
  },
  {
    "id": "hfz-52",
    "text": "人主之所以身危国亡者，大臣太贵，左右太威也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "人主第五十二"
  },
  {
    "id": "hfz-53",
    "text": "饬令，则法不迁；法平，则吏无奸。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "饬令第五十三"
  },
  {
    "id": "hfz-54",
    "text": "圣人之治民，度于本，不从其欲，期于利民而已。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "心度第五十四"
  },
  {
    "id": "hfz-55",
    "text": "夫凡国博君尊者，未尝非法重而可以至乎令行禁止于天下者也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "制分第五十五"
  },
  {
    "id": "hfz-56",
    "text": "为人臣不忠，当死；言而不当，亦当死。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "初见秦第一"
  },
  {
    "id": "hfz-57",
    "text": "秦特出锐师取地而韩随之，怨悬于天下，功归于强秦。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "存韩第二"
  },
  {
    "id": "hfz-58",
    "text": "敦祗恭厚，鲠固慎完，则见以为掘而不伦。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难言第三"
  },
  {
    "id": "hfz-59",
    "text": "是故诸侯之博大，天子之害也；群臣之太富，君主之败也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "爱臣第四"
  },
  {
    "id": "hfz-60",
    "text": "是以明君守始以知万物之源，治纪以知善败之端。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "主道第五"
  },
  {
    "id": "hfz-61",
    "text": "奉法者强，则国强；奉法者弱，则国弱。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "有度第六"
  },
  {
    "id": "hfz-62",
    "text": "二柄者，刑德也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "二柄第七"
  },
  {
    "id": "hfz-63",
    "text": "夫香美脆味，厚酒肥肉，甘口而疾形；曼理皓齿，说情而损精。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "扬权第八"
  },
  {
    "id": "hfz-64",
    "text": "二曰顾小利，则大利之残也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "十过第十"
  },
  {
    "id": "hfz-65",
    "text": "人臣循令而从事，案法而治官，非谓重人也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "孤愤第十一"
  },
  {
    "id": "hfz-66",
    "text": "凡说之难：在知所说之心，可以吾说当之。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说难第十二"
  },
  {
    "id": "hfz-67",
    "text": "厉王使玉人相之。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "和氏第十三"
  },
  {
    "id": "hfz-68",
    "text": "是以主有所善，臣从而誉之；主有所憎，臣因而毁之。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "奸劫弑臣第十四"
  },
  {
    "id": "hfz-69",
    "text": "简法禁而务谋虑，荒封内而恃交援者，可亡也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "亡征第十五"
  },
  {
    "id": "hfz-70",
    "text": "三守完，则国安身荣；三守不完，则国危身殆。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "三守第十六"
  },
  {
    "id": "hfz-71",
    "text": "人臣之于其君，非有骨肉之亲也，缚于势而不得不事也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "备内第十七"
  },
  {
    "id": "hfz-72",
    "text": "今所与备人者，且曩之所备也.人主不能明法而以制大臣之威，无道得小人之信矣。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "南面第十八"
  },
  {
    "id": "hfz-73",
    "text": "凿龟数䇲，兆曰大吉，而以攻赵者，燕也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "饰邪第十九"
  },
  {
    "id": "hfz-74",
    "text": "得者，外也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "解老第二十"
  },
  {
    "id": "hfz-75",
    "text": "故曰：却走马以粪。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "喻老第二十一"
  },
  {
    "id": "hfz-76",
    "text": "务光因自投于河。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说林上第二十二"
  },
  {
    "id": "hfz-77",
    "text": "一人举踶马。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说林下第二十三"
  },
  {
    "id": "hfz-78",
    "text": "故镜无见疵之罪，道无明过之恶。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "观行第二十四"
  },
  {
    "id": "hfz-79",
    "text": "安术：一曰，赏罚随是非；二曰，祸福随善恶；三曰，死生随法度；四曰，有贤不肖而无爱恶；五曰，有愚智而无非誉；六曰，有尺寸而无意度；七曰，有信而无诈。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "安危第二十五"
  },
  {
    "id": "hfz-80",
    "text": "治世之臣，功多者位尊，力极者赏厚，情尽者名立。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "守道第二十六"
  },
  {
    "id": "hfz-81",
    "text": "循天，则用力寡而功立；顺人，则刑罚省而令行；明赏罚，则伯夷、盗跖不乱。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "用人第二十七"
  },
  {
    "id": "hfz-82",
    "text": "非天时，虽十尧不能冬生一穗；逆人心，虽贲、育不能尽人力。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "功名第二十八"
  },
  {
    "id": "hfz-83",
    "text": "故车马不疲弊于远路，旌旗不乱乎大泽，万民不失命于寇戎，雄骏不创寿于旗幢；豪杰不著名于图书，不录功于盘盂，记年之牒空虚。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "大体第二十九"
  },
  {
    "id": "hfz-84",
    "text": "七术：一曰众端参观，二曰必罚明威，三曰信赏尽能，四曰一听责下，五曰疑诏诡使，六曰挟知而问，七曰倒言反事。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "内储说上七术第三十"
  },
  {
    "id": "hfz-85",
    "text": "此六者，主之所察也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "内储说下六微第三十一"
  },
  {
    "id": "hfz-86",
    "text": "明主之听言也，美其辩；其观行也，贤其远。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说左上第三十二"
  },
  {
    "id": "hfz-87",
    "text": "以功受赏，臣不德君，翟璜操右契而乘轩。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说左下第三十三"
  },
  {
    "id": "hfz-88",
    "text": "师旷之对，晏子之说，皆合势之易也，而道行之难，是与兽逐走也，未知除患。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说右上第三十四"
  },
  {
    "id": "hfz-89",
    "text": "明之以造父、于期。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "外储说右下第三十五"
  },
  {
    "id": "hfz-90",
    "text": "舅犯曰：臣闻之，繁礼君子，不厌忠信；战阵之间，不厌诈伪。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难一第三十六"
  },
  {
    "id": "hfz-91",
    "text": "晏子再拜而辞曰：且婴家贫，待市食，而朝暮趋之，不可以远。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难二第三十七"
  },
  {
    "id": "hfz-92",
    "text": "子服厉伯入见，问庞氏子，子服厉伯对曰：其过三。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难三第三十八"
  },
  {
    "id": "hfz-93",
    "text": "叔孙穆子趋进曰：诸侯之会，寡君未尝后卫君也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难四第三十九"
  },
  {
    "id": "hfz-94",
    "text": "贤人而诎于不肖者，则权轻位卑也；不肖而能服于贤者，则权重位尊也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难势第四十"
  },
  {
    "id": "hfz-95",
    "text": "对曰：明主之国，令者，言最贵者也；法者，事最适者也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "问辩第四十一"
  },
  {
    "id": "hfz-96",
    "text": "田鸠曰：此无他故异物，主有度、上有术之故也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "问田第四十二"
  },
  {
    "id": "hfz-97",
    "text": "人不食，十日则死；大寒之隆，不衣亦死。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "定法第四十三"
  },
  {
    "id": "hfz-98",
    "text": "赏无功之人，罚不辜之民，非谓明也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "说疑第四十四"
  },
  {
    "id": "hfz-99",
    "text": "夫利者，所以得民也；威者，所以行令也；名者，上下之所同道也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "诡使第四十五"
  },
  {
    "id": "hfz-100",
    "text": "学道立方，离法之民也，而世尊之曰文学之士游居厚养，牟食之民也，而世尊之曰有能之士。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "六反第四十六"
  },
  {
    "id": "hfz-101",
    "text": "不弃者，吏有奸也；仁人者，公财损也；君子者，民难使也；有行者，法制毁也；有侠者，官职旷也；高傲者，民不事也；刚材者，令不行也；得民者，君上孤也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八说第四十七"
  },
  {
    "id": "hfz-102",
    "text": "人情者，有好恶，故赏罚可用；赏罚可用，则禁令可立而治道具矣。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八经第四十八"
  },
  {
    "id": "hfz-103",
    "text": "有圣人作，构木为巢以避群害，而民悦之，使王天下，号曰有巢氏。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "五蠹第四十九"
  },
  {
    "id": "hfz-104",
    "text": "儒之所至，孔丘也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "显学第五十"
  },
  {
    "id": "hfz-105",
    "text": "皆以尧舜之道为是而法之，是以有弑君，有曲于父。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "忠孝第五十一"
  },
  {
    "id": "hfz-106",
    "text": "所谓贵者，无法而擅行，操国柄而便私者也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "人主第五十二"
  },
  {
    "id": "hfz-107",
    "text": "法已定矣，不以善言售法。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "饬令第五十三"
  },
  {
    "id": "hfz-108",
    "text": "故其与之刑，非所以恶民，爱之本也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "心度第五十四"
  },
  {
    "id": "hfz-109",
    "text": "是以君人者分爵制禄，则法必严以重之。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "制分第五十五"
  },
  {
    "id": "hfz-110",
    "text": "虽然，臣愿悉言所闻，唯大王裁其罪。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "初见秦第一"
  },
  {
    "id": "hfz-111",
    "text": "今日臣窃闻贵臣之计，举兵将伐韩。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "存韩第二"
  },
  {
    "id": "hfz-112",
    "text": "多言繁称，连类比物，则见以为虚而无用。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "难言第三"
  },
  {
    "id": "hfz-113",
    "text": "将相之管主而隆家，此君人者所外也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "爱臣第四"
  },
  {
    "id": "hfz-114",
    "text": "故虚静以待，令名自命也，令事自定也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "主道第五"
  },
  {
    "id": "hfz-115",
    "text": "荆庄王并国二十六，开地三千里；庄王之氓社稷也，而荆以亡。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "有度第六"
  },
  {
    "id": "hfz-116",
    "text": "故去甚去泰，身乃无害。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "扬权第八"
  },
  {
    "id": "hfz-117",
    "text": "托于燕处之虞，乘醉饱之时，而求其所欲，此必听之术也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "八奸第九"
  },
  {
    "id": "hfz-118",
    "text": "三曰行僻自用，无礼诸侯，则亡身之至也。",
    "source": "《韩非子》",
    "book": "韩非子",
    "chapter": "十过第十"
  }
]