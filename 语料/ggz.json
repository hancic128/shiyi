[
  {
    "id": "ggz-1",
    "text": "粤若稽古，圣人之在天地间也，为众生之先。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-2",
    "text": "古之大化者，乃与无形俱生。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-3",
    "text": "君臣上下之事，有远而亲，近而疏；就之不用，去之反求；日进前而不御，遥闻声而相思。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-4",
    "text": "物有自然，事有合离。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-5",
    "text": "凡度权量能，所以征远来近。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-6",
    "text": "凡趋合倍反，计有适合。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-7",
    "text": "古之善用天下者，必量天下之权，而揣诸侯之情。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "揣篇第七"
  },
  {
    "id": "ggz-8",
    "text": "摩者，揣之术也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-9",
    "text": "说者，说之也；说之者，资之也，饰言者，假之也；假之者，益损也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-10",
    "text": "凡谋有道，必得其所因，以求其情。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-11",
    "text": "凡决物，必托于疑者。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-12",
    "text": "安徐正静，其被节无不肉。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-13",
    "text": "盛神中有五气，神为之长，心为之舍，德为之大，养神之所归诸道。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-14",
    "text": "养志者，心气之思不达也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-15",
    "text": "实意者，气之虑也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-16",
    "text": "分威者，神之覆也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  },
  {
    "id": "ggz-17",
    "text": "散势者，神之使也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "散势法鸷鸟第十九"
  },
  {
    "id": "ggz-18",
    "text": "转圆者，无穷之计。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "转圆法猛兽第二十"
  },
  {
    "id": "ggz-19",
    "text": "损兑者，机危之决也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "损兑法灵蓍第二十一"
  },
  {
    "id": "ggz-20",
    "text": "持枢，谓春生、夏长、秋收、冬藏，天之正也，不可干而逆之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "持枢第二十二"
  },
  {
    "id": "ggz-21",
    "text": "中经，谓振穷趋急，施之能言厚德之人。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "全篇第二十三"
  },
  {
    "id": "ggz-22",
    "text": "观阴阳之开阖以命物，知存亡之门户，筹策万类之终始，达人心之理，见变化之朕焉，而守司其门户。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-23",
    "text": "反以观往，覆以验来；反以知古，覆以知今；反以知彼，覆以知己。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-24",
    "text": "事皆有内楗，素结本始。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-25",
    "text": "有近而不可见，有远而可知。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-26",
    "text": "立势而制事，必先察同异之计，别是非之语，见内外之辞，知有无之术；决安危之计，定亲疏之事；然后乃权量之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-27",
    "text": "化转环属，各有形势，反复相求，因事为制。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-28",
    "text": "量权不审，不知强弱轻重之称；揣情不审，不知隐匿变化之动静。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "揣篇第七"
  },
  {
    "id": "ggz-29",
    "text": "内符者，揣之主也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-30",
    "text": "应对者，利辞也；利辞者，轻论也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-31",
    "text": "审得其情，乃立三仪。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-32",
    "text": "喜其用福，恶其有患。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-33",
    "text": "善与而不静，虚心平意以待倾损。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-34",
    "text": "道者，天地之始，一其纪也，物之所造，天之所生，包宏无形，化气，先天地而成，莫见其形，莫知其名，谓之神灵。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-35",
    "text": "有所欲，志存而思之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-36",
    "text": "心欲安静，虑欲深远。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-37",
    "text": "故静意固志，神归其舍，则威覆盛矣。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  },
  {
    "id": "ggz-38",
    "text": "用之，必循间而动。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "散势法鸷鸟第十九"
  },
  {
    "id": "ggz-39",
    "text": "无穷者，必有圣人之心，以原不测之智而通心术。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "转圆法猛兽第二十"
  },
  {
    "id": "ggz-40",
    "text": "事有适然，物有成败，机危之动，不可不察。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "损兑法灵蓍第二十一"
  },
  {
    "id": "ggz-41",
    "text": "逆之者，虽成必败。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "持枢第二十二"
  },
  {
    "id": "ggz-42",
    "text": "救拘执穷者，不忘恩也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "全篇第二十三"
  },
  {
    "id": "ggz-43",
    "text": "故圣人之在天下也，自古及今，其道一也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-44",
    "text": "动静虚实之理，不合来今，反古而求之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-45",
    "text": "或结以道德，或结以党友，或结以财货，或结以采色。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-46",
    "text": "近而不可见者，不察其辞也；远而可知者，反往以验来也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-47",
    "text": "其有隐括，乃可征、乃可求、乃可用。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-48",
    "text": "是以圣人居天地之间，立身、御世、施教、扬声、明名也；必因事物之会，观天时之宜，因知所多所少，以此先知之，与之转化。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-49",
    "text": "用之有道，其道必隐。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-50",
    "text": "成义者，明之也；明之者，符验也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-51",
    "text": "三仪者曰上、曰中、曰下。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-52",
    "text": "善至于诱也，终无惑偏。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-53",
    "text": "目贵明，耳贵聪，心贵智。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-54",
    "text": "故道者，神明之源，一其化端。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-55",
    "text": "志者，欲之使也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-56",
    "text": "心安静则神策生，虑深远则计谋成。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-57",
    "text": "威覆盛，则内实坚；内实坚，则莫当；莫当，则能以分人之威，而动其势，如其天。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  },
  {
    "id": "ggz-58",
    "text": "威肃内盛，推间而行之，则势散。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "散势法鸷鸟第十九"
  },
  {
    "id": "ggz-59",
    "text": "智略计谋，各有形容：或圆或方，或阴或阳，或吉或凶，事类不同。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "转圆法猛兽第二十"
  },
  {
    "id": "ggz-60",
    "text": "故圣人以无为待有德，言察辞合于事。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "损兑法灵蓍第二十一"
  },
  {
    "id": "ggz-61",
    "text": "故人君亦有天枢，生养成藏，亦复不可干而逆之，逆之虽盛必衰。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "持枢第二十二"
  },
  {
    "id": "ggz-62",
    "text": "能言者，俦善博惠，施德者，依道；而救拘执者，养使小人。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "全篇第二十三"
  },
  {
    "id": "ggz-63",
    "text": "变化无穷，各有所归。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-64",
    "text": "事有反而得覆者，圣人之意也，不可不察。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-65",
    "text": "用其意，欲入则入，欲出则出；欲亲则亲，欲疏则疏；欲就则就；欲去则去；欲求则求，欲思则思。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-66",
    "text": "巇者，罅也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-67",
    "text": "引钩钳之辞，飞而钳之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-68",
    "text": "世无常贵，事无常师；圣人无常与，无不与；无所听，无不听；成于事而合于计谋，与之为主。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-69",
    "text": "称货财有无，料人民多少、饶乏，有余不足几何？",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "揣篇第七"
  },
  {
    "id": "ggz-70",
    "text": "微摩之以其索欲，测而探之，内符必应；其索应也，必有为之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-71",
    "text": "难言者，却论也；却论者，钓几也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-72",
    "text": "参以立焉，以生奇。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-73",
    "text": "有利焉，去其利则不受也，奇之所托。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-74",
    "text": "以天下之目视者，则无不见；以天下之耳听者，则无不闻；以天下之心思虑者，则无不知；辐辏并进，则明不可塞。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-75",
    "text": "是以德养五气，心能得一，乃有其术。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-76",
    "text": "欲多则心散，心散则志衰，志衰则思不达。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-77",
    "text": "神策生则志不可乱，计谋成则功不可间。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-78",
    "text": "以实取虚，以有取无，若以镒称铢。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  },
  {
    "id": "ggz-79",
    "text": "夫散势者，心虚志溢；意衰威失，精神不专，其言外而多变。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "散势法鸷鸟第十九"
  },
  {
    "id": "ggz-80",
    "text": "故圣人怀此用，转圆而求其合。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "转圆法猛兽第二十"
  },
  {
    "id": "ggz-81",
    "text": "兑者知之也，损者行之也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "损兑法灵蓍第二十一"
  },
  {
    "id": "ggz-82",
    "text": "此天道、人君之大纲也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "持枢第二十二"
  },
  {
    "id": "ggz-83",
    "text": "盖士，当世异时，或当因免阗坑，或当伐害能言，或当破德为雄，或当抑拘成罪，或当戚戚自善，或当败败自立。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "全篇第二十三"
  },
  {
    "id": "ggz-84",
    "text": "或阴或阳，或柔或刚，或开或闭，或弛或张。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-85",
    "text": "人言者，动也；己默者，静也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-86",
    "text": "独往独来，莫之能止。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-87",
    "text": "罅者，涧也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-88",
    "text": "钩钳之语，其说辞也，乍同乍异。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-89",
    "text": "合于彼而离于此，计谋不两忠，必有反忤；反于是，忤于彼；忤于此，反于彼，其术也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-90",
    "text": "辨地形之险易孰利、孰害？",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "揣篇第七"
  },
  {
    "id": "ggz-91",
    "text": "故微而去之，是谓塞窌匿端，隐貌逃情，而人不知，故能成其事而无患。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-92",
    "text": "佞言者，谄而于忠：谀言者，博而于智；平言者，决而于勇；戚言者，权而于信；静言者，反而于胜。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-93",
    "text": "奇不知其所壅，始于古之所从。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-94",
    "text": "故其有使失利者，有使离害者，此事之失。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-95",
    "text": "德之术曰：勿坚而拒之。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-96",
    "text": "术者，心气之道所由舍者，神乃为之使。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-97",
    "text": "故心气一，则欲不徨；欲不徨，则志意不衰；志意不衰，则思理达矣。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-98",
    "text": "意虑定则心遂安，心遂安则所行不错，神自得矣，得则凝。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-99",
    "text": "故动者必随，唱者必和；挠其一指，观其余次；动变见形，无能间者。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  },
  {
    "id": "ggz-100",
    "text": "故观其志意，为度数，乃以揣，说图事，尽圆方，齐短长。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "散势法鸷鸟第十九"
  },
  {
    "id": "ggz-101",
    "text": "故与造化者为始，动作无不包大道，以观神明之域。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "转圆法猛兽第二十"
  },
  {
    "id": "ggz-102",
    "text": "损之说之，物有不可者，圣人不为之辞。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "损兑法灵蓍第二十一"
  },
  {
    "id": "ggz-103",
    "text": "故道贵制人，不贵制于人也；制人者握权，制于人者失命。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "全篇第二十三"
  },
  {
    "id": "ggz-104",
    "text": "是故圣人一守司其门户，审察其所先后，度权量能，校其伎巧短长。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "捭阖第一"
  },
  {
    "id": "ggz-105",
    "text": "因其言，听其辞。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "反应第二"
  },
  {
    "id": "ggz-106",
    "text": "内者，进说辞也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "内揵第三"
  },
  {
    "id": "ggz-107",
    "text": "涧者，成大隙也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "抵巇第四"
  },
  {
    "id": "ggz-108",
    "text": "其不可善者：或先征之，而后重累；或先重以累，而后毁之；或以重累为毁；或以毁为重累。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "飞箝第五"
  },
  {
    "id": "ggz-109",
    "text": "用之于天下，必量天下而与之；用之于国，必量国而与之；用之于家，必量家而与之；用之于身，必量身材气势而与之；大小进退，其用一也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "忤合第六"
  },
  {
    "id": "ggz-110",
    "text": "谋虑孰长、孰短？",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "揣篇第七"
  },
  {
    "id": "ggz-111",
    "text": "摩之在此，符之在彼，从而用之，事无不可。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "摩篇第八"
  },
  {
    "id": "ggz-112",
    "text": "先意承欲者，谄也；繁种文辞者，博也；策选进谋者，权也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "权篇第九"
  },
  {
    "id": "ggz-113",
    "text": "故郑人之取玉也，必载司南之车，为其不惑也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "谋篇第十"
  },
  {
    "id": "ggz-114",
    "text": "圣人所以能成其事者有五：有以阳德之者，有以阴贼之者，有以信诚之者，有以蔽匿之者，有以平素之者。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "决篇第十一"
  },
  {
    "id": "ggz-115",
    "text": "许之则防守，拒之则闭塞。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "符言第十二"
  },
  {
    "id": "ggz-116",
    "text": "九窍十二舍者，气之门户，心之总摄也。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "盛神法五龙第十五"
  },
  {
    "id": "ggz-117",
    "text": "理达则和通，和通则乱气不烦于胸中。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "养志法灵龟第十六"
  },
  {
    "id": "ggz-118",
    "text": "识气寄，奸邪而倚之，诈谋而惑之，言无由心矣。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "实意法腾蛇第十七"
  },
  {
    "id": "ggz-119",
    "text": "审于唱和，以间见间，动变明而威可分。",
    "source": "《鬼谷子》",
    "book": "鬼谷子",
    "chapter": "分威法伏熊第十八"
  }
]