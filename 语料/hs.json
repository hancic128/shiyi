[
  {
    "id": "hs-1",
    "text": "高祖，沛丰邑中阳里人也，姓刘氏。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高帝纪上第一"
  },
  {
    "id": "hs-2",
    "text": "五年冬十月，汉王追项羽至阳夏南，止军，与齐王信、魏相国越期会击楚。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高帝纪下第二"
  },
  {
    "id": "hs-3",
    "text": "孝惠皇帝，高祖太子也，母曰吕皇后。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "惠帝纪第三"
  },
  {
    "id": "hs-4",
    "text": "高皇后吕氏，生惠帝。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高后纪第四"
  },
  {
    "id": "hs-5",
    "text": "孝文皇帝，高祖中子也，母曰薄姬。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "文帝纪第五"
  },
  {
    "id": "hs-6",
    "text": "孝景皇帝，文帝太子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "景帝纪第六"
  },
  {
    "id": "hs-7",
    "text": "孝武皇帝，景帝中子也，母曰王美人。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "武帝纪第七"
  },
  {
    "id": "hs-8",
    "text": "孝昭皇帝，武帝少子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "昭帝纪第八"
  },
  {
    "id": "hs-9",
    "text": "孝宣皇帝，武帝曾孙，戾太子孙也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "宣帝纪第九"
  },
  {
    "id": "hs-10",
    "text": "孝元皇帝，宣帝太子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "元帝纪第十"
  },
  {
    "id": "hs-11",
    "text": "孝成皇帝，元帝太子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "成帝纪第十一"
  },
  {
    "id": "hs-12",
    "text": "孝哀皇帝，元帝庶孙，定陶恭王子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "哀帝纪第十二"
  },
  {
    "id": "hs-13",
    "text": "孝平皇帝，元帝庶孙，中山孝王子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "平帝纪第十三"
  },
  {
    "id": "hs-14",
    "text": "昔诗书述虞夏之际，舜禹受䄠，积德累功，洽于百姓，摄位行政，孝之于天，经数十年，然后在位。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "异姓诸侯王表第一"
  },
  {
    "id": "hs-15",
    "text": "昔周监于二代，三圣制法，立爵五等，封国八百，同姓五十有余。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "诸侯王表第二"
  },
  {
    "id": "hs-16",
    "text": "大哉，圣祖之建业也！",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王子侯表上第三"
  },
  {
    "id": "hs-17",
    "text": "孝元之世，亡王子侯者，盛衰终始，岂非命哉！",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王子侯表下第四"
  },
  {
    "id": "hs-18",
    "text": "自古帝王之兴，曷尝不建辅弼之臣所与共成天功者乎！",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高惠高后文功臣表第五"
  },
  {
    "id": "hs-19",
    "text": "昔书称蛮夷帅服，诗云徐方既俫，春秋列潞子之爵，许其慕诸夏也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "景武昭宣元成功臣表第六"
  },
  {
    "id": "hs-20",
    "text": "自古受命及中兴之君，必兴灭继绝，修废举逸，然后天下归仁，四方之政行焉。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "外戚恩泽侯表第七"
  },
  {
    "id": "hs-21",
    "text": "易叙宓羲、神农、黄帝作教化民，而传述其官，以为宓羲龙师名官，神农火师火名，黄帝云师云名，少昊鸟师鸟名。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "百官公卿表上第八"
  },
  {
    "id": "hs-22",
    "text": "自书契之作，先民可得而闻者，经传所称，唐、虞以上，帝王有号谥。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "古今人表第十"
  },
  {
    "id": "hs-23",
    "text": "虞书曰乃同律度量衡，所以齐远近，立民信也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "律历志上第一"
  },
  {
    "id": "hs-24",
    "text": "日法八十一。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "律历志下第二"
  },
  {
    "id": "hs-25",
    "text": "六经之道同归，而礼、乐之用为急。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "礼乐志第三"
  },
  {
    "id": "hs-26",
    "text": "夫人宵天地之貌，怀五常之性，聪明精粹，有生之最灵者也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "刑法志第四"
  },
  {
    "id": "hs-27",
    "text": "洪范八政，一曰食，二曰货。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "食货志上第五"
  },
  {
    "id": "hs-28",
    "text": "凡货，金、钱、布、帛之用，夏、殷以前其详靡记云。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "食货志下第六"
  },
  {
    "id": "hs-29",
    "text": "洪范八政，三曰祀。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "郊祀志上第七"
  },
  {
    "id": "hs-30",
    "text": "是时既灭两粤，粤人勇之乃言：粤人俗鬼，而其祠皆见鬼，数有效。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "郊祀志下第八"
  },
  {
    "id": "hs-31",
    "text": "凡天文在图籍昭昭可知者，经星常宿中外官凡百一十八名，积数七百八十三星，皆有州国官宫物类之象。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "天文志第九"
  },
  {
    "id": "hs-32",
    "text": "易曰：天垂象，见吉凶，圣人象之；河出图，雒出书，圣人则之。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "五行志上第十"
  },
  {
    "id": "hs-33",
    "text": "经曰：羞用五事。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "五行志中之上第十一"
  },
  {
    "id": "hs-34",
    "text": "传曰：视之不明，是谓不哲，厥咎舒，厥罚恒奥，厥极疾。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "五行志中之下第十二"
  },
  {
    "id": "hs-35",
    "text": "传曰：思心之不，是谓不圣，厥咎，厥罚恒风，厥极凶短折。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "五行志下之上第十三"
  },
  {
    "id": "hs-36",
    "text": "隐公三年二月己巳，日有食之。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "五行志下之下第十四"
  },
  {
    "id": "hs-37",
    "text": "昔在黄帝，作舟车以济不通，旁行天下，方制万里，画野分州，得百里之国万区。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "地理志上第十五"
  },
  {
    "id": "hs-38",
    "text": "武都郡，武帝元鼎六年置。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "地理志下第十六"
  },
  {
    "id": "hs-39",
    "text": "夏书：禹堙洪水十三年，过家不入门。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "沟洫志第十七"
  },
  {
    "id": "hs-40",
    "text": "昔仲尼没而微言绝，七十子丧而大义乖。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "艺文志第十八"
  },
  {
    "id": "hs-41",
    "text": "陈胜字涉，阳城人。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "陈胜项籍传第一"
  },
  {
    "id": "hs-42",
    "text": "张耳，大梁人也，少时及魏公子毋忌为客。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张耳陈馀传第二"
  },
  {
    "id": "hs-43",
    "text": "魏豹，故魏诸公子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "魏豹田儋韩王信传第三"
  },
  {
    "id": "hs-44",
    "text": "韩信，淮阴人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "韩彭英卢吴传第四"
  },
  {
    "id": "hs-45",
    "text": "荆王刘贾，高帝从父兄也，不知其初起时。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "荆燕吴传第五"
  },
  {
    "id": "hs-46",
    "text": "楚元王交字游，高祖同父少弟也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "楚元王传第六"
  },
  {
    "id": "hs-47",
    "text": "季布，楚人也，为任侠有名。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "季布栾布田叔传第七"
  },
  {
    "id": "hs-48",
    "text": "高皇帝八男：吕后生孝惠帝，曹夫人生齐悼惠王肥，薄姬生孝文帝，戚夫人生赵隐王如意，赵姬生淮南厉王长，诸姬生赵幽王友、赵共王恢、燕灵王建。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高五王传第八"
  },
  {
    "id": "hs-49",
    "text": "萧何，沛人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "萧何曹参传第九"
  },
  {
    "id": "hs-50",
    "text": "张良字子房，其先韩人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张陈王周传第十"
  },
  {
    "id": "hs-51",
    "text": "樊哙，沛人也，以屠狗为事。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "樊郦滕灌傅靳周传第十一"
  },
  {
    "id": "hs-52",
    "text": "张苍，阳武人也，好书律历。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张周赵任申屠传第十二"
  },
  {
    "id": "hs-53",
    "text": "郦食其，陈留高阳人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "郦陆朱刘叔孙传第十三"
  },
  {
    "id": "hs-54",
    "text": "淮南厉王长，高帝少子也，其母故赵王张敖美人。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "淮南衡山济北王传第十四"
  },
  {
    "id": "hs-55",
    "text": "蒯通，范阳人也，本与武帝同讳。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "蒯伍江息夫传第十五"
  },
  {
    "id": "hs-56",
    "text": "万石君石奋，其父赵人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "万石卫直周张传第十六"
  },
  {
    "id": "hs-57",
    "text": "孝文皇帝四男：窦皇后生孝景帝、梁孝王武，诸姬生代孝王参、梁怀王揖。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "文三王传第十七"
  },
  {
    "id": "hs-58",
    "text": "贾谊，雒阳人也，年十八，以能诵诗书属文称于郡中。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "贾谊传第十八"
  },
  {
    "id": "hs-59",
    "text": "其父楚人也，故为群盗，徙安陵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "爰盎晁错传第十九"
  },
  {
    "id": "hs-60",
    "text": "张释之字季，南阳堵阳人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张冯汲郑传第二十"
  },
  {
    "id": "hs-61",
    "text": "贾山，颍川人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "贾邹枚路传第二十一"
  },
  {
    "id": "hs-62",
    "text": "窦婴字王孙，孝文皇后从兄子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "窦田灌韩传第二十二"
  },
  {
    "id": "hs-63",
    "text": "孝景皇帝十四男。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "景十三王传第二十三"
  },
  {
    "id": "hs-64",
    "text": "李广，陇西成纪人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "李广苏建传第二十四"
  },
  {
    "id": "hs-65",
    "text": "卫青字仲卿。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "卫青霍去病传第二十五"
  },
  {
    "id": "hs-66",
    "text": "董仲舒，广川人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "董仲舒传第二十六"
  },
  {
    "id": "hs-67",
    "text": "司马相如字长卿，蜀郡成都人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "司马相如传上第二十七"
  },
  {
    "id": "hs-68",
    "text": "相如为郎数岁，会唐蒙使略通夜郎、僰中，发巴、蜀吏卒，千人，郡又多为发转漕万余人，用军兴法诛其渠率。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "司马相如传下第二十八"
  },
  {
    "id": "hs-69",
    "text": "公孙弘，菑川薛人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "公孙弘卜式儿宽传第二十九"
  },
  {
    "id": "hs-70",
    "text": "张汤，杜陵人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张汤传第三十"
  },
  {
    "id": "hs-71",
    "text": "杜周，南阳杜衍人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "杜周传第三十一"
  },
  {
    "id": "hs-72",
    "text": "张骞，汉中人也，建元中为郎。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "张骞李广利传第三十二"
  },
  {
    "id": "hs-73",
    "text": "昔在颛顼，命南正重司天，火正黎司地。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "司马迁传第三十三"
  },
  {
    "id": "hs-74",
    "text": "孝武皇帝六男。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "武五子传第三十四"
  },
  {
    "id": "hs-75",
    "text": "严助，会稽吴人，严夫子子也，或言族家子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "严朱吾丘主父徐严终王贾传上第三十五"
  },
  {
    "id": "hs-76",
    "text": "严安者，临菑人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "严朱吾丘主父徐严终王贾传下第三十六"
  },
  {
    "id": "hs-77",
    "text": "东方朔字曼倩，平原厌次人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "东方朔传第三十七"
  },
  {
    "id": "hs-78",
    "text": "公孙贺字子叔，北地义渠人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "公孙刘田王杨蔡陈郑传第三十八"
  },
  {
    "id": "hs-79",
    "text": "杨王孙者，孝武时人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "杨胡朱梅云传第三十九"
  },
  {
    "id": "hs-80",
    "text": "霍光字子孟，票骑将军去病弟也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "霍光金日磾传第四十"
  },
  {
    "id": "hs-81",
    "text": "赵充国字翁孙，陇西上邽人也，后徙金城令居。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "赵充国辛庆忌传第四十一"
  },
  {
    "id": "hs-82",
    "text": "傅介子，北地人也，以从军为官。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "傅常郑甘陈段传第四十二"
  },
  {
    "id": "hs-83",
    "text": "隽不疑字曼倩，勃海人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "隽疏于薛平彭传第四十三"
  },
  {
    "id": "hs-84",
    "text": "昔武王伐纣，迁九鼎于雒邑，伯夷、叔齐薄之，饿死于首阳，不食其禄，周犹称盛德焉。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王贡两龚鲍传第四十四"
  },
  {
    "id": "hs-85",
    "text": "韦贤字长孺。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "韦贤传第四十五"
  },
  {
    "id": "hs-86",
    "text": "魏相字弱翁，济阴定陶人也，徙平陵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "魏相丙吉传第四十六"
  },
  {
    "id": "hs-87",
    "text": "眭弘字孟，鲁国蕃人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "眭两夏侯京翼李传第四十七"
  },
  {
    "id": "hs-88",
    "text": "赵广汉字子都，涿郡蠡吾人也，故属河间。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "赵尹韩张两王传第四十八"
  },
  {
    "id": "hs-89",
    "text": "盖宽饶字次公，魏郡人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "盖诸葛刘郑孙毋将何传第四十九"
  },
  {
    "id": "hs-90",
    "text": "萧望之字长倩，东海兰陵人也，徙杜陵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "萧望之传第五十"
  },
  {
    "id": "hs-91",
    "text": "冯奉世字子明，上党潞人也，徙杜陵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "冯奉世传第五十一"
  },
  {
    "id": "hs-92",
    "text": "孝宣皇帝五男。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "宣元六王传第五十二"
  },
  {
    "id": "hs-93",
    "text": "匡衡字稚圭，东海承人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "匡张孔马传第五十三"
  },
  {
    "id": "hs-94",
    "text": "王商字子威，涿郡蠡吾人也，徙杜陵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王商史丹傅喜传第五十四"
  },
  {
    "id": "hs-95",
    "text": "薛宣字赣君，东海郯人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "薛宣朱博传第五十五"
  },
  {
    "id": "hs-96",
    "text": "翟方进字子威，汝南上蔡人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "翟方进传第五十六"
  },
  {
    "id": "hs-97",
    "text": "谷永字子云，长安人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "谷永杜邺传第五十七"
  },
  {
    "id": "hs-98",
    "text": "何武字君公，蜀郡郫县人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "何武王嘉师丹传第五十八"
  },
  {
    "id": "hs-99",
    "text": "扬雄字子云，蜀郡成都人也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "扬雄传上第五十九"
  },
  {
    "id": "hs-100",
    "text": "明年，上将大夸胡人以多禽兽，秋，命右扶风发民入南山，西自褒斜，东至弘农，南驱汉中，张罗罔罴罘，捕熊罴、豪猪、虎豹、狖玃、狐菟、麋鹿，载以槛车，输长杨射熊馆。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "扬雄传下第六十"
  },
  {
    "id": "hs-101",
    "text": "古之儒者，博学乎六艺之文。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "儒林传第六十一"
  },
  {
    "id": "hs-102",
    "text": "汉兴之初，反秦之敝，与民休息，凡事简易，禁罔疏阔，而相国萧、曹以宽厚清静为天下帅，民作画一之歌。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "循吏传第六十二"
  },
  {
    "id": "hs-103",
    "text": "孔子曰：导之以政，齐之以刑，民免而无耻；导之以德，齐之以礼，有耻且格。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "酷吏传第六十三"
  },
  {
    "id": "hs-104",
    "text": "昔先王之制，自天子、公、侯、卿、大夫、士至于皂隶、抱关、击者，其爵禄、奉养、宫室、车服、棺椁、祭祀、死生之制各有差品，小不得僣大，贱不得逾贵。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "货殖传第六十四"
  },
  {
    "id": "hs-105",
    "text": "古者天子建国，诸侯立家，自卿、大夫以至于庶人，各有等差，是以民服事其上，而下无觊觎。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "游侠传第六十五"
  },
  {
    "id": "hs-106",
    "text": "汉兴，佞幸宠臣，高祖时则有籍孺，孝惠有闳孺。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "佞幸传第六十六"
  },
  {
    "id": "hs-107",
    "text": "匈奴，其先夏后氏之苗裔，曰淳维。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "匈奴传上第六十七"
  },
  {
    "id": "hs-108",
    "text": "呼韩邪单于归庭数月，罢兵使各归故地，乃收其兄呼屠吾斯在民间者立为左谷蠡王，使人告右贤贵人，欲令杀右贤王。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "匈奴传下第六十八"
  },
  {
    "id": "hs-109",
    "text": "南夷君长以十数，夜郎最大。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "西南夷两粤朝鲜传第六十九"
  },
  {
    "id": "hs-110",
    "text": "西域以孝武时始通，本三十六国，其后稍分至五十余，皆在匈奴之西，乌孙之南。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "西域传上第七十"
  },
  {
    "id": "hs-111",
    "text": "乌孙国，大昆弥治赤谷城，去长安八千九百里。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "西域传下第七十一"
  },
  {
    "id": "hs-112",
    "text": "孝元王皇后，成帝母也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "外戚传下第七十三"
  },
  {
    "id": "hs-113",
    "text": "孝元皇后，王莽姑也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "元后传第七十四"
  },
  {
    "id": "hs-114",
    "text": "王莽字巨君，孝元皇后之弟子也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王莽传上第七十五"
  },
  {
    "id": "hs-115",
    "text": "始建国元年正月朔，莽帅公侯卿士奉皇太后玺韨，上太皇太后，顺符命，去汉号焉。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王莽传中第七十六"
  },
  {
    "id": "hs-116",
    "text": "四年五月，莽曰：保成师友祭酒唐林、故谏议祭酒琅邪纪逡，孝弟忠恕，敬上爱下，博通旧闻，德行醇备，至于黄发，靡有愆失。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "王莽传下第七十七"
  },
  {
    "id": "hs-117",
    "text": "班氏之先，与楚同姓，令尹子文之后也。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "叙传上第七十八"
  },
  {
    "id": "hs-118",
    "text": "固以为唐虞三代，诗书所及，世有典籍，故虽尧，舜之盛，必有典谟之篇，然后扬名于后世，冠德于百王，故曰：巍巍乎其有成功，焕乎其有文章也！",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "叙传下第七十九"
  },
  {
    "id": "hs-119",
    "text": "母媪尝息大泽之陂，梦与神遇。",
    "source": "《汉书》",
    "book": "汉书",
    "chapter": "高帝纪上第一"
  }
]