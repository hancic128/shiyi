[
  {
    "id": "xz-1",
    "text": "君子曰：学不可以已。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "劝学第一"
  },
  {
    "id": "xz-2",
    "text": "见善，修然必以自存也；见不善，愀然必以自省也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "修身第二"
  },
  {
    "id": "xz-3",
    "text": "君子行不贵苟难，说不贵苟察，名不贵苟传，唯其当之为贵。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "不苟第三"
  },
  {
    "id": "xz-4",
    "text": "憍泄者，人之殃也；恭俭者，偋五兵也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "荣辱第四"
  },
  {
    "id": "xz-5",
    "text": "相人，古之人无有也，学者不道也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非相第五"
  },
  {
    "id": "xz-6",
    "text": "假今之世，饰邪说，文奸言，以枭乱天下，矞宇嵬琐，使天下混然不知是非治乱之所存者有人矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非十二子"
  },
  {
    "id": "xz-7",
    "text": "仲尼之门人，五尺之竖子言羞称乎五伯。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "仲尼第七"
  },
  {
    "id": "xz-8",
    "text": "大儒之效：武王崩，成王幼，周公屏成王而及武王以属天下，恶天下之倍周也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "儒效第八"
  },
  {
    "id": "xz-9",
    "text": "万物同宇而异体，无宜而有用为人，数也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "富国第十"
  },
  {
    "id": "xz-10",
    "text": "国者，天下之利用也；人主者，天下之利势也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王霸第十一"
  },
  {
    "id": "xz-11",
    "text": "有乱君，无乱国；有治人，无治法，羿之法非亡也，而羿不世中；禹之法犹存，而夏不世王。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君道第十二"
  },
  {
    "id": "xz-12",
    "text": "人臣之论：有态臣者，有篡臣者，有功臣者，有圣臣者。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "臣道第十三"
  },
  {
    "id": "xz-13",
    "text": "衡听、显幽、重明、退奸、进良之术：朋党比周之誉，君子不听；残贼加累之谮，君子不用；隐忌雍蔽之人，君子不近；货财禽犊之请，君子不许。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "致士第十四"
  },
  {
    "id": "xz-14",
    "text": "临武君与孙卿子议兵于赵孝成王前，王曰：请问兵要？",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "议兵第十五"
  },
  {
    "id": "xz-15",
    "text": "刑范正，金锡美，工冶巧，火齐得，剖刑而莫邪已。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "强国第十六"
  },
  {
    "id": "xz-16",
    "text": "天行有常，不为尧存，不为桀亡。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "天论第十七"
  },
  {
    "id": "xz-17",
    "text": "世俗之为说者曰：主道利周。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正论第十八"
  },
  {
    "id": "xz-18",
    "text": "礼起于何也？",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "礼论第十九"
  },
  {
    "id": "xz-19",
    "text": "夫乐者，乐也，人情之所必不免也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "乐论第二十"
  },
  {
    "id": "xz-20",
    "text": "凡人之患，蔽于一曲，而暗于大理。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "解蔽二十一"
  },
  {
    "id": "xz-21",
    "text": "后王之成名：刑名从商，爵名从周，文名从礼，散名之加于万物者，则从诸夏之成俗曲期，远方异俗之乡，则因之而为通。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正名第二十二"
  },
  {
    "id": "xz-22",
    "text": "人之性恶，其善者伪也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "性恶第二十三"
  },
  {
    "id": "xz-23",
    "text": "天子无妻，告人无匹也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君子第二十四"
  },
  {
    "id": "xz-24",
    "text": "请成相：世之殃，愚暗愚暗堕贤良！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "成相第二十五"
  },
  {
    "id": "xz-25",
    "text": "爰有大物，非丝非帛，文理成章；非日非月，为天下明。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "赋第二十六"
  },
  {
    "id": "xz-26",
    "text": "君人者，隆礼尊贤而王，重法爱民而霸，好利多诈而危。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "大略第二十七"
  },
  {
    "id": "xz-27",
    "text": "孔子观于鲁桓公之庙，有欹器焉，孔子问于守庙者曰：此为何器？",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "宥坐第二十八"
  },
  {
    "id": "xz-28",
    "text": "入孝出弟，人之小行也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "子道第二十九"
  },
  {
    "id": "xz-29",
    "text": "公输不能加于绳墨，圣人不能加于礼。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "法行第三十"
  },
  {
    "id": "xz-30",
    "text": "孔子对曰：生今之世，志古之道：居今之俗，服古之服；舍此而为非者，不亦鲜乎！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "哀公第三十一"
  },
  {
    "id": "xz-31",
    "text": "对曰：执一无失，行微无怠，忠信无倦，而天下自来。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "尧问第三十二"
  },
  {
    "id": "xz-32",
    "text": "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "劝学第一"
  },
  {
    "id": "xz-33",
    "text": "善在身，介然必以自好也；不善在身，菑然必以自恶也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "修身第二"
  },
  {
    "id": "xz-34",
    "text": "故怀负石而赴河，是行之难为者也，而申徒狄能之；然而君子不贵者，非礼义之中也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "不苟第三"
  },
  {
    "id": "xz-35",
    "text": "虽有戈矛之刺，不如恭俭之利也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "荣辱第四"
  },
  {
    "id": "xz-36",
    "text": "古者有姑布子卿，今之世，梁有唐举，相人之形状颜色而知其吉凶妖祥，世俗称之。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非相第五"
  },
  {
    "id": "xz-37",
    "text": "纵情性，安恣睢，禽兽行，不足以合文通治；然而其持之有故，其言之成理，足以欺惑愚众；是它嚣、魏牟也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非十二子"
  },
  {
    "id": "xz-38",
    "text": "彼诚可羞称也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "仲尼第七"
  },
  {
    "id": "xz-39",
    "text": "履天子之籍，听天下之断，偃然如固有之，而天下不称贪焉；杀管叔，虚殷国，而天下不称戾焉；兼制天下，立七十一国，姬姓独居五十三人，而天下不称偏焉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "儒效第八"
  },
  {
    "id": "xz-40",
    "text": "分未定也则有昭缪。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王制第九"
  },
  {
    "id": "xz-41",
    "text": "人伦并处，同求而异道，同欲而异知，生也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "富国第十"
  },
  {
    "id": "xz-42",
    "text": "得道以持之，则大安也，大荣也，积美之源也；不得道以持之，则大危也，大累也，有之不如无之；及其綦也，索为匹夫不可得也，齐愍、宋献是也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王霸第十一"
  },
  {
    "id": "xz-43",
    "text": "故法不能独立，类不能自行；得其人则存，失其人则亡。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君道第十二"
  },
  {
    "id": "xz-44",
    "text": "－－内不足使一民，外不足使距难，百姓不亲，诸侯不信；然而巧敏佞说，善取宠乎上，是态臣者也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "臣道第十三"
  },
  {
    "id": "xz-45",
    "text": "夫是之谓衡听、显幽、重明、退奸、进良之术。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "致士第十四"
  },
  {
    "id": "xz-46",
    "text": "临武君对曰：上得天时，下得地利，观敌之变动，后之发，先之至，此用兵之要术也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "议兵第十五"
  },
  {
    "id": "xz-47",
    "text": "然而不剥脱，不砥厉，则不可以断绳。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "强国第十六"
  },
  {
    "id": "xz-48",
    "text": "应之以治则吉，应之以乱则凶。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "天论第十七"
  },
  {
    "id": "xz-49",
    "text": "主者、民之唱也，上者、下之仪也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正论第十八"
  },
  {
    "id": "xz-50",
    "text": "故人不能无乐，乐则必发于声音，形于动静；而人之道，声音动静，性术之变尽是矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "乐论第二十"
  },
  {
    "id": "xz-51",
    "text": "治则复经，两疑则惑矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "解蔽二十一"
  },
  {
    "id": "xz-52",
    "text": "散名之在人者：生之所以然者谓之性；性之和所生，精合感应，不事而自然谓之性。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正名第二十二"
  },
  {
    "id": "xz-53",
    "text": "今人之性，生而有好利焉，顺是，故争夺生而辞让亡焉；生而有疾恶焉，顺是，故残贼生而忠信亡焉；生而有耳目之欲，有好声色焉，顺是，故淫乱生而礼义文理亡焉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "性恶第二十三"
  },
  {
    "id": "xz-54",
    "text": "四海之内无客礼，告无适也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君子第二十四"
  },
  {
    "id": "xz-55",
    "text": "人主无贤，如瞽无相，何伥伥！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "成相第二十五"
  },
  {
    "id": "xz-56",
    "text": "生者以寿，死者以葬。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "赋第二十六"
  },
  {
    "id": "xz-57",
    "text": "欲近四旁，莫如中央，故王者必居天下之中，礼也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "大略第二十七"
  },
  {
    "id": "xz-58",
    "text": "守庙者曰：此盖为宥坐之器，孔子曰：吾闻宥坐之器者，虚则欹，中则正，满则覆。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "宥坐第二十八"
  },
  {
    "id": "xz-59",
    "text": "上顺下笃，人之中行也；从道不从君，从义不从父，人之大行也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "子道第二十九"
  },
  {
    "id": "xz-60",
    "text": "礼者，众人法而不知，圣人法而知之。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "法行第三十"
  },
  {
    "id": "xz-61",
    "text": "哀公曰：然则夫章甫絇屦，绅带而搢笏者，此贤乎？",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "哀公第三十一"
  },
  {
    "id": "xz-62",
    "text": "执一如天地，行微如日月，忠诚盛于内，贲于外，形于四海，天下其在一隅邪！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "尧问第三十二"
  },
  {
    "id": "xz-63",
    "text": "木直中绳，𫐓以为轮，其曲中规，虽有槁暴，不复挺者，𫐓使之然也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "劝学第一"
  },
  {
    "id": "xz-64",
    "text": "故非我而当者，吾师也；是我而当者，吾友也；谄谀我者，吾贼也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "修身第二"
  },
  {
    "id": "xz-65",
    "text": "山渊平，天地比，齐、秦袭，入乎耳，出乎口，钩有须，卵有毛，是说之难持者也，而惠施、邓析能之；然而君子不贵者，非礼义之中也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "不苟第三"
  },
  {
    "id": "xz-66",
    "text": "故与人善言，暖于布帛；伤人之言，深于矛戟。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "荣辱第四"
  },
  {
    "id": "xz-67",
    "text": "古之人无有也，学者不道也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非相第五"
  },
  {
    "id": "xz-68",
    "text": "忍情性，綦谿利跂，苟以分异人为高，不足以合大众、明大分；然而其持之有故，其言之成理，足以欺惑愚众，是陈仲史䲡也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非十二子"
  },
  {
    "id": "xz-69",
    "text": "齐桓，五伯之盛者也，前事则杀兄而争国；内行则姑姊妹之不嫁者七人，闺门之内，般乐奢汏，以齐之分奉之而不足；外事则诈邾。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "仲尼第七"
  },
  {
    "id": "xz-70",
    "text": "教诲开导成王，使谕于道，而能掩迹于文、武。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "儒效第八"
  },
  {
    "id": "xz-71",
    "text": "虽王公士大夫之子孙也，不能属于礼义，则归之庶人。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王制第九"
  },
  {
    "id": "xz-72",
    "text": "皆有可也，知愚同；所可异也，知愚分。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "富国第十"
  },
  {
    "id": "xz-73",
    "text": "故人主天下之利埶也，然而不能自安也，安之者必将道也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王霸第十一"
  },
  {
    "id": "xz-74",
    "text": "法者、治之端也；君子者、法之原也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君道第十二"
  },
  {
    "id": "xz-75",
    "text": "上不忠乎君，下善取誉乎民，不恤公道通义，朋党比周，以环主图私为务，是篡臣者也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "臣道第十三"
  },
  {
    "id": "xz-76",
    "text": "川渊深而鱼鳖归之，山林茂而禽兽归之，刑政平而百姓归之，礼义备而君子归之。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "致士第十四"
  },
  {
    "id": "xz-77",
    "text": "孙卿子曰：不然！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "议兵第十五"
  },
  {
    "id": "xz-78",
    "text": "剥脱之，砥厉之，则劙盘盂，刎牛马，忽然耳。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "强国第十六"
  },
  {
    "id": "xz-79",
    "text": "疆本而节用，则天不能贫；养备而动时，则天不能病；循道而不忒，则天不能祸。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "天论第十七"
  },
  {
    "id": "xz-80",
    "text": "彼将听唱而应，视仪而动；唱默则民无应也，仪隐则下无动也；不应不动，则上下无以相有也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正论第十八"
  },
  {
    "id": "xz-81",
    "text": "求而无度量分界，则不能不争；争则乱，乱则穷。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "礼论第十九"
  },
  {
    "id": "xz-82",
    "text": "故人不能不乐，乐则不能无形，形而不为道，则不能无乱。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "乐论第二十"
  },
  {
    "id": "xz-83",
    "text": "天下无二道，圣人无两心。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "解蔽二十一"
  },
  {
    "id": "xz-84",
    "text": "性之好、恶、喜、怒、哀、乐谓之情。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正名第二十二"
  },
  {
    "id": "xz-85",
    "text": "然则从人之性，顺人之情，必出于争夺，合于犯分乱理，而归于暴。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "性恶第二十三"
  },
  {
    "id": "xz-86",
    "text": "足能行，待相者然后进；口能言，待官人然后诏。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君子第二十四"
  },
  {
    "id": "xz-87",
    "text": "请布基，慎圣人，愚而自专事不治。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "成相第二十五"
  },
  {
    "id": "xz-88",
    "text": "城郭以固，三军以强。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "赋第二十六"
  },
  {
    "id": "xz-89",
    "text": "天子外屏，诸侯内屏，礼也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "大略第二十七"
  },
  {
    "id": "xz-90",
    "text": "孔子顾谓弟子曰：注水焉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "宥坐第二十八"
  },
  {
    "id": "xz-91",
    "text": "虽尧舜不能加毫末于是矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "子道第二十九"
  },
  {
    "id": "xz-92",
    "text": "曾子曰：无内人之疏而外人之亲，无身不善而怨人，无刑己至而呼天。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "法行第三十"
  },
  {
    "id": "xz-93",
    "text": "孔子对曰：不必然，夫端衣玄裳，絻而乘路者，志不在于食荤；斩衰菅屦，杖而啜粥者，志不在于酒肉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "哀公第三十一"
  },
  {
    "id": "xz-94",
    "text": "夫有何足致也！",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "尧问第三十二"
  },
  {
    "id": "xz-95",
    "text": "故木受绳则直，金就砺则利，君子博学而日参省乎己，则知明而行无过矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "劝学第一"
  },
  {
    "id": "xz-96",
    "text": "故君子隆师而亲友，以致恶其贼。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "修身第二"
  },
  {
    "id": "xz-97",
    "text": "盗跖吟口，名声若日月，与舜、禹俱传而不息；然而君子不贵者，非礼义之中也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "不苟第三"
  },
  {
    "id": "xz-98",
    "text": "故薄薄之地，不得履之，非地不安也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "荣辱第四"
  },
  {
    "id": "xz-99",
    "text": "故相形不如论心，论心不如择术；形不胜心，心不胜术。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非相第五"
  },
  {
    "id": "xz-100",
    "text": "不知壹天下、建国家之权称，上功用、大俭约而僈差等，曾不足以容辨异，县君臣；然而其持之有故，其言之成理，足以欺惑愚众，是墨翟、宋钘也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "非十二子"
  },
  {
    "id": "xz-101",
    "text": "袭莒，并国三十五。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "仲尼第七"
  },
  {
    "id": "xz-102",
    "text": "周公归周，反籍于成王，而天下不辍事周，然而周公北面而朝之。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "儒效第八"
  },
  {
    "id": "xz-103",
    "text": "虽庶人之子孙也，积文学，正身行，能属于礼义，则归之卿相士大夫。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王制第九"
  },
  {
    "id": "xz-104",
    "text": "埶同而知异，行私而无祸，纵欲而不穷，则民心奋而不可说也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "富国第十"
  },
  {
    "id": "xz-105",
    "text": "故用国者，义立而王，信立而霸，权谋立而亡。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "王霸第十一"
  },
  {
    "id": "xz-106",
    "text": "故有君子，则法虽省，足以遍矣；无君子，则法虽具，失先后之施，不能应事之变，足以乱矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君道第十二"
  },
  {
    "id": "xz-107",
    "text": "内足使以一民，外足使以距难，民亲之，士信之，上忠乎君，下爱百姓而不倦，是功臣者也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "臣道第十三"
  },
  {
    "id": "xz-108",
    "text": "故礼及身而行修，义及国而政明，能以礼挟而贵名白，天下愿，令行禁止，王者之事毕矣。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "致士第十四"
  },
  {
    "id": "xz-109",
    "text": "臣所闻古之道，凡用兵攻战之本，在乎壹民。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "议兵第十五"
  },
  {
    "id": "xz-110",
    "text": "彼国者，亦强国之剖刑已。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "强国第十六"
  },
  {
    "id": "xz-111",
    "text": "故水旱不能使之饥，寒暑不能使之疾，祅怪不能使之凶。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "天论第十七"
  },
  {
    "id": "xz-112",
    "text": "不祥莫大焉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正论第十八"
  },
  {
    "id": "xz-113",
    "text": "先王恶其乱也，故制礼义以分之，以养人之欲，给人之求。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "礼论第十九"
  },
  {
    "id": "xz-114",
    "text": "先王恶其乱也，故制雅颂之声以道之，使其声足以乐而不流，使其文足以辨而不𫍰，使其曲直繁省廉肉节奏，足以感动人之善心，使夫邪污之气无由得接焉。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "乐论第二十"
  },
  {
    "id": "xz-115",
    "text": "今诸侯异政，百家异说，则必或是或非，或治或乱。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "解蔽二十一"
  },
  {
    "id": "xz-116",
    "text": "情然而心为之择谓之虑。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "正名第二十二"
  },
  {
    "id": "xz-117",
    "text": "故必将有师法之化，礼义之道，然后出于辞让，合于文理，而归于治。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "性恶第二十三"
  },
  {
    "id": "xz-118",
    "text": "不视而见，不听而聪，不言而信，不虑而知，不动而功，告至备也。",
    "source": "《荀子》",
    "book": "荀子",
    "chapter": "君子第二十四"
  }
]