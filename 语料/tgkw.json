[
  {
    "id": "tgkw-1",
    "text": "天覆地载，物数号万，而事亦因之，曲成而不遗，岂人力也哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-2",
    "text": "宋子曰：上古神农氏若存若亡，然味其徽号两言至今存矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-3",
    "text": "宋子曰：人为万物之灵，五官百体，赅而存焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-4",
    "text": "宋子曰：霄汉之间云霞异色，阎浮之内花叶殊形。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-5",
    "text": "宋子曰：天生五谷以育民，美在其中，有黄裳之意焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  },
  {
    "id": "tgkw-6",
    "text": "宋子曰：天有五气，是生五味。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "作咸第六"
  },
  {
    "id": "tgkw-7",
    "text": "宋子曰：气至于芳，色至于<青色>，味至于甘，人之大欲存焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "甘嗜第七"
  },
  {
    "id": "tgkw-8",
    "text": "宋子曰：水火既济而土合。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "陶埏第八"
  },
  {
    "id": "tgkw-9",
    "text": "宋子曰：首山之采，肇自轩辕，源流远矣哉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "冶铸第九"
  },
  {
    "id": "tgkw-10",
    "text": "宋子曰：人群分而物异产，来往懋迁以成宇宙。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "舟车第十"
  },
  {
    "id": "tgkw-11",
    "text": "宋子曰：金木受攻而物象曲成。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "锤锻第十一"
  },
  {
    "id": "tgkw-12",
    "text": "宋子曰：五行之内，土为万物之母。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "燔石第十二"
  },
  {
    "id": "tgkw-13",
    "text": "宋子曰：天道平分昼夜，而人工继晷以襄事，岂好劳而恶逸哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "膏液第十三"
  },
  {
    "id": "tgkw-14",
    "text": "宋子曰：物象精华，乾坤微妙，古传今而华达夷，使后起含生，目授而心识之，承载者以何物哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "杀青第十四"
  },
  {
    "id": "tgkw-15",
    "text": "宋子曰：人有十等，自王公至于舆台，缺一焉而人纪不立矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "五金第十五"
  },
  {
    "id": "tgkw-16",
    "text": "宋子曰：兵非圣人之得已也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "佳兵第十六"
  },
  {
    "id": "tgkw-17",
    "text": "宋子曰：斯文千古之不坠也，注玄尚白，其功孰与京哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "丹青第十七"
  },
  {
    "id": "tgkw-18",
    "text": "宋子曰：狱讼日繁，酒流生祸，其源则何辜！",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "曲蘖第十八"
  },
  {
    "id": "tgkw-19",
    "text": "宋子曰：玉韫山辉，珠涵水媚，此理诚然乎哉，抑意逆之说也？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "珠玉第十九"
  },
  {
    "id": "tgkw-20",
    "text": "事物而既万矣，必待口授目成而后识之，其与几何？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-21",
    "text": "生人不能久生而五谷生之，五谷不能自生而生人生之。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-22",
    "text": "贵者垂衣裳，煌煌山龙，以治天下。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-23",
    "text": "天垂象而圣人则之，以五彩彰施于五色，有虞氏岂无所用其心哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-24",
    "text": "稻以糠为甲，麦以<麦夫>为衣，粟、粱、黍、稷毛羽隐然。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  },
  {
    "id": "tgkw-25",
    "text": "润下作咸，王访箕子而首闻其义焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "作咸第六"
  },
  {
    "id": "tgkw-26",
    "text": "芳而烈，<青色>而艳，甘而甜，则造物有尤异之思矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "甘嗜第七"
  },
  {
    "id": "tgkw-27",
    "text": "万室之国，日勤千有而不足，民用亦繁矣哉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "陶埏第八"
  },
  {
    "id": "tgkw-28",
    "text": "九牧贡金，用襄禹鼎，从此火金功用日异而月新矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "冶铸第九"
  },
  {
    "id": "tgkw-29",
    "text": "人有贵而必出，行畏周行；物有贱而必须，坐穷负贩。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "舟车第十"
  },
  {
    "id": "tgkw-30",
    "text": "世无利器，即般、倕安所施其巧哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "锤锻第十一"
  },
  {
    "id": "tgkw-31",
    "text": "子之贵者，岂惟五金哉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "燔石第十二"
  },
  {
    "id": "tgkw-32",
    "text": "使织女燃薪，书生映雪，所济成何事也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "膏液第十三"
  },
  {
    "id": "tgkw-33",
    "text": "大地生五金以利用天下与后世，其义亦犹是也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "五金第十五"
  },
  {
    "id": "tgkw-34",
    "text": "虞舜在位五十载，而有苗犹弗率。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "佳兵第十六"
  },
  {
    "id": "tgkw-35",
    "text": "离火红而至黑孕其中，水银白而至红呈其变。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "丹青第十七"
  },
  {
    "id": "tgkw-36",
    "text": "祀天追远，沉吟商倾、周雅之间，若作酒醴之资曲蘖也，殆圣作而明述矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "曲蘖第十八"
  },
  {
    "id": "tgkw-37",
    "text": "大凡天地生物，光明者昏浊之反，滋润者枯涩之仇，贵在此则贱在彼矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "珠玉第十九"
  },
  {
    "id": "tgkw-38",
    "text": "万事万物之中，其无益生人与有益者，各载其半；世有聪明博物者，稠人推焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-39",
    "text": "土脉历时代而异，种性随水土而分。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-40",
    "text": "贱者短褐、枲裳，冬以御寒，夏以蔽体，以自别于禽兽。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-41",
    "text": "飞禽众而凤则丹，走兽盈而麟则碧，夫林林青衣，望阙而拜黄朱也，其义亦犹是矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-42",
    "text": "播精而择粹，其道宁终秘也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  },
  {
    "id": "tgkw-43",
    "text": "口之于味也，辛酸甘苦经年绝一无恙。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "作咸第六"
  },
  {
    "id": "tgkw-44",
    "text": "世间作甘之味什八产于草木，而飞虫竭力争衡，采取百花酿成佳味，使草木无全功。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "甘嗜第七"
  },
  {
    "id": "tgkw-45",
    "text": "上栋下室以避风雨，而瓴建焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "陶埏第八"
  },
  {
    "id": "tgkw-46",
    "text": "夫金之生也，以土为母，及其成形而效用于世也，母模子肖，亦犹是焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "冶铸第九"
  },
  {
    "id": "tgkw-47",
    "text": "四海之内，南资舟而北资车。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "舟车第十"
  },
  {
    "id": "tgkw-48",
    "text": "五兵之内，六乐之中，微钳锤之奏功也，生杀之机泯然矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "锤锻第十一"
  },
  {
    "id": "tgkw-49",
    "text": "金与水相守而流，功用谓莫尚焉矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "燔石第十二"
  },
  {
    "id": "tgkw-50",
    "text": "草木之实，其中韫藏膏液，而不能自流。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "膏液第十三"
  },
  {
    "id": "tgkw-51",
    "text": "持寸符，握半卷，终事诠旨，风行而冰释焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "杀青第十四"
  },
  {
    "id": "tgkw-52",
    "text": "贵者千里一生，促亦五六百里而生；贱者舟车稍艰之国，其土必广生焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "五金第十五"
  },
  {
    "id": "tgkw-53",
    "text": "明王圣帝，谁能去兵哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "佳兵第十六"
  },
  {
    "id": "tgkw-54",
    "text": "造化炉锤，思议何所容也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "丹青第十七"
  },
  {
    "id": "tgkw-55",
    "text": "惟是五谷菁华变幻，得水而凝，感风而化，供用岐黄者神其名，而坚固食羞者丹其色。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "曲蘖第十八"
  },
  {
    "id": "tgkw-56",
    "text": "合浦、于阗行程相去二万里，珠雄于此，玉峙于彼，无胫而来，以宠爱人寰之中，而辉煌廊庙之上，使中华无端宝藏折节而推上坐焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "珠玉第十九"
  },
  {
    "id": "tgkw-57",
    "text": "画工好图鬼魅而恶犬马，即郑侨、晋华，岂足为烈哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-58",
    "text": "不然，神农去陶唐，粒食已千年矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-59",
    "text": "是故其质则造物之所具也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-60",
    "text": "君子曰：甘受和，白受采。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-61",
    "text": "饮食而知味者，食不厌精。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  },
  {
    "id": "tgkw-62",
    "text": "独食盐禁戒旬日，则缚鸡胜匹倦怠恹然。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "作咸第六"
  },
  {
    "id": "tgkw-63",
    "text": "孰主张是，而颐养遍于天下哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "甘嗜第七"
  },
  {
    "id": "tgkw-64",
    "text": "王公设险以守其国，而城垣雉堞，寇来不可上矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "陶埏第八"
  },
  {
    "id": "tgkw-65",
    "text": "精粗巨细之间，但见钝者司舂，利者司垦，薄其身以媒合水火而百姓繁，虚其腹以振荡空灵而八音起。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "冶铸第九"
  },
  {
    "id": "tgkw-66",
    "text": "梯航万国，能使帝京元气充然。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "舟车第十"
  },
  {
    "id": "tgkw-67",
    "text": "同出洪炉烈火，大小殊形。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "锤锻第十一"
  },
  {
    "id": "tgkw-68",
    "text": "石得燔而成功，盖愈出而愈奇焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "燔石第十二"
  },
  {
    "id": "tgkw-69",
    "text": "假媒水火，冯藉木石，而后倾注而出焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "膏液第十三"
  },
  {
    "id": "tgkw-70",
    "text": "覆载之间之藉有楮先生也，圣顽咸嘉赖之矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "杀青第十四"
  },
  {
    "id": "tgkw-71",
    "text": "黄金美者，其值去黑铁一万六千倍，然使釜、鬵、斤、斧不呈效于日用之间，即得黄金，直高而无民耳。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "五金第十五"
  },
  {
    "id": "tgkw-72",
    "text": "弧矢之利，以威天下，其来尚矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "佳兵第十六"
  },
  {
    "id": "tgkw-73",
    "text": "五章遥降，朱临黑而大号彰。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "丹青第十七"
  },
  {
    "id": "tgkw-74",
    "text": "君臣自古配合日新，眉寿介而宿痼怯，其功不可殚述。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "曲蘖第十八"
  },
  {
    "id": "tgkw-75",
    "text": "岂中国辉山、媚水者，萃在人身，而天地菁华止有此数哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "珠玉第十九"
  },
  {
    "id": "tgkw-76",
    "text": "幸生圣明极盛之世，滇南车马，纵贯辽阳；岭徼官商，横游蓟北。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-77",
    "text": "耒耜之利，以教天下，岂有隐焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-78",
    "text": "属草木者，为枲、麻、苘、葛，属禽兽与昆虫者为裘褐、丝绵。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-79",
    "text": "世间丝、麻、裘、褐皆具素质，而使殊颜异色得以尚焉，谓造物不劳心者，吾不信也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-80",
    "text": "杵臼之利，万民以济，盖取诸小过。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  },
  {
    "id": "tgkw-81",
    "text": "岂非天一生水，而此味为生人生气之源哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "作咸第六"
  },
  {
    "id": "tgkw-82",
    "text": "凡甘蔗有二种，产繁闽、广间，他方合并得其什一而已。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "甘嗜第七"
  },
  {
    "id": "tgkw-83",
    "text": "泥瓮坚而醴酒欲清，瓦登洁而醯醢以荐。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "陶埏第八"
  },
  {
    "id": "tgkw-84",
    "text": "愿者肖仙梵之身，而尘凡有至象。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "冶铸第九"
  },
  {
    "id": "tgkw-85",
    "text": "何其始造舟车者不食尸祝之报也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "舟车第十"
  },
  {
    "id": "tgkw-86",
    "text": "重千钧者系巨舰于狂渊。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "锤锻第十一"
  },
  {
    "id": "tgkw-87",
    "text": "水浸淫而败物，有隙必攻，所谓不遗丝发者。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "燔石第十二"
  },
  {
    "id": "tgkw-88",
    "text": "此人巧聪明，不知于何禀度也。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "膏液第十三"
  },
  {
    "id": "tgkw-89",
    "text": "身为竹骨为与木皮，杀其青而白乃见，万卷百家基从此起。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "杀青第十四"
  },
  {
    "id": "tgkw-90",
    "text": "懋迁有无，货居周官泉府，万物司命系焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "五金第十五"
  },
  {
    "id": "tgkw-91",
    "text": "为老氏者，有葛天之思焉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "佳兵第十六"
  },
  {
    "id": "tgkw-92",
    "text": "万卷横披，墨得朱而天章焕。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "丹青第十七"
  },
  {
    "id": "tgkw-93",
    "text": "自非炎黄作祖、末流聪明，乌能竟其方术哉。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "曲蘖第十八"
  },
  {
    "id": "tgkw-94",
    "text": "凡珍珠必产蚌腹，映月成胎，经年最久，乃为至宝。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "珠玉第十九"
  },
  {
    "id": "tgkw-95",
    "text": "为方万里中，何事何物，不可见见闻闻。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "序第一"
  },
  {
    "id": "tgkw-96",
    "text": "纨绔之子，以赭衣视笠蓑；经生之家，以农夫为诟詈。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃粒第二"
  },
  {
    "id": "tgkw-97",
    "text": "各载其半，而裳服充焉矣。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "乃服第三"
  },
  {
    "id": "tgkw-98",
    "text": "大红色、其质红花饼一味，用乌梅水煎出。",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "彰施第四"
  },
  {
    "id": "tgkw-99",
    "text": "为此者岂非人貌而天者哉？",
    "source": "《天工开物》",
    "book": "天工开物",
    "chapter": "粹精第五"
  }
]