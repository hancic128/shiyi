[
  {
    "id": "xj-1",
    "text": "仲尼居，曾子侍。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-2",
    "text": "子曰：爱亲者，不敢恶于人；敬亲者，不敢慢于人。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "天子第二"
  },
  {
    "id": "xj-3",
    "text": "在上不骄，高而不危；制节谨度，满而不溢。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-4",
    "text": "非先王之法服不敢服，非先王之法言不敢道，非先王之德行不敢行。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-5",
    "text": "资于事父以事母，而爱同；资于事父以事君，而敬同。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-6",
    "text": "用天之道，分地之利，谨身节用，以养父母，此庶人之孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "庶人第六"
  },
  {
    "id": "xj-7",
    "text": "曾子曰：甚哉，孝之大也！",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-8",
    "text": "子曰：昔者明王之以孝治天下也，不敢遗小国之臣，而况于公、侯、伯、子、男乎？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-9",
    "text": "曾子曰：敢问圣人之德，无以加于孝乎？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-10",
    "text": "子曰：孝子之事亲也，居则致其敬，养则致其乐，病则致其忧，丧则致其哀，祭则致其严。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "纪孝行第十"
  },
  {
    "id": "xj-11",
    "text": "子曰：五刑之属三千，而罪莫大于不孝。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "五刑第十一"
  },
  {
    "id": "xj-12",
    "text": "子曰：教民亲爱，莫善于孝。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-13",
    "text": "子曰：君子之教以孝也，非家至而日见之也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-14",
    "text": "子曰：君子之事亲孝，故忠可移于君。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广扬名第十四"
  },
  {
    "id": "xj-15",
    "text": "曾子曰：若夫慈爱、恭敬、安亲、扬名，则闻命矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-16",
    "text": "子曰：昔者明王事父孝，故事天明；事母孝，故事地察；长幼顺，故上下治。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-17",
    "text": "子曰：君子之事上也，进思尽忠，退思补过，将顺其美，匡救其恶，故上下能相亲也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "事君第十七"
  },
  {
    "id": "xj-18",
    "text": "子曰：孝子之丧亲也，哭不偯，礼无容，言不文，服美不安，闻乐不乐，食旨不甘，此哀戚之情也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-19",
    "text": "子曰：先王有至德要道，以顺天下，民用和睦，上下无怨。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-20",
    "text": "爱敬尽于事亲，而德教加于百姓，刑于四海。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "天子第二"
  },
  {
    "id": "xj-21",
    "text": "高而不危，所以长守贵也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-22",
    "text": "是故非法不言，非道不行；口无择言，身无择行。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-23",
    "text": "故母取其爱，而君取其敬，兼之者父也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-24",
    "text": "故自天子至于庶人，孝无终始，而患不及者，未之有也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "庶人第六"
  },
  {
    "id": "xj-25",
    "text": "子曰：夫孝，天之经也，地之义也，民之行也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-26",
    "text": "故得万国之欢心，以事其先王。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-27",
    "text": "子曰：天地之性，人为贵。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-28",
    "text": "五者备矣，然后能事亲。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "纪孝行第十"
  },
  {
    "id": "xj-29",
    "text": "要君者无上，非圣人者无法，非孝者无亲。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "五刑第十一"
  },
  {
    "id": "xj-30",
    "text": "教民礼顺，莫善于悌。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-31",
    "text": "教以孝，所以敬天下之为人父者也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-32",
    "text": "事兄悌，故顺可移于长。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广扬名第十四"
  },
  {
    "id": "xj-33",
    "text": "敢问子从父之令，可谓孝乎？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-34",
    "text": "天地明察，神明彰矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-35",
    "text": "诗云：‘心乎爱矣，遐不谓矣，中心藏之，何日忘之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "事君第十七"
  },
  {
    "id": "xj-36",
    "text": "三日而食，教民无以死伤生。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-37",
    "text": "曾子避席曰：参不敏，何足以知之？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-38",
    "text": "盖天子之孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "天子第二"
  },
  {
    "id": "xj-39",
    "text": "满而不溢，所以长守富也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-40",
    "text": "言满天下无口过，行满天下无怨恶。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-41",
    "text": "故以孝事君则忠，以敬事长则顺。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-42",
    "text": "天地之经，而民是则之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-43",
    "text": "治国者，不敢侮于鳏寡，而况于士民乎？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-44",
    "text": "人之行，莫大于孝。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-45",
    "text": "事亲者，居上不骄，为下不乱，在丑不争。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "纪孝行第十"
  },
  {
    "id": "xj-46",
    "text": "此大乱之道也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "五刑第十一"
  },
  {
    "id": "xj-47",
    "text": "移风易俗，莫善于乐。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-48",
    "text": "教以悌，所以敬天下之为人兄者也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-49",
    "text": "居家理，故治可移于官。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广扬名第十四"
  },
  {
    "id": "xj-50",
    "text": "子曰：是何言与，是何言与！",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-51",
    "text": "故虽天子，必有尊也，言有父也；必有先也，言有兄也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-52",
    "text": "毁不灭性，此圣人之政也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-53",
    "text": "子曰：夫孝，德之本也，教之所由生也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-54",
    "text": "甫刑云：一人有庆，兆民赖之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "天子第二"
  },
  {
    "id": "xj-55",
    "text": "富贵不离其身，然后能保其社稷，而和其民人。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-56",
    "text": "三者备矣，然后能守其宗庙。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-57",
    "text": "忠顺不失，以事其上，然后能保其禄位，而守其祭祀。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-58",
    "text": "是以其教不肃而成，其政不严而治。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-59",
    "text": "故得百姓之欢心，以事其先君。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-60",
    "text": "孝莫大于严父。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-61",
    "text": "居上而骄则亡，为下而乱则刑，在丑而争则兵。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "纪孝行第十"
  },
  {
    "id": "xj-62",
    "text": "安上治民，莫善于礼。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-63",
    "text": "教以臣，所以敬天下之为人君者也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-64",
    "text": "是以行成于内，而名立于后世矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广扬名第十四"
  },
  {
    "id": "xj-65",
    "text": "昔者天子有争臣七人，虽无道，不失其天下；诸侯有争臣五人，虽无道，不失其国；大夫有争臣三人，虽无道，不失其家；士有争友，则身不离于令名；父有争子，则身不陷于不义。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-66",
    "text": "宗庙致敬，不忘亲也；修身慎行，恐辱先也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-67",
    "text": "丧不过三年，示民有终也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-68",
    "text": "复坐，吾语汝。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-69",
    "text": "盖诸侯之孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-70",
    "text": "盖卿、大夫之孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-71",
    "text": "盖士之孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-72",
    "text": "先王见教之可以化民也，是故先之以博爱，而民莫遗其亲；陈之以德义，而民兴行。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-73",
    "text": "治家者，不敢失于臣妾，而况于妻子乎？",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-74",
    "text": "严父莫大于配天，则周公其人也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-75",
    "text": "三者不除，虽日用三牲之养，犹为不孝也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "纪孝行第十"
  },
  {
    "id": "xj-76",
    "text": "礼者，敬而已矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-77",
    "text": "诗云：‘恺悌君子，民之父母。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-78",
    "text": "故当不义，则子不可以不争于父，臣不可以不争于君；故当不义，则争之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-79",
    "text": "宗庙致敬，鬼神著矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-80",
    "text": "为之棺椁衣衾而举之，陈其簠簋而哀戚之；擗踊哭泣，哀以送之；卜其宅兆，而安措之；为之宗庙，以鬼享之；春秋祭祀，以时思之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-81",
    "text": "身体发肤，受之父母，不敢毁伤，孝之始也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-82",
    "text": "诗云：战战兢兢，如临深渊，如履薄冰。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "诸侯第三"
  },
  {
    "id": "xj-83",
    "text": "诗云：夙夜匪懈，以事一人。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "卿大夫第四"
  },
  {
    "id": "xj-84",
    "text": "诗云：夙兴夜寐，无忝尔所生。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "士第五"
  },
  {
    "id": "xj-85",
    "text": "先之以敬让，而民不争；导之以礼乐，而民和睦；示之以好恶，而民知禁。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-86",
    "text": "故得人之欢心，以事其亲。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-87",
    "text": "昔者，周公郊祀后稷以配天，宗祀文王于明堂，以配上帝。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-88",
    "text": "故敬其父，则子悦；敬其兄，则弟悦；敬其君，则臣悦；敬一人，而千万人悦。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-89",
    "text": "’非至德，其孰能顺民如此其大者乎！",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广至德第十三"
  },
  {
    "id": "xj-90",
    "text": "从父之令，又焉得为孝乎！",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "谏诤第十五"
  },
  {
    "id": "xj-91",
    "text": "孝悌之至，通于神明，光于四海，无所不通。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-92",
    "text": "生事爱敬，死事哀戚，生民之本尽矣，死生之义备矣，孝子之事亲终矣。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "丧亲第十八"
  },
  {
    "id": "xj-93",
    "text": "立身行道，扬名于后世，以显父母，孝之终也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-94",
    "text": "诗云：‘赫赫师尹，民具尔瞻。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "三才第七"
  },
  {
    "id": "xj-95",
    "text": "夫然，故生则亲安之，祭则鬼享之。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  },
  {
    "id": "xj-96",
    "text": "是以四海之内，各以其职来祭。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "圣治第九"
  },
  {
    "id": "xj-97",
    "text": "所敬者寡，而悦者众，此之谓要道也。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "广要道第十二"
  },
  {
    "id": "xj-98",
    "text": "诗云：‘自西自东，自南自北，无思不服。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "感应第十六"
  },
  {
    "id": "xj-99",
    "text": "夫孝，始于事亲，中于事君，终于立身。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "开宗明义第一"
  },
  {
    "id": "xj-100",
    "text": "是以天下和平，灾害不生，祸乱不作。",
    "source": "《孝经》",
    "book": "孝经",
    "chapter": "孝治第八"
  }
]