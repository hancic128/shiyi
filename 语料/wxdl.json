[
  {
    "id": "wxdl-1",
    "text": "文之为德也大矣，与天地并生者。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "原道第一"
  },
  {
    "id": "wxdl-2",
    "text": "夫作者曰圣，述者曰明。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "征圣第二"
  },
  {
    "id": "wxdl-3",
    "text": "三极彝训，其书言经​。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "宗经第三"
  },
  {
    "id": "wxdl-4",
    "text": "夫神道阐幽，天命微显，马龙出而大易兴，神龟见而洪范耀，故系辞称河出图，洛出书，圣人则之，斯之谓也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "正纬第四"
  },
  {
    "id": "wxdl-5",
    "text": "自风雅寝声，莫或抽绪，奇文郁起，其离骚哉！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "辨骚第五"
  },
  {
    "id": "wxdl-6",
    "text": "大舜云∶诗言志，歌永言。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "明诗第六"
  },
  {
    "id": "wxdl-7",
    "text": "乐府者，声依永，律和声也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "乐府第七"
  },
  {
    "id": "wxdl-8",
    "text": "诗有六义，其二曰赋。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诠赋第八"
  },
  {
    "id": "wxdl-9",
    "text": "四始之至，颂居其极。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "颂赞第九"
  },
  {
    "id": "wxdl-10",
    "text": "天地定位，祀遍群神，六宗既禋，三望咸秩，甘雨和风，是生黍稷，兆民所仰，美报兴焉！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "祝盟第十"
  },
  {
    "id": "wxdl-11",
    "text": "昔帝轩刻舆几以弼违，大禹勒笋虡而招谏。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "铭箴第十一"
  },
  {
    "id": "wxdl-12",
    "text": "周世盛德，有铭诔之文。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诔碑第十二"
  },
  {
    "id": "wxdl-13",
    "text": "赋宪之谥，短折曰哀。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "哀吊第十三"
  },
  {
    "id": "wxdl-14",
    "text": "智术之子，博雅之人，藻溢于辞，辩盈乎气。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "杂文第十四"
  },
  {
    "id": "wxdl-15",
    "text": "芮良夫之诗云∶自有肺肠，俾民卒狂。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "谐讔第十五"
  },
  {
    "id": "wxdl-16",
    "text": "开辟草昧，岁纪绵邈，居今识古，其载籍乎？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "史传第十六"
  },
  {
    "id": "wxdl-17",
    "text": "诸子者，入道见志之书。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诸子第十七"
  },
  {
    "id": "wxdl-18",
    "text": "圣哲彝训曰经，述经叙理曰论。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "论说第十八"
  },
  {
    "id": "wxdl-19",
    "text": "皇帝御宇，其言也神。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诏策第十九"
  },
  {
    "id": "wxdl-20",
    "text": "震雷始于曜电，出师先乎威声。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "檄移第二十"
  },
  {
    "id": "wxdl-21",
    "text": "夫正位北辰，向明南面，所以运天枢，毓黎献者，何尝不经道纬德，以勒皇迹者哉？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "封禅第二十一"
  },
  {
    "id": "wxdl-22",
    "text": "夫设官分职，高卑联事。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "章表第二十二"
  },
  {
    "id": "wxdl-23",
    "text": "昔唐虞之臣，敷奏以言；秦汉之辅，上书称奏。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "奏启第二十三"
  },
  {
    "id": "wxdl-24",
    "text": "周爰咨谋，是谓为议。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "议对第二十四"
  },
  {
    "id": "wxdl-25",
    "text": "大舜云∶书用识哉！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "书记第二十五"
  },
  {
    "id": "wxdl-26",
    "text": "古人云：形在江海之上，心存魏阙之下。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "神思第二十六"
  },
  {
    "id": "wxdl-27",
    "text": "夫情动而言形，理发而文见，盖沿隐以至显，因内而符外者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "体性第二十七"
  },
  {
    "id": "wxdl-28",
    "text": "诗总六义，风冠其首，斯乃化感之本源，志气之符契也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "风骨第二十八"
  },
  {
    "id": "wxdl-29",
    "text": "夫设文之体有常，变文之数无方，何以明其然耶？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "通变第二十九"
  },
  {
    "id": "wxdl-30",
    "text": "夫情致异区，文变殊术，莫不因情立体，即体成势也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "定势第三十"
  },
  {
    "id": "wxdl-31",
    "text": "圣贤书辞，总称文章，非采而何？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "情采第三十一"
  },
  {
    "id": "wxdl-32",
    "text": "情理设位，文采行乎其中。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "熔裁第三十二"
  },
  {
    "id": "wxdl-33",
    "text": "夫音律所始，本于人声者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "声律第三十三"
  },
  {
    "id": "wxdl-34",
    "text": "夫设情有宅，置言有位；宅情曰章，位言曰句。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "章句第三十四"
  },
  {
    "id": "wxdl-35",
    "text": "造化赋形，支体必双，神理为用，事不孤立。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "丽辞第三十五"
  },
  {
    "id": "wxdl-36",
    "text": "诗文宏奥，包韫六义；毛公述传，独标兴体，岂不以风通而赋同，比显而兴隐哉？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "比兴第三十六"
  },
  {
    "id": "wxdl-37",
    "text": "夫形而上者谓之道，形而下者谓之器。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "夸饰第三十七"
  },
  {
    "id": "wxdl-38",
    "text": "事类者，盖文章之外，据事以类义，援古以证今者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "事类第三十八"
  },
  {
    "id": "wxdl-39",
    "text": "夫文象列而结绳移，鸟迹明而书契作，斯乃言语之体貌，而文章之宅宇也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "练字第三十九"
  },
  {
    "id": "wxdl-40",
    "text": "夫心术之动远矣，文情之变深矣，源奥而派生，根盛而颖峻，是以文之英蕤，有秀有隐。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "隐秀第四十"
  },
  {
    "id": "wxdl-41",
    "text": "管仲有言∶无翼而飞者声也；无根而固者情也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "指瑕第四十一"
  },
  {
    "id": "wxdl-42",
    "text": "昔王充著述，制养气之篇，验己而作，岂虚造哉！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "养气第四十二"
  },
  {
    "id": "wxdl-43",
    "text": "谓总文理，统首尾，定与夺，合涯际，弥纶一篇，使杂而不越者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "附会第四十三"
  },
  {
    "id": "wxdl-44",
    "text": "今之常言，有文有笔，以为无韵者笔也，有韵者文也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "总术第四十四"
  },
  {
    "id": "wxdl-45",
    "text": "时运交移，质文代变，古今情理，如可言乎？",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "时序第四十五"
  },
  {
    "id": "wxdl-46",
    "text": "春秋代序，阴阳惨舒，物色之动，心亦摇焉。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "物色第四十六"
  },
  {
    "id": "wxdl-47",
    "text": "九代之文，富矣盛矣；其辞令华采，可略而详也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "才略第四十七"
  },
  {
    "id": "wxdl-48",
    "text": "知音其难哉！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "知音第四十八"
  },
  {
    "id": "wxdl-49",
    "text": "周书论士，方之梓材，盖贵器用而兼文采也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "程器第四十九"
  },
  {
    "id": "wxdl-50",
    "text": "夫文心者，言为文之用心也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "序志第五十"
  },
  {
    "id": "wxdl-51",
    "text": "夫玄黄色杂，方圆体分，日月叠璧，以垂丽天之象；山川焕绮，以铺理地之形：此盖道之文也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "原道第一"
  },
  {
    "id": "wxdl-52",
    "text": "陶铸性情，功在上哲。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "征圣第二"
  },
  {
    "id": "wxdl-53",
    "text": "​经也者，恒久之至道，不刊之鸿教也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "宗经第三"
  },
  {
    "id": "wxdl-54",
    "text": "但世夐文隐，好生矫诞，真虽存矣，伪亦凭焉。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "正纬第四"
  },
  {
    "id": "wxdl-55",
    "text": "固已轩翥诗人之后，奋飞辞家之前，岂去圣之未远，而楚人之多才乎！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "辨骚第五"
  },
  {
    "id": "wxdl-56",
    "text": "圣谟所析，义已明矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "明诗第六"
  },
  {
    "id": "wxdl-57",
    "text": "钧天九奏，既其上帝；葛天八阕，爰及皇时。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "乐府第七"
  },
  {
    "id": "wxdl-58",
    "text": "赋者，铺也，铺采攡文，体物写志也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诠赋第八"
  },
  {
    "id": "wxdl-59",
    "text": "颂者，容也，所以美盛德而述形容也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "颂赞第九"
  },
  {
    "id": "wxdl-60",
    "text": "牺盛惟馨，本于明德，祝史陈信，资乎文辞。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "祝盟第十"
  },
  {
    "id": "wxdl-61",
    "text": "成汤盘盂，著日新之规；武王户席，题必诫之训。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "铭箴第十一"
  },
  {
    "id": "wxdl-62",
    "text": "大夫之材，临丧能诔。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诔碑第十二"
  },
  {
    "id": "wxdl-63",
    "text": "哀者，依也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "哀吊第十三"
  },
  {
    "id": "wxdl-64",
    "text": "苑囿文情，故日新殊致。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "杂文第十四"
  },
  {
    "id": "wxdl-65",
    "text": "夫心险如山，口壅若川，怨怒之情不一，欢谑之言无方。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "谐讔第十五"
  },
  {
    "id": "wxdl-66",
    "text": "轩辕之世，史有仓颉，主文之职，其来久矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "史传第十六"
  },
  {
    "id": "wxdl-67",
    "text": "太上立德，其次立言。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诸子第十七"
  },
  {
    "id": "wxdl-68",
    "text": "论者，伦也；伦理无爽，则圣意不坠。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "论说第十八"
  },
  {
    "id": "wxdl-69",
    "text": "渊嘿负扆，而响盈四表，其唯诏策乎！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诏策第十九"
  },
  {
    "id": "wxdl-70",
    "text": "故观电而惧雷壮，听声而惧兵威。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "檄移第二十"
  },
  {
    "id": "wxdl-71",
    "text": "言至德所被也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "封禅第二十一"
  },
  {
    "id": "wxdl-72",
    "text": "天子垂珠以听，诸侯鸣玉以朝。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "章表第二十二"
  },
  {
    "id": "wxdl-73",
    "text": "陈政事，献典仪，上急变，劾愆谬，总谓之奏。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "奏启第二十三"
  },
  {
    "id": "wxdl-74",
    "text": "议之言宜，审事宜也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "议对第二十四"
  },
  {
    "id": "wxdl-75",
    "text": "所以记时事也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "书记第二十五"
  },
  {
    "id": "wxdl-76",
    "text": "神思之谓也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "神思第二十六"
  },
  {
    "id": "wxdl-77",
    "text": "然才有庸俊，气有刚柔，学有浅深，习有雅郑，并情性所铄，陶染所凝，是以笔区云谲，文苑波诡者矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "体性第二十七"
  },
  {
    "id": "wxdl-78",
    "text": "是以怊怅述情，必始乎风；沉吟铺辞，莫先于骨。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "风骨第二十八"
  },
  {
    "id": "wxdl-79",
    "text": "凡诗赋书记，名理相因，此有常之体也；文辞气力，通变则久，此无方之数也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "通变第二十九"
  },
  {
    "id": "wxdl-80",
    "text": "势者，乘利而为制也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "定势第三十"
  },
  {
    "id": "wxdl-81",
    "text": "夫水性虚而沦漪结，木体实而花萼振，文附质也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "情采第三十一"
  },
  {
    "id": "wxdl-82",
    "text": "刚柔以立本，变通以趋时。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "熔裁第三十二"
  },
  {
    "id": "wxdl-83",
    "text": "声合宫商，肇自血气，先王因之，以制乐歌。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "声律第三十三"
  },
  {
    "id": "wxdl-84",
    "text": "故章者，明也；句者，局也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "章句第三十四"
  },
  {
    "id": "wxdl-85",
    "text": "夫心生文辞，运裁百虑，高下相须，自然成对。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "丽辞第三十五"
  },
  {
    "id": "wxdl-86",
    "text": "故比者，附也；兴者，起也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "比兴第三十六"
  },
  {
    "id": "wxdl-87",
    "text": "神道难摹，精言不能追其极；形器易写，壮辞可得喻其真；才非短长，理自难易耳。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "夸饰第三十七"
  },
  {
    "id": "wxdl-88",
    "text": "昔文王繇易，剖判爻位。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "事类第三十八"
  },
  {
    "id": "wxdl-89",
    "text": "苍颉造之，鬼哭粟飞；黄帝用之，官治民察。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "练字第三十九"
  },
  {
    "id": "wxdl-90",
    "text": "隐也者，文外之重旨者也；秀也者，篇中之独拔者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "隐秀第四十"
  },
  {
    "id": "wxdl-91",
    "text": "然则声不假翼，其飞甚易；情不待根，其固匪难。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "指瑕第四十一"
  },
  {
    "id": "wxdl-92",
    "text": "夫耳目鼻口，生之役也；心虑言辞，神之用也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "养气第四十二"
  },
  {
    "id": "wxdl-93",
    "text": "夫才童学文，宜正体制∶必以情志为神明，事义为骨髓，辞采为肌肤，宫商为声气；然后品藻玄黄，摛振金玉，献可替否，以裁厥中：斯缀思之恒数也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "附会第四十三"
  },
  {
    "id": "wxdl-94",
    "text": "夫文以足言，理兼诗、书，别目两名，自近代耳。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "总术第四十四"
  },
  {
    "id": "wxdl-95",
    "text": "昔在陶唐，德盛化钧，野老吐何力之谈，郊童含不识之歌。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "时序第四十五"
  },
  {
    "id": "wxdl-96",
    "text": "盖阳气萌而玄驹步，阴律凝而丹鸟羞，微虫犹或入感，四时之动物深矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "物色第四十六"
  },
  {
    "id": "wxdl-97",
    "text": "虞、夏文章，则有皋陶六德，夔序八音，益则有赞，五子作歌，辞义温雅，万代之仪表也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "才略第四十七"
  },
  {
    "id": "wxdl-98",
    "text": "音实难知，知实难逢，逢其知音，千载其一乎！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "知音第四十八"
  },
  {
    "id": "wxdl-99",
    "text": "是以朴斫成而丹雘施，垣墉立而雕杇附。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "程器第四十九"
  },
  {
    "id": "wxdl-100",
    "text": "昔涓子琴心，王孙巧心，心哉美矣，故用之焉。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "序志第五十"
  },
  {
    "id": "wxdl-101",
    "text": "仰观吐曜，俯察含章，高卑定位，故两仪既生矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "原道第一"
  },
  {
    "id": "wxdl-102",
    "text": "夫子文章，可得而闻，则圣人之情，见乎文辞矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "征圣第二"
  },
  {
    "id": "wxdl-103",
    "text": "故象天地，效鬼神，参物序，制人纪，洞性灵之奥区，极文章之骨髓者也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "宗经第三"
  },
  {
    "id": "wxdl-104",
    "text": "夫六经彪炳，而纬候稠叠；孝、论昭晣，而钩谶葳蕤。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "正纬第四"
  },
  {
    "id": "wxdl-105",
    "text": "昔汉武爱骚，而淮南作传，以为：国风好色而不淫，小雅怨诽而不乱，若离骚者，可谓兼之。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "辨骚第五"
  },
  {
    "id": "wxdl-106",
    "text": "是以在心为志，发言为诗，舒文载实，其在兹乎！",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "明诗第六"
  },
  {
    "id": "wxdl-107",
    "text": "自咸、英以降，亦无得而论矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "乐府第七"
  },
  {
    "id": "wxdl-108",
    "text": "昔邵公称∶公卿献诗，师箴瞍赋。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诠赋第八"
  },
  {
    "id": "wxdl-109",
    "text": "昔帝喾之世，咸墨为颂，以歌九招。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "颂赞第九"
  },
  {
    "id": "wxdl-110",
    "text": "昔伊耆始蜡，以祭八神。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "祝盟第十"
  },
  {
    "id": "wxdl-111",
    "text": "周公慎言于金人，仲尼革容于欹器，则先圣鉴戒，其来久矣。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "铭箴第十一"
  },
  {
    "id": "wxdl-112",
    "text": "诔者，累也，累其德行，旌之不朽也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诔碑第十二"
  },
  {
    "id": "wxdl-113",
    "text": "悲实依心，故曰哀也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "哀吊第十三"
  },
  {
    "id": "wxdl-114",
    "text": "宋玉含才，颇亦负俗，始造对问，以申其志，放怀寥廓，气实使文。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "杂文第十四"
  },
  {
    "id": "wxdl-115",
    "text": "昔华元弃甲，城者发睅目之讴；臧纥丧师，国人造侏儒之歌；并嗤戏形貌，内怨为俳也。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "谐讔第十五"
  },
  {
    "id": "wxdl-116",
    "text": "曲礼曰∶史载笔。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "史传第十六"
  },
  {
    "id": "wxdl-117",
    "text": "百姓之群居，苦纷杂而莫显；君子之处世，疾名德之不章。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诸子第十七"
  },
  {
    "id": "wxdl-118",
    "text": "昔仲尼微言，门人追记，故抑其经目，称为论语。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "论说第十八"
  },
  {
    "id": "wxdl-119",
    "text": "昔轩辕唐虞，同称为命。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "诏策第十九"
  },
  {
    "id": "wxdl-120",
    "text": "兵先乎声，其来已久。",
    "source": "《文心雕龙》",
    "book": "文心雕龙",
    "chapter": "檄移第二十"
  }
]