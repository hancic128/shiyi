[
  {
    "id": "wlz-1",
    "text": "尉缭子对曰：​刑以伐之，德以守之，非所谓天官、时日、阴阳、向背也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-2",
    "text": "量土地肥硗而立邑，建城称地，以城称人，以人称粟。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵谈第二"
  },
  {
    "id": "wlz-3",
    "text": "凡兵，制必先定。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "制谈第三"
  },
  {
    "id": "wlz-4",
    "text": "凡兵，有以道胜，有以威胜，有以力胜。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战威第四"
  },
  {
    "id": "wlz-5",
    "text": "兵以静胜，国以专胜。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "攻权第五"
  },
  {
    "id": "wlz-6",
    "text": "凡守者，进不郭圉退不亭障以御战，非善者也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "守权第六"
  },
  {
    "id": "wlz-7",
    "text": "威在于不变。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "十二陵第七"
  },
  {
    "id": "wlz-8",
    "text": "凡兵不攻无过之城，不杀无罪之人。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "武议第八"
  },
  {
    "id": "wlz-9",
    "text": "凡将，理官也，万物之主也，不私于一人。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将理第九"
  },
  {
    "id": "wlz-10",
    "text": "官者，事之所主，为治之本也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "原官第十"
  },
  {
    "id": "wlz-11",
    "text": "凡治人者何？",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "治本第十一"
  },
  {
    "id": "wlz-12",
    "text": "兵法曰：​千人而成权，万人而成武。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战权第十二"
  },
  {
    "id": "wlz-13",
    "text": "将自千人以上，有战而北，守而降，离地逃众，命曰国贼。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "重刑令第十三"
  },
  {
    "id": "wlz-14",
    "text": "军中之制，五人为伍，伍相保也；十人为什，什相保也；五十为属，属相保也；百人为闾，闾相保也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "伍制令第十四"
  },
  {
    "id": "wlz-15",
    "text": "中军、左右前后军，皆有分地，方之以行垣，而无通其交往。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "分塞令第十五"
  },
  {
    "id": "wlz-16",
    "text": "束伍之令曰：五人为伍，共一符，收于将吏之所。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "束伍令第十六"
  },
  {
    "id": "wlz-17",
    "text": "经卒者，以经令分之为三分焉：左军苍旗，卒戴苍羽；右军白旗，卒戴白羽；中军黄旗，卒戴黄羽。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "经卒令第十七"
  },
  {
    "id": "wlz-18",
    "text": "金、鼓、铃、旗，四者各有法：鼓之则进，重鼓则击。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "勒卒令第十八"
  },
  {
    "id": "wlz-19",
    "text": "将军受命，君必先谋于庙，行令于廷，君身以斧钺授将，曰：左、右、中军皆有分职，若逾分而上请者死。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将令第十九"
  },
  {
    "id": "wlz-20",
    "text": "所谓踵军者，去大军百里，期于会地，为三日熟食，前军而行。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "踵军令第二十"
  },
  {
    "id": "wlz-21",
    "text": "兵之教令，分营居陈，有非令而进退者，加犯教之罪。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教上第二十一"
  },
  {
    "id": "wlz-22",
    "text": "臣闻人君有必胜之道，故能并兼广大，以一其制度，则威加天下。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教下第二十二"
  },
  {
    "id": "wlz-23",
    "text": "兵者，凶器也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令上第二十三"
  },
  {
    "id": "wlz-24",
    "text": "诸去大军为前御之备者，边县列候，相去三、五里。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令下第二十四"
  },
  {
    "id": "wlz-25",
    "text": "黄帝者，人事而已矣。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-26",
    "text": "三相称，则内可以固守，外可以战胜。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵谈第二"
  },
  {
    "id": "wlz-27",
    "text": "制先定则士不乱，士不乱则形乃明。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "制谈第三"
  },
  {
    "id": "wlz-28",
    "text": "讲武料敌，使敌之气失而师散，虽形全而不为之用，此道胜也；审法制，明赏罚，便器用，使民有必胜之心，此威胜也；破军杀将，乘发机，溃众夺地，成功乃返，此力胜也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战威第四"
  },
  {
    "id": "wlz-29",
    "text": "力分者弱，心疑者背。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "攻权第五"
  },
  {
    "id": "wlz-30",
    "text": "豪杰雄俊，坚甲利兵，劲弩强矢，尽在郭中。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "守权第六"
  },
  {
    "id": "wlz-31",
    "text": "惠在于因时。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "十二陵第七"
  },
  {
    "id": "wlz-32",
    "text": "夫杀人之父兄，利人之财货，臣妾人之子女，此皆盗也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "武议第八"
  },
  {
    "id": "wlz-33",
    "text": "夫能无私于一人，故万物至而制之，万物至而命之。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将理第九"
  },
  {
    "id": "wlz-34",
    "text": "制者，职分四民，治之分也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "原官第十"
  },
  {
    "id": "wlz-35",
    "text": "权先加人者，敌不力交。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战权第十二"
  },
  {
    "id": "wlz-36",
    "text": "身戮家残，去其籍，发其坟墓，暴其骨于市，男女公于官。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "重刑令第十三"
  },
  {
    "id": "wlz-37",
    "text": "伍有干令犯禁者，揭之，免于罪；知而弗揭，全伍有诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "伍制令第十四"
  },
  {
    "id": "wlz-38",
    "text": "将有分地，帅有分地，伯有分地，皆营其沟域，而明其塞令，使非百人无得通。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "分塞令第十五"
  },
  {
    "id": "wlz-39",
    "text": "亡伍而得伍，当之；得伍而不亡，有赏，亡伍不得伍，身死家残。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "束伍令第十六"
  },
  {
    "id": "wlz-40",
    "text": "卒有五章：前一行苍章，次二行赤章，次三行黄章，次四行白章，次五行黑章。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "经卒令第十七"
  },
  {
    "id": "wlz-41",
    "text": "金之则止，重金则退。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "勒卒令第十八"
  },
  {
    "id": "wlz-42",
    "text": "军无二令，二令者诛，留令者诛，失令者诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将令第十九"
  },
  {
    "id": "wlz-43",
    "text": "为战，合之表，合表乃起。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "踵军令第二十"
  },
  {
    "id": "wlz-44",
    "text": "前行者，前行教之；后行者，后行教之；左行者，左行教之；右行者，右行教之。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教上第二十一"
  },
  {
    "id": "wlz-45",
    "text": "此十二者教成，犯令不舍。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教下第二十二"
  },
  {
    "id": "wlz-46",
    "text": "争者，逆德也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令上第二十三"
  },
  {
    "id": "wlz-47",
    "text": "闻大军为前御之备，战则皆禁行，所以安内也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令下第二十四"
  },
  {
    "id": "wlz-48",
    "text": "今有城，东西攻不能取，南北攻不能取，四方岂无顺时乘之者邪？",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-49",
    "text": "战胜于外，备主于内，胜备相应，犹合符节，无异故也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵谈第二"
  },
  {
    "id": "wlz-50",
    "text": "金鼓所指，则百人尽斗。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "制谈第三"
  },
  {
    "id": "wlz-51",
    "text": "王侯如此，所以三胜者毕矣。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战威第四"
  },
  {
    "id": "wlz-52",
    "text": "夫力弱，故进退不豪，纵敌不擒。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "攻权第五"
  },
  {
    "id": "wlz-53",
    "text": "令客气十百倍，而主之气不半焉，敌攻者伤之甚也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "守权第六"
  },
  {
    "id": "wlz-54",
    "text": "机在于应事。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "十二陵第七"
  },
  {
    "id": "wlz-55",
    "text": "故兵者，所诛暴乱禁不义也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "武议第八"
  },
  {
    "id": "wlz-56",
    "text": "君子不救囚于五步之外，虽钩矢射之，弗追也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将理第九"
  },
  {
    "id": "wlz-57",
    "text": "贵爵富禄必称，尊卑之体也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "原官第十"
  },
  {
    "id": "wlz-58",
    "text": "故充腹有粒，盖形有缕。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "治本第十一"
  },
  {
    "id": "wlz-59",
    "text": "武先加人者，敌无威接。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战权第十二"
  },
  {
    "id": "wlz-60",
    "text": "自百人以上，有战而北，守而降，离地逃众，命曰军贼。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "重刑令第十三"
  },
  {
    "id": "wlz-61",
    "text": "什有干令犯禁者，揭之，免于罪；知而弗揭，全什有诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "伍制令第十四"
  },
  {
    "id": "wlz-62",
    "text": "非其百人而入者，伯诛之；伯不诛，与之同罪。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "分塞令第十五"
  },
  {
    "id": "wlz-63",
    "text": "亡长得长，当之；得长不亡，有赏，亡长不得长，身死家残；复战得首长，除之。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "束伍令第十六"
  },
  {
    "id": "wlz-64",
    "text": "次以经卒，亡章者有诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "经卒令第十七"
  },
  {
    "id": "wlz-65",
    "text": "旗麾之左则左，麾之右则右，奇兵则反是。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "勒卒令第十八"
  },
  {
    "id": "wlz-66",
    "text": "将军告曰：出国门之外，期日中，设营表，置辕门。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将令第十九"
  },
  {
    "id": "wlz-67",
    "text": "踵军飨士，使为之战势，是谓趋战者也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "踵军令第二十"
  },
  {
    "id": "wlz-68",
    "text": "教举五人，其甲首有赏。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教上第二十一"
  },
  {
    "id": "wlz-69",
    "text": "兵弱能强之，主卑能尊之，令弊能起之，民流能亲之，人众能治之，地大能守之。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教下第二十二"
  },
  {
    "id": "wlz-70",
    "text": "事必有本，故王者伐暴乱，本仁义焉。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令上第二十三"
  },
  {
    "id": "wlz-71",
    "text": "内卒出戍，令将吏授旗鼓戈甲。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令下第二十四"
  },
  {
    "id": "wlz-72",
    "text": "然不能取者，城高池深，兵器备具，财谷多积，豪士一谋者也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-73",
    "text": "治兵者，若秘于地，若邃于天，生于无，故开之，大不窕，小不恢。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵谈第二"
  },
  {
    "id": "wlz-74",
    "text": "陷行乱陈，则千人尽斗。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "制谈第三"
  },
  {
    "id": "wlz-75",
    "text": "夫将之所以战者，民也；民之所以战者，气也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战威第四"
  },
  {
    "id": "wlz-76",
    "text": "将吏士卒，动静一身。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "攻权第五"
  },
  {
    "id": "wlz-77",
    "text": "然而世将弗能知。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "守权第六"
  },
  {
    "id": "wlz-78",
    "text": "战在于治气。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "十二陵第七"
  },
  {
    "id": "wlz-79",
    "text": "兵之所加者，农不离其田业，贾不离其肆宅，士大夫不离其官府，由其武议在于一人。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "武议第八"
  },
  {
    "id": "wlz-80",
    "text": "​故兵贵先，胜于此，则胜彼矣；弗胜于此，则弗胜彼矣。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战权第十二"
  },
  {
    "id": "wlz-81",
    "text": "亡将得将，当之；得将不亡，有赏，亡将不得将，坐离地遁逃之法。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "束伍令第十六"
  },
  {
    "id": "wlz-82",
    "text": "期之，如过时，则坐法。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将令第十九"
  },
  {
    "id": "wlz-83",
    "text": "由是观之，天官时日，不若人事也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-84",
    "text": "故善审囚之情，不待菙楚，而囚之情可毕矣。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将理第九"
  },
  {
    "id": "wlz-85",
    "text": "好善罚恶，正比法，会计民之具也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "原官第十"
  },
  {
    "id": "wlz-86",
    "text": "夫在耘耨，妻在机杼，民无二事，即有储蓄。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "治本第十一"
  },
  {
    "id": "wlz-87",
    "text": "凡我往则彼来，彼来则我往，相为胜败，此战之理然也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战权第十二"
  },
  {
    "id": "wlz-88",
    "text": "身死家残，男女公于官。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "重刑令第十三"
  },
  {
    "id": "wlz-89",
    "text": "属有干令犯禁者，揭之，免于罪；知而弗揭，全属有诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "伍制令第十四"
  },
  {
    "id": "wlz-90",
    "text": "军中纵横之道，百有二十步，而立一府柱。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "分塞令第十五"
  },
  {
    "id": "wlz-91",
    "text": "前一五行，置章于首，次二五行，置章于项，次三五行，置章于胸，次四五行，置章于腹，次五五行，置章于腰。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "经卒令第十七"
  },
  {
    "id": "wlz-92",
    "text": "一鼓一击而左，一鼓一击而右。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "勒卒令第十八"
  },
  {
    "id": "wlz-93",
    "text": "将军入营，即闭门清道，有敢行者诛，有敢高言者诛，有敢不从令者诛。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "将令第十九"
  },
  {
    "id": "wlz-94",
    "text": "兴军者，前踵军而行，合表乃起。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "踵军令第二十"
  },
  {
    "id": "wlz-95",
    "text": "弗教，如犯教之罪。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教上第二十一"
  },
  {
    "id": "wlz-96",
    "text": "国车不出于阃，组甲不出于橐，而威服天下矣。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵教下第二十二"
  },
  {
    "id": "wlz-97",
    "text": "战国则以立威抗敌相图，故不能废兵也。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令上第二十三"
  },
  {
    "id": "wlz-98",
    "text": "发日，后将吏及出县封界者，以坐后戍法。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵令下第二十四"
  },
  {
    "id": "wlz-99",
    "text": "’武王伐纣，背济水向山阪而阵，以二万二千五百人，击纣之亿万而灭商，岂纣不得天官之陈哉！",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "天官第一"
  },
  {
    "id": "wlz-100",
    "text": "明乎禁、舍、开、塞，民流者亲之。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "兵谈第二"
  },
  {
    "id": "wlz-101",
    "text": "覆军杀将，则万人齐刃。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "制谈第三"
  },
  {
    "id": "wlz-102",
    "text": "气实则斗，气夺则走。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "战威第四"
  },
  {
    "id": "wlz-103",
    "text": "心既疑背，则计决而不动，动决而不禁。",
    "source": "《尉缭子》",
    "book": "尉缭子",
    "chapter": "攻权第五"
  }
]