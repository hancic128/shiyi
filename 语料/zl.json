[
  {
    "id": "zl-1",
    "text": "惟王建国，辨方正位，体国经野。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第一"
  },
  {
    "id": "zl-2",
    "text": "大宰之职，掌建邦之六典，以佐王治邦国：一曰治典，以经邦国，以治官府，以纪万民。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大宰第二"
  },
  {
    "id": "zl-3",
    "text": "小宰之职，掌建邦之宫刑，以治王宫之政令，凡宫之纠禁。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小宰第三"
  },
  {
    "id": "zl-4",
    "text": "宰夫之职，掌治朝之法，以正王及三公、六卿、大夫、群吏之位，掌其禁令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "宰夫第四"
  },
  {
    "id": "zl-5",
    "text": "宫正掌王宫之戒令纠禁，以时比宫中之官府、次舍之众寡，为之版以待。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "宫正/外饔第五"
  },
  {
    "id": "zl-6",
    "text": "亨人掌共鼎镬，以给水、火之齐。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "亨人/兽医第六"
  },
  {
    "id": "zl-7",
    "text": "酒正掌酒之政令，以式法授酒材。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "酒正/掌次第七"
  },
  {
    "id": "zl-8",
    "text": "大府掌九贡、九赋、九功之贰。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大府/职币第八"
  },
  {
    "id": "zl-9",
    "text": "司裘掌为大裘，以共王祀天之服。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司裘/内竖第九"
  },
  {
    "id": "zl-10",
    "text": "九嫔掌妇学之法，以教九御妇德、妇言、妇容、妇功，各帅其属而以时御叙于王所。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "九嫔/女史第十"
  },
  {
    "id": "zl-11",
    "text": "典妇功掌妇式之法，以授嫔妇及内人女功之事赍。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "典妇功/夏采第十一"
  },
  {
    "id": "zl-12",
    "text": "惟王建国，辨方正位，体国经野，设官分职，以为民极。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第十二"
  },
  {
    "id": "zl-13",
    "text": "大司徒之职，掌建邦之土地之图与其人民之数，以佐王安扰邦国。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司徒第十三"
  },
  {
    "id": "zl-14",
    "text": "小司徒之职，掌建邦之教法，以稽国中及四郊都鄙之夫家九比之数，以辨其贵贱、老幼、废疾，凡征役之施舍，与其祭祀、饮食、丧纪之禁令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司徒第十四"
  },
  {
    "id": "zl-15",
    "text": "乡师之职，各掌其所治乡之教，而听其治。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "乡师/比长第十五"
  },
  {
    "id": "zl-16",
    "text": "封人掌设王之社壝。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "封人/均人第十六"
  },
  {
    "id": "zl-17",
    "text": "师氏掌以媺诏王。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "师氏/媒氏第十七"
  },
  {
    "id": "zl-18",
    "text": "司市掌市之治教、政刑、量度禁令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司市/掌节第十八"
  },
  {
    "id": "zl-19",
    "text": "遂人掌邦之野。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "遂人/土均第十九"
  },
  {
    "id": "zl-20",
    "text": "草人掌土化之法以物地，相其宜而为之种。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "草人/羽人第二十"
  },
  {
    "id": "zl-21",
    "text": "掌葛掌以时征𫄨绤之材于山农。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "掌葛/槁人第二十一"
  },
  {
    "id": "zl-22",
    "text": "大宗伯之职，掌建邦之天神、人鬼、地示之礼，以佐王建保邦国。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大宗伯第二十三"
  },
  {
    "id": "zl-23",
    "text": "小宗伯之职，掌建国之神位，右社稷，左宗庙。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小宗伯第二十四"
  },
  {
    "id": "zl-24",
    "text": "肆师之职，掌立国祀之礼，以佐大宗伯。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "肆师第二十五"
  },
  {
    "id": "zl-25",
    "text": "郁人掌祼器。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "郁人/典瑞第二十六"
  },
  {
    "id": "zl-26",
    "text": "典命掌诸侯之五仪诸臣之五等之命。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "典命/职丧第二十七"
  },
  {
    "id": "zl-27",
    "text": "大司乐掌成均之法，以治建国之学政，而合国之子弟焉。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司乐/小师第二十八"
  },
  {
    "id": "zl-28",
    "text": "瞽蒙掌播鼗、柷、敔、埙、箫、管、弦、歌。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "瞽蒙/司干第二十九"
  },
  {
    "id": "zl-29",
    "text": "大卜掌三兆之法，一曰玉兆，二曰瓦兆，三曰原兆。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大卜/诅祝第三十"
  },
  {
    "id": "zl-30",
    "text": "司巫掌群巫之政令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司巫/神仕第三十一"
  },
  {
    "id": "zl-31",
    "text": "大司马之职，掌建邦国之九法，以佐王平邦国。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司马第三十三"
  },
  {
    "id": "zl-32",
    "text": "小司马之职，掌凡小祭祀。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司马/司险第三十四"
  },
  {
    "id": "zl-33",
    "text": "候人各掌其方之道治，与其禁令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "候人/司右第三十五"
  },
  {
    "id": "zl-34",
    "text": "虎贲氏掌先后王而趋以卒伍。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "虎贲氏/道右第三十六"
  },
  {
    "id": "zl-35",
    "text": "大驭掌驭玉路以祀。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大驭/形方式第三十七"
  },
  {
    "id": "zl-36",
    "text": "山师掌山林之名，辨其物与其利害，而颁之于邦国，使致其珍异之物。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "山师/都司马第三十八"
  },
  {
    "id": "zl-37",
    "text": "大司寇之职，掌建邦之三典，以佐王刑邦国，诘四方。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司寇第四十"
  },
  {
    "id": "zl-38",
    "text": "小司寇之职，掌外朝之政，以致万民而询焉。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司寇第四十一"
  },
  {
    "id": "zl-39",
    "text": "士师之职，掌国之五禁之法，以左右刑罚，一曰宫禁，二曰官禁，三曰国禁，四曰野禁，五曰军禁，皆以木铎徇之于朝，书而县于门闾。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "士师/朝士第四十二"
  },
  {
    "id": "zl-40",
    "text": "司民掌登万民之数。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司民/掌戮第四十三"
  },
  {
    "id": "zl-41",
    "text": "司隶掌五隶之法，辨其物而掌其政令。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司隶/庭氏第四十四"
  },
  {
    "id": "zl-42",
    "text": "衔枚氏掌司嚣。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "衔枚氏/司仪第四十五"
  },
  {
    "id": "zl-43",
    "text": "行夫掌邦国传遽之小事恶、而无礼者。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "行夫/朝大夫第四十六"
  },
  {
    "id": "zl-44",
    "text": "国有六职，百工与居一焉。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "总叙第四十七"
  },
  {
    "id": "zl-45",
    "text": "轮人为轮，斩三材必以其时。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "轮人/輈人第四十八"
  },
  {
    "id": "zl-46",
    "text": "攻金之工，筑氏执下齐，治氏执上齐，凫氏为声，栗氏为量，段氏为鏄器，桃氏为刃。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "筑氏/玉人第四十九"
  },
  {
    "id": "zl-47",
    "text": "磬氏为磬，倨句一矩有半，其博为一，股为二，鼓为三。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "磬氏/车人第五十"
  },
  {
    "id": "zl-48",
    "text": "弓人为弓，取六材必以其时，六材既聚，巧者和之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "弓人第五十一"
  },
  {
    "id": "zl-49",
    "text": "设官分职，以为民极。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第一"
  },
  {
    "id": "zl-50",
    "text": "二曰教典，以安邦国，以教官府，以扰万民。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大宰第二"
  },
  {
    "id": "zl-51",
    "text": "掌邦之六典、八法、八则之贰，以逆邦国、都鄙、官府之治。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小宰第三"
  },
  {
    "id": "zl-52",
    "text": "叙群吏之治，以待宾客之令，诸臣之复，万民之逆。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "宰夫第四"
  },
  {
    "id": "zl-53",
    "text": "夕击柝而比之，国有故则令宿。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "宫正/外饔第五"
  },
  {
    "id": "zl-54",
    "text": "职外，内饔之爨亨煮，辨膳羞之物。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "亨人/兽医第六"
  },
  {
    "id": "zl-55",
    "text": "凡为公酒者，亦如之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "酒正/掌次第七"
  },
  {
    "id": "zl-56",
    "text": "以受其货贿之人，颁其货于受藏之府，颁其贿于受用之府。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大府/职币第八"
  },
  {
    "id": "zl-57",
    "text": "中秋，献良裘，王乃行羽物。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司裘/内竖第九"
  },
  {
    "id": "zl-58",
    "text": "凡祭祀，赞玉赍，选后荐，彻豆笾。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "九嫔/女史第十"
  },
  {
    "id": "zl-59",
    "text": "凡授嫔妇功，及秋献功，辨其苦良，比其小大而贾之物书而楬之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "典妇功/夏采第十一"
  },
  {
    "id": "zl-60",
    "text": "教官之属：大司徒，卿一人。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第十二"
  },
  {
    "id": "zl-61",
    "text": "以土会之法，辨五地之物生。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司徒第十三"
  },
  {
    "id": "zl-62",
    "text": "及三年则大比。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司徒第十四"
  },
  {
    "id": "zl-63",
    "text": "以国比之法，以时稽其夫家众寡，辨其老幼、贵贱、废疾、马牛之物，辨其可任者与其施舍者。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "乡师/比长第十五"
  },
  {
    "id": "zl-64",
    "text": "为畿，封而树之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "封人/均人第十六"
  },
  {
    "id": "zl-65",
    "text": "以三德教国子：一曰至德，以为道本；二曰敏德，以为行本；三曰孝德，以知逆恶。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "师氏/媒氏第十七"
  },
  {
    "id": "zl-66",
    "text": "以次叙分地而经市，以陈肆辨物而平市，以政令禁物靡而均市，以商贾阜货而行市。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司市/掌节第十八"
  },
  {
    "id": "zl-67",
    "text": "以土地之图经田野，造县鄙，形体之法。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "遂人/土均第十九"
  },
  {
    "id": "zl-68",
    "text": "凡粪种，骍刚用牛，赤缇用羊，坟壤用麋，渴泽用鹿，咸澙用貆，勃壤用狐，埴垆用豕，彊用蕡。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "草人/羽人第二十"
  },
  {
    "id": "zl-69",
    "text": "凡葛征，征草贡之材于泽农，以当邦赋之政令，以权度受之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "掌葛/槁人第二十一"
  },
  {
    "id": "zl-70",
    "text": "大宗伯，卿一人。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第二十二"
  },
  {
    "id": "zl-71",
    "text": "以吉礼事邦国之鬼神示，以禋祀祀昊天上帝，以实柴祀日、月、星、辰，以槱祀司中、司命、飌师、雨师。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大宗伯第二十三"
  },
  {
    "id": "zl-72",
    "text": "兆五帝于四郊，四望、四类，亦如之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小宗伯第二十四"
  },
  {
    "id": "zl-73",
    "text": "立大祀，用玉帛、牲牷；立次祀，用牲币；立小祀，用牲。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "肆师第二十五"
  },
  {
    "id": "zl-74",
    "text": "凡祭祀、宾客之祼事，和郁鬯以实彝而陈之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "郁人/典瑞第二十六"
  },
  {
    "id": "zl-75",
    "text": "上公九命为伯，其国家、宫室、车旗、衣服、礼仪，皆以九为节。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "典命/职丧第二十七"
  },
  {
    "id": "zl-76",
    "text": "凡有道者，有德者，使教焉。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司乐/小师第二十八"
  },
  {
    "id": "zl-77",
    "text": "讽诵诗，世奠系，鼓琴瑟。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "瞽蒙/司干第二十九"
  },
  {
    "id": "zl-78",
    "text": "其经兆之体，皆百有二十，其颂皆千有二百。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大卜/诅祝第三十"
  },
  {
    "id": "zl-79",
    "text": "凡祭事，守瘗。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司巫/神仕第三十一"
  },
  {
    "id": "zl-80",
    "text": "政官之属：大司马，卿一人。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第三十二"
  },
  {
    "id": "zl-81",
    "text": "制畿封国，以正邦国；设仆辨位，以等邦国；进贤兴功，以作邦国；建牧立监，以维邦国；制军诘禁，以纠邦国；施贡分职，以任邦国；简稽乡民，以用邦国；均守平则，以安邦国；比小事大，以和邦国。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司马第三十三"
  },
  {
    "id": "zl-82",
    "text": "会同、飨射、师田、丧纪，掌其事，如大司马之法。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司马/司险第三十四"
  },
  {
    "id": "zl-83",
    "text": "以设侯人，若有方治，则帅而致于朝。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "候人/司右第三十五"
  },
  {
    "id": "zl-84",
    "text": "军旅、会同亦如之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "虎贲氏/道右第三十六"
  },
  {
    "id": "zl-85",
    "text": "及犯𫐈，王自左驭，驭下祝，登，受辔，犯𫐈，遂驱之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大驭/形方式第三十七"
  },
  {
    "id": "zl-86",
    "text": "川师掌川泽之名，辨其物与其利害而颁之于邦国，使致其珍异之物。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "山师/都司马第三十八"
  },
  {
    "id": "zl-87",
    "text": "刑官之属：大司寇，卿一人。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第三十九"
  },
  {
    "id": "zl-88",
    "text": "一曰，刑新国用轻典；二曰，刑平国用中典；三曰，刑乱国用重典。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "大司寇第四十"
  },
  {
    "id": "zl-89",
    "text": "一曰询国危，二曰询国迁，三曰询立君。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "小司寇第四十一"
  },
  {
    "id": "zl-90",
    "text": "以五戒先后刑罚，毋使罪丽于民：一曰誓，用之于军旅；二曰诰，用之于会同；三曰禁，用诸田役；四曰纠，用诸国中；五曰宪，用诸都鄙。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "士师/朝士第四十二"
  },
  {
    "id": "zl-91",
    "text": "自生齿以上，皆书于版。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司民/掌戮第四十三"
  },
  {
    "id": "zl-92",
    "text": "帅其民而搏盗贼，役国中之辱事，为百官积任器。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "司隶/庭氏第四十四"
  },
  {
    "id": "zl-93",
    "text": "国之大祭祀，令禁无嚣。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "衔枚氏/司仪第四十五"
  },
  {
    "id": "zl-94",
    "text": "凡其使也，必以旌节，虽道有难，而不时必达，居于其国，则掌行人之劳辱事焉，使则介之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "行夫/朝大夫第四十六"
  },
  {
    "id": "zl-95",
    "text": "或坐而论道，或作而行之，或审曲面执，以饬五材，以辨民器，或通四方之珍异以资之，或饬力以长地财，或治丝麻以成之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "总叙第四十七"
  },
  {
    "id": "zl-96",
    "text": "三材既具，巧者和之。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "轮人/輈人第四十八"
  },
  {
    "id": "zl-97",
    "text": "筑氏为削，长尺博寸，合六而成规。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "筑氏/玉人第四十九"
  },
  {
    "id": "zl-98",
    "text": "参分其鼓博，去一以为鼓博。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "磬氏/车人第五十"
  },
  {
    "id": "zl-99",
    "text": "干也者，以为远也；角也者，以为疾也；筋也者，以为深也；胶也者，以为和也；丝也者，以为固也；漆也者，以为受霜露也。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "弓人第五十一"
  },
  {
    "id": "zl-100",
    "text": "治官之属：大宰，卿一人；小宰，中大夫二人；宰夫，下大夫四人；上士八人，中士十有六人，旅下士三十有二人，府六人，史十有二人，胥十有二人，徒百有二十人。",
    "source": "《周礼》",
    "book": "周礼",
    "chapter": "叙官第一"
  }
]