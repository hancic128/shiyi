[
  {
    "id": "lz-1",
    "text": "子列子居郑圃，四十年人无识者。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-2",
    "text": "黄帝即位十有五年，喜天下戴己，养正命，娱耳目，供鼻口，焦然肌色皯黣，昏然五情爽惑。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-3",
    "text": "周穆王时，西极之国有化人来，入水火，贯金石；反山川，移城邑；乘虚不坠，触实不硋。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-4",
    "text": "仲尼闲居，子贡入侍，而有忧色。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-5",
    "text": "夏革曰：古初无物，今恶得物？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-6",
    "text": "力谓命曰：若之功奚若我哉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-7",
    "text": "杨朱游于鲁，舍于孟氏。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-8",
    "text": "子列子学于壶丘子林。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-9",
    "text": "国君卿大夫眎之，犹众庶也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-10",
    "text": "又十有五年，忧天下之不治，竭聪明，进智力，营百姓，焦然肌色皯黣，昏然五情爽惑。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-11",
    "text": "千变万化，不可穷极。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-12",
    "text": "子贡不敢问，出告颜回。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-13",
    "text": "后之人将谓今之无物，可乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-14",
    "text": "命曰：汝奚功于物而欲比朕？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-15",
    "text": "壶丘子林曰：子知持后，则可言持身矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-16",
    "text": "国不足，将嫁于卫。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-17",
    "text": "黄帝乃喟然赞曰：朕之过淫矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-18",
    "text": "既已变物之形，又且易人之虑。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-19",
    "text": "颜回援琴而歌。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-20",
    "text": "殷汤曰：然则物无先后乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-21",
    "text": "力曰：寿夭、穷达、贵贱、贫富，我力之所能也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-22",
    "text": "既富矣，奚不已焉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-23",
    "text": "列子曰：愿闻持后。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-24",
    "text": "弟子曰：先生往无反期，弟子敢有所谒，先生将何以教？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-25",
    "text": "养一己其患如此，治万物其患如此。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-26",
    "text": "穆王敬之若神，事之若君。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-27",
    "text": "回曰：夫子奚独忧？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-28",
    "text": "夏革曰：物之终始，初无极已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-29",
    "text": "命曰：彭祖之智不出尧、舜之上，而寿八百；颜渊之才不出众人之下，而寿四八。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-30",
    "text": "既贵矣，奚不已焉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-31",
    "text": "先生不闻壶丘子林之言乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-32",
    "text": "于是放万机，舍宫寝，去直侍，彻钟悬，减厨膳，退而闲居大庭之馆，斋心服形，三月不亲政事。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-33",
    "text": "推路寝以居之，引三牲以进之，选女乐以娱之。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-34",
    "text": "孔子曰：先言尔志。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-35",
    "text": "始或为终，终或为始，恶知其纪？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-36",
    "text": "仲尼之德不出诸侯之下，而困于陈、蔡；殷纣之行不出三仁之上，而居君位。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-37",
    "text": "既死矣，奚为焉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-38",
    "text": "列子顾而观影：形枉则影曲，形直则影正。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-39",
    "text": "子列子笑曰：壶子何言哉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-40",
    "text": "昼寝而梦，游于华胥氏之国。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-41",
    "text": "化人以为王之宫室卑陋而不可处，王之厨馔腥蝼而不可飨，王之嫔御膻恶而不可亲。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-42",
    "text": "然自物之外，自事之先，朕所不知也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-43",
    "text": "季札无爵于吴，田恒专有齐国。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-44",
    "text": "然则枉直随形而不在影，屈申任物而不在我，此之谓持后而处先。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-45",
    "text": "虽然，夫子尝语伯昏瞀人，吾侧闻之，试以告女。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-46",
    "text": "华胥氏之国在弇州之西，台州之北，不知斯齐国几千万里；盖非舟车足力之所及，神游而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-47",
    "text": "穆王乃为之改筑。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-48",
    "text": "孔子愀然有间曰：有是言哉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-49",
    "text": "殷汤曰：然则上下八方有极尽乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-50",
    "text": "夷、齐饿于首阳，季氏富于展禽。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-51",
    "text": "名奚益于子孙？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-52",
    "text": "关尹谓子列子曰：言美则响美，言恶则响恶；身长则影长，身短则影短。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-53",
    "text": "其言曰：有生不生，有化不化。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-54",
    "text": "其国无帅长，自然而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-55",
    "text": "土木之功，赭垩之色，无遗巧焉。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-56",
    "text": "汝之意失矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-57",
    "text": "革曰：不知也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-58",
    "text": "力曰：若如若言，我固无功于物，而物若此邪，此则若之所制邪？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-59",
    "text": "名也者，响也；身也者，影也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-60",
    "text": "不生者能生生，不化者能化化。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-61",
    "text": "其民无嗜欲，自然而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-62",
    "text": "五府为虚，而台始成。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-63",
    "text": "此吾昔日之言尔，请以今言为正也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-64",
    "text": "革曰：无则无极，有则有尽；朕何以知之？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-65",
    "text": "命曰：既谓之命，奈何有制之者邪？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-66",
    "text": "乘其名者，泽及宗族，利兼乡党；况子孙乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-67",
    "text": "故曰：慎尔言，将有和之；慎尔行，将有随之，是故圣人见出以知入，观往以知来，此其所以先知之理也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-68",
    "text": "生者不能不生，化者不能不化，故常生常化。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-69",
    "text": "不知乐生，不知恶死，故无夭殇；不知亲己，不知疏物，故无爱憎；不知背逆，不知向顺，故无利害：都无所爱惜，都无所畏忌。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-70",
    "text": "其高千仞，临终南之上，号曰中天之台。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-71",
    "text": "汝徒知乐天知命之无忧，未知乐天知命有忧之大也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-72",
    "text": "然无极之外复无无极，无尽之中复无无尽。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-73",
    "text": "朕直而推之，曲而任之。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-74",
    "text": "凡为名者必廉，廉斯贫；为名者必让，让斯贱。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-75",
    "text": "度在身，稽在人。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-76",
    "text": "常生常化者，无时不生，无时不化。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-77",
    "text": "入水不溺，入火不热。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-78",
    "text": "简郑、卫之处子娥媌靡曼者，施芳泽，正蛾眉，设笄珥，衣阿锡，曳齐纨，粉白黛黑，佩玉环，杂芷若以满之，奏承云、六莹、九韶、晨露以乐之。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-79",
    "text": "今告若其实：修一身，任穷达，知去来之非我，亡变乱于心虑，尔之所谓乐天知命之无忧也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-80",
    "text": "无极复无无极，无尽复无无尽。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-81",
    "text": "自寿自夭，自穷自达，自贵自贱，自富自贫，朕岂能识之哉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-82",
    "text": "人爱我，我必爱之；人恶我，我必恶之。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-83",
    "text": "阴阳尔，四时尔，不生者疑独，不化者往复。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-84",
    "text": "斫挞无伤痛，指擿无痟痒。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-85",
    "text": "月月献玉衣，旦旦荐玉食。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-86",
    "text": "曩吾修诗、书，正礼乐，将以治天下，遗来世；非但修一身，治鲁国而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-87",
    "text": "朕以是知其无极无尽也，而不知其有极有尽也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-88",
    "text": "朕岂能识之哉？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-89",
    "text": "志合言从，道行国霸。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-90",
    "text": "汤武爱天下，故王；桀纣恶天下，故亡，此所稽也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-91",
    "text": "往复，其际不可终；疑独，其道不可穷。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-92",
    "text": "乘空如履实，寝虚若处床。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-93",
    "text": "化人犹不舍然，不得已而临之。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-94",
    "text": "此道不行一国与当年，其如天下与来世矣？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-95",
    "text": "问营之东，复犹营也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-96",
    "text": "北宫子谓西门子曰：朕与子并世也，而人子达；并族也，而人子敬；并貌也，而人子爱；并言也，而人子庸；并行也，而人子诚；并仕也，而人子贵；并农也，而人子富；并商也，而人子利。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-97",
    "text": "西行至豳，人民犹是也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-98",
    "text": "朕衣则裋褐，食则粢粝，居则蓬室，出则徒行。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-99",
    "text": "问豳之西，复犹豳也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-100",
    "text": "子衣则文锦，食则粱肉，居则连𪲔，出则结驷。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-101",
    "text": "稽度皆明而不道也，譬之出不由门，行不从径也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-102",
    "text": "朕以是知四海、四荒、四极之不异是也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-103",
    "text": "在家熙然有弃朕之心，在朝谔然有敖朕之色。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-104",
    "text": "以是求利，不亦难乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-105",
    "text": "玄牝之门，是谓天地之根。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-106",
    "text": "故大小相含，无穷极也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-107",
    "text": "请谒不及相，遨游不同行，固有年矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-108",
    "text": "尝观之神农有炎之德，稽之虞、夏、商、周之书，度诸法士贤人之言，所以存亡废兴而非由此道者，未之有也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-109",
    "text": "绵绵若存，用之不勤。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-110",
    "text": "吾始知诗、书、礼乐无救于治乱，而未知所以革之之方。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-111",
    "text": "含万物者，亦如含天地。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-112",
    "text": "子自以德过朕邪？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-113",
    "text": "幸哉余未汝语也！",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-114",
    "text": "故生物者不生，化物者不化。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-115",
    "text": "云雾不硋其视，雷霆不乱其听，美恶不滑其心，山谷不踬其步，神行而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-116",
    "text": "此乐天知命者之所忧。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-117",
    "text": "含万物也故不穷，含天地也故无极。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-118",
    "text": "汝造事而穷，予造事而达，此厚薄之验欤？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-119",
    "text": "死之后，管氏而已。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-120",
    "text": "人而无义，唯食而已，是鸡狗也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-121",
    "text": "自生自化，自形自色，自智自力，自消自息。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-122",
    "text": "黄帝既寤，怡然自得，召天老、力牧、太山稽，告之，曰：朕闲居三月，斋心服形，思有以养身治物之道，弗获其术。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-123",
    "text": "居亡几何，谒王同游。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-124",
    "text": "虽然，吾得之矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-125",
    "text": "朕亦焉知天地之表不有大天地者乎？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-126",
    "text": "北宫子无以应，自失而归。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-127",
    "text": "田氏之相齐也，君盈则己降，君敛则己施。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-128",
    "text": "强食靡角，胜者为制，是禽兽也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-129",
    "text": "谓之生化、形色、智力、消息者，非也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-130",
    "text": "疲而睡，所梦若此。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-131",
    "text": "王执化人之袪，腾而上者，中天乃止。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-132",
    "text": "夫乐而知者，非古人之所谓乐知也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-133",
    "text": "亦吾所不知也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-134",
    "text": "中途遇东郭先生。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-135",
    "text": "民皆归之，因有齐国；子孙享之，至今不绝。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "杨朱第七"
  },
  {
    "id": "lz-136",
    "text": "为鸡狗禽兽矣，而欲人之尊己，不可得也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-137",
    "text": "夫有形者生于无形，则天地安从生？",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-138",
    "text": "今知至道不可以情求矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  },
  {
    "id": "lz-139",
    "text": "暨及化人之宫。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "周穆王第三"
  },
  {
    "id": "lz-140",
    "text": "无乐无知，是真乐真知；故无所不乐，无所不知，无所不忧，无所不为。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "仲尼第四"
  },
  {
    "id": "lz-141",
    "text": "然则天地亦物也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "汤问第五"
  },
  {
    "id": "lz-142",
    "text": "北宫子言其状。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "力命第六"
  },
  {
    "id": "lz-143",
    "text": "人不尊己，则危辱及之矣。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "说符第八"
  },
  {
    "id": "lz-144",
    "text": "太易者，未见气也；太初者，气之始也；太始者，形之始也；太素者，质之始也。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "天瑞第一"
  },
  {
    "id": "lz-145",
    "text": "又二十有八年，天下大治，几若华胥氏之国，而帝登假。",
    "source": "《列子》",
    "book": "列子",
    "chapter": "黄帝第二"
  }
]