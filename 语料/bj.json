[
  {
    "id": "bj-1",
    "text": "语云：脱谷为糠，其髓斯存，神之谓也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-2",
    "text": "既识神骨，当辨刚柔。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-3",
    "text": "容以七尺为期，貌合两仪而论。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-4",
    "text": "容貌者，骨之余，常佐骨之不足。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-5",
    "text": "未有须眉不具可称男子者。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-6",
    "text": "人之声音，犹天地之气，轻清上浮，重浊下坠。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-7",
    "text": "面部如命，气色如运。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-8",
    "text": "山骞不崩，唯石为镇，骨之谓也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-9",
    "text": "刚柔，则五行生克之数，名曰先天种子，不足用补，有余用泄。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-10",
    "text": "胸腹手足，实接五行；耳目口鼻，全通四气。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-11",
    "text": "情态者，神之余，常佐神之不足。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-12",
    "text": "少年两道眉，临老一付须。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-13",
    "text": "始于丹田，发于喉，转于舌，辨于齿，出于唇，实与五音相配。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-14",
    "text": "大命固宜整齐，小运亦当亨泰。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-15",
    "text": "一身精神，具乎两目；一身骨相，具乎面部。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-16",
    "text": "消息与命相通，此其较然易见者。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-17",
    "text": "相顾相称，则福生；如背如凑，则林林总总，不足论也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-18",
    "text": "久注观人精神，乍见观人情态。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-19",
    "text": "此言眉主早成，须主晚运也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-20",
    "text": "取其自成一家，不必一一合调，闻声相思，其人斯在，宁必一见决英雄哉！",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-21",
    "text": "是故光焰不发，珠玉与瓦砾同观；藻绘未扬，明光与布葛齐价。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-22",
    "text": "他家兼论形骸，文人先观神骨。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-23",
    "text": "五行有合法，木合火，水合木，此顺而合。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-24",
    "text": "容贵整，整非整齐之谓。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-25",
    "text": "大家举止，羞涩亦佳；小儿行藏，跳叫愈失。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-26",
    "text": "然而紫面无须自贵，暴腮缺须亦荣：郭令公半部不全，霍骠骁一副寡脸。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-27",
    "text": "声与音不同。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-28",
    "text": "大者主一生祸福，小者亦三月吉凶。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-29",
    "text": "开门见山，此为第一。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-30",
    "text": "顺者多富，即贵亦在浮沉之间。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-31",
    "text": "短不豕蹲，长不茅立，肥不熊餐，瘦不鹊寒，所谓整也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-32",
    "text": "大旨亦辨清浊，细处兼论取舍。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-33",
    "text": "此等间逢，毕竟有须眉者，十之九也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-34",
    "text": "声主张，寻发处见；音主敛，寻歇处见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-35",
    "text": "人以气为主，于内为精神，于外为气色。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-36",
    "text": "文人论神，有清浊之辨。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-37",
    "text": "金与火仇，有时合火，推之水土者皆然，此逆而合者，其贵非常。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-38",
    "text": "背宜圆厚，腹宜突坦，手宜温软，曲若弯弓，足宜丰满，下宜藏蛋，所谓整也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-39",
    "text": "有弱态，有狂态，有疏懒态，有周旋态。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-40",
    "text": "眉尚彩，彩者，杪处反光也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-41",
    "text": "辨声之法，必辨喜怒哀乐；喜如折竹当风，怒如阴雷起地，哀如击薄冰，乐如雪舞风前，大概以轻清；为上。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-42",
    "text": "有终身之气色，少淡、长明、壮艳、老素是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-43",
    "text": "清浊易辨，邪正难辨。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-44",
    "text": "然所谓逆合者，金形带火则然，火形带金，则三十死矣；水形带土则然，土形带水，则孤寡终老矣；木形带金则然，金形带木，则刀剑随身矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-45",
    "text": "五短多贵，两大不扬，负重高官，鼠行好利，此为定格。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-46",
    "text": "飞鸟依人，情致婉转，此弱态也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-47",
    "text": "贵人有三层彩，有一二层者。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-48",
    "text": "声雄者，如钟则贵，如锣则贱；声雌者，如雉鸣则贵，如蛙鸣则贱。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-49",
    "text": "有一年之气色，春青、夏红、秋黄、冬白是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-50",
    "text": "欲辨邪正，先观动静；静若含珠，动若木发；静若无人，动若赴的，此为澄清到底。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-51",
    "text": "此外牵合，俱是杂格，不入文人正论。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-52",
    "text": "他如手长于身，身过于体，配以佳骨，定主封侯；罗纹满身，胸有秀骨，配以妙神，不拜相即鼎甲矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-53",
    "text": "不衫不履，旁若无人，此狂态也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-54",
    "text": "所谓文明气象，宜疏爽不宜凝滞。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-55",
    "text": "远听声雄，近听悠扬，起若乘风，止如拍琴，上上。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-56",
    "text": "有一月之气色，朔后森发，望后隐跃是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-57",
    "text": "静若萤光，动若流水，尖巧而喜淫；静若半睡，动若鹿骇，别才而深思。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-58",
    "text": "五行为外刚柔，内刚柔，则喜怒、跳伏、深浅者是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-59",
    "text": "貌有清、古、奇、秀之别，总之须看科名星与阴骘纹为主。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-60",
    "text": "坐止自如，问答随意，此疏懒态也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-61",
    "text": "一望有乘风翔舞之势，上也；如泼墨者，最下。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-62",
    "text": "大言不张唇，细言不露齿，上也，出而不返，荒郊牛鸣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-63",
    "text": "有一日之气色，早青、昼满、晚停、暮静是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-64",
    "text": "一为败器，一为隐流，均之托迹于清，不可不辨。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-65",
    "text": "喜高怒重，过目辄忘，近粗。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-66",
    "text": "科名星，十三岁至三十九岁随时而见；阴骘纹，十九岁至四十六岁随时而见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-67",
    "text": "饰其中机，不苟言笑，察言观色，趋吉避凶，则周旋态也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-68",
    "text": "倒竖者，上也；下垂者，最下。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-69",
    "text": "急而不达，深夜鼠嚼；或字句相联，喋喋利口；或齿喉隔断，喈喈混谈：市井之夫，何足比较？",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-70",
    "text": "科名中人，以黄为主，此正色也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-71",
    "text": "凡精神，抖擞处易见，断续处难见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-72",
    "text": "伏亦不伉，跳亦不扬，近蠢。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-73",
    "text": "二者全，大物也；得一亦贵。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-74",
    "text": "皆根其情，不由矫枉。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-75",
    "text": "长有起伏，短有神气；浓忌浮光，淡忌枯索。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-76",
    "text": "音者，声之余也，与声相去不远，此则从细曲中见耳。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-77",
    "text": "黄云盖顶，必掇大魁；黄翅入鬓，进身不远；印堂黄色，富贵逼人；明堂素净，明年及第。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-78",
    "text": "断者出处断，续者闭处续。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-79",
    "text": "初念甚浅，转念甚深，近奸。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-80",
    "text": "科名星见于印堂眉彩，时隐时见，或为钢针，或为小丸，尝有光气，酒后及发怒时易见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-81",
    "text": "弱而不媚，狂而不哗，疏懒而真诚，周旋而健举，皆能成器；反之，败类也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-82",
    "text": "个中亦有征范，不可不辨。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-83",
    "text": "贫贱者有声无音，尖巧者有音无声，所谓禽无声，兽无音是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-84",
    "text": "他如眼角霞鲜，决利小考；印堂垂紫，动获小利，红晕中分，定产佳儿；两颧红润，骨肉发迹。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-85",
    "text": "道家所谓收拾入门之说，不了处看其脱略，做了处看其针线。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-86",
    "text": "内奸者，功名可期。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-87",
    "text": "阴骘纹见于眼角，阴雨便见，如三叉样，假寐时最易见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-88",
    "text": "大概亦得二三矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-89",
    "text": "但如压眼不利，散乱多忧，细而带媚，粗而无文，是最下乘。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-90",
    "text": "凡人说话，是声散在前后左右者是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-91",
    "text": "由此推之，足见一斑矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-92",
    "text": "小心者，从其不了处看之，疏节阔目，若不经意，所谓脱略也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-93",
    "text": "粗蠢各半者，胜人以寿。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-94",
    "text": "得科名星者早荣，得阴骘纹者迟发。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-95",
    "text": "前者恒态，又有时态。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-96",
    "text": "须有多寡，取其与眉相称。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-97",
    "text": "开谈多含情，话终有余响，不唯雅人，兼称国士；口阔无溢出，舌尖无窕音，不唯实厚，兼获名高。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "声音第六"
  },
  {
    "id": "bj-98",
    "text": "色忌青，忌白。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-99",
    "text": "大胆者，从其做了处看之，慎重周密，无有苟且，所谓针线也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-100",
    "text": "纯奸能豁达，其人终成。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-101",
    "text": "二者全无，前程莫问。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-102",
    "text": "方有对谈，神忽他往；众方称言，此独冷笑；深险难近，不足与论情。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-103",
    "text": "多者，宜清、宜疏、宜缩、宜参差不齐；少者，宜光、宜健、宜圆、宜有情照顾。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-104",
    "text": "青常见于眼底，白常见于眉端。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-105",
    "text": "二者实看向内处，稍移外便落情态矣，情态易见。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-106",
    "text": "纯粗无周密，半途必弃。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-107",
    "text": "阴骘纹见于喉间，又主生贵子；杂路不在此路。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-108",
    "text": "言不必当，极口称是，未交此人，故意底毁；卑庸可耻，不足与论事。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-109",
    "text": "卷如螺纹，聪明豁达；长如解索，风流荣显；劲如张戟，位高权重；亮若银条，早登廊庙，皆宦途大器。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-110",
    "text": "然亦不同：心事忧劳，青如凝墨；祸生不测，青如浮烟；酒色惫倦，白如卧羊；灾晦催人，白如傅粉。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-111",
    "text": "骨有九起：天庭骨隆起，枕骨强起，顶骨平起，佐串骨角起，太阳骨线起，眉骨伏犀起，鼻骨芽起，颧骨若不得而起，项骨平伏起。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-112",
    "text": "观人所忽，十有九八矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "刚柔第二"
  },
  {
    "id": "bj-113",
    "text": "目者面之渊，不深则不清。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-114",
    "text": "漫无可否，临事迟回；不甚关情，亦为堕泪。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-115",
    "text": "紫须剑眉，声音洪壮；蓬然虬乱，尝见耳后，配以神骨清奇，不千里封侯，亦十年拜相。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-116",
    "text": "又有青而带紫，金形遇之而飞扬，白而有光，土庚相当亦富贵，又不在此论也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-117",
    "text": "在头，以天庭骨、枕骨、太阳骨为主；在面，以眉骨、颧骨为主。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-118",
    "text": "鼻者面之山，不高则不灵。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-119",
    "text": "妇人之仁，不足与谈心。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-120",
    "text": "他如辅须先长终不利、人中不见一世穷、鼻毛接须多滞晦、短髭遮口饿终身，此其显而可见者耳。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "须眉第五"
  },
  {
    "id": "bj-121",
    "text": "最不佳者：太白夹日月，乌鸟集天庭，桃花散面颊，赪尾守地阁。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-122",
    "text": "五者备，柱石之器也；一则不穷；二则不贱；三则动履稍胜；四则贵矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-123",
    "text": "口阔而方禄千钟，齿多而圆不家食。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-124",
    "text": "三者不必定人终身。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-125",
    "text": "有一于此，前程退落，祸患再三矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "气色第七"
  },
  {
    "id": "bj-126",
    "text": "骨有色，面以青为贵，少年公卿半青面是也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-127",
    "text": "眼角入鬓，必掌刑名。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  },
  {
    "id": "bj-128",
    "text": "反此以求，可以交天下士。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "情态第四"
  },
  {
    "id": "bj-129",
    "text": "紫次之，白斯下矣。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "神骨第一"
  },
  {
    "id": "bj-130",
    "text": "顶见于面，终司钱谷：出贵征也。",
    "source": "《冰鉴》",
    "book": "冰鉴",
    "chapter": "容貌第三"
  }
]