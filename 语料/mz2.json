[
  {
    "id": "mz2-1",
    "text": "入国而不存其士，则亡国矣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "01章 亲士"
  },
  {
    "id": "mz2-2",
    "text": "君子战虽有陈，而勇为本焉；丧虽有礼，而哀为本焉；士虽有学，而行为本焉。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "02章 修身"
  },
  {
    "id": "mz2-3",
    "text": "子墨子言见染丝者而叹，曰：染于苍则苍，染于黄则黄，所入者变，其色亦变。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "03章 所染"
  },
  {
    "id": "mz2-4",
    "text": "子墨子曰：天下从事者，不可以无法仪。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "04章 法仪"
  },
  {
    "id": "mz2-5",
    "text": "子墨子曰：国有七患。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "05章 七患"
  },
  {
    "id": "mz2-6",
    "text": "子墨子曰：古之民，未知为宫室时，就陵阜而居，穴而处。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "06章 辞过"
  },
  {
    "id": "mz2-7",
    "text": "’昔诸侯倦于听治，息于钟鼓之乐；士大夫倦于听治，息于竽瑟之乐；农夫春耕、夏耘、秋敛、冬藏，息于聆缶之乐。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "07章 三辩"
  },
  {
    "id": "mz2-8",
    "text": "子墨子言曰：今者王公大人为政于国家者，皆欲国家之富，人民之众，刑政之治。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "08章 尚贤(上)"
  },
  {
    "id": "mz2-9",
    "text": "子墨子言曰：今王公大人之君人民、主社稷、治国家，欲修保而勿失，故不察尚贤为政之本也！",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "09章 尚贤(中)"
  },
  {
    "id": "mz2-10",
    "text": "子墨子言曰：天下之王公大人皆欲其国家之富也，人民之众也，刑法之治也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "10章 尚贤(下)"
  },
  {
    "id": "mz2-11",
    "text": "子墨子言曰：古者民始生，未有刑政之时，盖其语，人异义。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "11章 尚同(上)"
  },
  {
    "id": "mz2-12",
    "text": "子墨子曰：方今之时，复古之民始生，未有正长之时，盖其语曰，天下之人异义，是以一人一义，十人十义，百人百义。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "12章 尚同(中)"
  },
  {
    "id": "mz2-13",
    "text": "子墨子言曰：知者之事，必计国家百姓所以治者而为之，必计国家百姓之所以乱者而辟之。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "13章 尚同(下)"
  },
  {
    "id": "mz2-14",
    "text": "圣人以治天下为事者也，必知乱之所自起，焉能治之；不知乱之所自起，则不能治。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "14章 兼爱(上)"
  },
  {
    "id": "mz2-15",
    "text": "子墨子言曰：仁人之所以为事者，必兴天下之利，除去天下之害，以此为事者也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "15章 兼爱(中)"
  },
  {
    "id": "mz2-16",
    "text": "子墨子言曰：仁人之事者，必务求兴天下之利，除天下之害。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "16章 兼爱(下)"
  },
  {
    "id": "mz2-17",
    "text": "今有一人，入人园圃，窃其桃李，众闻则非之，上为政者，得则罚之，此何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "17章 非攻(上)"
  },
  {
    "id": "mz2-18",
    "text": "子墨子言曰：古者王公大人为政于国家者，情欲誉之审，赏罚之当，刑政之不过失……。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "18章 非攻(中)"
  },
  {
    "id": "mz2-19",
    "text": "子墨子言曰：今天下之所誉善者，其说将何哉？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "19章 非攻(下)"
  },
  {
    "id": "mz2-20",
    "text": "圣人为政一国，一国可倍也；大之为政天下，天下可倍也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "20章 节用(上)"
  },
  {
    "id": "mz2-21",
    "text": "子墨子言曰：古者明王圣人所以王天下、正诸侯者，彼其爱民谨忠，利民谨厚，忠信相连，又示之以利，是以终身不餍，殁世而不卷。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "21章 节用(中)"
  },
  {
    "id": "mz2-22",
    "text": "子墨子言曰：仁者之为天下度也，辟之无以异乎孝子之为亲度也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "25章 节葬(下)"
  },
  {
    "id": "mz2-23",
    "text": "子墨子言曰：天下之士君子，知小而不知大。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "26章 天志(上)"
  },
  {
    "id": "mz2-24",
    "text": "子墨子言曰：今天下之君子之欲为仁义者，则不可不察义之所从出。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "27章 天志(中)"
  },
  {
    "id": "mz2-25",
    "text": "子墨子言曰：天下之所以乱者，其说将何哉？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "28章 天志(下)"
  },
  {
    "id": "mz2-26",
    "text": "子墨子言曰：逮至昔三代圣王既没，天下失义，诸侯力正。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "31章 明鬼(下)"
  },
  {
    "id": "mz2-27",
    "text": "子墨子言曰：仁之事者，必务求兴天下之利，除天下之害。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "32章 非乐(上)"
  },
  {
    "id": "mz2-28",
    "text": "子墨子言曰：古者王公大人，为政国家者，皆欲国家之富，人民之众，刑政之治。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "35章 非命(上)"
  },
  {
    "id": "mz2-29",
    "text": "子墨子言曰：凡出言谈、由文学之为道也，则不可而不先立义法。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "36章 非命(中)"
  },
  {
    "id": "mz2-30",
    "text": "子墨子言曰：凡出言谈，则必可而不先立仪而言。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "37章 非命(下)"
  },
  {
    "id": "mz2-31",
    "text": "儒者曰：亲亲有术，尊贤有等。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "39章 非儒(下)"
  },
  {
    "id": "mz2-32",
    "text": "故，所得而后成也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "40章 经(上)"
  },
  {
    "id": "mz2-33",
    "text": "止，类以行人。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "41章 经(下)"
  },
  {
    "id": "mz2-34",
    "text": "小故，有之不必然，无之必不然。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "42章 经说(上)"
  },
  {
    "id": "mz2-35",
    "text": "止，彼以此其然也，说是其然也；我以此其不然也，疑是其然也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "43章 经说(下)"
  },
  {
    "id": "mz2-36",
    "text": "天之爱人也，薄于圣人之爱人也；其利人也，厚于圣人之利人也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "44章 大取"
  },
  {
    "id": "mz2-37",
    "text": "夫辩者，将以明是非之分，审治乱之纪，明同异之处，察名实之理，处利害，决嫌疑。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "45章 小取"
  },
  {
    "id": "mz2-38",
    "text": "子墨子怒耕柱子。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "46章 耕柱"
  },
  {
    "id": "mz2-39",
    "text": "子墨子曰：万事莫贵于义。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "47章 贵义"
  },
  {
    "id": "mz2-40",
    "text": "公孟子谓子墨子曰：君子共己以待，问焉则言，不问焉则止，譬若钟然，扣则鸣，不扣则不鸣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "48章 公孟"
  },
  {
    "id": "mz2-41",
    "text": "鲁君谓子墨子曰：吾恐齐之攻我也，可救乎？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "49章 鲁问"
  },
  {
    "id": "mz2-42",
    "text": "公输盘为楚造云梯之械，成，将以攻宋。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "50章 公输"
  },
  {
    "id": "mz2-43",
    "text": "​子墨子曰：​何攻之守？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "52章 备城门"
  },
  {
    "id": "mz2-44",
    "text": "禽子再拜再拜曰：敢问适人积土为高，以临吾城，薪土俱上，以为羊黔，蒙橹俱前，遂属之城，兵弩俱上，为之奈何？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "53章 备高临"
  },
  {
    "id": "mz2-45",
    "text": "禽滑厘子事子墨子三年，手足胼胝，面目黧黑，役身给使，不敢问欲。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "56章 备梯"
  },
  {
    "id": "mz2-46",
    "text": "城内堑外周道，广八步。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "58章 备水"
  },
  {
    "id": "mz2-47",
    "text": "城百步一突门，突门各为窑灶，窦入门四五尺，为其门上瓦屋，毋令水潦能入门中。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "61章 备突"
  },
  {
    "id": "mz2-48",
    "text": "禽子再拜再拜曰：敢问古人有善攻者，穴土而入，缚柱施火，以坏吾城，城坏，或中人为之奈何？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "62章 备穴"
  },
  {
    "id": "mz2-49",
    "text": "禽子再拜再拜曰：敢问适人强弱，遂以傅城，后上先断，以为法程；斩城为基，掘下为室。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "63章 备蛾傅"
  },
  {
    "id": "mz2-50",
    "text": "敌以东方来，迎之东坛，坛高八尺，堂密八；年八十者八人，主祭；青旗、青神长八尺者八，弩八，八发而止；将服必青，其牲以鸡。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "68章 迎敌祠"
  },
  {
    "id": "mz2-51",
    "text": "凡所求索旗名不在书者，皆以其形名为旗。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "69章 旗帜"
  },
  {
    "id": "mz2-52",
    "text": "安国之道，道任地始，地得其任则功成，地不得其任则劳而无功。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "70章 号令"
  },
  {
    "id": "mz2-53",
    "text": "子墨子曰：子问羊坽之守邪？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "71章 杂守"
  },
  {
    "id": "mz2-54",
    "text": "见贤而不急，则缓其君矣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "01章 亲士"
  },
  {
    "id": "mz2-55",
    "text": "是故置本不安者，无务丰末；近者不亲，无务求远；亲戚不附，无务外交；事无终始，无务多业；举物而暗，无务博闻。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "02章 修身"
  },
  {
    "id": "mz2-56",
    "text": "五入必而已则为五色矣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "03章 所染"
  },
  {
    "id": "mz2-57",
    "text": "无法仪而其事能成者，无有。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "04章 法仪"
  },
  {
    "id": "mz2-58",
    "text": "以七患居国，必无社稷；以七患守城，敌至国倾。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "05章 七患"
  },
  {
    "id": "mz2-59",
    "text": "下润湿伤民，故圣王作为宫室，为宫室之法，曰：室高足以辟润湿，边足以圉风寒，上足以待雪霜雨露，宫墙之高，足以别男女之礼。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "06章 辞过"
  },
  {
    "id": "mz2-60",
    "text": "今夫子曰：圣王不为乐。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "07章 三辩"
  },
  {
    "id": "mz2-61",
    "text": "然而不得富而得贫，不得众而得寡，不得治而得乱，则是本失其所欲，得其所恶。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "08章 尚贤(上)"
  },
  {
    "id": "mz2-62",
    "text": "何以知尚贤之为政之本也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "09章 尚贤(中)"
  },
  {
    "id": "mz2-63",
    "text": "然而不识以尚贤为政其国家百姓，王公大人本失尚贤为政之本也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "10章 尚贤(下)"
  },
  {
    "id": "mz2-64",
    "text": "是以一人则一义，二人则二义，十人则十义。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "11章 尚同(上)"
  },
  {
    "id": "mz2-65",
    "text": "其人数兹众，其所谓义者亦兹众。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "12章 尚同(中)"
  },
  {
    "id": "mz2-66",
    "text": "然计国家百姓之所以治者，何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "13章 尚同(下)"
  },
  {
    "id": "mz2-67",
    "text": "譬之如医之攻人之疾者然：必知疾之所自起，焉能攻之；不知疾之所自起，则弗能攻。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "14章 兼爱(上)"
  },
  {
    "id": "mz2-68",
    "text": "然则天下之利何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "15章 兼爱(中)"
  },
  {
    "id": "mz2-69",
    "text": "然当今之时，天下之害孰为大？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "16章 兼爱(下)"
  },
  {
    "id": "mz2-70",
    "text": "以亏人自利也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "17章 非攻(上)"
  },
  {
    "id": "mz2-71",
    "text": "是故子墨子曰：古者有语：谋而不得，则以往知来，以见知隐。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "18章 非攻(中)"
  },
  {
    "id": "mz2-72",
    "text": "为其上中天之利，而中中鬼之利，而下中人之利，故誉之与？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "19章 非攻(下)"
  },
  {
    "id": "mz2-73",
    "text": "其倍之，非外取地也，因其国家去其无用之费，足以倍之。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "20章 节用(上)"
  },
  {
    "id": "mz2-74",
    "text": "古者明王圣人其所以王天下、正诸侯者，此也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "21章 节用(中)"
  },
  {
    "id": "mz2-75",
    "text": "今孝子之为亲度也，将奈何哉？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "25章 节葬(下)"
  },
  {
    "id": "mz2-76",
    "text": "以其处家者知之。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "26章 天志(上)"
  },
  {
    "id": "mz2-77",
    "text": "既曰不可以不察义之所从出，然则义何从出？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "27章 天志(中)"
  },
  {
    "id": "mz2-78",
    "text": "何以知其明于小而不明于大也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "28章 天志(下)"
  },
  {
    "id": "mz2-79",
    "text": "是以存夫为人君臣上下者之不惠忠也，父子弟兄之不慈孝弟长贞良也，正长之不强于听治，贱人之不强于从事也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "31章 明鬼(下)"
  },
  {
    "id": "mz2-80",
    "text": "将以为法乎天下，利人乎即为，不利人乎即止。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "32章 非乐(上)"
  },
  {
    "id": "mz2-81",
    "text": "然而不得富而得贫，不得众而得寡，不得治而得乱，则是本失其所欲，得其所恶，是故何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "35章 非命(上)"
  },
  {
    "id": "mz2-82",
    "text": "然今天下之情伪，未可得而识也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "36章 非命(中)"
  },
  {
    "id": "mz2-83",
    "text": "言亲疏尊卑之异也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "39章 非儒(下)"
  },
  {
    "id": "mz2-84",
    "text": "止，以久也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "40章 经(上)"
  },
  {
    "id": "mz2-85",
    "text": "所存与者，于存与孰存？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "41章 经(下)"
  },
  {
    "id": "mz2-86",
    "text": "体也，若有端。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "42章 经说(上)"
  },
  {
    "id": "mz2-87",
    "text": "谓四足兽，与生鸟与。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "43章 经说(下)"
  },
  {
    "id": "mz2-88",
    "text": "大人之爱小人也，薄于小人之爱大人也；其利小人也，厚于小人之利大人也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "44章 大取"
  },
  {
    "id": "mz2-89",
    "text": "以名举实，以辞抒意，以说出故。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "45章 小取"
  },
  {
    "id": "mz2-90",
    "text": "耕柱子曰：我毋俞于人乎？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "46章 耕柱"
  },
  {
    "id": "mz2-91",
    "text": "今谓人曰：‘予子冠履，而断子之手足，子为之乎？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "47章 贵义"
  },
  {
    "id": "mz2-92",
    "text": "墨子曰：是言有三物焉，子乃今知其一身也，又未知其所谓也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "48章 公孟"
  },
  {
    "id": "mz2-93",
    "text": "子墨子曰：可。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "49章 鲁问"
  },
  {
    "id": "mz2-94",
    "text": "子墨子闻之，起于鲁，行十日十夜而至于郢，见公输盘。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "50章 公输"
  },
  {
    "id": "mz2-95",
    "text": "​禽滑厘对曰：​今之世常所以攻者：临、钩、冲、梯、堙、水、穴、突、空洞、蚁傅、轒辒、轩车，敢问守此十二者奈何？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "52章 备城门"
  },
  {
    "id": "mz2-96",
    "text": "子墨子曰：子问羊黔之守邪？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "53章 备高临"
  },
  {
    "id": "mz2-97",
    "text": "子墨子其哀之，乃管酒块脯，寄于大山，昧葇坐之，以樵禽子。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "56章 备梯"
  },
  {
    "id": "mz2-98",
    "text": "备水谨度四旁高下。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "58章 备水"
  },
  {
    "id": "mz2-99",
    "text": "吏主塞突门，用车两轮，以木束之，涂其上，维置突门内，使度门广狭，令之入门中四五尺。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "61章 备突"
  },
  {
    "id": "mz2-100",
    "text": "谋若此可得而知矣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "18章 非攻(中)"
  },
  {
    "id": "mz2-101",
    "text": "’必不为，何故？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "47章 贵义"
  },
  {
    "id": "mz2-102",
    "text": "昔者，三代之圣王禹、汤、文、武，百里之诸侯也，说忠行义，取天下；三代之暴王桀、纣、幽、厉，雠怨行暴，失天下。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "49章 鲁问"
  },
  {
    "id": "mz2-103",
    "text": "羊黔者，将之拙者也，足以劳卒，不足以害城。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "53章 备高临"
  },
  {
    "id": "mz2-104",
    "text": "备穴者城内为高楼，以谨候望适人。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "62章 备穴"
  },
  {
    "id": "mz2-105",
    "text": "前上不止，后射既疾，为之奈何？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "63章 备蛾傅"
  },
  {
    "id": "mz2-106",
    "text": "羊坽者，攻之拙者也，足以劳卒，不足以害城。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "71章 杂守"
  },
  {
    "id": "mz2-107",
    "text": "虽至士之为将相者，皆有法。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "04章 法仪"
  },
  {
    "id": "mz2-108",
    "text": "七患之所当，国必有殃。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "05章 七患"
  },
  {
    "id": "mz2-109",
    "text": "谨此则止，凡费财劳力，不加利者，不为也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "06章 辞过"
  },
  {
    "id": "mz2-110",
    "text": "此譬之犹马驾而不税，弓张而不弛，无乃非有血气者之所不能至邪！",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "07章 三辩"
  },
  {
    "id": "mz2-111",
    "text": "是其故何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "08章 尚贤(上)"
  },
  {
    "id": "mz2-112",
    "text": "今若有一诸侯于此，为政其国家也，曰：凡我国能射御之士，我将赏贵之；不能射御之士，我将罪贱之。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "10章 尚贤(下)"
  },
  {
    "id": "mz2-113",
    "text": "其人兹众，其所谓义者亦兹众。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "11章 尚同(上)"
  },
  {
    "id": "mz2-114",
    "text": "是以人是其义，而非人之义，故相交非也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "12章 尚同(中)"
  },
  {
    "id": "mz2-115",
    "text": "上之为政，得下之情则治，不得下之情则乱。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "13章 尚同(下)"
  },
  {
    "id": "mz2-116",
    "text": "天下之害何也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "15章 兼爱(中)"
  },
  {
    "id": "mz2-117",
    "text": "今师徒唯毋兴起，冬行恐寒，夏行恐暑，此不可以冬夏为者也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "18章 非攻(中)"
  },
  {
    "id": "mz2-118",
    "text": "意亡非为其上中天之利，而中中鬼之利，而下中人之利，故誉之与？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "19章 非攻(下)"
  },
  {
    "id": "mz2-119",
    "text": "是故古者圣王制为节用之法，曰：凡天下群百工，轮车鞼匏、陶冶梓匠，使各从事其所能，曰：凡足以奉给民用，则止。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "21章 节用(中)"
  },
  {
    "id": "mz2-120",
    "text": "非独处家者为然，虽处国亦然。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "26章 天志(上)"
  },
  {
    "id": "mz2-121",
    "text": "何以知义之不从愚且贱者出，而必自贵且知者出也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "27章 天志(中)"
  },
  {
    "id": "mz2-122",
    "text": "以其不明于天之意也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "28章 天志(下)"
  },
  {
    "id": "mz2-123",
    "text": "民之为淫暴寇乱盗贼，以兵刃、毒药、水火，退无罪人乎道路率径，夺人车马、衣裘以自利者，并作，由此始，是以天下乱。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "31章 明鬼(下)"
  },
  {
    "id": "mz2-124",
    "text": "是故子墨子之所以非乐者，非以大钟鸣鼓、琴瑟竽笙之声以为不乐也，非以刻镂华文章之色以为不美也，非以犓豢煎炙之味以为不甘也，非以高台厚榭邃野之居以为不安也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "32章 非乐(上)"
  },
  {
    "id": "mz2-125",
    "text": "命……虽强劲，何益哉？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "35章 非命(上)"
  },
  {
    "id": "mz2-126",
    "text": "故使言有三法。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "36章 非命(中)"
  },
  {
    "id": "mz2-127",
    "text": "考先圣大王之事；恶乎原之？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "37章 非命(下)"
  },
  {
    "id": "mz2-128",
    "text": "其亲死，列尸弗敛，登堂窥井，挑鼠穴，探涤器，而求其人矣，以为实在，则赣愚甚矣；如其亡也必求焉，伪亦大矣！",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "39章 非儒(下)"
  },
  {
    "id": "mz2-129",
    "text": "巫马子谓子墨子曰：鬼神孰与圣人明智？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "46章 耕柱"
  },
  {
    "id": "mz2-130",
    "text": "此君子之所疑惑也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "48章 公孟"
  },
  {
    "id": "mz2-131",
    "text": "吾愿主君之上者，尊天事鬼，下者爱利百姓，厚为皮币，卑辞令，亟遍礼四邻诸候，驱国而以事齐，患可救也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "49章 鲁问"
  },
  {
    "id": "mz2-132",
    "text": "守为台城，以临羊黔，左右出巨，各二十尺，行城三十尺，强弩之，技机藉之，奇器口口之，然则羊黔之攻败矣。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "53章 备高临"
  },
  {
    "id": "mz2-133",
    "text": "适人为变筑垣聚土非常者，若彭有水浊非常者，此穴土也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "62章 备穴"
  },
  {
    "id": "mz2-134",
    "text": "蛾傅者，将之忿者也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "63章 备蛾傅"
  },
  {
    "id": "mz2-135",
    "text": "敌以南方来，迎之南坛，坛高七尺，堂密七；年七十者七人，主祭；赤旗、赤神长七尺者七，弩七，七发而止；将服必赤，其牲以狗。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "68章 迎敌祠"
  },
  {
    "id": "mz2-136",
    "text": "城上举旗，备具之官致财物，之足而下旗。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "69章 旗帜"
  },
  {
    "id": "mz2-137",
    "text": "人亦如此，备不先具者无以安主，吏卒民多心不一者，皆在其将长，诸行赏罚及有治者，必出于王公。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "70章 号令"
  },
  {
    "id": "mz2-138",
    "text": "羊坽之政，远攻则远害，近城则近害，不至城。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "71章 杂守"
  },
  {
    "id": "mz2-139",
    "text": "非贤无急，非士无与虑国。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "01章 亲士"
  },
  {
    "id": "mz2-140",
    "text": "是故先王之治天下也，必察迩来远，君子察迩而迩修者也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "02章 修身"
  },
  {
    "id": "mz2-141",
    "text": "故染不可不慎也！",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "03章 所染"
  },
  {
    "id": "mz2-142",
    "text": "虽至百工从事者，亦皆有法。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "04章 法仪"
  },
  {
    "id": "mz2-143",
    "text": "凡五谷者，民之所仰也，君之所以为养也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "05章 七患"
  },
  {
    "id": "mz2-144",
    "text": "役修其城郭，则民劳而不伤，以其常正，收其租税，则民费而不病。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "06章 辞过"
  },
  {
    "id": "mz2-145",
    "text": "汤放桀于大水，环天下自立以为王，事成功立，无大后患，因先王之乐，又自作乐，命曰护，又修九招，武王胜殷杀纣，环天下自立以为王，事成功立，无大后患，因先王之乐，又自作乐，命曰象。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "07章 三辩"
  },
  {
    "id": "mz2-146",
    "text": "是故国有贤良之士众，则国家之治厚；贤良之士寡，则国家之治薄。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "08章 尚贤(上)"
  },
  {
    "id": "mz2-147",
    "text": "是以知尚贤之为政本也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "09章 尚贤(中)"
  },
  {
    "id": "mz2-148",
    "text": "问于若国之士，孰喜孰惧？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "10章 尚贤(下)"
  },
  {
    "id": "mz2-149",
    "text": "是以人是其义，以非人之义，故交相非也。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "11章 尚同(上)"
  },
  {
    "id": "mz2-150",
    "text": "内之父子兄弟作怨雠，皆有离散之心，不能相和合。",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "12章 尚同(中)"
  },
  {
    "id": "mz2-151",
    "text": "何以知其然也？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "13章 尚同(下)"
  },
  {
    "id": "mz2-152",
    "text": "治乱者何独不然？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "14章 兼爱(上)"
  },
  {
    "id": "mz2-153",
    "text": "然则崇此害亦何用生哉？",
    "source": "《墨子》",
    "book": "墨子",
    "chapter": "15章 兼爱(中)"
  }
]