[
  {
    "id": "lt-1",
    "text": "文王将田，史编布卜曰：田于渭阳，将大得焉。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文师第一"
  },
  {
    "id": "lt-2",
    "text": "其君贤不肖不等乎？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "盈虚第二"
  },
  {
    "id": "lt-3",
    "text": "太公曰：爱民而已。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "国务第三"
  },
  {
    "id": "lt-4",
    "text": "太公曰：为上惟临，为下惟沉，临而无远，沉而无隐。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "大礼第四"
  },
  {
    "id": "lt-5",
    "text": "文王寝疾，召太公望，太子发在侧，曰：呜呼！",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "明传第五"
  },
  {
    "id": "lt-6",
    "text": "太公曰：不慎所与也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "六守第六"
  },
  {
    "id": "lt-7",
    "text": "太公曰：无疏其亲，无怠其众，抚其左右，御其四旁。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "守土第七"
  },
  {
    "id": "lt-8",
    "text": "太公曰：斋，将语君天之经，四时所生，仁圣之道，民机之情。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "守国第八"
  },
  {
    "id": "lt-9",
    "text": "太公曰：王人者，上贤，下不肖，取诚信，去诈伪，禁暴乱，止奢侈。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "上贤第九"
  },
  {
    "id": "lt-10",
    "text": "太公曰：举贤而不用，是有举贤之名，而无用贤之实也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "举贤第十"
  },
  {
    "id": "lt-11",
    "text": "太公曰：凡用赏者贵信，用罚者贵必。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "赏罚第十一"
  },
  {
    "id": "lt-12",
    "text": "太公曰：凡兵之道莫过乎一，一者能独往独来。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "兵道第十二"
  },
  {
    "id": "lt-13",
    "text": "文王在酆，召太公曰：呜呼！",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "发启第十三"
  },
  {
    "id": "lt-14",
    "text": "太公曰：何忧何啬，万物皆得；何啬何忧，万物皆遒。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文启第十四"
  },
  {
    "id": "lt-15",
    "text": "一曰，因其所喜，以顺其志，彼将生骄，必有奸事，苟能因之，必能去之。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文伐第十五"
  },
  {
    "id": "lt-16",
    "text": "太公曰：大盖天下，然后能容天下；信盖天下，然后能约天下；仁盖天下，然后能怀天下；恩盖天下，然后能保天下；权盖天下，然后能不失天下；事而不疑，则天运不能移，时变不能迁。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "顺启第十六"
  },
  {
    "id": "lt-17",
    "text": "太公曰：因之，慎谋，用财。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "三疑第十七"
  },
  {
    "id": "lt-18",
    "text": "太公曰：凡举兵帅师，以将为命。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "王翼第十八"
  },
  {
    "id": "lt-19",
    "text": "太公曰：将有五材十过。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "论将第十九"
  },
  {
    "id": "lt-20",
    "text": "天下所贱，圣人所贵，凡人莫知，非有大明，不见其际，此士之外貌不与中情相应者也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "选将第二十"
  },
  {
    "id": "lt-21",
    "text": "太公曰：凡国有难，君避正殿，召将而诏之曰：‘社稷安危，一在将军。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "立将第二十一"
  },
  {
    "id": "lt-22",
    "text": "何以为禁止而令行？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "将威第二十二"
  },
  {
    "id": "lt-23",
    "text": "太公曰：将有三。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "励军第二十三"
  },
  {
    "id": "lt-24",
    "text": "太公曰：主与将有阴符凡八等：凡大胜克敌之符，长一尺；破军杀将之符，长九寸；降城得邑之符，长八寸；却敌报远之符，长七寸；警众坚守之符，长六寸；请粮益兵之符，长五寸。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "阴符第二十四"
  },
  {
    "id": "lt-25",
    "text": "太公曰：诸有阴事大虑，当用书，不用符，主以书遗将，将以书问主，书皆一合而再离，三发而一知。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "阴书第二十五"
  },
  {
    "id": "lt-26",
    "text": "太公曰：势因敌家之动，变生于两阵之间，奇正发于无穷之源。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军势第二十六"
  },
  {
    "id": "lt-27",
    "text": "太公曰：古之善战者，非能战于天上，非能战于地下，其成与败，皆由神势，得之者昌，失之者亡。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "奇兵第二十七"
  },
  {
    "id": "lt-28",
    "text": "太公曰：深哉！",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "五音第二十八"
  },
  {
    "id": "lt-29",
    "text": "太公曰：胜负之征，精神先见，明将察之，其效在人。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "兵征第二十九"
  },
  {
    "id": "lt-30",
    "text": "守御之备可无设乎？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "农器第三十"
  },
  {
    "id": "lt-31",
    "text": "太公曰：大哉，王之问也！",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军用第三十一"
  },
  {
    "id": "lt-32",
    "text": "太公曰：日月、星辰、斗杓，一左一右，一向一背，此谓天陈。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "三陈第三十二"
  },
  {
    "id": "lt-33",
    "text": "太公曰：此天下之困兵也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "疾战第三十三"
  },
  {
    "id": "lt-34",
    "text": "太公曰：必出之道，器械为宝，勇斗为首。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "必出第三十四"
  },
  {
    "id": "lt-35",
    "text": "太公日：凡帅师将众，虑不先设，器械不备，教不素信，士卒不习，若此，不可以为王者之兵也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军略第三十五"
  },
  {
    "id": "lt-36",
    "text": "太公曰：分兵三处，令我前军深沟增垒而无出。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "临境第三十六"
  },
  {
    "id": "lt-37",
    "text": "太公曰：如此者，发我兵去寇十里而伏其两旁，车骑百里而越前后，多其旌旗，益其金鼓。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "动静第三十七"
  },
  {
    "id": "lt-38",
    "text": "三军无备，上下惑乱，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "金鼓第三十八"
  },
  {
    "id": "lt-39",
    "text": "太公曰：凡深入敌人之境，必察地之形势，务求便利，依山林、险阻、水泉、林木而为之固，谨守关梁，又知城邑、丘墓地形之利，如是，则我军坚固，敌人不能绝我粮道，又不能越我前后。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "绝道第三十九"
  },
  {
    "id": "lt-40",
    "text": "其别军守险，与我相拒。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "略地第四十"
  },
  {
    "id": "lt-41",
    "text": "敌人因天燥疾风之利，燔吾上风，车骑锐士，坚伏吾后，吾三军恐怖，散乱而走，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "火战第四十一"
  },
  {
    "id": "lt-42",
    "text": "太公曰：将必上知天道，下知地理，中知人事。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "垒虚第四十二"
  },
  {
    "id": "lt-43",
    "text": "吾欲以守则固，以战则胜，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "林战第四十三"
  },
  {
    "id": "lt-44",
    "text": "太公曰：如此者，谓之突兵。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "突战第四十四"
  },
  {
    "id": "lt-45",
    "text": "太公曰：如此者，谓之震寇。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "敌强第四十五"
  },
  {
    "id": "lt-46",
    "text": "太公曰：如此者，谓之‘败兵’。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "敌武第四十六"
  },
  {
    "id": "lt-47",
    "text": "太公曰：凡三军处山之高，则为敌所栖，处山之下，则为敌所囚。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "鸟云山兵第四十七"
  },
  {
    "id": "lt-48",
    "text": "太公曰：三军无备，牛马无食，士卒无粮，如此者，索便诈敌而亟去之，设伏兵于后。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "鸟云泽兵第四十八"
  },
  {
    "id": "lt-49",
    "text": "太公曰：以少击众者，必以日之暮，伏于深草，要之隘路；以弱击强者，必得大国而与，邻国之助。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "少众第四十九"
  },
  {
    "id": "lt-50",
    "text": "吾左山而右水，敌右山而左水，与我分险相拒，吾欲与以守则固，以战则胜，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "分险第五十"
  },
  {
    "id": "lt-51",
    "text": "太公曰；凡用兵之法，三军之众，必有分合之变。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "分兵第五十一"
  },
  {
    "id": "lt-52",
    "text": "武王问太公曰；凡用兵之要，必有武车骁骑，驰陈选锋，见可则击之。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "武锋第五十二"
  },
  {
    "id": "lt-53",
    "text": "此军之服习，不可不察也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "练士第五十三"
  },
  {
    "id": "lt-54",
    "text": "太公曰：凡领三军，有金鼓之节，所以整齐士众者也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "教战第五十四"
  },
  {
    "id": "lt-55",
    "text": "几步卒当一车？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "均兵第五十五"
  },
  {
    "id": "lt-56",
    "text": "太公曰：选车士之法：取年四十以下，长七尺五寸以上，走能逐奔马，及驰而乘之，前后左右、上下周旋、能束缚旌旗；力能彀八石弩，射前后左右，皆便习者，名曰武车之士，不可不厚也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "武车士第五十六"
  },
  {
    "id": "lt-57",
    "text": "太公曰：选骑士之法：取年四十以下，长七尺五寸以上，壮健捷疾，超绝伦等，能驰骑彀射，前后左右，周旋进退，越沟堑，登丘陵，冒险阻，绝大泽，驰强敌，乱大众者，名曰武骑之士，不可不厚也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "武骑士第五十七"
  },
  {
    "id": "lt-58",
    "text": "太公曰：步贵知变动，车贵知地形，骑贵知别径奇道，三军同名而异用也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战车第五十八"
  },
  {
    "id": "lt-59",
    "text": "太公曰：骑有十胜，九败。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战骑第五十九"
  },
  {
    "id": "lt-60",
    "text": "太公曰：步兵与车、骑战者，必依丘陵，险阻，长兵强弩居前，短兵弱弩居后，更发更止，敌之车骑，虽众而至，坚阵疾战，材士强弩，以备我后。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战步第六十"
  },
  {
    "id": "lt-61",
    "text": "非龙、非螭，非虎、非罴，兆得公侯。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文师第一"
  },
  {
    "id": "lt-62",
    "text": "其天时变化自然乎？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "盈虚第二"
  },
  {
    "id": "lt-63",
    "text": "文王曰：爱民奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "国务第三"
  },
  {
    "id": "lt-64",
    "text": "为上惟周，为下惟定。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "大礼第四"
  },
  {
    "id": "lt-65",
    "text": "天将弃予，周之社稷将以属汝，今予欲师至道之言，以明传之子孙。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "明传第五"
  },
  {
    "id": "lt-66",
    "text": "人君有六守、三宝。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "六守第六"
  },
  {
    "id": "lt-67",
    "text": "无借人国柄，借人国柄，则失其权。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "守土第七"
  },
  {
    "id": "lt-68",
    "text": "王即斋七日，北面再拜而问之。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "守国第八"
  },
  {
    "id": "lt-69",
    "text": "故王人者，有六贼七害。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "上贤第九"
  },
  {
    "id": "lt-70",
    "text": "文王曰：其失安在？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "举贤第十"
  },
  {
    "id": "lt-71",
    "text": "赏信罚必于耳目之所闻见，则所不闻见者莫不阴化矣。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "赏罚第十一"
  },
  {
    "id": "lt-72",
    "text": "用之在于机，显之在于势，成之在于君。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "兵道第十二"
  },
  {
    "id": "lt-73",
    "text": "商王虐极，罪杀不辜，公尚助予，忧民如何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "发启第十三"
  },
  {
    "id": "lt-74",
    "text": "政之所施，莫知其化；时之所在，莫知其移。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文启第十四"
  },
  {
    "id": "lt-75",
    "text": "二曰，亲其所爱，以分其威。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文伐第十五"
  },
  {
    "id": "lt-76",
    "text": "此六者备，然后可以为天下政。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "顺启第十六"
  },
  {
    "id": "lt-77",
    "text": "夫攻强，必养之使强，益之使张。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "三疑第十七"
  },
  {
    "id": "lt-78",
    "text": "命在通达，不守一术。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "王翼第十八"
  },
  {
    "id": "lt-79",
    "text": "武王曰：敢问其目。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "论将第十九"
  },
  {
    "id": "lt-80",
    "text": "武王曰：何以知之？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "选将第二十"
  },
  {
    "id": "lt-81",
    "text": "今某国不臣，愿将军帅师应之’。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "立将第二十一"
  },
  {
    "id": "lt-82",
    "text": "太公曰：将以诛大为威，以赏小为明，以罚审为禁止而令行。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "将威第二十二"
  },
  {
    "id": "lt-83",
    "text": "败军亡将之符，长四寸；失利亡士之符，长三寸。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "阴符第二十四"
  },
  {
    "id": "lt-84",
    "text": "再离者，分书为三部；三发而一知者，言三人，人操一分，相参而不知情也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "阴书第二十五"
  },
  {
    "id": "lt-85",
    "text": "故至事不语，用兵不言。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军势第二十六"
  },
  {
    "id": "lt-86",
    "text": "故曰：不知战攻之策，不可以语敌；不能分移，不可以语奇；不能治乱，不可以为语变。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "奇兵第二十七"
  },
  {
    "id": "lt-87",
    "text": "夫律管十二，共要有五音——宫、商、角、征、羽、此其正声也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "五音第二十八"
  },
  {
    "id": "lt-88",
    "text": "谨候敌人出入进退，察其动静，言语妖祥，士卒所告。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "兵征第二十九"
  },
  {
    "id": "lt-89",
    "text": "太公曰：战攻守御之具尽在于人事。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "农器第三十"
  },
  {
    "id": "lt-90",
    "text": "夫攻守之具，各有科品，此兵之大威也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军用第三十一"
  },
  {
    "id": "lt-91",
    "text": "丘陵水泉，亦有前后左右之利，此谓地陈。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "三陈第三十二"
  },
  {
    "id": "lt-92",
    "text": "暴用之则胜，徐用之则败。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "疾战第三十三"
  },
  {
    "id": "lt-93",
    "text": "审知敌人空虚之地，无人之处，可以必出。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "必出第三十四"
  },
  {
    "id": "lt-94",
    "text": "凡三军有大事，莫不习用器械。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "军略第三十五"
  },
  {
    "id": "lt-95",
    "text": "列旌旗，击鼙鼓，宛为守备；令我后军，多积粮食，无使敌人知我意；发我锐士，潜袭其中，击其不意，攻其无备，敌人不知我情，则止不来矣。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "临境第三十六"
  },
  {
    "id": "lt-96",
    "text": "战合，鼓噪而俱起，敌将必恐，其军惊骇，众寡不相救，贵贱不相待，敌人必败。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "动静第三十七"
  },
  {
    "id": "lt-97",
    "text": "太公曰：凡三军，以戒为固，以怠为败。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "金鼓第三十八"
  },
  {
    "id": "lt-98",
    "text": "武王曰：吾三军过大林、广泽、平易之地，吾盟望误失，卒与敌人相薄，以战则不胜以守则不固，敌人翼我两旁，越我前后，三军大恐为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "绝道第三十九"
  },
  {
    "id": "lt-99",
    "text": "我欲攻城围邑，恐其别军卒至而击我，中外相合，击我表里，三军大乱，上下恐骇，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "略地第四十"
  },
  {
    "id": "lt-100",
    "text": "太公曰：若此者，则以云梯、飞楼，远望左右，谨察前后。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "火战第四十一"
  },
  {
    "id": "lt-101",
    "text": "登高下望，以观敌人变动：望其垒，即知其虚实；望其士卒，则知其去来。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "垒虚第四十二"
  },
  {
    "id": "lt-102",
    "text": "太公曰：使吾三军分为冲陈，便兵所处，弓弩为表，戟盾为里；斩除草木，极广吾道，以便战所；高置旌旗，谨敕三军，无使敌人知吾之情，是谓林战。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "林战第四十三"
  },
  {
    "id": "lt-103",
    "text": "其牛马必不得食，士卒绝粮，暴击而前，令我远邑别军，选其锐士，疾击其后；审其期日，必会于晦，三军疾战，敌人虽众，其将可虏。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "突战第四十四"
  },
  {
    "id": "lt-104",
    "text": "利以出战，不可以守。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "敌强第四十五"
  },
  {
    "id": "lt-105",
    "text": "善者以胜，不善者以亡。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "敌武第四十六"
  },
  {
    "id": "lt-106",
    "text": "既以被山而处，必为鸟云之陈。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "鸟云山兵第四十七"
  },
  {
    "id": "lt-107",
    "text": "武王曰：敌不可得而诈，吾士卒迷惑，敌人越我前后，吾三军败而走。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "鸟云泽兵第四十八"
  },
  {
    "id": "lt-108",
    "text": "武王曰：我无深草，又无隘路，敌人已至，不适日暮；我无大国之与，又无邻国之助。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "少众第四十九"
  },
  {
    "id": "lt-109",
    "text": "太公曰；处山之左，急备山之右；处山右，急备山左。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "分险第五十"
  },
  {
    "id": "lt-110",
    "text": "其大将先定战地、战日，然后移檄书与诸将吏，期攻城围邑；各会其所；明告战日，漏刻有时。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "分兵第五十一"
  },
  {
    "id": "lt-111",
    "text": "太公曰：夫欲击者，当审察敌人十四变，变见则击之，敌人必败。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "武锋第五十二"
  },
  {
    "id": "lt-112",
    "text": "将必先明告吏士，申之以三令，以教操兵起居、旌旗指麾之变法。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "教战第五十四"
  },
  {
    "id": "lt-113",
    "text": "以骑与步卒战，一骑当几步卒？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "均兵第五十五"
  },
  {
    "id": "lt-114",
    "text": "凡车之死地有十，其胜地有八。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战车第五十八"
  },
  {
    "id": "lt-115",
    "text": "武王曰：十胜奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战骑第五十九"
  },
  {
    "id": "lt-116",
    "text": "武王曰：吾无丘陵，又无险阻，敌人之至，既众且武，车骑翼我两旁，猎我前后；吾三军恐怖，乱败而走，为之奈何？",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "战步第六十"
  },
  {
    "id": "lt-117",
    "text": "天遗汝师，以之佐昌，施及三王。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "文师第一"
  },
  {
    "id": "lt-118",
    "text": "太公曰：君不肖，则国危而民乱，君贤圣，则国安而民治，祸福在君不在天时。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "盈虚第二"
  },
  {
    "id": "lt-119",
    "text": "太公曰：利而勿害，成而不败，生而勿杀，与而勿夺，乐而勿苦，喜而勿怒。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "国务第三"
  },
  {
    "id": "lt-120",
    "text": "周则天也，定则地也。",
    "source": "《六韬》",
    "book": "六韬",
    "chapter": "大礼第四"
  }
]