[
  {
    "id": "zn-1",
    "text": "冯子曰：智无常局，以恰肖其局者为上。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "总序第一"
  },
  {
    "id": "zn-2",
    "text": "太公望封于齐。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "太公 孔子第二"
  },
  {
    "id": "zn-3",
    "text": "有言诸葛丞相惜赦者。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "诸葛亮第三"
  },
  {
    "id": "zn-4",
    "text": "刘秀为大司马时，舍中儿犯法，军市令祭遵格杀之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "汉光武帝第四"
  },
  {
    "id": "zn-5",
    "text": "孔子行游，马逸食稼，野人怒，絷其马。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "孔子第五"
  },
  {
    "id": "zn-6",
    "text": "吉为相，有驭吏嗜酒，从吉出，醉呕丞相车上。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "丙吉 郭进第六"
  },
  {
    "id": "zn-7",
    "text": "唐高宗幸东都时，关中饥馑。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "魏元忠第七"
  },
  {
    "id": "zn-8",
    "text": "范文正公用士，多取气节而略细故，如孙威敏、滕达道，皆所素重。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "范仲淹第八"
  },
  {
    "id": "zn-9",
    "text": "狄青起行伍十余年，既贵显，面涅犹存，曰：留以劝军中！",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "狄青第九"
  },
  {
    "id": "zn-10",
    "text": "熙宁中，新法方行，州县骚然，邵康节闲居林下，门生故旧仕宦者皆欲投劾而归，以书问康节。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "邵雍第十"
  },
  {
    "id": "zn-11",
    "text": "沛公至咸阳，诸将皆争走金帛财物之府分之，何独先入收秦丞相、御史律令图书藏之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "萧何 任氏第十一"
  },
  {
    "id": "zn-12",
    "text": "先主一见马超，以为平西将军，封都亭侯，超见先主待之厚也，阔略无上下礼，与先主言，常呼字，关羽怒，请杀之，先主不从，张飞曰：如是，当示之以礼。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "张飞第十二"
  },
  {
    "id": "zn-13",
    "text": "李渊克霍邑。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "唐高祖第十三"
  },
  {
    "id": "zn-14",
    "text": "大将军青兵出定襄。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "卫青第十四"
  },
  {
    "id": "zn-15",
    "text": "节度使李愬既平蔡，械吴元济送京师。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "李愬第十五"
  },
  {
    "id": "zn-16",
    "text": "肃宗子建宁王倓性英果，有才略。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "李泌第十六"
  },
  {
    "id": "zn-17",
    "text": "白起贞元中，咸阳人上言见白起，令奏云：请为国家捍御西陲，正月吐蕃必大下。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "白起祠第十七"
  },
  {
    "id": "zn-18",
    "text": "宋艺祖推戴之初，陈桥守门者拒而不纳，遂如封丘门，抱关吏望风启钥。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "宋太祖 何真第十八"
  },
  {
    "id": "zn-19",
    "text": "初，太祖谓赵普曰：自唐季以来数十年，帝王凡十易姓，兵革不息，其故何也？",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "宋太祖第十九"
  },
  {
    "id": "zn-20",
    "text": "大将军达之蹙元帝于开平也，缺其围一角，使逸去。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "徐达第二十"
  },
  {
    "id": "zn-21",
    "text": "交趾贡异兽，谓之麟。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "司马光第二十一"
  },
  {
    "id": "zn-22",
    "text": "太宗、仁宗尝猎于大名之郊，题诗数十篇，贾昌朝时刻于石。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "韩琦第二十二"
  },
  {
    "id": "zn-23",
    "text": "天顺中，朝廷好宝玩。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "刘大夏第二十三"
  },
  {
    "id": "zn-24",
    "text": "姚崇为灵武道大总管。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "姚崇第二十四"
  },
  {
    "id": "zn-25",
    "text": "王振谓杨士奇等曰：朝廷事亏三杨先生，然三公亦高年倦勤矣。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "杨荣第二十五"
  },
  {
    "id": "zn-26",
    "text": "程颢为越州佥判，蔡卞为帅，待公甚厚。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "程颢第二十六"
  },
  {
    "id": "zn-27",
    "text": "李晟之屯渭桥也，荧惑守岁，久乃退，府中皆贺曰：荧惑退，国家之利，速用兵者昌。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "李晟第二十七"
  },
  {
    "id": "zn-28",
    "text": "仁宗时，大内灾，宫室略尽。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "吕端第二十八"
  },
  {
    "id": "zn-29",
    "text": "孙叔敖疾将死，戒其子曰：王亟封我矣，吾不受也。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "孙叔敖第二十九"
  },
  {
    "id": "zn-30",
    "text": "郭令公每见客，姬侍满前。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "郭子仪第三十"
  },
  {
    "id": "zn-31",
    "text": "宋真宗朝，尝有兵士作过，于法合死，持贷命决脊杖二十改配。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "宋真宗第三十一"
  },
  {
    "id": "zn-32",
    "text": "曹参被召，将行，属其后相：以齐狱市为寄。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "曹参第三十二"
  },
  {
    "id": "zn-33",
    "text": "赵韩王为相，置二大瓮于坐屏后，凡有人投利害文字，皆置其中，满即焚之于通衢。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "赵普 李沆 陆九渊第三十三"
  },
  {
    "id": "zn-34",
    "text": "光武诛王郎，收文书，得吏人与郎交关谤毁者数千章。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "汉光武帝(二)第三十四"
  },
  {
    "id": "zn-35",
    "text": "宣帝时，渤海左右郡岁饥，盗起，二千石不能制。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "龚遂第三十五"
  },
  {
    "id": "zn-36",
    "text": "文潞公知成都，尝于大雪会客，夜久不罢。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "文彦博第三十六"
  },
  {
    "id": "zn-37",
    "text": "张辽受曹公命屯长社。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "张辽第三十七"
  },
  {
    "id": "zn-38",
    "text": "韩愈为吏部侍郎。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "韩愈第三十八"
  },
  {
    "id": "zn-39",
    "text": "公在中书，左右忽白以失印，公怡然，戒勿言。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "裴度第三十九"
  },
  {
    "id": "zn-40",
    "text": "汾阳王宅在亲仁里，大启其第，任人出入不问。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "郭子仪(二)第四十"
  },
  {
    "id": "zn-41",
    "text": "奇章公牛弘有弟弼，好酒而酗。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "牛弘第四十一"
  },
  {
    "id": "zn-42",
    "text": "郑良霄既诛，国人相惊，或梦伯有介而行，曰：壬子余将杀带，明年壬寅余又将杀段！",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "子产第四十二"
  },
  {
    "id": "zn-43",
    "text": "汉患诸侯强，主父偃谋令诸侯以私恩自裂地，分其子弟，而汉为定其封号；汉有厚恩而诸侯渐自分析弱小云。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "主父偃第四十三"
  },
  {
    "id": "zn-44",
    "text": "张说以大驾东巡，恐突厥乘间入寇，议加兵备边，召兵部郎中裴光庭谋之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "裴光庭第四十四"
  },
  {
    "id": "zn-45",
    "text": "燕王卢绾反，高帝使樊哙以相国将兵击之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "陈平第四十五"
  },
  {
    "id": "zn-46",
    "text": "永乐间，降虏多安置河间、东昌等处，生养蕃息，骄悍不驯。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "于谦第四十六"
  },
  {
    "id": "zn-47",
    "text": "庄浪土帅鲁麟为甘肃副将，求大将不得，恃其部落强，径归庄浪，以子幼请告。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "刘大夏 张居正第四十七"
  },
  {
    "id": "zn-48",
    "text": "贾耽为山南东道节度使，使行军司马樊泽奏事行在。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "贾耽第四十八"
  },
  {
    "id": "zn-49",
    "text": "西鄙用兵，大将刘平战死。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "吕夷简第四十九"
  },
  {
    "id": "zn-50",
    "text": "冯子曰：有宇宙以来，只争‘明’、‘暗’二字而已。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "总序第五十"
  },
  {
    "id": "zn-51",
    "text": "纣初立，始为象箸。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "箕子第五十一"
  },
  {
    "id": "zn-52",
    "text": "太公封于齐，五月而报政。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "周公 姜太公第五十二"
  },
  {
    "id": "zn-53",
    "text": "管仲对曰：愿君之远易牙、竖刁、常之巫、卫公子启方。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "管仲第五十三"
  },
  {
    "id": "zn-54",
    "text": "丁谓诗有天门九重开，终当掉臂入，王禹偁读之，曰：入公门，鞠躬如也。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "王禹偁第五十四"
  },
  {
    "id": "zn-55",
    "text": "武陵郡樊仙尝诱诸夷作乱，州督请以万人讨之，权召问潘濬。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "潘濬第五十五"
  },
  {
    "id": "zn-56",
    "text": "诸马既得罪，窦氏益贵盛，皇后兄宪、弟笃喜交通宾客。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "魏相第五十六"
  },
  {
    "id": "zn-57",
    "text": "建武中，诸王皆在京师，竞修名誉，招游士。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "马援第五十七"
  },
  {
    "id": "zn-58",
    "text": "子列子穷，貌有饥色。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "列子第五十八"
  },
  {
    "id": "zn-59",
    "text": "宸濠甚爱唐六如，尝遣人持百金，至苏聘之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "唐寅第五十九"
  },
  {
    "id": "zn-60",
    "text": "郗司空在北府，桓宣武忌其握兵。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "郗超第六十"
  },
  {
    "id": "zn-61",
    "text": "张忠定公视事退后，有一厅子熟睡。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "张咏第六十一"
  },
  {
    "id": "zn-62",
    "text": "鲁定公十五年正月，邾隐公来朝，子贡观焉。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "子贡第六十二"
  },
  {
    "id": "zn-63",
    "text": "朱公居陶，生少子。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "范蠡第六十三"
  },
  {
    "id": "zn-64",
    "text": "魏知古起诸吏，为姚崇所引用，及同升也，崇颇轻之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "姚崇第六十四"
  },
  {
    "id": "zn-65",
    "text": "辛幼安流寓江南，而豪侠之气未除。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "陈同甫第六十五"
  },
  {
    "id": "zn-66",
    "text": "嘉靖初年，北虏尝寇陕西，犯花马池，镇巡惶遽，请兵策应。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "王琼第六十六"
  },
  {
    "id": "zn-67",
    "text": "班超久于西域，上疏愿生入玉门关。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "班超第六十七"
  },
  {
    "id": "zn-68",
    "text": "何进与袁绍谋诛宦官，何太后不听，进乃召董卓，欲以兵胁太后。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "曹操第六十八"
  },
  {
    "id": "zn-69",
    "text": "郭嘉孙策既尽有江东，转斗千里，闻曹公与袁绍相持官渡，将议袭许。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "郭嘉 虞翻第六十九"
  },
  {
    "id": "zn-70",
    "text": "浙帅钱镠时，宣州叛卒五千余人送款，钱氏纳之，以为腹心。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "罗隐第七十"
  },
  {
    "id": "zn-71",
    "text": "陆逊陆逊多沉虑，筹无不中，尝谓诸葛恪曰：在吾前者，吾必奉之同升；在吾下者，吾必扶持之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "陆逊 孙登第七十一"
  },
  {
    "id": "zn-72",
    "text": "王安石罢相，吕惠卿参知政事。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "邵雍第七十二"
  },
  {
    "id": "zn-73",
    "text": "说有材辩，能断大义。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "张说第七十三"
  },
  {
    "id": "zn-74",
    "text": "楚王元佐，太宗长子也，因申救廷美不获，遂感心疾，习为残忍；左右微过，辄弯弓射之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "寇准第七十四"
  },
  {
    "id": "zn-75",
    "text": "魏文侯时，西门豹为邺令，会长老问民疾苦。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "西门豹第七十五"
  },
  {
    "id": "zn-76",
    "text": "南山僧舍有石佛，岁传其首放光，远近男女聚观，昼夜杂处。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "程颢第七十六"
  },
  {
    "id": "zn-77",
    "text": "狄梁公为度支员外郎，车驾将幸汾阳，公奉使修供顿。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "狄仁杰第七十七"
  },
  {
    "id": "zn-78",
    "text": "苏东坡知扬州，一夕梦在山林间，见一虎来噬，公方惊怖，一紫袍黄冠以袖障公，叱虎使去。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "苏东坡第七十八"
  },
  {
    "id": "zn-79",
    "text": "唐魏元忠未达时，一婢出汲方还，见老猿于厨下看火。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "魏元忠第七十九"
  },
  {
    "id": "zn-80",
    "text": "朱熹乾道四年，民艰食，熹请于府，得常平米六百石赈贷。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "朱熹第八十"
  },
  {
    "id": "zn-81",
    "text": "三年视其成，则以地之高下，定额于朝，而以次征之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "虞集第八十一"
  },
  {
    "id": "zn-82",
    "text": "弘治十年，命户部刘大夏出理边饷，或曰：北边粮草，半属中贵人子弟经营，公素不与先辈合。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "刘大夏第八十二"
  },
  {
    "id": "zn-83",
    "text": "陶侃性俭厉，勤于事。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "陶侃第八十三"
  },
  {
    "id": "zn-84",
    "text": "西番故饶马，而仰给中国茶饮疗疾。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "杨一清第八十四"
  },
  {
    "id": "zn-85",
    "text": "苏州至昆山县凡七十里，皆浅水，无陆途。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "苏州堤第八十五"
  },
  {
    "id": "zn-86",
    "text": "叶梦得叶石林在颍昌，岁值水灾，京西尤甚，浮殍自唐、邓入境，不可胜计，令尽发常平所储以赈。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "叶梦得第八十六"
  },
  {
    "id": "zn-87",
    "text": "种世衡所置青涧城，逼近虏境，守备单弱，刍粮俱乏。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "种世衡 杨掞第八十八"
  },
  {
    "id": "zn-88",
    "text": "襄阳围急，将破，立信遗似道书，云：沿江之守，不过七千里，而内郡见兵尚可七十余万，宜尽出之江干，以实外御。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "汪立信 文天祥第八十九"
  },
  {
    "id": "zn-89",
    "text": "冯子曰：智非察不神，察非智不精。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "总序第九十"
  },
  {
    "id": "zn-90",
    "text": "正德中，殷云霁字近夫，知清江，县民朱铠死于文庙西庑中，莫知杀之者。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "殷云霁第九十一"
  },
  {
    "id": "zn-91",
    "text": "高子业初任代州守，有诸生江槔与邻人争宅址。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "高子业第九十二"
  },
  {
    "id": "zn-92",
    "text": "李德裕镇浙右。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "李德裕第九十三"
  },
  {
    "id": "zn-93",
    "text": "戚里有分财不均者，更相讼。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "张齐贤第九十四"
  },
  {
    "id": "zn-94",
    "text": "宣彦昭仕元，为平阳州判官，天大雨，民与军争簦，各认己物。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "宣彦昭 范邰第九十五"
  },
  {
    "id": "zn-95",
    "text": "安重荣虽武人而习吏事。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "安重荣 韩彦古第九十六"
  },
  {
    "id": "zn-96",
    "text": "亮出西苑，方食生梅，使黄门至中藏取蜜渍梅，蜜中有鼠矢。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "孙亮第九十七"
  },
  {
    "id": "zn-97",
    "text": "赵广汉为颍川太守。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "赵广汉第九十八"
  },
  {
    "id": "zn-98",
    "text": "周文襄公忱巡抚江南，有一册历，自记日行事，纤悉不遗，每日阴晴风雨，亦必详记。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "周忱第九十九"
  },
  {
    "id": "zn-99",
    "text": "王世贞备兵青州，部民雷龄以捕盗横莱、潍间，海道宋购之急而遁，以属世贞。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "王世贞第一百"
  },
  {
    "id": "zn-100",
    "text": "范槚，会稽人，守淮安。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "范槚第一百零一"
  },
  {
    "id": "zn-101",
    "text": "北齐任城王湝领并州刺史，有妇人临汾水浣衣，有乘马行人换其新靴，驰而去。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "高湝 杨津第一百零二"
  },
  {
    "id": "zn-102",
    "text": "襄摄浦城令，民有失物者，贼曹捕偷儿数辈至，相撑拄。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "陈襄第一百零三"
  },
  {
    "id": "zn-103",
    "text": "包拯包孝肃知天长县，有诉盗割牛舌者，公使归屠其牛鬻之，既有告此人盗杀牛者，公曰：何为割其家牛舌，而又告之？",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "包拯第一百零四"
  },
  {
    "id": "zn-104",
    "text": "参军宋儋年暴死。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "范纯仁第一百零五"
  },
  {
    "id": "zn-105",
    "text": "冯子曰：凡任天下事，皆胆也；其济，则智也。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "总序第一百零六"
  },
  {
    "id": "zn-106",
    "text": "窦固出击匈奴，以班超为假司马，将兵别击伊吾，战于蒲类海，多斩首虏而还。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "班超第一百零七"
  },
  {
    "id": "zn-107",
    "text": "东汉真定王扬谋反，光武使耿纯持节收扬。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "耿纯第一百零八"
  },
  {
    "id": "zn-108",
    "text": "唐哥舒翰为安西节度使，差都兵马使张擢上都奏事，逗留不返，纳贿交结杨国忠。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "哥舒翰 李光弼第一百零九"
  },
  {
    "id": "zn-109",
    "text": "杨素攻陈时，使军士三百人守营。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "杨素第一百一十"
  },
  {
    "id": "zn-110",
    "text": "安禄山将反前两三日，于宅集宴大将十余人，锡赍绝厚。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "安禄山第一百一十一"
  },
  {
    "id": "zn-111",
    "text": "金寇犯阙，銮舆南幸。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "宗泽第一百一十二"
  },
  {
    "id": "zn-112",
    "text": "宁戚，卫人，饭牛车下，扣角而歌。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "齐桓公第一百一十三"
  },
  {
    "id": "zn-113",
    "text": "曹操既得荆州，顺流东下，遗孙权书，言：治水军八十万众，与将军会猎于吴。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "周瑜 寇准 陈康伯第一百一十四"
  },
  {
    "id": "zn-114",
    "text": "高峻久不下，光武遣寇恂奉玺书往降之。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "寇恂第一百一十五"
  },
  {
    "id": "zn-115",
    "text": "冯子曰：智者，术所以生也；术者，智所以转也。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "总序第一百一十六"
  },
  {
    "id": "zn-116",
    "text": "纣为长夜之饮而失日，问其左右，尽不知也。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "箕子第一百一十七"
  },
  {
    "id": "zn-117",
    "text": "荆州牧刘表不供职贡，多行僭伪，遂乃郊祀天地，拟斥乘舆。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "孔融第一百一十八"
  },
  {
    "id": "zn-118",
    "text": "丁晋公执政，不许同列留身奏事，唯王文正一切委顺，未尝忤其意。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "王曾第一百一十九"
  },
  {
    "id": "zn-119",
    "text": "秦伐楚，使王翦将兵六十万人，始皇自送至灞上。",
    "source": "《智囊》",
    "book": "智囊",
    "chapter": "王翦 萧何第一百二十"
  }
]