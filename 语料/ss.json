[
  {
    "id": "ss-1",
    "text": "夫道、德、仁、义、礼，五者一体也。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-2",
    "text": "德足以怀远，信足以一异，义足以得众，才足以鉴古，明足以照下，此人之俊也。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "正道第二"
  },
  {
    "id": "ss-3",
    "text": "绝嗜禁欲，所以除累。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-4",
    "text": "夫志心笃行之术。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "本德宗道第四"
  },
  {
    "id": "ss-5",
    "text": "略己而责人者不治，自厚而薄人者弃废。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-6",
    "text": "怨在不舍小过，患在不预定谋。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-7",
    "text": "道者，人之所蹈，使万物不知其所由。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-8",
    "text": "行足以为仪表，智足以决嫌疑，信可以使守约，廉可以使分财，此人之豪也。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "正道第二"
  },
  {
    "id": "ss-9",
    "text": "抑非损恶，所以禳过。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-10",
    "text": "以过弃功者损，群下外异者沦，既用不任者疏，行赏吝色者沮，多许少与者怨，既迎而拒者乖。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-11",
    "text": "福在积善，祸在积恶。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-12",
    "text": "德者，人之所得，使万物各得其所欲。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-13",
    "text": "守职而不废，处义而不回，见嫌而不苟免，见利而不苟得，此人之杰也。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "正道第二"
  },
  {
    "id": "ss-14",
    "text": "贬酒阙色，所以无污。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-15",
    "text": "薄施厚望者不报，贵而忘贱者不久。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-16",
    "text": "饥在贱农，寒在堕织。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-17",
    "text": "仁者，人之所亲，有慈慧恻隐之心，以遂其生存。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-18",
    "text": "避嫌远疑，所以不误。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-19",
    "text": "念旧恶而弃新功者凶，用人不得正者殆，强用人者不畜，为人择官者乱，失其所强者弱，决策于不仁者险，阴计外泄者败，厚敛薄施者凋。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-20",
    "text": "安在得人，危在失事。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-21",
    "text": "博学切问，所以广知。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-22",
    "text": "战士贫，游士富者衰；货赂公行者昧；闻善忽略，记过不忘者暴；所任不可信，所信不可任者浊。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-23",
    "text": "富在迎来，贫在弃时。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-24",
    "text": "义者，人之所宜，赏善罚恶，以立功立事。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-25",
    "text": "高行微言，所以修身。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-26",
    "text": "牧人以德者集，绳人以刑者散。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-27",
    "text": "上无常操，下多疑心。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-28",
    "text": "礼者，人之所履，夙兴夜寐，以成人伦之序。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-29",
    "text": "恭俭谦约，所以自守。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-30",
    "text": "小功不赏，则大功不立；小怨不赦，则大怨必生。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-31",
    "text": "轻上生罪，侮下无亲。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-32",
    "text": "夫欲为人之本，不可无一焉。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-33",
    "text": "深计远虑，所以不穷。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-34",
    "text": "赏不服人，罚不甘心者叛。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-35",
    "text": "近臣不重，远臣轻之。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-36",
    "text": "贤人君子，明于盛衰之道，通乎成败之数，审乎治乱之势，达乎去就之理。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-37",
    "text": "亲仁友直，所以扶颠。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-38",
    "text": "赏及无功，罚及无罪者酷。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-39",
    "text": "自疑不信人，自信不疑人。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-40",
    "text": "故潜居抱道，以待其时。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-41",
    "text": "近恕笃行，所以接人。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-42",
    "text": "听谗而美，闻谏而仇者亡。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-43",
    "text": "枉士无正友，曲上无直下。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-44",
    "text": "是以其道足高，而名重于后代。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "原始第一"
  },
  {
    "id": "ss-45",
    "text": "任材使能，所以济物。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-46",
    "text": "能有其有者安，贪人之有者残。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "遵义第五"
  },
  {
    "id": "ss-47",
    "text": "危国无贤人，乱政无善人。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-48",
    "text": "殚恶斥谗，所以止乱。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-49",
    "text": "爱人深者求贤急，乐得贤者养人厚。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-50",
    "text": "推古验今，所以不惑。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-51",
    "text": "国将霸者士皆归，邦将亡者贤先避。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-52",
    "text": "先揆后度，所以应卒。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-53",
    "text": "地薄者大物不产，水浅者大鱼不游，树秃者大禽不栖，林疏者大兽不居。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-54",
    "text": "设变致权，所以解结。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-55",
    "text": "山峭者崩，泽满者溢。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-56",
    "text": "括囊顺会，所以无咎。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-57",
    "text": "弃玉取石者盲，羊质虎皮者柔。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-58",
    "text": "橛橛梗梗，所以立功。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-59",
    "text": "衣不举领者倒，走不视地者颠。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-60",
    "text": "孜孜淑淑，所以保终。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "求人之志第三"
  },
  {
    "id": "ss-61",
    "text": "柱弱者屋坏，辅弱者国倾。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-62",
    "text": "足寒伤心，人怨伤国。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-63",
    "text": "山将崩者下先隳，国将衰者人先弊。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-64",
    "text": "根枯枝朽，人困国残。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-65",
    "text": "与覆车同轨者倾，与亡国同事者灭。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-66",
    "text": "见已生者慎将生，恶其迹者须避之。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-67",
    "text": "畏危者安，畏亡者存。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-68",
    "text": "夫人之所行，有道则吉，无道则凶。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-69",
    "text": "吉者，百福所归；凶者，百祸所攻。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-70",
    "text": "非其神圣，自然所钟。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-71",
    "text": "务善策者无恶事，无远虑者有近忧。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-72",
    "text": "释己而教人者逆，正己而化人者顺。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  },
  {
    "id": "ss-73",
    "text": "逆者难从，顺者易行，难从则乱，易行则理。",
    "source": "《素书》",
    "book": "素书",
    "chapter": "安礼第六"
  }
]