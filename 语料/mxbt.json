[
  {
    "id": "mxbt-1",
    "text": "上亲郊庙，册文皆曰恭荐歳事。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第一"
  },
  {
    "id": "mxbt-2",
    "text": "三司使班在翰林学士之上。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第二"
  },
  {
    "id": "mxbt-3",
    "text": "钧石之石，五权之名，石重百二十斤。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第三"
  },
  {
    "id": "mxbt-4",
    "text": "司马相如上林赋叙上林诸水曰：丹水，紫渊，灞、浐、泾、谓，八川分流，相背而异态，灏溔潢漾……东注太湖。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第四"
  },
  {
    "id": "mxbt-5",
    "text": "周礼：凡乐，圜钟为宫，黄钟为角，太蔟为征，姑洗为羽。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第五"
  },
  {
    "id": "mxbt-6",
    "text": "前世遗事，时有于古人文章中见之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第六"
  },
  {
    "id": "mxbt-7",
    "text": "开元大衍历法最为精密，历代用其朔法。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第七"
  },
  {
    "id": "mxbt-8",
    "text": "历法，天有黄、赤二道，月有九道。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第八"
  },
  {
    "id": "mxbt-9",
    "text": "景德中，河北用兵，车驾欲幸澶渊，中外之论不一，独寇忠愍赞成上意。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第九"
  },
  {
    "id": "mxbt-10",
    "text": "蒋堂侍郎为淮南转运使日，属县例致贺冬至书，皆投书即还。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第十"
  },
  {
    "id": "mxbt-11",
    "text": "世传算茶有三说最便。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十一"
  },
  {
    "id": "mxbt-12",
    "text": "淮南漕渠，筑埭以畜水，不知始于何时，旧传召伯埭谢公所为。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十二"
  },
  {
    "id": "mxbt-13",
    "text": "陵州盐井，深五百余尺，皆石也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "权智第十三"
  },
  {
    "id": "mxbt-14",
    "text": "欧阳文忠常爱林逋诗草泥行郭索，云木叫钩辀之句，文忠以谓语新而属对新切。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十四"
  },
  {
    "id": "mxbt-15",
    "text": "切韵之学，本出于西域。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十五"
  },
  {
    "id": "mxbt-16",
    "text": "士人刘克博观异书。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十六"
  },
  {
    "id": "mxbt-17",
    "text": "藏书画者，多取空名。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "书画第十七"
  },
  {
    "id": "mxbt-18",
    "text": "算术求积尺之法，如刍萌、刍童、方池、冥谷、堑堵、鳖臑、圆锥、阳马之类，物形备矣，独未有隙积一术，古法：凡算方积之物，有立方，谓六幂皆方者。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "技艺第十八"
  },
  {
    "id": "mxbt-19",
    "text": "礼书所载黄彝，乃画人目为饰，谓之黄目。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "器用第十九"
  },
  {
    "id": "mxbt-20",
    "text": "世人有得雷斧、雷楔者，云：雷神所坠，多于震雷之下得之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "神奇第二十"
  },
  {
    "id": "mxbt-21",
    "text": "世传虹能入溪涧饮水，信然。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "异事异疾附第二十一"
  },
  {
    "id": "mxbt-22",
    "text": "丁晋公之逐，士大夫远嫌，莫敢与之通声问。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "谬误谲诈附第二十二"
  },
  {
    "id": "mxbt-23",
    "text": "石曼卿为集贤校理，微行倡馆。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "讥谑第二十三"
  },
  {
    "id": "mxbt-24",
    "text": "鄜、延境内有石油，旧说高奴县出脂水，即此也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十四"
  },
  {
    "id": "mxbt-25",
    "text": "宣州宁国县多积首蛇，其长盈尺，黑鳞白章，两首文彩同，但一首逆鳞耳。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十五"
  },
  {
    "id": "mxbt-26",
    "text": "古方言云母粗服，则著人肝肺不可去。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "药议第二十六"
  },
  {
    "id": "mxbt-27",
    "text": "旧制，馆职自校勘以上，非特除者，皆先试，唯检讨不试。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷一第二十七"
  },
  {
    "id": "mxbt-28",
    "text": "卢肇论海潮，以谓日出没所激而成，此极无理。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷二第二十八"
  },
  {
    "id": "mxbt-29",
    "text": "地理之书，古人有飞鸟图，不知何人所为。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷三第二十九"
  },
  {
    "id": "mxbt-30",
    "text": "鲁肃简公劲正，不狥爱憎，出于天性，素与曹襄悼不协。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "续笔谈十一篇第三十"
  },
  {
    "id": "mxbt-31",
    "text": "先景灵宫，谓之朝献；次太庙，谓之朝飨；末乃有事于南郊。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第一"
  },
  {
    "id": "mxbt-32",
    "text": "旧制，权使即与正同，故三司使结衔皆在官职之上。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第二"
  },
  {
    "id": "mxbt-33",
    "text": "后人以一斛为一石，自汉已如此，饮酒一石不乱是也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第三"
  },
  {
    "id": "mxbt-34",
    "text": "八川自入大河，大河去太湖数千里，中间隔太山及淮、济、大江，何缘与太湖相涉？",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第四"
  },
  {
    "id": "mxbt-35",
    "text": "函钟为宫，太蔟为角，姑洗为征，南吕为羽。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第五"
  },
  {
    "id": "mxbt-36",
    "text": "元稹诗有琵琶宫调八十一，三调弦中弹不出。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第六"
  },
  {
    "id": "mxbt-37",
    "text": "至熙宁中考之，历已后天五十余刻，而前世历官皆不能知。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第七"
  },
  {
    "id": "mxbt-38",
    "text": "此皆强名而已，非实有也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第八"
  },
  {
    "id": "mxbt-39",
    "text": "乘舆方渡河，虏骑充斥，至于城下，人情恟恟。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第九"
  },
  {
    "id": "mxbt-40",
    "text": "有一县令使人，独不肯去，须责回书；左右谕之皆不听，以至呵逐亦不去，曰：宁得罪；不得书，不敢回邑。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第十"
  },
  {
    "id": "mxbt-41",
    "text": "三说者，皆谓见钱为一说，犀牙、香药为一说，茶为一说，深不然也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十一"
  },
  {
    "id": "mxbt-42",
    "text": "按李翱来南录，唐时犹是流水，不应谢公时已作此埭。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十二"
  },
  {
    "id": "mxbt-43",
    "text": "上下甚宽广，独中间稍狭，谓之杖鼓腰。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "权智第十三"
  },
  {
    "id": "mxbt-44",
    "text": "钩辀，鹧鸪声也，李群玉诗云：方穿诘曲崎岖路，又听钩辀格磔声。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十四"
  },
  {
    "id": "mxbt-45",
    "text": "汉人训字，止曰读如某字，未用反切。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十五"
  },
  {
    "id": "mxbt-46",
    "text": "杜甫诗有家家养乌鬼，顿顿食黄鱼。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十六"
  },
  {
    "id": "mxbt-47",
    "text": "偶传为钟、王、顾、陆之笔，见者争售，此所谓耳鉴。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "书画第十七"
  },
  {
    "id": "mxbt-48",
    "text": "其法再自乘则得之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "技艺第十八"
  },
  {
    "id": "mxbt-49",
    "text": "余游关中，得古铜黄彝，殊不然。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "器用第十九"
  },
  {
    "id": "mxbt-50",
    "text": "元丰中，予居随州，夏月大雷震一木折，其下乃得一楔，信如所传。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "神奇第二十"
  },
  {
    "id": "mxbt-51",
    "text": "熙宁中，余使契丹，至其极北黑水境永安山下卓帐。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "异事异疾附第二十一"
  },
  {
    "id": "mxbt-52",
    "text": "一日，忽有一书与执政。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "谬误谲诈附第二十二"
  },
  {
    "id": "mxbt-53",
    "text": "为不逞者所窘。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "讥谑第二十三"
  },
  {
    "id": "mxbt-54",
    "text": "生于水际，沙石与泉水相杂，惘惘而出，土人以雉尾甃之，用采入缶中。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十四"
  },
  {
    "id": "mxbt-55",
    "text": "人家庭槛间，动有数十同空，略如蚯蚓。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十五"
  },
  {
    "id": "mxbt-56",
    "text": "世俗似此之论甚多，皆谬说也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "药议第二十六"
  },
  {
    "id": "mxbt-57",
    "text": "初置检讨官，只作差遣，未比馆职故也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷一第二十七"
  },
  {
    "id": "mxbt-58",
    "text": "余常考其行节，每至月正临子、午，则潮生，候之万万无差。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷二第二十八"
  },
  {
    "id": "mxbt-59",
    "text": "所谓飞鸟者，谓虽有四至里数，皆是循路步之，道路迂直而不常，既列为图，则里步无缘相应，故按图别量径直四至，如空中鸟飞直达，更无山川回屈之差。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷三第二十九"
  },
  {
    "id": "mxbt-60",
    "text": "天圣中因议茶法，曹力挤肃简，因得罪去；赖上察其情，寝前命，止从罚俸，独三司使李谘夺职，谪洪州。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "续笔谈十一篇第三十"
  },
  {
    "id": "mxbt-61",
    "text": "予集郊式时，曾预讨论，常疑其次序，若先为尊，则郊不应在庙后；若后为尊，则景灵宫不应在太庙之先。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第一"
  },
  {
    "id": "mxbt-62",
    "text": "庆历中，叶道卿为权三司使，执政有欲抑道卿者，降敕时移权三司使在职下结衔，遂立翰林学士之下，至今为例。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第二"
  },
  {
    "id": "mxbt-63",
    "text": "挽蹶弓弩，古人以钧石率之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第三"
  },
  {
    "id": "mxbt-64",
    "text": "郭璞江赋云：注五湖以漫漭，灌三江而漰沛。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第四"
  },
  {
    "id": "mxbt-65",
    "text": "黄钟为宫，大吕为角，太蔟为征，应钟为羽。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第五"
  },
  {
    "id": "mxbt-66",
    "text": "琵琶共有八十四调，盖十二律各七均，乃成八十四调。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第六"
  },
  {
    "id": "mxbt-67",
    "text": "奉元历乃移其闰朔。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第七"
  },
  {
    "id": "mxbt-68",
    "text": "亦由天之有三百六十五度，天何尝有度？",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第八"
  },
  {
    "id": "mxbt-69",
    "text": "上使人微觇准所为，而准方酣寝于中书，鼻息如雷。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第九"
  },
  {
    "id": "mxbt-70",
    "text": "时苏子美在坐，颇骇怪，曰：皂隶如此野很，其令可知。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第十"
  },
  {
    "id": "mxbt-71",
    "text": "此乃三分法，其谓缘边入纳粮草，其价折为三分，一分支见钱，一分折犀象杂货，一分折茶尔，后又有并折盐为四分法，更改不一，皆非三说也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十一"
  },
  {
    "id": "mxbt-72",
    "text": "天圣中，监真州排岸司右禁陶鉴始议为复闸节水，以省舟船过埭之劳。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十二"
  },
  {
    "id": "mxbt-73",
    "text": "旧自吉底用柏木为干，上出井口，自木干垂绠而下，方能至水。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "权智第十三"
  },
  {
    "id": "mxbt-74",
    "text": "郭索，蟹行貌也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十四"
  },
  {
    "id": "mxbt-75",
    "text": "然古语已有二声合为一字者，如不可为叵，何不为盍，如是为尔，而已为耳之乎为诸之类，以西域二合之音，盖切字之原也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十五"
  },
  {
    "id": "mxbt-76",
    "text": "世之说者，皆谓夔、峡间至今有鬼户，乃夷人也，其主谓之鬼主，然不闻有乌鬼之说。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十六"
  },
  {
    "id": "mxbt-77",
    "text": "又有观画而以手摸之，相传以谓色不隐指者为佳画，此又在耳鉴之下，谓之揣骨听声。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "书画第十七"
  },
  {
    "id": "mxbt-78",
    "text": "有堑堵，谓如土墙者，两边杀，两头齐。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "技艺第十八"
  },
  {
    "id": "mxbt-79",
    "text": "其刻画甚繁，大体似缪篆，又如阑盾间所画回波曲水之文。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "器用第十九"
  },
  {
    "id": "mxbt-80",
    "text": "凡雷斧多以铜铁为之；楔乃石耳，似斧而无孔。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "神奇第二十"
  },
  {
    "id": "mxbt-81",
    "text": "是时新雨霁，见虹下帐前涧中。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "异事异疾附第二十一"
  },
  {
    "id": "mxbt-82",
    "text": "执政得之，不敢发，立具上闻。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "谬误谲诈附第二十二"
  },
  {
    "id": "mxbt-83",
    "text": "曼卿醉与之校，为街司所录。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "讥谑第二十三"
  },
  {
    "id": "mxbt-84",
    "text": "颇似淳漆，然之如麻，但烟甚浓，所沾幄幕皆黑。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十四"
  },
  {
    "id": "mxbt-85",
    "text": "信州铅山县有苦泉，流以为涧。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十五"
  },
  {
    "id": "mxbt-86",
    "text": "又言人有水喉、食喉、气喉者，亦谬说也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "药议第二十六"
  },
  {
    "id": "mxbt-87",
    "text": "后来检讨给职钱，并同带职在校勘之上，亦承例不试。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷一第二十七"
  },
  {
    "id": "mxbt-88",
    "text": "此以海上候之，得潮生之时。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷二第二十八"
  },
  {
    "id": "mxbt-89",
    "text": "余尝为守令图，虽以二寸折百里为分率，又立准望、牙融、傍验、高下、方斜、迂直七法，以取鸟飞之数。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷三第二十九"
  },
  {
    "id": "mxbt-90",
    "text": "及肃简病，有人密报肃简，但云今日有佳事。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "续笔谈十一篇第三十"
  },
  {
    "id": "mxbt-91",
    "text": "求共所从来，盖有所因。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "故事第一"
  },
  {
    "id": "mxbt-92",
    "text": "今人乃以粳米一斛之重为一石。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第三"
  },
  {
    "id": "mxbt-93",
    "text": "此皆未尝详考地理。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "辨证第四"
  },
  {
    "id": "mxbt-94",
    "text": "凡声之高下，列为五等，以宫、商、角、征、羽名之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第五"
  },
  {
    "id": "mxbt-95",
    "text": "稹诗言八十一调，人多不喻所谓。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "乐律第六"
  },
  {
    "id": "mxbt-96",
    "text": "熙宁十年，天正元用午时。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第七"
  },
  {
    "id": "mxbt-97",
    "text": "以日行三百六十五日而一期，强谓之度，以步日月五星行次而已。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "象数第八"
  },
  {
    "id": "mxbt-98",
    "text": "人以其一时镇物，比之谢安。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第九"
  },
  {
    "id": "mxbt-99",
    "text": "子美归吴中月余，得蒋书曰：县令果健者。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "人事第十"
  },
  {
    "id": "mxbt-100",
    "text": "余在三司，求得三说旧案。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十一"
  },
  {
    "id": "mxbt-101",
    "text": "是时工部郎中方仲荀、文思使张纶为发运使、副，表行之，始为真州闸。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "官政第十二"
  },
  {
    "id": "mxbt-102",
    "text": "井侧设大车绞之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "权智第十三"
  },
  {
    "id": "mxbt-103",
    "text": "韩退之集中罗池神碑铭有春与猿吟兮秋与鹤飞，今验石刻，乃春与猿吟兮秋鹤与飞。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十四"
  },
  {
    "id": "mxbt-104",
    "text": "殆与声俱生，莫知从来。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十五"
  },
  {
    "id": "mxbt-105",
    "text": "又鬼户者，夷人所称，又非人家所养。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "艺文第十六"
  },
  {
    "id": "mxbt-106",
    "text": "欧阳公尝得一古画牡丹丛，其下有一猫，未知其精粗。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "书画第十七"
  },
  {
    "id": "mxbt-107",
    "text": "其法并上下广，折半以为之广以直高乘之，以直高以股，以上广减下广，余者半之为勾。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "技艺第十八"
  },
  {
    "id": "mxbt-108",
    "text": "中间有二目，如大弹丸，突起。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "器用第十九"
  },
  {
    "id": "mxbt-109",
    "text": "世传雷州多雷，有雷祠在焉，其间多雷斧、雷楔。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "神奇第二十"
  },
  {
    "id": "mxbt-110",
    "text": "余与同职扣涧观之，虹两头皆笄涧中。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "异事异疾附第二十一"
  },
  {
    "id": "mxbt-111",
    "text": "洎发之，乃表也，深自叙致，词颇哀切。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "谬误谲诈附第二十二"
  },
  {
    "id": "mxbt-112",
    "text": "曼卿诡怪不羁，谓主者曰：只乞就本厢科决，欲诘旦归馆供职。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "讥谑第二十三"
  },
  {
    "id": "mxbt-113",
    "text": "余疑其烟可用，试扫其煤以为墨，黑光如漆，松墨不及也，遂大为之，其识文为延川石液者是也。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十四"
  },
  {
    "id": "mxbt-114",
    "text": "挹其水熬之，则成胆矾。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "杂志第二十五"
  },
  {
    "id": "mxbt-115",
    "text": "世传欧希范真五脏图，亦画三喉，盖当时验之不审耳。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "药议第二十六"
  },
  {
    "id": "mxbt-116",
    "text": "兴国中，琴待诏朱文济鼓琴为天下第一。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷一第二十七"
  },
  {
    "id": "mxbt-117",
    "text": "去海远，即须据地理增添时刻。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷二第二十八"
  },
  {
    "id": "mxbt-118",
    "text": "图成，得方隅远近之实，始可施此法，分四至、八到为二十四至，以十二支、甲乙丙丁庚辛壬癸八干、乾坤艮巽四卦名之。",
    "source": "《梦溪笔谈》",
    "book": "梦溪笔谈",
    "chapter": "补笔谈卷三第二十九"
  }
]