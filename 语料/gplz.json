[
  {
    "id": "gplz-1",
    "text": "公孙龙，六国时辩士也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-2",
    "text": "白马非马，可乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-3",
    "text": "物莫非指，而指非指。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-4",
    "text": "天地与其所产焉，物也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-5",
    "text": "坚白石三可乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-6",
    "text": "疾名实之散乱，因资材之所长，为守白之论。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-7",
    "text": "天下无指，物无可以谓物。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-8",
    "text": "物以物其所物而不过焉，实也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-9",
    "text": "假物取譬，以守白辩，谓白马为非马也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-10",
    "text": "命色者非名形也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-11",
    "text": "非指者天下，而物可谓指乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-12",
    "text": "实以实其所实而不旷焉，位也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-13",
    "text": "白马为非马者，言白所以名色，言马所以名形也；色非形，形非色也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-14",
    "text": "故曰：白马非马。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-15",
    "text": "指也者，天下之所无也；物也者，天下之所有也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-16",
    "text": "出其所位，非位，位其所位焉，正也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-17",
    "text": "夫言色则形不当与，言形则色不宜从，今合以为物，非也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-18",
    "text": "以天下之所有，为天下之所无，未可。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-19",
    "text": "以其所正，正其所不正；以其所不正，疑其所正。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-20",
    "text": "不可以应有白马，则所求之马亡矣；亡则白马竟非马。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-21",
    "text": "不可谓无马者，非马也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-22",
    "text": "天下无指，而物不可谓指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-23",
    "text": "其正者，正其所实也；正其所实者，正其名也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-24",
    "text": "欲推是辩，以正名实而化天下焉。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-25",
    "text": "有白马为有马，白之，非马何也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-26",
    "text": "不可谓指者，非指也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-27",
    "text": "其名正则唯乎其彼此焉。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-28",
    "text": "坚、白不相外，藏三，可乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-29",
    "text": "龙于孔穿会赵平原君家。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-30",
    "text": "非指者，物莫非指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-31",
    "text": "谓彼而彼不唯乎彼，则彼谓不行；谓此而此不唯乎此，则此谓不行。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-32",
    "text": "有自藏也，非藏而藏也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-33",
    "text": "穿曰：素闻先生高谊，愿为弟子久，但不取先生以白马为非马耳！",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-34",
    "text": "是白马乃马也，是所求一也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-35",
    "text": "天下无指而物不可谓指者，非有非指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-36",
    "text": "其以当不当也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-37",
    "text": "请去此术，则穿请为弟子。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-38",
    "text": "所求一者，白者不异马也，所求不异，如黄、黑马有可有不可，何也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-39",
    "text": "非有非指者，物莫非指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-40",
    "text": "不当而当，乱也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-41",
    "text": "龙曰：先生之言悖。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-42",
    "text": "可与不可，其相非明。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-43",
    "text": "物莫非指者，而指非指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-44",
    "text": "故彼彼当乎彼，则唯乎彼，其谓行彼；此此当乎此，则唯乎此，其谓行此。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-45",
    "text": "离也者，藏也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-46",
    "text": "龙之所以为名者，乃以白马之论尔！",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-47",
    "text": "天下无指者，生于物之各有名，不为指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-48",
    "text": "其以当而当也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-49",
    "text": "今使龙去之，则无以教焉。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-50",
    "text": "天下无马可乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-51",
    "text": "不为指而谓之指，是无不为指。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-52",
    "text": "以当而当，正也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-53",
    "text": "今使龙去之，此先教而后师也；先教而后师之者，悖。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-54",
    "text": "龙闻楚王张繁弱之弓，载亡归之矢，以射蛟口于云梦之圃，而丧其弓。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-55",
    "text": "左右请求之。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-56",
    "text": "使马无色，有马如已耳，安取白马？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-57",
    "text": "以有不为指之无不为指，未可。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-58",
    "text": "故彼彼止于彼，此此止于此，可。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-59",
    "text": "不定者，兼。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-60",
    "text": "楚人遗弓，楚人得之，又何求乎？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-61",
    "text": "故白马非马也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-62",
    "text": "以指者天下之所无。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-63",
    "text": "彼此而彼且此，此彼而此且彼，不可。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-64",
    "text": "恶乎其石也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-65",
    "text": "’仲尼闻之曰：‘楚王仁义而未遂也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-66",
    "text": "白马者，马与白也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-67",
    "text": "天下无指者，物不可谓无指也；不可谓无指者。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-68",
    "text": "夫名，实谓也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-69",
    "text": "亦曰人亡弓，人得之而已，何必楚？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-70",
    "text": "黑与白，马也？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-71",
    "text": "非有非指也；非有非指者，物莫非指、指非非指也，指与物非指也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-72",
    "text": "知此之非此也，知此之不在此也，则不谓也；知彼之非彼也，知彼之不在彼也，则不谓也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-73",
    "text": "是不俱有而或类焉。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "通变论第五"
  },
  {
    "id": "gplz-74",
    "text": "不相离也，固乎然，其无已！",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "坚白论第六"
  },
  {
    "id": "gplz-75",
    "text": "’若此，仲尼异‘楚人’与所谓‘人’。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-76",
    "text": "使天下无物指，谁径谓非指？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-77",
    "text": "至矣哉，古之明王。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-78",
    "text": "羊有角，牛有角，牛之而羊也，未可。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "通变论第五"
  },
  {
    "id": "gplz-79",
    "text": "夫是仲尼异‘楚人’与所谓‘人’，而非龙‘白马’于所谓‘马’，悖。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "迹府第一"
  },
  {
    "id": "gplz-80",
    "text": "合马与白，复名白马。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "白马论第二"
  },
  {
    "id": "gplz-81",
    "text": "天下无物，谁径谓指？",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "指物论第三"
  },
  {
    "id": "gplz-82",
    "text": "审其名实，慎其所谓。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "名实论第四"
  },
  {
    "id": "gplz-83",
    "text": "是俱有而类之不同也。",
    "source": "《公孙龙子》",
    "book": "公孙龙子",
    "chapter": "通变论第五"
  },
  {
    "id": "gplz-84",
    "text": "故有知焉，有不知焉；有见焉，。",
    "source": "《公孙龙子》",
