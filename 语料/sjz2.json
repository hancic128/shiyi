[
  {
    "id": "sjz2-1",
    "text": "序曰：易称天以一生水，故气微于北方，而为物之先也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "序"
  },
  {
    "id": "sjz2-2",
    "text": "仑墟在西北，三成为昆仑丘。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷一"
  },
  {
    "id": "sjz2-3",
    "text": "又南入葱岭山，又从葱岭出而东北流。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二"
  },
  {
    "id": "sjz2-4",
    "text": "北过北地富平县西，河侧有两山相对，水出其间，即上河峡也，世谓之为青山峡。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三"
  },
  {
    "id": "sjz2-5",
    "text": "又南过河东北屈县西，河水南径北屈县故城西，西四十里有风山，上有穴如轮，风气萧瑟，习常不止，当其冲飘也，略无生草，盖常不定，众风之门故也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷四"
  },
  {
    "id": "sjz2-6",
    "text": "又东过平县北，湛水从北来注之。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷五"
  },
  {
    "id": "sjz2-7",
    "text": "汾水出太原汾阳县北管涔山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷六"
  },
  {
    "id": "sjz2-8",
    "text": "济水出河东垣县东王屋山，为沇水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷七"
  },
  {
    "id": "sjz2-9",
    "text": "又东至乘氏县西，分为二，春秋左传傅公三十一年，分曹地东傅，于济。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷八"
  },
  {
    "id": "sjz2-10",
    "text": "清水出河内修武县之北黑山，黑山在县北白鹿山东，清水所出也，上承诸陂散泉，积以成川。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷九"
  },
  {
    "id": "sjz2-11",
    "text": "浊漳水出上党长子县西发鸠山，漳水出鹿谷山，与发鸠连麓而在南。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十"
  },
  {
    "id": "sjz2-12",
    "text": "易水出涿郡故安县阎乡西山，易水出西山宽中谷，东径五大夫城南。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十一"
  },
  {
    "id": "sjz2-13",
    "text": "圣水出上谷，故燕地，秦始皇二十三年，置上谷郡。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十二"
  },
  {
    "id": "sjz2-14",
    "text": "漯水出雁门阴馆县，东北过代郡桑干县南，漯水出于累头山，一曰治水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十三"
  },
  {
    "id": "sjz2-15",
    "text": "湿余水出上谷居庸关东，关在沮阳城东南六十里居庸界，故关名矣。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十四"
  },
  {
    "id": "sjz2-16",
    "text": "洛水出京兆上洛县遭举山，地理志曰：洛出冢岭山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十五"
  },
  {
    "id": "sjz2-17",
    "text": "谷水出宏农黾池县南墦冢林谷阳谷，山海经曰：傅山之西有林焉，曰墦冢，谷水出焉，东流注于洛，其中多玉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十六"
  },
  {
    "id": "sjz2-18",
    "text": "渭水出陇西首阳县渭谷亭南鸟鼠山，渭水出首阳县首阳山渭首亭南谷，山在鸟鼠山西北。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十七"
  },
  {
    "id": "sjz2-19",
    "text": "又东过武功县北，渭水于县，斜水自南来注之。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十八"
  },
  {
    "id": "sjz2-20",
    "text": "又东过槐里县南，又东，涝水从南来注之。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十九"
  },
  {
    "id": "sjz2-21",
    "text": "漾水出陇西氏道县.冢山，东至武都沮县为汉水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十"
  },
  {
    "id": "sjz2-22",
    "text": "汝水出河南梁县勉乡西天息山，地理志曰：出高陵山，即猛山也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十一"
  },
  {
    "id": "sjz2-23",
    "text": "颍水出颍川阳城县西北少室山，秦始皇十七年，灭韩，以其地为颍川郡，盖因水以著称者也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十二"
  },
  {
    "id": "sjz2-24",
    "text": "阴沟水出河南阳武县蒗渠，阴沟首受大河于卷县，故渎东南径卷县故城南，又东径蒙城北。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十三"
  },
  {
    "id": "sjz2-25",
    "text": "睢水出梁郡鄢县，睢水出陈留县西蒗渠，东北流。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十四"
  },
  {
    "id": "sjz2-26",
    "text": "泗水出鲁卞县北山，地理志曰，出济阴乘氏县。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十五"
  },
  {
    "id": "sjz2-27",
    "text": "沭水出琅邪东莞县西北山，大弁山与小泰山连麓而异名也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十六"
  },
  {
    "id": "sjz2-28",
    "text": "沔水出武都沮县东狼谷口，沔水一名沮水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十七"
  },
  {
    "id": "sjz2-29",
    "text": "沔水又东过堵阳县，堵水出自上粉县，北流注之。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十八"
  },
  {
    "id": "sjz2-30",
    "text": "沔水与江合流，又东过彭蠡泽，尚书。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十九"
  },
  {
    "id": "sjz2-31",
    "text": "淮水出南阳平氏县胎替山，东北过桐柏山，山海经曰：淮出余山，在朝阳东，义乡西。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十"
  },
  {
    "id": "sjz2-32",
    "text": "滍水出南阳鲁阳县西之尧山，尧之未孙刘累，以龙食帝孔甲，孔甲又求之，不得。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十一"
  },
  {
    "id": "sjz2-33",
    "text": "漻水出江夏平春县西，漻水北出大义山，南至厉乡西，赐水入焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十二"
  },
  {
    "id": "sjz2-34",
    "text": "岷山在蜀郡氐道县，大江所出，东南过其县北。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十三"
  },
  {
    "id": "sjz2-35",
    "text": "又东出江关，入南郡界。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十四"
  },
  {
    "id": "sjz2-36",
    "text": "又东至华容县西，夏水出焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十五"
  },
  {
    "id": "sjz2-37",
    "text": "青衣水出青衣县西蒙山，东与沫水合也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十六"
  },
  {
    "id": "sjz2-38",
    "text": "淹水出越巂遂久县徼外，吕忱曰：淹水，一曰复水也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十七"
  },
  {
    "id": "sjz2-39",
    "text": "资水出零陵都梁县路山，资水出武陵郡无阳县界唐𫄙山，盖路山之别名也，谓之大溪水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十八"
  },
  {
    "id": "sjz2-40",
    "text": "洭水出桂阳县卢聚，水出桂阳县西北上驿山卢溪，为卢溪水，东南流径桂阳县故城，谓之洭水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十九"
  },
  {
    "id": "sjz2-41",
    "text": "江以南至日南郡二十水，禹贡山水泽地所在，江水出三天子都，山海经谓之浙江也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷四十"
  },
  {
    "id": "sjz2-42",
    "text": "玄中记曰：天下之多者水也，浮天载地，高下无所不至，万物无所不润。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "序"
  },
  {
    "id": "sjz2-43",
    "text": "昆仑说曰：昆仑之山三级：下曰樊桐，一名板桐；二曰玄圃，一名阆风；上曰层城，一名天庭；是为太帝之居。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷一"
  },
  {
    "id": "sjz2-44",
    "text": "河水重源有三，非惟二也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二"
  },
  {
    "id": "sjz2-45",
    "text": "河水历峡北注，枝分东出。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三"
  },
  {
    "id": "sjz2-46",
    "text": "风山西四十里，河南孟门山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷四"
  },
  {
    "id": "sjz2-47",
    "text": "河水又东径河阳县故城南。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷五"
  },
  {
    "id": "sjz2-48",
    "text": "山海经曰：北次二经之首，在河之东，其首枕汾，曰管涔之山，其上无木，而下多玉，汾水出焉，西流注于河。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷六"
  },
  {
    "id": "sjz2-49",
    "text": "山海经曰：王屋之山联水出焉，西北流，注于秦泽。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷七"
  },
  {
    "id": "sjz2-50",
    "text": "济水自是东北流，出巨泽。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷八"
  },
  {
    "id": "sjz2-51",
    "text": "南流西南屈，瀑布乘岩，悬河注壑二十余丈，雷赴之声，震动山谷。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷九"
  },
  {
    "id": "sjz2-52",
    "text": "淮南子谓之发苞山，故异名互见也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十"
  },
  {
    "id": "sjz2-53",
    "text": "昔北平侯王谭，不从王莽之政，子兴生五子。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十一"
  },
  {
    "id": "sjz2-54",
    "text": "王隐晋书地道志曰：郡在谷之头，故因以上谷名焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十二"
  },
  {
    "id": "sjz2-55",
    "text": "泉发于山侧，沿波历涧，东北流出山，径阴馆县故城西。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十三"
  },
  {
    "id": "sjz2-56",
    "text": "更始使者入上谷，耿况迎之于居庸关，即是关也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十四"
  },
  {
    "id": "sjz2-57",
    "text": "山海经曰：出上洛西山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十五"
  },
  {
    "id": "sjz2-58",
    "text": "今谷水出千崤东马头山谷阳谷，东北流历黾池川，本中乡地也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十六"
  },
  {
    "id": "sjz2-59",
    "text": "此县有高城岭，岭上有城，号渭源城，渭水出焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十七"
  },
  {
    "id": "sjz2-60",
    "text": "水出县西南衙岭山，北历斜谷，径五丈原东。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十八"
  },
  {
    "id": "sjz2-61",
    "text": "渭水径县之故城南。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十九"
  },
  {
    "id": "sjz2-62",
    "text": "常璩华阳国志曰：汉水有二源，东源出武都氐道县漾山，为漾水。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十"
  },
  {
    "id": "sjz2-63",
    "text": "亦言出南阳鲁阳县之大盂山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十一"
  },
  {
    "id": "sjz2-64",
    "text": "汉高帝二年，以为韩国。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十二"
  },
  {
    "id": "sjz2-65",
    "text": "史记秦庄襄王元年，蒙骛击取成皋、荥阳，初置三川郡，疑即骛所筑也，干事未洋。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十三"
  },
  {
    "id": "sjz2-66",
    "text": "地理志曰：睢水首受陈留浚仪狼汤水也，经言出鄢，非矣。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十四"
  },
  {
    "id": "sjz2-67",
    "text": "又云：出卞县北。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十五"
  },
  {
    "id": "sjz2-68",
    "text": "引控众流，积以成川。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十六"
  },
  {
    "id": "sjz2-69",
    "text": "阚骃曰：以其初出沮洳然，故曰沮水也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十七"
  },
  {
    "id": "sjz2-70",
    "text": "堵水出建平郡界故亭谷，东历新城郡。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十八"
  },
  {
    "id": "sjz2-71",
    "text": "禹贡汇泽也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二十九"
  },
  {
    "id": "sjz2-72",
    "text": "尚书：导淮自桐柏。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十"
  },
  {
    "id": "sjz2-73",
    "text": "累惧而迁于鲁县，立尧祠于西山，谓之尧山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十一"
  },
  {
    "id": "sjz2-74",
    "text": "水源东出大紫山，分为二水，一水西径厉乡南，水南有重山，即烈山也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十二"
  },
  {
    "id": "sjz2-75",
    "text": "岷山即渎山也，水曰渎水矣。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十三"
  },
  {
    "id": "sjz2-76",
    "text": "江水自关，东径弱关、捍关。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十四"
  },
  {
    "id": "sjz2-77",
    "text": "江水左迤为中夏水，右则中郎浦出焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十五"
  },
  {
    "id": "sjz2-78",
    "text": "县故青衣羌国也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十六"
  },
  {
    "id": "sjz2-79",
    "text": "东南至青蛉县。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十七"
  },
  {
    "id": "sjz2-80",
    "text": "东北径邵陵郡武冈县南，县分都梁之所置也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十八"
  },
  {
    "id": "sjz2-81",
    "text": "地理志曰：洭水出桂阳，南至四会是也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三十九"
  },
  {
    "id": "sjz2-82",
    "text": "地理志云：水出丹阳黟县南蛮中，北径其县，南有博山，山上有石，特起十丈，上峰若剑杪。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷四十"
  },
  {
    "id": "sjz2-83",
    "text": "及其气流届石，精薄肤寸，不崇朝而泽合灵宇者，神莫与并矣。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "序"
  },
  {
    "id": "sjz2-84",
    "text": "去嵩高五万里，地之中也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷一"
  },
  {
    "id": "sjz2-85",
    "text": "一源西出捐毒之国葱岭之上。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷二"
  },
  {
    "id": "sjz2-86",
    "text": "河水又北径富平县故城西。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷三"
  },
  {
    "id": "sjz2-87",
    "text": "山海经曰：孟门之山，其上多金玉，其下多黄垩、涅石。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷四"
  },
  {
    "id": "sjz2-88",
    "text": "春秋经书天王狩于河阳，王申，公朝于王所，晋侯执卫侯归于京师，春秋左传僖公二十八年，冬，会于温，执卫侯。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷五"
  },
  {
    "id": "sjz2-89",
    "text": "十三州志曰：出武州之燕京山。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷六"
  },
  {
    "id": "sjz2-90",
    "text": "郭景纯云：联、沇声相近，即沇水也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷七"
  },
  {
    "id": "sjz2-91",
    "text": "其一水东南流，其一水从县东北流，入巨野泽。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷八"
  },
  {
    "id": "sjz2-92",
    "text": "左右石壁层深，兽迹不交，隍中散水雾合，视不见底。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷九"
  },
  {
    "id": "sjz2-93",
    "text": "左则阳泉水注之，右则伞盖水入焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十"
  },
  {
    "id": "sjz2-94",
    "text": "并避时乱，隐居此山，故其旧居，世以为五大夫城，即此。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十一"
  },
  {
    "id": "sjz2-95",
    "text": "王莽更名朔调也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十二"
  },
  {
    "id": "sjz2-96",
    "text": "县，故楼烦乡也。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十三"
  },
  {
    "id": "sjz2-97",
    "text": "其水导源关山，南流历故关下。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十四"
  },
  {
    "id": "sjz2-98",
    "text": "又曰：讙举之山，洛水出焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十五"
  },
  {
    "id": "sjz2-99",
    "text": "汉景帝中二年，初城，徙万户为县，因崤黾之池以目县焉。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十六"
  },
  {
    "id": "sjz2-100",
    "text": "三源合注，东北流径首阳县西，与别源合，水南出鸟鼠山渭水谷，尚书。",
    "source": "《水经注》",
    "book": "水经注",
    "chapter": "卷十七"
  }
]