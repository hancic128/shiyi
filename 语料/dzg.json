[
  {
    "id": "dzg-1",
    "text": "弟子规，圣人训。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "总叙第一"
  },
  {
    "id": "dzg-2",
    "text": "父母呼，应勿缓。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-3",
    "text": "兄道友，弟道恭。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-4",
    "text": "朝起早，夜眠迟。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-5",
    "text": "凡出言，信为先。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-6",
    "text": "凡是人，皆须爱。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-7",
    "text": "同是人，类不齐，流俗众，仁者希。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "亲仁第七"
  },
  {
    "id": "dzg-8",
    "text": "不力行，但学文。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-9",
    "text": "首孝悌，次谨信。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "总叙第一"
  },
  {
    "id": "dzg-10",
    "text": "父母命，行勿懒。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-11",
    "text": "兄弟睦，孝在中。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-12",
    "text": "老易至，惜此时。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-13",
    "text": "诈与妄，奚可焉？",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-14",
    "text": "天同覆，地同载。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-15",
    "text": "果仁者，人多畏，言不讳，色不媚。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "亲仁第七"
  },
  {
    "id": "dzg-16",
    "text": "长浮华，成何人。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-17",
    "text": "泛爱众，而亲仁。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "总叙第一"
  },
  {
    "id": "dzg-18",
    "text": "父母教，须敬听。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-19",
    "text": "财物轻，怨何生。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-20",
    "text": "晨必盥，兼漱口。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-21",
    "text": "话说多，不如少。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-22",
    "text": "行高者，名自高。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-23",
    "text": "能亲仁，无限好，德日进，过日少。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "亲仁第七"
  },
  {
    "id": "dzg-24",
    "text": "但力行，不学文。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-25",
    "text": "有余力，则学文。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "总叙第一"
  },
  {
    "id": "dzg-26",
    "text": "父母责，须顺承。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-27",
    "text": "言语忍，忿自泯。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-28",
    "text": "便溺回，辄净手。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-29",
    "text": "惟其是，勿佞巧。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-30",
    "text": "人所重，非貌高。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-31",
    "text": "不亲仁，无限害，小人进，百事坏。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "亲仁第七"
  },
  {
    "id": "dzg-32",
    "text": "任己见，昧理真。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-33",
    "text": "冬则温，夏则凊。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-34",
    "text": "或饮食，或坐走。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-35",
    "text": "冠必正，纽必结。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-36",
    "text": "奸巧语，秽污词。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-37",
    "text": "才大者，望自大。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-38",
    "text": "读书法，有三到。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-39",
    "text": "晨则省，昏则定。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-40",
    "text": "长者先，幼者后。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-41",
    "text": "袜与履，俱紧切。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-42",
    "text": "市井气，切戒之。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-43",
    "text": "人所服，非言大。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-44",
    "text": "心眼口，信皆要。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-45",
    "text": "出必告，反必面。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-46",
    "text": "长呼人，即代叫。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-47",
    "text": "置冠服，有定位。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-48",
    "text": "见未真，勿轻言。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-49",
    "text": "己有能，勿自私。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-50",
    "text": "方读此，勿慕彼。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-51",
    "text": "居有常，业无变。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-52",
    "text": "人不在，己即到。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-53",
    "text": "勿乱顿，致污秽。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-54",
    "text": "知未的，勿轻传。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-55",
    "text": "人所能，勿轻訾。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-56",
    "text": "此未终，彼勿起。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-57",
    "text": "事虽小，勿擅为。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-58",
    "text": "称尊长，勿呼名。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-59",
    "text": "衣贵洁，不贵华。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-60",
    "text": "事非宜，勿轻诺。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-61",
    "text": "勿谄富，勿骄贫。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-62",
    "text": "宽为限，紧用功。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-63",
    "text": "苟擅为，子道亏。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-64",
    "text": "对尊长，勿见能。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-65",
    "text": "上循分，下称家。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-66",
    "text": "苟轻诺，进退错。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-67",
    "text": "勿厌故，勿喜新。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-68",
    "text": "工夫到，滞塞通。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-69",
    "text": "物虽小，勿私藏。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-70",
    "text": "路遇长，疾趋揖。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-71",
    "text": "对饮食，勿拣择。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-72",
    "text": "凡道字，重且舒。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-73",
    "text": "人不闲，勿事搅。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-74",
    "text": "心有疑，随札记。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-75",
    "text": "苟私藏，亲心伤。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-76",
    "text": "长无言，退恭立。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-77",
    "text": "食适可，勿过则。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-78",
    "text": "勿急疾，勿模糊。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-79",
    "text": "人不安，勿话扰。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-80",
    "text": "就人问，求确义。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-81",
    "text": "亲所好，力为具。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-82",
    "text": "骑下马，乘下车。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-83",
    "text": "年方少，勿饮酒。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-84",
    "text": "彼说长，此说短。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-85",
    "text": "人有短，切莫揭。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-86",
    "text": "房室清，墙壁净。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-87",
    "text": "亲所恶，谨为去。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-88",
    "text": "过犹待，百步余。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-89",
    "text": "饮酒醉，最为丑。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-90",
    "text": "不关己，莫闲管。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-91",
    "text": "人有私，切莫说。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-92",
    "text": "几案洁，笔砚正。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-93",
    "text": "身有伤，贻亲忧。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-94",
    "text": "长者立，幼勿坐。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-95",
    "text": "步从容，立端正。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-96",
    "text": "见人善，即思齐。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-97",
    "text": "道人善，即是善。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-98",
    "text": "墨磨偏，心不端。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-99",
    "text": "德有伤，贻亲羞。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-100",
    "text": "长者坐，命乃坐。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-101",
    "text": "揖深圆，拜恭敬。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-102",
    "text": "纵去远，以渐跻。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-103",
    "text": "人知之，愈思勉。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-104",
    "text": "字不敬，心先病。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-105",
    "text": "亲爱我，孝何难。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-106",
    "text": "尊长前，声要低。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-107",
    "text": "勿践阈，勿跛倚。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-108",
    "text": "见人恶，即内省。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-109",
    "text": "扬人恶，即是恶。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-110",
    "text": "列典籍，有定处。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-111",
    "text": "亲憎我，孝方贤。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-112",
    "text": "低不闻，却非宜。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-113",
    "text": "勿箕踞，勿摇髀。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-114",
    "text": "有则改，无加警。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-115",
    "text": "疾之甚，祸且作。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-116",
    "text": "读看毕，还原处。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-117",
    "text": "亲有过，谏使更。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-118",
    "text": "进必趋，退必迟。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-119",
    "text": "缓揭帘，勿有声。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-120",
    "text": "唯德学，唯才艺。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-121",
    "text": "善相劝，德皆建。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-122",
    "text": "虽有急，卷束齐。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-123",
    "text": "怡吾色，柔吾声。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-124",
    "text": "问起对，视勿移。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-125",
    "text": "宽转弯，勿触棱。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-126",
    "text": "不如人，当自砺。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-127",
    "text": "过不规，道两亏。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-128",
    "text": "有缺坏，就补之。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-129",
    "text": "谏不入，悦复谏。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-130",
    "text": "事诸父，如事父。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-131",
    "text": "执虚器，如执盈。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-132",
    "text": "不如人，勿生戚。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-133",
    "text": "凡取与，贵分晓。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-134",
    "text": "非圣书，屏勿视。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-135",
    "text": "号泣随，挞无怨。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-136",
    "text": "事诸兄，如事兄。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "出则悌第三"
  },
  {
    "id": "dzg-137",
    "text": "入虚室，如有人。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-138",
    "text": "闻过怒，闻誉乐。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-139",
    "text": "与宜多，取宜少。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-140",
    "text": "蔽聪明，坏心志。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-141",
    "text": "亲有疾，药先尝。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-142",
    "text": "事勿忙，忙多错。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-143",
    "text": "损友来，益友却。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-144",
    "text": "将加人，先问己。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-145",
    "text": "勿自暴，勿自弃。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-146",
    "text": "昼夜侍，不离床。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-147",
    "text": "勿畏难，勿轻略。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-148",
    "text": "闻誉恐，闻过欣。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-149",
    "text": "己不欲，即速已。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-150",
    "text": "圣与贤，可驯致。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "余力学文第八"
  },
  {
    "id": "dzg-151",
    "text": "丧三年，常悲咽。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-152",
    "text": "斗闹场，绝勿近。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-153",
    "text": "直谅士，渐相亲。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-154",
    "text": "恩欲报，怨欲忘。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-155",
    "text": "居处变，酒肉绝。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-156",
    "text": "邪僻事，绝勿问。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-157",
    "text": "无心非，名为错。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-158",
    "text": "报怨短，报恩长。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-159",
    "text": "丧尽礼，祭尽诚。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-160",
    "text": "将入门，问孰存。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-161",
    "text": "有心非，名为恶。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-162",
    "text": "待婢仆，身贵端。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-163",
    "text": "事死者，如事生。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "入则孝第二"
  },
  {
    "id": "dzg-164",
    "text": "将上堂，声必扬。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-165",
    "text": "过能改，归于无。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-166",
    "text": "虽贵端，慈而宽。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-167",
    "text": "人问谁，对以名。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  },
  {
    "id": "dzg-168",
    "text": "倘掩饰，增一辜。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "信第五"
  },
  {
    "id": "dzg-169",
    "text": "势服人，心不然。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "泛爱众第六"
  },
  {
    "id": "dzg-170",
    "text": "吾与我，不分明。",
    "source": "《弟子规》",
    "book": "弟子规",
    "chapter": "谨第四"
  }
]