[
  {
    "id": "szj-1",
    "text": "人之初，性本善。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-2",
    "text": "性相近，习相远。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-3",
    "text": "苟不教，性乃迁。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-4",
    "text": "教之道，贵以专。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-5",
    "text": "昔孟母，择邻处。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-6",
    "text": "子不学，断机杼。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-7",
    "text": "窦燕山，有义方。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-8",
    "text": "教五子，名俱扬。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "人之初"
  },
  {
    "id": "szj-9",
    "text": "养不教，父之过。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-10",
    "text": "教不严，师之惰。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-11",
    "text": "子不学，非所宜。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-12",
    "text": "幼不学，老何为。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-13",
    "text": "玉不琢，不成器。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-14",
    "text": "人不学，不知义。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-15",
    "text": "为人子，方少时。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-16",
    "text": "亲师友，习礼仪。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "养不教"
  },
  {
    "id": "szj-17",
    "text": "香九龄，能温席。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-18",
    "text": "孝于亲，所当执。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-19",
    "text": "融四岁，能让梨，悌于长，宜先知。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-20",
    "text": "首孝悌，次见闻。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-21",
    "text": "知某数，识某文。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-22",
    "text": "一而十，十而百。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-23",
    "text": "百而千，千而万。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "香九龄"
  },
  {
    "id": "szj-24",
    "text": "三才者，天地人。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-25",
    "text": "三光者，日月星。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-26",
    "text": "三纲者，君臣义。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-27",
    "text": "父子亲，夫妇顺。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-28",
    "text": "曰春夏，曰秋冬。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-29",
    "text": "此四时，运不穷。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-30",
    "text": "曰南北，曰西东。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-31",
    "text": "此四方，应乎中。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三才者"
  },
  {
    "id": "szj-32",
    "text": "曰水火，木金土。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-33",
    "text": "此五行，本乎数。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-34",
    "text": "十干者，甲至癸。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-35",
    "text": "十二支，子至亥。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-36",
    "text": "曰黄道，日所躔。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-37",
    "text": "曰赤道，当中权。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-38",
    "text": "赤道下，温暖极。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-39",
    "text": "我中华，在东北。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰水火"
  },
  {
    "id": "szj-40",
    "text": "寒燠均，霜露改。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-41",
    "text": "右高原，左大海。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-42",
    "text": "曰江河，曰淮济。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-43",
    "text": "此四渎，水之纪。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-44",
    "text": "曰岱华，嵩恒衡。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-45",
    "text": "此五岳，山之名。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-46",
    "text": "古九州，今改制，称行省，三十五。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "寒燠均"
  },
  {
    "id": "szj-47",
    "text": "曰士农，曰工商。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-48",
    "text": "此四民，国之良。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-49",
    "text": "曰仁义，礼智信。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-50",
    "text": "此五常，不容紊。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-51",
    "text": "地所生，有草木。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-52",
    "text": "此植物，遍水陆。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-53",
    "text": "有虫鱼，有鸟兽。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-54",
    "text": "此动物，能飞走。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "曰士农"
  },
  {
    "id": "szj-55",
    "text": "稻粱菽，麦黍稷。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-56",
    "text": "此六谷，人所食。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-57",
    "text": "马牛羊，鸡犬豕。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-58",
    "text": "此六畜，人所饲。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-59",
    "text": "曰喜怒，曰哀惧。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-60",
    "text": "爱恶欲，七情俱。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-61",
    "text": "青赤黄，及黑白。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-62",
    "text": "此五色，目所识。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "稻粱菽"
  },
  {
    "id": "szj-63",
    "text": "酸苦甘，及辛咸。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-64",
    "text": "此五味，口所含。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-65",
    "text": "膻焦香，及腥朽。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-66",
    "text": "此五臭，鼻所嗅。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-67",
    "text": "匏土革，木石金。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-68",
    "text": "丝与竹，乃八音。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-69",
    "text": "曰平上，曰去入。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-70",
    "text": "此四声，宜调协。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "酸苦甘"
  },
  {
    "id": "szj-71",
    "text": "高曾祖，父而身。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-72",
    "text": "身而子，子而孙。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-73",
    "text": "自子孙，至玄曾。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-74",
    "text": "父子恩，夫妇从。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-75",
    "text": "兄则友，弟则恭。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-76",
    "text": "长幼序，友与朋。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-77",
    "text": "君则敬，臣则忠。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "高曾祖"
  },
  {
    "id": "szj-78",
    "text": "此十义，人所同。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-79",
    "text": "当师叙，勿违背。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-80",
    "text": "斩齐衰，大小功。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-81",
    "text": "至缌麻，五服终。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-82",
    "text": "礼乐射，御书数。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-83",
    "text": "古六艺，今不具。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-84",
    "text": "惟书学，人共遵。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-85",
    "text": "既识字，讲说文。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "此十义"
  },
  {
    "id": "szj-86",
    "text": "有古文，大小篆。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-87",
    "text": "隶草继，不可乱。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-88",
    "text": "但略说，能知原。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-89",
    "text": "凡训蒙，须讲究。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-90",
    "text": "详训诂，明句读。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-91",
    "text": "为学者，必有初。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-92",
    "text": "小学终，至四书。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "有古文"
  },
  {
    "id": "szj-93",
    "text": "论语者，二十篇。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-94",
    "text": "群弟子，记善言。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-95",
    "text": "孟子者，七篇止。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-96",
    "text": "讲道德，说仁义。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-97",
    "text": "作中庸，乃孔伋。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-98",
    "text": "中不偏，庸不易。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-99",
    "text": "作大学，乃曾子。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-100",
    "text": "自修齐，至平治。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "论语者"
  },
  {
    "id": "szj-101",
    "text": "孝经通，四书熟。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-102",
    "text": "诗书易，礼春秋。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-103",
    "text": "号六经，当讲求。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-104",
    "text": "有连山，有归藏。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-105",
    "text": "有周易，三易详。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-106",
    "text": "有典谟，有训诰。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-107",
    "text": "有誓命，书之奥。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "孝经通"
  },
  {
    "id": "szj-108",
    "text": "我周公，作周礼。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-109",
    "text": "著六官，存治体。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-110",
    "text": "大小戴，注礼记。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-111",
    "text": "述圣言，礼乐备。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-112",
    "text": "曰国风，曰雅颂。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-113",
    "text": "号四诗，当讽咏。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-114",
    "text": "诗既亡，春秋作。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-115",
    "text": "寓褒贬，别善恶。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "我周公"
  },
  {
    "id": "szj-116",
    "text": "三传者，有公羊。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三传者"
  },
  {
    "id": "szj-117",
    "text": "有左氏，有谷梁。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三传者"
  },
  {
    "id": "szj-118",
    "text": "经既明，方读子。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三传者"
  },
  {
    "id": "szj-119",
    "text": "撮其要，记其事。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三传者"
  },
  {
    "id": "szj-120",
    "text": "五子者，有荀扬。",
    "source": "《三字经》",
    "book": "三字经",
    "chapter": "三传者"
  }
]