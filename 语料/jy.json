[
  {
    "id": "jy-1",
    "text": "夫兵权者，是三军之司命，主将之威势。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "兵权第一"
  },
  {
    "id": "jy-2",
    "text": "夫军国之弊，有五害焉：一曰结党相连，毁谮贤良；二曰侈其衣服，异其冠带；三曰虚夸妖术，诡言神道；四曰专察是非，私以动众；五曰伺候得失，阴结敌人。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "逐恶第二"
  },
  {
    "id": "jy-3",
    "text": "夫知人之性，莫难察焉。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "知人性第三"
  },
  {
    "id": "jy-4",
    "text": "将之器，其用大小不同。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将器第五"
  },
  {
    "id": "jy-5",
    "text": "夫为将之道，有八弊焉，一曰贪而无厌，二曰妒贤嫉能，三曰信谗好佞，四曰料彼不自料，五曰犹豫不自决，六曰荒淫于酒色，七曰奸诈而自怯，八曰狡言而不以礼。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将弊第六"
  },
  {
    "id": "jy-6",
    "text": "兵者凶器，将者危任，是以器刚则缺，任重则危。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将志第七"
  },
  {
    "id": "jy-7",
    "text": "将有五善四欲。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将善第八"
  },
  {
    "id": "jy-8",
    "text": "善将者，其刚不可折，其柔不可卷，故以弱制强，以柔制刚。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将刚第九"
  },
  {
    "id": "jy-9",
    "text": "将不可骄，骄则失礼，失礼则人离，人离则众判。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将骄吝第十"
  },
  {
    "id": "jy-10",
    "text": "将有五强八恶。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将强第十一"
  },
  {
    "id": "jy-11",
    "text": "古者国有危难，君简贤能而任之，齐三日，入太庙，南面而立，将北面，太师进钺于君。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "出师第十二"
  },
  {
    "id": "jy-12",
    "text": "此六军之善士，各因其能而用之也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "择材第十三"
  },
  {
    "id": "jy-13",
    "text": "夫为将之道，必顺天、因时、依人以立胜也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "智用第十四"
  },
  {
    "id": "jy-14",
    "text": "古之善理者不师，善师者不陈，善陈者不战，善战者不败，善败者不亡。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "不陈第十五"
  },
  {
    "id": "jy-15",
    "text": "书曰：狎侮君子，罔以尽人心；狎侮小人，罔以尽人力。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将诫第十六"
  },
  {
    "id": "jy-16",
    "text": "夫国之大务，莫先于戒备。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "戒备第十七"
  },
  {
    "id": "jy-17",
    "text": "夫军无习练，百不当一；习而用之，一可当百。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "习练第十八"
  },
  {
    "id": "jy-18",
    "text": "此九者，三军之蠹，有之必败也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "军蠹第十九"
  },
  {
    "id": "jy-19",
    "text": "夫为将者，必有腹心、耳目、爪牙。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "腹心第二十"
  },
  {
    "id": "jy-20",
    "text": "夫败军丧师，未有不因轻敌而致祸者，故师出以律，失律则凶。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "谨候第二十一"
  },
  {
    "id": "jy-21",
    "text": "夫以愚克智，逆也；以智克愚，顺也；以智克智，机也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "机形第二十二"
  },
  {
    "id": "jy-22",
    "text": "吴起曰：鼓鼙金铎，所以威耳；旌帜，所以威目；禁令刑罚，所以威心。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "重刑第二十三"
  },
  {
    "id": "jy-23",
    "text": "古之善将者有四：示之以进退，故人知禁；诱之以仁义，故人知礼；重之以是非，故人知劝；决之以赏罚，故人知信。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "善将第二十四"
  },
  {
    "id": "jy-24",
    "text": "夫因人之势以伐恶，则黄帝不能与争威矣；因人之力以决胜，则汤、武不能与争功矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "审因第二十五"
  },
  {
    "id": "jy-25",
    "text": "夫行兵之势有三焉：一曰天，二曰地，三曰人。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "兵势第二十六"
  },
  {
    "id": "jy-26",
    "text": "贤才居上，不肖居下，三军悦乐，士卒畏服，相议以勇斗，相望以威武，相劝以刑赏，此必胜之征也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "胜败第二十七"
  },
  {
    "id": "jy-27",
    "text": "夫将者，人命之所县也，成败之所系也，祸福之所倚也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "假权第二十八"
  },
  {
    "id": "jy-28",
    "text": "古之善将者，养人如养己子，有难则以身先之，有功则以身后之；伤者，泣而抚之；死者，哀而葬之；饥者，舍食而食之；寒者，解衣而衣之；智者，礼而禄之；勇者，赏而劝之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "哀死第二十九"
  },
  {
    "id": "jy-29",
    "text": "夫三军之行也，必有宾客群议得失，以资将用。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "三宾第三十"
  },
  {
    "id": "jy-30",
    "text": "师徒已列，戎马交驰，强弩才临，短兵又接，乘威布信，敌人告急，此用兵之能也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "后应第三十一"
  },
  {
    "id": "jy-31",
    "text": "夫草木丛集，利以游逸；重塞山林，利以不意；前林无隐，利以潜伏；以少击众，利以日莫；以众击寡，利以清晨；强弩长兵，利以捷次；逾渊隔水，风大暗昧，利以搏前击后。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "便利第三十二"
  },
  {
    "id": "jy-32",
    "text": "夫必胜之术，合变之形，在于机也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "应机第三十三"
  },
  {
    "id": "jy-33",
    "text": "古之善用兵者，揣其能而料其胜负。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "揣能第三十四"
  },
  {
    "id": "jy-34",
    "text": "螫虫之触，负其毒也；战士能勇，恃其备也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "轻战第三十五"
  },
  {
    "id": "jy-35",
    "text": "夫地势者，兵之助也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "地势第三十六"
  },
  {
    "id": "jy-36",
    "text": "夫将有勇而轻死者，有急而心速者，有贪而喜利者，有仁而不忍者，有智而心怯者，有谋而情缓者。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "情势第三十七"
  },
  {
    "id": "jy-37",
    "text": "古之善斗者，必先探敌情而后图之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "击势第三十八"
  },
  {
    "id": "jy-38",
    "text": "夫出师行军，以整为胜。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "整师第三十九"
  },
  {
    "id": "jy-39",
    "text": "圣人则天，贤者法地，智者则古。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "自勉第四十一"
  },
  {
    "id": "jy-40",
    "text": "夫林战之道：昼广旌旗，夜多金鼓，利用短兵，巧在设伏，或攻于前，或发于后。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "战道第四十二"
  },
  {
    "id": "jy-41",
    "text": "夫用兵之道，在于人和，人和则不劝而自战矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "和人第四十三"
  },
  {
    "id": "jy-42",
    "text": "夫为将之道，军井未汲，将不言渴；军食未熟，将不言饥；军火未然，将不言寒；军幕未施，将不言困。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将情第四十五"
  },
  {
    "id": "jy-43",
    "text": "夫一人之身，百万之众，束肩敛息，重足俯听，莫敢仰视者，法制使然也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "威令第四十六"
  },
  {
    "id": "jy-44",
    "text": "东夷之性，薄礼少义，捍急能斗，仪山堑海，凭险自固。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "东夷第四十七"
  },
  {
    "id": "jy-45",
    "text": "南蛮多种，性不能教，连合朋党，失意则相攻。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "南蛮第四十八"
  },
  {
    "id": "jy-46",
    "text": "西戎之性，勇悍好利，或城居，或野处，米粮少，金贝多，故人勇战斗，难败。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "西戎第四十九"
  },
  {
    "id": "jy-47",
    "text": "北狄居无城郭，随逐水草，势利则南侵，势失则北遁，长山广碛，足以自卫，饥则捕兽饮乳，寒则寝皮服裘，奔走射猎，以杀为务，未可以道德怀之，未可以兵戎服之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "北狄第五十"
  },
  {
    "id": "jy-48",
    "text": "将能执兵之权，操兵之势而临群下，譬如猛虎，加之羽翼而翱翔四海，随所遇而施之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "兵权第一"
  },
  {
    "id": "jy-49",
    "text": "此所谓奸伪悖德之人，可远而不可亲也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "逐恶第二"
  },
  {
    "id": "jy-50",
    "text": "美恶既殊，情貌不一，有温良而为诈者，有外恭而内欺者，有外勇而内怯者，有尽力而不忠者。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "知人性第三"
  },
  {
    "id": "jy-51",
    "text": "故善将者，不恃强，不怙势，宠之而不喜，辱之而不惧，见利不贪，见美不淫，以身殉国，壹意而已。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将志第七"
  },
  {
    "id": "jy-52",
    "text": "五善者，所谓善知敌之形势，善知进退之道，善知国之虚实，善知天时人事，善知山川险阻。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将善第八"
  },
  {
    "id": "jy-53",
    "text": "纯柔纯弱，其势必削；纯刚纯强，其势必亡；不柔不刚，合道之常。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将刚第九"
  },
  {
    "id": "jy-54",
    "text": "将不可吝，吝则赏不行，赏不行则士不致命，士不致命则军无功，无功则国虚，国虚则寇实矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将骄吝第十"
  },
  {
    "id": "jy-55",
    "text": "高节可以厉俗，孝弟可以扬名，信义可以交友，沈虑可以容众，力行可以建功，此将之五强也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将强第十一"
  },
  {
    "id": "jy-56",
    "text": "君持钺柄以授将，曰：从此至军，将军其裁之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "出师第十二"
  },
  {
    "id": "jy-57",
    "text": "故天作时不作而人作，是谓逆时；时作天不作而人作，是谓逆天；天作时作而人不作，是谓逆人。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "智用第十四"
  },
  {
    "id": "jy-58",
    "text": "昔者，圣人之治理也，安其居，乐其业，至老不相攻伐，可谓善理者不师也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "不陈第十五"
  },
  {
    "id": "jy-59",
    "text": "将能如此，严号申令而人愿斗，则兵合刃接而人乐死矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "将诫第十六"
  },
  {
    "id": "jy-60",
    "text": "故有患难，君臣旰食而谋之，择贤而任之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "戒备第十七"
  },
  {
    "id": "jy-61",
    "text": "故仲尼曰：不教而战，是谓弃之。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "习练第十八"
  },
  {
    "id": "jy-62",
    "text": "无腹心者，如人夜行，无所措手足；无耳目者，如冥然而居，不知运动；无爪牙者，如饥人食毒物，无不死矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "腹心第二十"
  },
  {
    "id": "jy-63",
    "text": "其道有三：一曰事，二曰势，三曰情。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "机形第二十二"
  },
  {
    "id": "jy-64",
    "text": "三者不立，士可怠也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "重刑第二十三"
  },
  {
    "id": "jy-65",
    "text": "禁、礼、劝、信，师之大经也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "善将第二十四"
  },
  {
    "id": "jy-66",
    "text": "天势者，日月清明，五星合度，彗孛不殃，风气调和；地势者，城峻重崖，洪波千里，石门幽洞，羊肠曲沃；人势者，主圣将贤，三军由礼，士卒用命，粮甲坚备。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "兵势第二十六"
  },
  {
    "id": "jy-67",
    "text": "士卒惰慢，三军数惊，下无礼信，人不畏法，相恐以敌，相语以利，相嘱以祸福，相惑以妖言，此必败之征也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "胜败第二十七"
  },
  {
    "id": "jy-68",
    "text": "虽伊、吕之谋，韩白之功，而不能自卫也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "假权第二十八"
  },
  {
    "id": "jy-69",
    "text": "将能如此，所向必捷矣。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "哀死第二十九"
  },
  {
    "id": "jy-70",
    "text": "有词若县流，奇谋不测，博闻广见，多艺多才，此万夫之望，可引为上宾；有猛若熊虎，捷若腾猿，刚如铁石，利若龙泉，此一时之雄，可以为中宾；有多言或中，薄技小才，常人之能，此可引为下宾。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "三宾第三十"
  },
  {
    "id": "jy-71",
    "text": "身冲矢石，争胜一时，成败未分，我伤彼死，此用兵之下也。",
    "source": "《将苑》",
    "book": "将苑",
    "chapter": "后应第三十一"
  },
  {
    "id": "jy-72",
    "text": "非智者孰能见机而作乎？",
