[
  {
    "id": "sjs-1",
    "text": "孝公平画，公孙鞅、甘龙、杜挚三大夫御于君。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "更法第一"
  },
  {
    "id": "sjs-2",
    "text": "无宿治，则邪官不及为私利于民。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "垦令第二"
  },
  {
    "id": "sjs-3",
    "text": "凡人主之所以劝民者，官爵也；国之所以兴者，农战也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "农战第三"
  },
  {
    "id": "sjs-4",
    "text": "以强去强者，弱；以弱去强者，强。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "去强第四"
  },
  {
    "id": "sjs-5",
    "text": "辩慧，乱之赞也；礼乐，淫佚之征也；慈仁，过之母也；任誉，奸之鼠也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "说民第五"
  },
  {
    "id": "sjs-6",
    "text": "凡世主之患，用兵者不量力，治草莱者不度地。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "算地第六"
  },
  {
    "id": "sjs-7",
    "text": "天地设而民生之。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "开塞第七"
  },
  {
    "id": "sjs-8",
    "text": "凡将立国，制度不可不察也，治法不可不慎也，国务不可不谨也，事本不可不抟也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "壹言第八"
  },
  {
    "id": "sjs-9",
    "text": "臣闻：古之明君错法而民无邪，举事而材自练，赏行而兵强。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "错法第九"
  },
  {
    "id": "sjs-10",
    "text": "凡战法必本于政胜，则其民不争，不争则无以私意，以上为意。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "战法第十"
  },
  {
    "id": "sjs-11",
    "text": "凡用兵，胜有三等，若兵未起则错法，错法而俗成，而用具。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "立本第十一"
  },
  {
    "id": "sjs-12",
    "text": "四战之国贵守战，负海之国贵攻战。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "兵守第十二"
  },
  {
    "id": "sjs-13",
    "text": "靳令，则治不留；法平，则吏无奸。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "靳令第十三"
  },
  {
    "id": "sjs-14",
    "text": "国之所以治者三：一曰法，二曰信，三曰权。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "修权第十四"
  },
  {
    "id": "sjs-15",
    "text": "地方百里者，山陵处什一，薮泽处什一，薮谷流水处什一，都邑蹊道处什一，恶田处什二，良田处什四，以此食作夫五万，其山陵、薮泽、谿谷可以给其材，都邑蹊道足以处其民，先王制土分民之律也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "徕民第十五"
  },
  {
    "id": "sjs-16",
    "text": "圣人之为国也，壹赏，壹刑，壹教。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "赏刑第十七"
  },
  {
    "id": "sjs-17",
    "text": "昔者昊英之世，以代木杀兽，人民少而木兽多，黄帝之世，不麛不卵，官无供备之民，死不得用椁。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "画策第十八"
  },
  {
    "id": "sjs-18",
    "text": "四境之内，丈夫女子皆有名于上，生者著，死者削。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "境内第十九"
  },
  {
    "id": "sjs-19",
    "text": "民弱国强，民强国弱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "弱民第二十"
  },
  {
    "id": "sjs-20",
    "text": "民之外事，莫难于战，故轻法不可以使之。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "外内第二十二"
  },
  {
    "id": "sjs-21",
    "text": "古者未有君臣、上下之时，民乱而不治。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "君臣第二十三"
  },
  {
    "id": "sjs-22",
    "text": "人主之所以禁使者，赏罚也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "禁使第二十四"
  },
  {
    "id": "sjs-23",
    "text": "凡世莫不以其所以乱者治，故小治而小乱，大治而大乱，人主莫能世治其民，世无不乱之国。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "慎法第二十五"
  },
  {
    "id": "sjs-24",
    "text": "公孙鞅曰：为法令，置官吏，朴足以知法令之谓者，以为天下正，则奏天子。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "定分第二十六"
  },
  {
    "id": "sjs-25",
    "text": "虑世事之变，讨正法之本，求使民之道。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "更法第一"
  },
  {
    "id": "sjs-26",
    "text": "农不败而有余日，则草必垦矣。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "垦令第二"
  },
  {
    "id": "sjs-27",
    "text": "今民求官爵，皆不以农战，而以巧言虚道，此谓劳民。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "农战第三"
  },
  {
    "id": "sjs-28",
    "text": "国为善，奸必多。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "去强第四"
  },
  {
    "id": "sjs-29",
    "text": "乱有赞则行，淫佚有征则用，过有母则生，奸有鼠则不止。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "说民第五"
  },
  {
    "id": "sjs-30",
    "text": "故有地狭而民众者，民胜其地；地广而民少者，地胜其民。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "算地第六"
  },
  {
    "id": "sjs-31",
    "text": "当此之时也，民知其母而不知其父，其道亲亲而爱私。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "开塞第七"
  },
  {
    "id": "sjs-32",
    "text": "制度时，则国俗可化，而民从制；治法明，则官无邪；国务壹，则民应用；事本抟，则民喜农而乐战。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "壹言第八"
  },
  {
    "id": "sjs-33",
    "text": "此三者，治之本也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "错法第九"
  },
  {
    "id": "sjs-34",
    "text": "故王者之政，使民怯于邑斗，而勇于寇战。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "战法第十"
  },
  {
    "id": "sjs-35",
    "text": "此三者必行于境内，而后兵可出也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "立本第十一"
  },
  {
    "id": "sjs-36",
    "text": "四战之国，好举兴兵以距四邻者，国危。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "兵守第十二"
  },
  {
    "id": "sjs-37",
    "text": "法已定矣，不以善言害法。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "靳令第十三"
  },
  {
    "id": "sjs-38",
    "text": "法者，君臣之所共操也；信者，君臣之所共立也；权者，君之所独制也，人主失守则危。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "修权第十四"
  },
  {
    "id": "sjs-39",
    "text": "今秦之地，方千里者五，而谷土不能处二，田数不满百万，其薮泽、谿谷、名山、大川之材物货宝，又不尽为用，此人不称土地。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "徕民第十五"
  },
  {
    "id": "sjs-40",
    "text": "壹赏则兵无敌，壹刑则令行，壹教则下听上。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "赏刑第十七"
  },
  {
    "id": "sjs-41",
    "text": "事不同，皆王者，时异也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "画策第十八"
  },
  {
    "id": "sjs-42",
    "text": "其有爵者乞无爵者以为庶子，级乞一人。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "境内第十九"
  },
  {
    "id": "sjs-43",
    "text": "故有道之国，务在弱民。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "弱民第二十"
  },
  {
    "id": "sjs-44",
    "text": "其赏少而威薄、淫道不塞之谓也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "外内第二十二"
  },
  {
    "id": "sjs-45",
    "text": "是以圣人列贵贱，制爵位，立名号，以别君臣上下之义。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "君臣第二十三"
  },
  {
    "id": "sjs-46",
    "text": "赏随功，罚随罪。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "禁使第二十四"
  },
  {
    "id": "sjs-47",
    "text": "奚谓以其所以乱者治？",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "慎法第二十五"
  },
  {
    "id": "sjs-48",
    "text": "天子若，则各主法令之，皆降，受命，发官。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "定分第二十六"
  },
  {
    "id": "sjs-49",
    "text": "君曰：代立不忘社稷，君之道也；错法务明主长，臣之行也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "更法第一"
  },
  {
    "id": "sjs-50",
    "text": "訾粟而税，则上壹而民平。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "垦令第二"
  },
  {
    "id": "sjs-51",
    "text": "劳民者，其国必无力；无力者，其国必削。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "农战第三"
  },
  {
    "id": "sjs-52",
    "text": "国富而贫治，曰重富，重富者强；国贫而富治，曰重贫，重贫者弱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "去强第四"
  },
  {
    "id": "sjs-53",
    "text": "八者有群，民胜其政；国无八者，政胜其民。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "说民第五"
  },
  {
    "id": "sjs-54",
    "text": "民胜其地，务开；地胜其民者，事徕。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "算地第六"
  },
  {
    "id": "sjs-55",
    "text": "亲亲则别，爱私则险。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "开塞第七"
  },
  {
    "id": "sjs-56",
    "text": "夫圣人之立法、化俗，而使民朝夕从事于农也，不可不变也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "壹言第八"
  },
  {
    "id": "sjs-57",
    "text": "夫错法而民无邪者，法明而民利之也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "错法第九"
  },
  {
    "id": "sjs-58",
    "text": "民习以力攻难，故轻死。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "战法第十"
  },
  {
    "id": "sjs-59",
    "text": "行三者有二势：一曰辅法而法行，二曰举必得而法立。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "立本第十一"
  },
  {
    "id": "sjs-60",
    "text": "四邻之国一兴事，而己四兴军，故曰国危。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "兵守第十二"
  },
  {
    "id": "sjs-61",
    "text": "任功，则民少言；任善，则民多言。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "靳令第十三"
  },
  {
    "id": "sjs-62",
    "text": "君臣释法任私必乱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "修权第十四"
  },
  {
    "id": "sjs-63",
    "text": "秦之所与邻者，三晋也；所欲用兵者，韩、魏也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "徕民第十五"
  },
  {
    "id": "sjs-64",
    "text": "夫明赏不费，明刑不戮，明教不变，而民知于民务，国无异俗。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "赏刑第十七"
  },
  {
    "id": "sjs-65",
    "text": "神农之世，男耕而食，妇织而衣；刑政不用而治，甲兵不起而王。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "画策第十八"
  },
  {
    "id": "sjs-66",
    "text": "其无役事也，其庶子役其大夫月六日；其役事也，随而养之军。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "境内第十九"
  },
  {
    "id": "sjs-67",
    "text": "朴则强，淫则弱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "弱民第二十"
  },
  {
    "id": "sjs-68",
    "text": "为辩知者贵、游宦者任、文学私名显之谓也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "外内第二十二"
  },
  {
    "id": "sjs-69",
    "text": "地广，民众，万物多，故分五官而守之。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "君臣第二十三"
  },
  {
    "id": "sjs-70",
    "text": "故论功察罪，不可不审也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "禁使第二十四"
  },
  {
    "id": "sjs-71",
    "text": "夫举贤能，世之所治也，而治之所以乱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "慎法第二十五"
  },
  {
    "id": "sjs-72",
    "text": "各主法令之民，敢忘行主法令之所谓之名，各以其所忘之法令名罪之。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "定分第二十六"
  },
  {
    "id": "sjs-73",
    "text": "今吾欲变法以治，更礼以教百姓，恐天下之议我也。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "更法第一"
  },
  {
    "id": "sjs-74",
    "text": "上壹，则信；信，则臣不敢为邪。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "垦令第二"
  },
  {
    "id": "sjs-75",
    "text": "善为国者，其教民也，皆作壹而得官爵，是故不官无爵。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "农战第三"
  },
  {
    "id": "sjs-76",
    "text": "兵行敌所不敢行，强；事兴敌所羞为，利。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "去强第四"
  },
  {
    "id": "sjs-77",
    "text": "民胜其政，国弱；政胜其民，兵强。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "说民第五"
  },
  {
    "id": "sjs-78",
    "text": "开，则行倍。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "算地第六"
  },
  {
    "id": "sjs-79",
    "text": "民众，而以别、险为务，则民乱。",
    "source": "《商君书》",
    "book": "商君书",
    "chapter": "开塞第七"
  },
  {
