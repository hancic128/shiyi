[
  {
    "id": "ymy-1",
    "text": "读经宜冬，其神专也；读史宜夏，其时久也；读诸子宜秋，其致别也；读诸集宜春，其机畅也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-2",
    "text": "水浒传是一部怒书，西游记是一部悟书，金瓶梅是一部哀书。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-3",
    "text": "经传宜独坐读，史鉴宜与友共读。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-4",
    "text": "读书最乐，若读史书，则喜少怒多。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-5",
    "text": "无善无恶是圣人，善多恶少是贤者，善少恶多是庸人，有恶无善是小人，有善无恶是仙佛。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-6",
    "text": "究之，怒处亦乐处也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-7",
    "text": "天下有一人知己，可以不恨。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-8",
    "text": "发前人未发之论，方是奇书；言妻子难言之情，乃为密友。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-9",
    "text": "不独人也，物亦有之。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-10",
    "text": "一介之士，必有密友，密友，不必定是刎颈之交。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-11",
    "text": "一与之订，千秋不移。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-12",
    "text": "此皆所谓密友也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-13",
    "text": "为月忧云，为书忧蠹，为花忧风雨，为才子佳人忧命薄，真是菩萨心肠。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-14",
    "text": "风流自赏，祇容花鸟趋陪；真率谁知？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-15",
    "text": "花不可以无蝶，山不可以无泉，石不可以无苔，水不可以无藻，乔木不可以无藤萝，人不可以无癖。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-16",
    "text": "合受烟霞供养。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-17",
    "text": "春听鸟声，夏听蝉声，秋听虫声，冬听雪声；白昼听棋声，月下听箫声；山中听松声，水际听欸乃声，方不虚生此耳。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-18",
    "text": "万事可忘，难忘者名心一段；千般易淡，未淡者美酒三杯。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-19",
    "text": "上元须酌豪友，端午须酌丽友，七夕须酌韵友，中秋须酌淡友，重九须酌逸友。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-20",
    "text": "芰荷可食，而亦可衣；金石可器，而亦可服。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-21",
    "text": "鳞虫中金鱼，羽虫中紫燕，可云物类神仙。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-22",
    "text": "宜于耳复宜于目者，弹琴也，吹箫也；宜于耳不宜于目者，吹笙也，𢬍管也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-23",
    "text": "正如东方曼倩避世，金马门人不得而害之。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-24",
    "text": "看晓妆宜于傅粉之后。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-25",
    "text": "入世，须学东方曼倩；出世，须学佛印了元。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-26",
    "text": "我不知我之生前，当春秋之季，曾一识西施否？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-27",
    "text": "赏花宜对佳人，醉月宜对韵人，映雪宜对高人。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-28",
    "text": "当典午之时，曾一看卫玠否？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-29",
    "text": "对渊博友，如读异书；对风雅友，如读名人诗文；对谨饬友，如读圣贤经传；对滑稽友，如阅传奇小说。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-30",
    "text": "当义熙之世，曾一醉渊明否？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-31",
    "text": "楷书须如文人，草书须如名将，行书介乎二者之间。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-32",
    "text": "当天宝之代，曾一睹太真否？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-33",
    "text": "人须求可入诗，物须求可入画。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-34",
    "text": "当元丰之朝，曾一晤东坡否？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-35",
    "text": "少年人须有老成之识见，老成人须有少年之襟怀。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-36",
    "text": "千古之上，相思者不止此，数人则其尤甚者，故姑举之，以概其余也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-37",
    "text": "春者天之本怀，秋者天之别调。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-38",
    "text": "我又不知在隆万时，曾于旧院中交几名妓？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-39",
    "text": "昔人云：若无花月美人，不愿生此世界。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-40",
    "text": "眉公、伯虎、若士、赤水诸君，曾共我谈笑几回？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-41",
    "text": "予益一语云：若无翰墨棋酒，不必定作人身。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-42",
    "text": "茫茫宇宙，我今当向谁问之耶？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-43",
    "text": "愿在木而为樗，愿在草而为蓍，愿在鸟而为鸥，愿在兽而为廌，愿在虫而为蝶，愿在鱼而为鲲。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-44",
    "text": "文章是有字句之锦绣，锦绣是无字句之文章，两者同出于一原。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-45",
    "text": "黄九烟先生云：古今人必有其偶双。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-46",
    "text": "姑即粗迹论之，如金陵，如武林，如姑苏，书林之所在，即机杼之所在也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-47",
    "text": "千古而无偶者，其惟盘古乎？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-48",
    "text": "予尝集诸法帖字为诗。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-49",
    "text": "即此劫尽时最后一人是也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-50",
    "text": "字之不复而多者，莫善于千字文，然诗家目前常用之字，犹苦其未备。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-51",
    "text": "古人以冬为三余。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-52",
    "text": "千字文且然，况其它乎？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-53",
    "text": "予谓当以夏为三余：晨起者，夜之余；夜坐者，昼之余；午睡者，应酬人事之余。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-54",
    "text": "花不可见其落，月不可见其沈，美人不可见其夭。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-55",
    "text": "庄周梦为蝴蝶，庄周之幸也；蝴蝶梦为庄周，蝴蝶之不幸也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-56",
    "text": "种花须见其开，待月须见其满，著书须见其成，美人须见其畅适，方有实际。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-57",
    "text": "艺花可以邀蝶，累石可以邀云，栽松可以邀风，贮水可以邀萍，筑台可以邀月，种蕉可以邀雨，植柳可以邀蝉。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-58",
    "text": "否则皆为虚设。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-59",
    "text": "景有言之极幽，而实萧索者，烟雨也；境有言之极雅，而实难堪者，贫病也；声有言之极韵，而实粗鄙者，卖花声也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-60",
    "text": "惠施多方，其书五车；虞卿以穷愁著书，今皆不传。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-61",
    "text": "才子而富贵，定从福慧双修得来。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-62",
    "text": "不知书中果作何语？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-63",
    "text": "新月恨其易沈，缺月恨其迟上。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-64",
    "text": "我不见古人，安得不恨！",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-65",
    "text": "躬耕，吾所不能，学灌园而已矣；樵薪，吾所不能，学薙草而已矣。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-66",
    "text": "以松花为量，以松实为香，以松枝为麈尾，以松阴为步障，以松涛为鼓吹。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-67",
    "text": "一恨书囊易蛀，二恨夏夜有蚊，三恨站台易漏，四恨菊叶多焦，五恨松多大蚁，六恨竹多落叶，七恨桂、荷易谢，八恨薜、萝藏虺，九恨架花生刺，十恨河豚多毒。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-68",
    "text": "山居得乔松百余章，真乃受用不尽。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-69",
    "text": "楼上看山，城头看雪，灯前看月，舟中看霞，月下看美人，另是一番情境。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-70",
    "text": "玩月之法，皎洁则仰观，朦胧则宜俯视。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-71",
    "text": "山之光，水之声，月之色，花之香，文人之韵致，美人之姿态，皆无可名状，无可执着。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-72",
    "text": "孩提之童，一无所知。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-73",
    "text": "真足以摄召魂梦，颠倒情思。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-74",
    "text": "目不能辨美恶，耳不能判清浊，鼻不能别香臭。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-75",
    "text": "假使梦能自主，虽千里无难命驾，可不羡长房之缩地；死者可以晤对，可不需少君之招魂；五岳可以卧游，可不俟婚嫁之尽毕。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-76",
    "text": "至若味之甘苦，则不第知之，且能取之弃之。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-77",
    "text": "昭君以和亲而显，刘蕡以下第而传；可谓之不幸，不可为之缺陷。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-78",
    "text": "告子以甘食、悦色为性，殆指此类耳。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-79",
    "text": "以爱花之心爱美人，则领略自饶别趣；以爱美人之心爱花，则护惜倍有深情。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-80",
    "text": "凡事不宜刻，若读书则不可不刻；凡事不宜贪，若买书则不可不贪；凡事不宜痴，若行善则不可不痴。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-81",
    "text": "美人之胜于花者，解语也；花之胜于美人者，生香也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-82",
    "text": "酒可好，不可骂座；色可好，不可伤生；财可好，不可昧心；气可好，不可越理。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-83",
    "text": "二者不可得兼，舍生香而解语者也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-84",
    "text": "文名，可以当科第；俭德，可以当货财；清闲，可以当寿考。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-85",
    "text": "窗内人于窗纸上作字，吾于窗外观之，极佳。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-86",
    "text": "不独诵其诗读其书，是尚友古人；即观其字画，亦是尚友古人处。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-87",
    "text": "少年读书，如隙中窥月；中年读书，如庭中望月；老年读书，如台上玩月。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-88",
    "text": "无益之施舍，莫过于斋僧；无益之诗文，莫甚于祝寿。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-89",
    "text": "皆以阅历之浅深，为所得之浅深耳。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-90",
    "text": "妾美不如妻贤；钱多不如境顺。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-91",
    "text": "吾欲致书雨师：春雨，宜始于上元节后，至清明十日前之内，及谷雨节中；夏雨，宜于每月上弦之前，及下弦之后；秋雨，宜于孟秋、季秋之上下二旬；至若三冬，正可不必雨也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-92",
    "text": "创新庵，不若修古庙；读生书，不若温旧业。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-93",
    "text": "为浊富不若为清贫；以忧生不若以乐死。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-94",
    "text": "字与画同出一源，观六书始于象形，则可知矣。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-95",
    "text": "天下唯鬼最富：生前囊无一文，死后每饶楮镪；天下唯鬼最尊，生前或受欺凌，死后必多跪拜。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-96",
    "text": "忙人园亭，宜与住宅相连；闲人园亭，不妨与住宅相远。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-97",
    "text": "蝶为才子之化身，花乃美人之别号。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-98",
    "text": "酒可以当茶，茶不可以当酒；诗可以当文，文不可以当诗；曲可以当词，词不可以当曲；月可以当灯，灯不可以当月；笔可以当口，口不可以当笔；婢可以当奴，奴不可以当婢。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-99",
    "text": "因雪想高士，因花想美人，因酒想侠客，因月想好友，因山水想得意诗文。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-100",
    "text": "胸中小不平，可以酒消之；世间大不平，非剑不能消也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-101",
    "text": "闻鹅声，如在白门；闻橹声，如在三吴；闻滩声，如在浙江；闻羸马项下铃铎声，如在长安道上。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-102",
    "text": "不得以而谀之者，宁以口，毋以笔；不可耐而骂之者，亦宁以口，毋以笔。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-103",
    "text": "一岁诸节，以上元为第一，中秋次之，五日、九日又次之。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-104",
    "text": "多情者必好色，而好色者未必尽属多情；红颜者必薄命，而薄命者未必尽属红颜；能诗者必好酒，而好酒者未必尽属能诗。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-105",
    "text": "雨之为物，能令昼短，能令夜长。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-106",
    "text": "梅令人高，兰令人幽，菊令人野，莲令人淡，春海棠令人艳，牡丹令人豪，蕉与竹令人韵，秋海棠令人媚，松令人逸，桐令人清，柳令人感。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-107",
    "text": "古之不传于今者，啸也、剑术也、弹棋也、打球也。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-108",
    "text": "物之能感人者：在天莫如月，在乐莫如琴，在动物莫如鹃，在植物莫如柳。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  },
  {
    "id": "ymy-109",
    "text": "诗僧时复有之，若道士之能诗，不啻空谷足音，何也？",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第一卷"
  },
  {
    "id": "ymy-110",
    "text": "妻子颇足累人，羡和靖梅妻鹤子；奴婢亦能供职，喜志和樵婢渔奴。",
    "source": "《幽梦影》",
    "book": "幽梦影",
    "chapter": "第二卷"
  }
]