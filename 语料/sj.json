[
  {
    "id": "sj-1",
    "text": "黄帝者，少典之子，姓公孙，名曰轩辕。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "五帝本纪第一"
  },
  {
    "id": "sj-2",
    "text": "夏禹，名曰文命。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "夏本纪第二"
  },
  {
    "id": "sj-3",
    "text": "殷契，母曰简狄，有娀氏之女，为帝喾次妃。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "殷本纪第三"
  },
  {
    "id": "sj-4",
    "text": "周后稷，名弃。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "周本纪第四"
  },
  {
    "id": "sj-5",
    "text": "秦之先，帝颛顼之苗裔孙曰女修。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "秦本纪第五"
  },
  {
    "id": "sj-6",
    "text": "秦始皇帝者，秦庄襄王子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "秦始皇本纪第六"
  },
  {
    "id": "sj-7",
    "text": "项籍者，下相人也，字羽。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "项羽本纪第七"
  },
  {
    "id": "sj-8",
    "text": "高祖，沛丰邑中阳里人，姓刘氏，字季。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "高祖本纪第八"
  },
  {
    "id": "sj-9",
    "text": "吕太后者，高祖微时妃也，生孝惠帝、女鲁元太后。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "吕太后本纪第九"
  },
  {
    "id": "sj-10",
    "text": "孝文皇帝，高祖中子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孝文本纪第十"
  },
  {
    "id": "sj-11",
    "text": "孝景皇帝者，孝文之中子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孝景本纪第十一"
  },
  {
    "id": "sj-12",
    "text": "孝武皇帝者，孝景中子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孝武本纪第十二"
  },
  {
    "id": "sj-13",
    "text": "太史公曰：五帝、三代之记，尚矣。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "三代世表第一"
  },
  {
    "id": "sj-14",
    "text": "太史公读春秋历谱谍，至周厉王，未尝不废书而叹也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "十二诸侯年表第二"
  },
  {
    "id": "sj-15",
    "text": "太史公读秦记，至犬戎败幽王，周东徙洛邑，秦襄公始封为诸侯，作西畤用事上帝，僭端见矣。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "六国年表第三"
  },
  {
    "id": "sj-16",
    "text": "太史公读秦楚之际，曰：初作难，发于陈涉；虐戾灭秦，自项氏；拨乱诛暴，平定海内，卒践帝祚，成于汉家。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "秦楚之际月表第四"
  },
  {
    "id": "sj-17",
    "text": "太史公曰：殷以前尚矣。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "汉兴以来诸侯王年表第五"
  },
  {
    "id": "sj-18",
    "text": "太史公曰：古者人臣功有五品，以德立宗庙定社稷曰勋，以言曰劳，用力曰功，明其等曰伐，积日曰阅。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "高祖功臣侯者年表第六"
  },
  {
    "id": "sj-19",
    "text": "太史公读列封至便侯曰：有以也夫！",
    "source": "《史记》",
    "book": "史记",
    "chapter": "惠景间侯者年表第七"
  },
  {
    "id": "sj-20",
    "text": "太史公曰：匈奴绝和亲，攻当路塞；闽越擅伐，东瓯请降。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "建元以来侯者年表第八"
  },
  {
    "id": "sj-21",
    "text": "制诏御史：诸侯王或欲推私恩分子弟邑者，令各条上，朕且临定其号名。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "建元以来王子侯者年表第九"
  },
  {
    "id": "sj-22",
    "text": "高祖初起，啸命群雄。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "汉兴以来将相名臣年表第十"
  },
  {
    "id": "sj-23",
    "text": "太史公曰：洋洋美德乎！",
    "source": "《史记》",
    "book": "史记",
    "chapter": "礼书第一"
  },
  {
    "id": "sj-24",
    "text": "太史公曰：余每读虞书，至于君臣相敕，维是几安，而股肱不良，万事堕坏，未尝不流涕也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "乐书第二"
  },
  {
    "id": "sj-25",
    "text": "王者制事立法，物度轨则，壹禀于六律，六律为万事根本焉。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "律书第三"
  },
  {
    "id": "sj-26",
    "text": "昔自在古，历建正作于孟春。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "历书第四"
  },
  {
    "id": "sj-27",
    "text": "中宫天极星，其一明者，太一常居也；旁三星三公，或曰子属。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "天官书第五"
  },
  {
    "id": "sj-28",
    "text": "自古受命帝王，曷尝不封禅？",
    "source": "《史记》",
    "book": "史记",
    "chapter": "封禅书第六"
  },
  {
    "id": "sj-29",
    "text": "夏书曰：禹抑洪水十三年，过家不入门。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "河渠书第七"
  },
  {
    "id": "sj-30",
    "text": "汉兴，接秦之弊，丈夫从军旅，老弱转粮饷，作业剧而财匮，自天子不能具钧驷，而将相或乘牛车，齐民无藏盖。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "平准书第八"
  },
  {
    "id": "sj-31",
    "text": "吴太伯，太伯弟仲雍，皆周太王之子，而王季历之兄也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "吴太伯世家第一"
  },
  {
    "id": "sj-32",
    "text": "太公望吕尚者，东海上人。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "齐太公世家第二"
  },
  {
    "id": "sj-33",
    "text": "周公旦者，周武王弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "鲁周公世家第三"
  },
  {
    "id": "sj-34",
    "text": "召公奭与周同姓，姓姬氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "燕召公世家第四"
  },
  {
    "id": "sj-35",
    "text": "管叔鲜、蔡叔度者，周文王子而武王弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "管蔡世家第五"
  },
  {
    "id": "sj-36",
    "text": "陈胡公满者，虞帝舜之后也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "陈杞世家第六"
  },
  {
    "id": "sj-37",
    "text": "卫康叔名封，周武王同母少弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "卫康叔世家第七"
  },
  {
    "id": "sj-38",
    "text": "微子开者，殷帝乙之首子而帝纣之庶兄也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "宋微子世家第八"
  },
  {
    "id": "sj-39",
    "text": "晋唐叔虞者，周武王子而成王弟。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "晋世家第九"
  },
  {
    "id": "sj-40",
    "text": "楚之先祖出自帝颛顼高阳。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "楚世家第十"
  },
  {
    "id": "sj-41",
    "text": "越王勾践，其先禹之苗裔，而夏后帝少康之庶子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "越王勾践世家第十一"
  },
  {
    "id": "sj-42",
    "text": "郑桓公友者，周厉王少子而宣王庶弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "郑世家第十二"
  },
  {
    "id": "sj-43",
    "text": "赵氏之先，与秦共祖。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "赵世家第十三"
  },
  {
    "id": "sj-44",
    "text": "魏之先，毕公高之后也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "魏世家第十四"
  },
  {
    "id": "sj-45",
    "text": "韩之先与周同姓，姓姬氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "韩世家第十五"
  },
  {
    "id": "sj-46",
    "text": "陈完者，陈厉公他之子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "田敬仲完世家第十六"
  },
  {
    "id": "sj-47",
    "text": "孔子生鲁昌平乡陬邑。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孔子世家第十七"
  },
  {
    "id": "sj-48",
    "text": "陈胜者，阳城人也，字涉。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "陈涉世家第十八"
  },
  {
    "id": "sj-49",
    "text": "自古受命帝王及继体守文之君，非独内德茂也，盖亦有外戚之助焉。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "外戚世家第十九"
  },
  {
    "id": "sj-50",
    "text": "楚元王刘交者，高祖之同母少弟也，字游。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "楚元王世家第二十"
  },
  {
    "id": "sj-51",
    "text": "荆王刘贾者，诸刘，不知其何属初起时。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "荆燕世家第二十一"
  },
  {
    "id": "sj-52",
    "text": "齐悼惠王刘肥者，高祖长庶男也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "齐悼惠王世家第二十二"
  },
  {
    "id": "sj-53",
    "text": "萧相国何者，沛丰人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "萧相国世家第二十三"
  },
  {
    "id": "sj-54",
    "text": "平阳侯曹参者，沛人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "曹相国世家第二十四"
  },
  {
    "id": "sj-55",
    "text": "留侯张良者，其先韩人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "留侯世家第二十五"
  },
  {
    "id": "sj-56",
    "text": "陈丞相平者，阳武户牖乡人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "陈丞相世家第二十六"
  },
  {
    "id": "sj-57",
    "text": "绛侯周勃者，沛人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "绛侯周勃世家第二十七"
  },
  {
    "id": "sj-58",
    "text": "梁孝王武者，孝文皇帝子也，而与孝景帝同母。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "梁孝王世家第二十八"
  },
  {
    "id": "sj-59",
    "text": "孝景皇帝子凡十三人为王，而母五人，同母者为宗亲。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "五宗世家第二十九"
  },
  {
    "id": "sj-60",
    "text": "大司马臣去病昧死再拜上疏皇帝陛下：陛下过听，使臣去病待罪行间。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "三王世家第三十"
  },
  {
    "id": "sj-61",
    "text": "夫学者载籍极博，犹考信于六艺。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "伯夷列传第一"
  },
  {
    "id": "sj-62",
    "text": "管仲夷吾者，颍上人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "管晏列传第二"
  },
  {
    "id": "sj-63",
    "text": "老子者，楚苦县厉乡曲仁里人也，姓李氏，名耳，字聃，周守藏室之史也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "老子韩非列传第三"
  },
  {
    "id": "sj-64",
    "text": "司马穰苴者，田完之苗裔也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "司马穰苴列传第四"
  },
  {
    "id": "sj-65",
    "text": "孙子武者，齐人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孙子吴起列传第五"
  },
  {
    "id": "sj-66",
    "text": "伍子胥者，楚人也，名员。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "伍子胥列传第六"
  },
  {
    "id": "sj-67",
    "text": "孔子曰受业身通者七十有七人，皆异能之士也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "仲尼弟子列传第七"
  },
  {
    "id": "sj-68",
    "text": "商君者，卫之诸庶孽公子也，名鞅，姓公孙氏，其祖本姬姓也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "商君列传第八"
  },
  {
    "id": "sj-69",
    "text": "苏秦者，东周雒阳人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "苏秦列传第九"
  },
  {
    "id": "sj-70",
    "text": "张仪者，魏人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "张仪列传第十"
  },
  {
    "id": "sj-71",
    "text": "樗里子者，名疾，秦惠王之弟也，与惠王异母。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "樗里子甘茂列传第十一"
  },
  {
    "id": "sj-72",
    "text": "穰侯魏冉者，秦昭王母宣太后弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "穰侯列传第十二"
  },
  {
    "id": "sj-73",
    "text": "白起者，郿人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "白起王翦列传第十三"
  },
  {
    "id": "sj-74",
    "text": "太史公曰：余读孟子书，至梁惠王问何以利吾国，未尝不废书而叹也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孟子荀卿列传第十四"
  },
  {
    "id": "sj-75",
    "text": "孟尝君名文，姓田氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "孟尝君列传第十五"
  },
  {
    "id": "sj-76",
    "text": "平原君赵胜者，赵之诸公子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "平原君虞卿列传第十六"
  },
  {
    "id": "sj-77",
    "text": "魏公子无忌者，魏昭王少子而魏安厘王异母弟也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "魏公子列传第十七"
  },
  {
    "id": "sj-78",
    "text": "春申君者，楚人也，名歇，姓黄氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "春申君列传第十八"
  },
  {
    "id": "sj-79",
    "text": "范雎者，魏人也，字叔。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "范雎蔡泽列传第十九"
  },
  {
    "id": "sj-80",
    "text": "乐毅者，其先祖曰乐羊。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "乐毅列传第二十"
  },
  {
    "id": "sj-81",
    "text": "廉颇者，赵之良将也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "廉颇蔺相如列传第二十一"
  },
  {
    "id": "sj-82",
    "text": "田单者，齐诸田疏属也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "田单列传第二十二"
  },
  {
    "id": "sj-83",
    "text": "鲁仲连者，齐人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "鲁仲连邹阳列传第二十三"
  },
  {
    "id": "sj-84",
    "text": "屈原者，名平，楚之同姓也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "屈原贾生列传第二十四"
  },
  {
    "id": "sj-85",
    "text": "吕不韦者，阳翟大贾人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "吕不韦列传第二十五"
  },
  {
    "id": "sj-86",
    "text": "曹沫者，鲁人也，以勇力事鲁庄公。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "刺客列传第二十六"
  },
  {
    "id": "sj-87",
    "text": "李斯者，楚上蔡人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "李斯列传第二十七"
  },
  {
    "id": "sj-88",
    "text": "蒙恬者，其先齐人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "蒙恬列传第二十八"
  },
  {
    "id": "sj-89",
    "text": "张耳者，大梁人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "张耳陈馀列传第二十九"
  },
  {
    "id": "sj-90",
    "text": "魏豹者，故魏诸公子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "魏豹彭越列传第三十"
  },
  {
    "id": "sj-91",
    "text": "黥布者，六人也，姓英氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "黥布列传第三十一"
  },
  {
    "id": "sj-92",
    "text": "淮阴侯韩信者，淮阴人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "淮阴侯列传第三十二"
  },
  {
    "id": "sj-93",
    "text": "韩王信者，故韩襄王孽孙也，长八尺五寸。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "韩信卢绾列传第三十三"
  },
  {
    "id": "sj-94",
    "text": "田儋者，狄人也，故齐王田氏族也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "田儋列传第三十四"
  },
  {
    "id": "sj-95",
    "text": "舞阳侯樊哙者，沛人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "樊郦滕灌列传第三十五"
  },
  {
    "id": "sj-96",
    "text": "张丞相苍者，阳武人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "张丞相列传第三十六"
  },
  {
    "id": "sj-97",
    "text": "郦生食其者，陈留高阳人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "郦生陆贾列传第三十七"
  },
  {
    "id": "sj-98",
    "text": "阳陵侯傅宽，以魏五大夫骑将从，为舍人，起横阳。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "傅靳蒯成列传第三十八"
  },
  {
    "id": "sj-99",
    "text": "刘敬者，齐人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "刘敬叔孙通列传第三十九"
  },
  {
    "id": "sj-100",
    "text": "季布者，楚人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "季布栾布列传第四十"
  },
  {
    "id": "sj-101",
    "text": "袁盎者，楚人也，字丝。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "袁盎晁错列传第四十一"
  },
  {
    "id": "sj-102",
    "text": "张廷尉释之者，堵阳人也，字季。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "张释之冯唐列传第四十二"
  },
  {
    "id": "sj-103",
    "text": "万石君名奋，其父赵人也，姓石氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "万石张叔列传第四十三"
  },
  {
    "id": "sj-104",
    "text": "田叔者，赵陉城人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "田叔列传第四十四"
  },
  {
    "id": "sj-105",
    "text": "扁鹊者，勃海郡郑人也，姓秦氏，名越人。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "扁鹊仓公列传第四十五"
  },
  {
    "id": "sj-106",
    "text": "吴王濞者，高帝兄刘仲之子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "吴王濞列传第四十六"
  },
  {
    "id": "sj-107",
    "text": "魏其侯窦婴者，孝文后从兄子也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "魏其武安侯列传第四十七"
  },
  {
    "id": "sj-108",
    "text": "御史大夫韩安国者，梁成安人也，后徙睢阳。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "韩长孺列传第四十八"
  },
  {
    "id": "sj-109",
    "text": "李将军广者，陇西成纪人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "李将军列传第四十九"
  },
  {
    "id": "sj-110",
    "text": "匈奴，其先祖夏后氏之苗裔也，曰淳维。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "匈奴列传第五十"
  },
  {
    "id": "sj-111",
    "text": "大将军卫青者，平阳人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "卫将军骠骑列传第五十一"
  },
  {
    "id": "sj-112",
    "text": "丞相公孙弘者，齐菑川国薛县人也，字季。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "平津侯主父列传第五十二"
  },
  {
    "id": "sj-113",
    "text": "南越王尉佗者，真定人也，姓赵氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "南越列传第五十三"
  },
  {
    "id": "sj-114",
    "text": "闽越王无诸及越东海王摇者，其先皆越王句践之后也，姓驺氏。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "东越列传第五十四"
  },
  {
    "id": "sj-115",
    "text": "朝鲜王满者，故燕人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "朝鲜列传第五十五"
  },
  {
    "id": "sj-116",
    "text": "西南夷君长以什数，夜郎最大；其西靡莫之属以什数，滇最大；自滇以北君长以什数，邛都最大：此皆魋结，耕田，有邑聚。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "西南夷列传第五十六"
  },
  {
    "id": "sj-117",
    "text": "司马相如者，蜀郡成都人也，字长卿。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "司马相如列传第五十七"
  },
  {
    "id": "sj-118",
    "text": "淮南厉王长者，高祖少子也，其母故赵王张敖美人。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "淮南衡山列传第五十八"
  },
  {
    "id": "sj-119",
    "text": "太史公曰：法令所以导民也，刑罚所以禁奸也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "循吏列传第五十九"
  },
  {
    "id": "sj-120",
    "text": "汲黯字长孺，濮阳人也。",
    "source": "《史记》",
    "book": "史记",
    "chapter": "汲郑列传第六十"
  }
]