[
  {
    "id": "yzs-1",
    "text": "天生民而制其度，度小大以整，权轻重以极，明本末以立中。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "度训解第一"
  },
  {
    "id": "yzs-2",
    "text": "天生民而成大命，命司德，正之以祸福，立明王以顺之，曰：大命有常，小命日成，成则敬，有常则广，广以敬命，则度至于极。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "命训解第二"
  },
  {
    "id": "yzs-3",
    "text": "天有常性，人有常顺，顺在可变，性在不改。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "常训解第三"
  },
  {
    "id": "yzs-4",
    "text": "民生而有欲、有恶、有乐、有哀、有德、有则，则有九聚，德有五宝，哀有四忍，乐有三丰，恶有二咎，欲有一极。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文酌解第四"
  },
  {
    "id": "yzs-5",
    "text": "成年，年谷足宾祭，祭以盛。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "籴匡解第五"
  },
  {
    "id": "yzs-6",
    "text": "大国不失其威，小国不失其卑。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武称解第六"
  },
  {
    "id": "yzs-7",
    "text": "思静振胜，允文维记。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "允文解第七"
  },
  {
    "id": "yzs-8",
    "text": "武有六制：政、攻、侵、伐、搏、战。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大武解第八"
  },
  {
    "id": "yzs-9",
    "text": "畏严大武，曰维四方畏威，乃宁。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大明武解第九"
  },
  {
    "id": "yzs-10",
    "text": "凡攻凡攻之道，必得地势，以顺天时，观之以今，稽之以古，攻其逆政，毁其地阻，立之五教，以惠其下。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小明武解第十"
  },
  {
    "id": "yzs-11",
    "text": "维周王在酆，三年遭天之大荒，作大匡，以诏牧其方，三州之侯咸率。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大匡解第十一"
  },
  {
    "id": "yzs-12",
    "text": "维三月，既生魄，文王令六州之侯，奉勤于商。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "程典解第十二"
  },
  {
    "id": "yzs-13",
    "text": "惟王元祀正月既生霸，大姒梦见商廷唯棘，乃小子发取周廷梓树于厥外，化为松柏棫柞。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "程寤解第十三"
  },
  {
    "id": "yzs-14",
    "text": "维二十三祀，庚子朔，九州之侯，咸格于周，王在酆，昧爽，立于少庭。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "酆保解第二十一"
  },
  {
    "id": "yzs-15",
    "text": "维王二月，既生魄，王在酆，立于少庭，兆墓九开，开厥后人。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大开解第二十二"
  },
  {
    "id": "yzs-16",
    "text": "维三十有五祀，王念曰：□所□，正月丙子，拜望食无时，汝开后嗣，谋曰：呜呼，于来，后之人，余闻在昔，曰明明非常维德，曰为明食无时。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小开解第二十三"
  },
  {
    "id": "yzs-17",
    "text": "维文王告梦，惧后嗣之无保，庚辰诏太子发曰：汝敬之哉！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文儆解第二十四"
  },
  {
    "id": "yzs-18",
    "text": "文王受命之九年，时维暮春，在鄗召太子发曰：呜呼！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文传解第二十五"
  },
  {
    "id": "yzs-19",
    "text": "维王元祀一月，既生魄，王召周公旦曰：呜呼，维在王考之绪功，维周禁五戎，五戎不禁，厥民乃淫。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "柔武解第二十六"
  },
  {
    "id": "yzs-20",
    "text": "维王一祀二月，王在酆，密命。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大开武解第二十七"
  },
  {
    "id": "yzs-21",
    "text": "维王二祀一月，既生魄，王召周公旦曰：呜呼，余夙夜忌商，不知道极，敬听以勤天命。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小开武解第二十八"
  },
  {
    "id": "yzs-22",
    "text": "维王三祀二月丙辰朔，王在鄗，召周公旦曰：呜呼，敬哉！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "宝典解第二十九"
  },
  {
    "id": "yzs-23",
    "text": "维王三祀，王在酆，谋言告闻。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "酆谋解第三十"
  },
  {
    "id": "yzs-24",
    "text": "维四月朔，王告儆，召周公旦曰：呜呼，谋泄哉！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "寤儆解第三十一"
  },
  {
    "id": "yzs-25",
    "text": "天道尚左，日月西移；地道尚右，水道东流。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武顺解第三十二"
  },
  {
    "id": "yzs-26",
    "text": "曰若稽古，曰昭天之道，熙地之载，揆民之任，夷德之用。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武穆解第三十三"
  },
  {
    "id": "yzs-27",
    "text": "王乃出图商，至于鲜原，召邵公奭、毕公高。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "和寤解第三十四"
  },
  {
    "id": "yzs-28",
    "text": "王赫奋烈，八方咸发，高城若地，商庶若化。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武寤解第三十五"
  },
  {
    "id": "yzs-29",
    "text": "周车三百五十乘，陈于牧野，帝辛从。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "克殷解第三十六"
  },
  {
    "id": "yzs-30",
    "text": "惟是有三祀，王在管，管叔自作殷之监，东隅之侯咸受赐于王，王乃旅之，以上东隅。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大匡解第三十七"
  },
  {
    "id": "yzs-31",
    "text": "惟十有三祀，桑在管，管蔡开宗循，禁九慝，昭九行，济九丑，尊九德，止九过，务九胜，倾九戒，固九守，顺九典。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文政解第三十八"
  },
  {
    "id": "yzs-32",
    "text": "维武王胜殷，抚国绥民，乃观于殷政，告周公旦曰：呜呼，殷政总总，若风草有所积，有所虚，和此如何？",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大聚解第三十九"
  },
  {
    "id": "yzs-33",
    "text": "维四月乙未日，武王成辟，四方通殷，命有国。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "世俘解第四十"
  },
  {
    "id": "yzs-34",
    "text": "今惟新诰命尔，敬诸朕话言，自一言至于十话，言其惟明命尔。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "商誓解第四十三"
  },
  {
    "id": "yzs-35",
    "text": "维王维王克殷，国君诸侯、乃厥献民征主、九牧之师见王与殷郊。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "度邑解第四十四"
  },
  {
    "id": "yzs-36",
    "text": "惟十有二祀四月，王告梦，丙辰，出金枝，郊宝，开和细书，命诏周公旦立后嗣，属小子诵文及宝典。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武儆解第四十五"
  },
  {
    "id": "yzs-37",
    "text": "维王不豫，于五日召周公旦，曰：呜呼，敬之哉！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "五权解第四十六"
  },
  {
    "id": "yzs-38",
    "text": "成王元年，大开告用。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "成开解第四十七"
  },
  {
    "id": "yzs-39",
    "text": "武王克殷，乃立王子禄父，俾守商祀。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "作雒解第四十八"
  },
  {
    "id": "yzs-40",
    "text": "维正月庚午，周公格左闳门，会群门。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "皇门解第四十九"
  },
  {
    "id": "yzs-41",
    "text": "维正月，既生魄，王访于周公曰：呜呼，朕闻维时兆厥工，非不显，朕实不明。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大戒解第五十"
  },
  {
    "id": "yzs-42",
    "text": "惟一惟一月，既南至，昏昴见，日短件，基践长，微阳动于黄泉，阴降惨于万物。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "周月解第五十一"
  },
  {
    "id": "yzs-43",
    "text": "立春之日，东风解冻。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "时训解第五十二"
  },
  {
    "id": "yzs-44",
    "text": "孟春之月，日在营室，昏参中，旦尾中。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "月令解第五十三"
  },
  {
    "id": "yzs-45",
    "text": "维周公旦、太公望，开嗣王业，建功于牧之野，终将葬，乃制谥。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "谥法解第五十四"
  },
  {
    "id": "yzs-46",
    "text": "大维商纣暴虐，脯鬼侯以享诸侯，天下患之，四海兆民欣戴文武，是以周公相武王以伐纣，夷定天下，既克纣六年，而武王崩，成王嗣，幼弱，未能践天子之位。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "明堂解第五十五"
  },
  {
    "id": "yzs-47",
    "text": "维四年孟夏，王初祈祷于宗庙，乃尝麦于太祖。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "尝麦解第五十六"
  },
  {
    "id": "yzs-48",
    "text": "维四月既生魄，王在东宫，告周公曰：呜呼，朕闻武考不知，乃闻不得，乃学俾资不肖，永无惑矣。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "本典解第五十七"
  },
  {
    "id": "yzs-49",
    "text": "王曰：呜呼，大师，朕维民务官，论用有征，观诚考言，视声观色，观隐揆德，可得闻乎？",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "官人解第五十 八"
  },
  {
    "id": "yzs-50",
    "text": "成周之会，𫮃上张赤帟阴羽，天子南面立，絻无繁露，朝服，八十物缙珽。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "王会解第五十九"
  },
  {
    "id": "yzs-51",
    "text": "王若曰：祖祭公，予小子虔虔在位，昊天疾威，予多时溥愆。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "祭公解第六十"
  },
  {
    "id": "yzs-52",
    "text": "维正月王在成周，昧爽，召三公、左史戎夫，曰：今夕朕寤，遂事惊予。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "史记解第六十一"
  },
  {
    "id": "yzs-53",
    "text": "职方氏掌天下之图，辩其邦国、都鄙、四夷、八蛮、七闽、九貉、五戎、六狄之人民，与其财用九谷六畜之数，周知其利害，乃辩九州之国，使同贯利。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "职方解第六十二"
  },
  {
    "id": "yzs-54",
    "text": "芮伯若曰：予小臣良夫，稽道谋告，天子惟民父母，致厥道，无远不服，无道，左右臣妾乃违。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "芮良夫解第六十三"
  },
  {
    "id": "yzs-55",
    "text": "晋平公使叔誉于周，见太子晋而与之言。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "太子晋解第六十四"
  },
  {
    "id": "yzs-56",
    "text": "王者所佩在德，德在利民，民在顺上。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "王佩解第六十五"
  },
  {
    "id": "yzs-57",
    "text": "汤将放桀于中野，士民闻汤在野，皆委货扶老携幼奔，国中虚。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "殷祝解第六十六"
  },
  {
    "id": "yzs-58",
    "text": "币帛之间，有巧言令色，事不成。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武纪解第六十八"
  },
  {
    "id": "yzs-59",
    "text": "有三不远，有三不近，有三不畜。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "铨法解第六十九"
  },
  {
    "id": "yzs-60",
    "text": "明器因外，有三疲二用。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "器服解第七十"
  },
  {
    "id": "yzs-61",
    "text": "昔在文王，商纣并立，困于虐政，将弘道以弼无道，作度训。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "序第七十一"
  },
  {
    "id": "yzs-62",
    "text": "立中以补损，补损以知足。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "度训解第一"
  },
  {
    "id": "yzs-63",
    "text": "夫司德司义而赐之福禄，福禄在人，能无惩乎？",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "命训解第二"
  },
  {
    "id": "yzs-64",
    "text": "不改可因，因在好恶，好恶生变，变习生常，常则生丑，丑命生德。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "常训解第三"
  },
  {
    "id": "yzs-65",
    "text": "极有七事，咎有三尼，丰有三频，忍有四教，宝有五大，聚有九酌。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文酌解第四"
  },
  {
    "id": "yzs-66",
    "text": "大驯锺绝，服美义淫。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "籴匡解第五"
  },
  {
    "id": "yzs-67",
    "text": "敌国不失其权。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武称解第六"
  },
  {
    "id": "yzs-68",
    "text": "昭告周行，维旌所在。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "允文解第七"
  },
  {
    "id": "yzs-69",
    "text": "善政不攻，善攻不侵，善侵不伐，善伐不搏，善搏不战。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大武解第八"
  },
  {
    "id": "yzs-70",
    "text": "天作武，修戎兵，以助义正违。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大明武解第九"
  },
  {
    "id": "yzs-71",
    "text": "矜寡无告，实为之主。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小明武解第十"
  },
  {
    "id": "yzs-72",
    "text": "王乃召冢卿、三老、三吏大夫、百执事之人，朝于大庭。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大匡解第十一"
  },
  {
    "id": "yzs-73",
    "text": "商王用宗谗，震怒无疆，诸侯不娱，逆诸文王。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "程典解第十二"
  },
  {
    "id": "yzs-74",
    "text": "寤惊，告王。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "程寤解第十三"
  },
  {
    "id": "yzs-75",
    "text": "王告周公旦曰：呜呼，诸侯咸格来庆，辛苦役周，吾何保守，何用行？",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "酆保解第二十一"
  },
  {
    "id": "yzs-76",
    "text": "八儆、王戒。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大开解第二十二"
  },
  {
    "id": "yzs-77",
    "text": "汝夜何修非躬，何慎非言，何择非德。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小开解第二十三"
  },
  {
    "id": "yzs-78",
    "text": "民物多变，民何乡非利，利维生痛，痛维生乐，乐维生礼，礼维生义，义维生仁。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文儆解第二十四"
  },
  {
    "id": "yzs-79",
    "text": "我身老矣，吾语汝。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文传解第二十五"
  },
  {
    "id": "yzs-80",
    "text": "呜呼，乃齐以揆之。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "官人解第五十 八"
  },
  {
    "id": "yzs-81",
    "text": "我闻祖不豫，有加予，维敬省不吊，田降疾病，予畏天威，公其告予懿德。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "祭公解第六十"
  },
  {
    "id": "yzs-82",
    "text": "民归于德，德则民戴，否则民雠。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "芮良夫解第六十三"
  },
  {
    "id": "yzs-83",
    "text": "王其祀德纯礼，明允无二，卑位柔色，金声以合之。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "酆保解第二十一"
  },
  {
    "id": "yzs-84",
    "text": "一曰土观幸时，政匮不疑；二曰狱雠刑蔽，奸吏济贷；三曰声乐□□，饰女灭德；四曰维势是辅，维祷是怙；五曰盘游安居，枝叶维落。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "柔武解第二十六"
  },
  {
    "id": "yzs-85",
    "text": "访于周公旦，曰：呜呼！",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大开武解第二十七"
  },
  {
    "id": "yzs-86",
    "text": "三极既明，五行乃常，四祭既是，七顺乃辨，明势天道，九纪咸当，顺德以谋，罔惟不行。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "小开武解第二十八"
  },
  {
    "id": "yzs-87",
    "text": "何择非人，人有十奸。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "宝典解第二十九"
  },
  {
    "id": "yzs-88",
    "text": "初用三同：一戚取同，二任用能，三矢无声。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "酆谋解第三十"
  },
  {
    "id": "yzs-89",
    "text": "今朕寤，有商惊予。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "寤儆解第三十一"
  },
  {
    "id": "yzs-90",
    "text": "人道尚中，耳目役心。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武顺解第三十二"
  },
  {
    "id": "yzs-91",
    "text": "总之以咸，殷，等之以□禁，成之以□和，咸康于民，卿格维时，监于列辟。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武穆解第三十三"
  },
  {
    "id": "yzs-92",
    "text": "无竞惟人，人允忠；惟事惟敬，小人难保，后降惠于民，民罔不格，惟风行贿，贿无成事。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "和寤解第三十四"
  },
  {
    "id": "yzs-93",
    "text": "约期于牧，案用师旅，商不足灭，分祷上下。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武寤解第三十五"
  },
  {
    "id": "yzs-94",
    "text": "武王使尚父与伯夫致师。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "克殷解第三十六"
  },
  {
    "id": "yzs-95",
    "text": "用大匡，顺九则、八宅、六位。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大匡解第三十七"
  },
  {
    "id": "yzs-96",
    "text": "九慝：一不类，二不服，三不则，四□务有不功，五外有内通，六幼不观国，七闾不通径，八家不开刑，九大禁不令路径。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "文政解第三十八"
  },
  {
    "id": "yzs-97",
    "text": "大夫免列以选，赦刑以宽，复亡解辱削赦□重，皆有数，此谓行风。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "大聚解第三十九"
  },
  {
    "id": "yzs-98",
    "text": "惟一月丙午，旁生魄，若翼日丁未，王乃步自于周，征伐商王纣。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "世俘解第四十"
  },
  {
    "id": "yzs-99",
    "text": "在商先誓王明祀上帝□□□□亦维我后稷之元谷用告和用胥饮食。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "商誓解第四十三"
  },
  {
    "id": "yzs-100",
    "text": "王乃升汾之阜以望商邑，永叹曰：呜呼，不淑，兑天对。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "度邑解第四十四"
  },
  {
    "id": "yzs-101",
    "text": "汝勤之无盖□周未知所周不知商□无也。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "武儆解第四十五"
  },
  {
    "id": "yzs-102",
    "text": "昔天初降命于周，维在文考，克致天之命。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "五权解第四十六"
  },
  {
    "id": "yzs-103",
    "text": "余何循，何循何慎，王其敬天命，无易天不虞。",
    "source": "《逸周书》",
    "book": "逸周书",
    "chapter": "成开解第四十七"
  }
]