[
  {
    "id": "cgt-1",
    "text": "欲做精金美玉的人品，定从烈火中煅来；思立掀天揭地的事功，须向薄冰上履过。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-2",
    "text": "操存要有真宰，无真宰则遇事便倒，何以植顶天立地之砥柱！",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-3",
    "text": "物莫大于天地日月，而子美云﹕日月笼中鸟，乾坤水上萍。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-4",
    "text": "昼闲人寂，听数声鸟语悠扬，不觉耳根尽彻；夜静天高，看一片云光舒卷，顿令眼界俱空。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-5",
    "text": "君子之心事，天青日白，不可使人不知；君子之才华，玉韫珠藏，不可使人易知。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-6",
    "text": "一念错，便觉百行皆非，防之当如渡海浮囊，勿容一针之罅漏；万善全，始得一生无愧，修之当如凌云宝树，须假众木以撑持。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-7",
    "text": "应用要有圆机，无圆机则触物有碍，何以成旋干转坤之经纶！",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-8",
    "text": "事莫大于揖逊征诛，而康节云﹕唐虞揖逊三杯酒，汤武征诛一局棋。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-9",
    "text": "世事如棋局，不着得才是高手；人生似瓦盆，打破了方见真空。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-10",
    "text": "疾风怒雨，禽鸟戚戚；霁月光风，草木欣欣，可见天地不可一日无和气，人心不可一日无喜神。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-11",
    "text": "忙处事为，常向闲中先检点，过举自稀。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-12",
    "text": "士君子之涉世，于人不可轻为喜怒，喜怒轻，则心腹肝胆皆为人所窥；于物不可重为爱憎，爱憎重，则意气精神悉为物所制。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-13",
    "text": "人能以此胸襟眼界吞吐六合，上下千古，事来如沤生大海，事去如影灭长空，自经纶万变而不动一尘矣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-14",
    "text": "龙可豢非真龙，虎可搏非真虎，故爵禄可饵荣进之辈，必不可笼淡然无欲之人；鼎镬可及宠利之流，必不可加飘然远引之士。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-15",
    "text": "𬪩肥辛甘非真味，真味只是淡；神奇卓异非至人，至人只是常。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-16",
    "text": "动时念想，预从静里密操持，非心自息。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-17",
    "text": "倚高才而玩世，背后须防射影之虫；饰厚貌以欺人，面前恐有照胆之镜。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-18",
    "text": "君子好名，便起欺人之念；小人好名，犹怀畏人之心。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-19",
    "text": "一场闲富贵，狠狠争来，虽得还是失；百岁好光阴，忙忙过了，纵寿亦为夭。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-20",
    "text": "夜深人静独坐观心；始知妄穷而真独露，每于此中得大机趣；既觉真现而妄难逃，又于此中得大惭忸。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-21",
    "text": "为善而欲自高胜人，施恩而欲要名结好，修业而欲惊世骇俗，植节而欲标异见奇，此皆是善念中戈矛，理路上荆棘，最易夹带，最难拔除者也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-22",
    "text": "心体澄彻，常在明镜止水之中，则天下自无可厌之事；意气和平，常在丽日光风之内，则天下自无可恶之人。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-23",
    "text": "故人而皆好名，则开诈善之门。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-24",
    "text": "高车嫌地僻，不如鱼鸟解亲人。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-25",
    "text": "恩里由来生害，故快意时须早回头；败后或反成功，故拂心处切莫放手。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-26",
    "text": "须是涤尽渣滓，斩绝萌芽，才见本来真体。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-27",
    "text": "当是非邪正之交，不可少迁就，少迁就则失从违之正；值利害得失之会，不可太分明，太分明则起趋避之私。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-28",
    "text": "使人而不好名，则绝为善之路。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-29",
    "text": "驷马喜门高，怎似莺花能避俗。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-30",
    "text": "藜口苋肠者，多冰清玉洁；衮衣玉食者，甘婢膝奴颜。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-31",
    "text": "能轻富贵，不能轻一轻富贵之心；能重名义，又复重一重名义之念。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-32",
    "text": "苍蝇附骥，捷则捷矣，难辞处后之羞；萝茑依松，高则高矣，未免仰攀之耻。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-33",
    "text": "此讥好名者，当严责君子，不当过求于小人也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-34",
    "text": "红烛烧残，万念自然厌冷；黄粱梦破，一身亦似云浮。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-35",
    "text": "盖志以淡泊明，而节从肥甘丧矣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-36",
    "text": "是事境之尘氛未扫，而心境之芥蒂未忘。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-37",
    "text": "所以君子宁以风霜自挟，毋为鱼鸟亲人。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-38",
    "text": "大恶多从柔处伏，哲士须防绵里之针；深仇常自爱中来，达人宜远刀头之蜜。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-39",
    "text": "千载奇逢，无如好书良友；一生清福，只在碗茗炉烟。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-40",
    "text": "面前的田地要放得宽，使人无不平之叹；身后的惠泽要流得长，使人有不匮之思。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-41",
    "text": "此处拔除不净，恐石去而草复生矣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-42",
    "text": "好丑心太明，则物不契；贤愚心太明，则人不亲。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-43",
    "text": "持身涉世，不可随境而迁。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-44",
    "text": "蓬茅下诵诗读书，日日与圣贤晤语，谁云贫是病？",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-45",
    "text": "路径窄处留一步，与人行；滋味浓的减三分，让人嗜。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-46",
    "text": "纷扰固溺志之场，而枯寂亦槁心之地。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-47",
    "text": "士君子须是内精明而外浑厚，使好丑两得其平，贤愚共受其益，才是生成的德量。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-48",
    "text": "须是大火流金而清风穆然，严霜杀物而和气蔼然，阴霾翳空而慧日朗然，洪涛倒海而坻柱屹然，方是宇宙内的真人品。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-49",
    "text": "樽罍边幕天席地，时时共造化氤氲，孰谓醉非禅？",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-50",
    "text": "此是涉世一极乐法。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-51",
    "text": "故学者当栖心元默，以宁吾真体。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-52",
    "text": "伺察以为明者，常因明而生暗，故君子以恬养智；奋迅以为速者，多因速而致迟，故君子以重持轻。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-53",
    "text": "爱是万缘之根，当知割舍。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-54",
    "text": "兴来醉倒落花前，天地即为衾枕。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-55",
    "text": "作人无甚高远的事业，摆脱得俗情便入名流；为学无甚增益的工夫，减除得物累便臻圣境。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-56",
    "text": "亦当适志恬愉，以养吾圆机。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-57",
    "text": "士君子济人利物，宜居其实，不宜居其名，居其名则德损；士大夫忧国为民，当有其心，不当有其语，有其语则毁来。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-58",
    "text": "识是众欲之本，要力扫除。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-59",
    "text": "机息坐忘盘石上，古今尽属蜉蝣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-60",
    "text": "宠利毋居人前，德业毋落人后，受享毋逾分外，修持毋减分中。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-61",
    "text": "昨日之非不可留，留之则根烬复萌，而尘情终累乎理趣；今日之是不可执，执之则渣滓未化，而理趣反转为欲根。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-62",
    "text": "遇大事矜持者，小事必纵弛；处明庭检饬者，暗室必放逸。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-63",
    "text": "作人要脱俗，不可存一矫俗之心；应世要随时，不可起一趋时之念。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-64",
    "text": "昂藏老鹤虽饥，饮啄犹闲，肯同鸡鹜之营营而竞食？",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-65",
    "text": "处世让一步为高，退步即进步的张本；待人宽一分是福，利人实利己的根基。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-66",
    "text": "无事便思有闲杂念想否。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-67",
    "text": "君子只是一个念头持到底，自然临小事如临大敌，坐密室若坐通衢。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-68",
    "text": "宁有求全之毁，不可有过情之誉；宁有无妄之灾，不可有非分之福。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-69",
    "text": "偃蹇寒松纵老，丰标自在，岂似桃李之灼灼而争妍！",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-70",
    "text": "盖世的功劳，当不得一个矜字；弥天的罪过，当不得一个悔字。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-71",
    "text": "有事便思有粗浮意气否。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-72",
    "text": "使人有面前之誉，不若使其无背后之毁；使人有乍交之欢，不若使其无久处之厌。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-73",
    "text": "毁人者不美，而受人毁者遭一番讪谤便加一番修省，可释回而增美；欺人者非福，而受人欺者遇一番横逆便长一番器宇，可以转祸而为福。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-74",
    "text": "吾人适志于花柳烂漫之时，得趣于笙歌腾沸之处，乃是造化之幻境，人心之荡念也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-75",
    "text": "完名美节，不宜独任，分些与人，可以远害全身；辱行污名，不宜全推，引些归己，可以韬光养德。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-76",
    "text": "得意便思有骄矜辞色否。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-77",
    "text": "善启迪人心者，当因其所明而渐通之，毋强开其所闭；善移风化者，当因其所易而渐及之，毋轻矫其所难。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-78",
    "text": "梦里悬金佩玉，事事逼真，睡去虽真觉后假；闲中演偈谈玄，言言酷似，说来虽是用时非。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-79",
    "text": "须从木落草枯之后，向声希味淡之中，觅得一些消息，才是乾坤的橐籥，人物的根宗。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-80",
    "text": "事事要留个有余不尽的意思，便造物不能忌我，鬼神不能损我。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-81",
    "text": "失意便思有怨望情怀否。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-82",
    "text": "彩笔描空，笔不落色，而空亦不受染；利刀割水，刀不损锷，而水亦不留痕。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-83",
    "text": "天欲祸人，必先以微福骄之，所以福来不必喜，要看他会受；天欲福人，必先以微祸儆之，所以祸来不必忧，要看他会救。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-84",
    "text": "静处观人事，即伊吕之勋庸、夷齐之节义，无非大海浮沤；闲中玩物情，虽木石之偏枯、鹿豕之顽蠢，总是吾性真如。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-85",
    "text": "家庭有个真佛，日用有种真道，人能诚心和气、愉色婉言，使父母兄弟间形骸两释，意气交流，胜于调息观心万倍矣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-86",
    "text": "时时检点，到得从多入少、从有入无处，才是学问的真消息。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-87",
    "text": "得此意以持身涉世，感与应俱适，心与境两忘矣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-88",
    "text": "荣与辱共蒂，厌辱何须求荣；生与死同根，贪生不必畏死。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-89",
    "text": "花开花谢春不管，拂意事休对人言；水暖水寒鱼自知，会心处还期独赏。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-90",
    "text": "攻人之恶毋太严，要思其堪受；教人以善毋过高，当使其可从。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-91",
    "text": "士人有百折不回之真心，才有万变不穷之妙用。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-92",
    "text": "己之情欲不可纵，当用逆之之法以制之，其道只在一忍字；人之情欲不可拂，当用顺之之法以调之，其道只在一恕字。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-93",
    "text": "作人只是一味率真，踪迹虽隐还显；存心若有半毫未净，事为虽公亦私。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-94",
    "text": "闲观扑纸蝇，笑痴人自生障碍；静觇竞巢鹊，叹杰士空逞英雄。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-95",
    "text": "粪虫至秽变为蝉，而饮露于秋风；腐草无光化为荧，而耀采于夏月。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-96",
    "text": "立业建功，事事要从实地着脚，若少慕声闻，便成伪果；讲道修德，念念要从虚处立基，若稍计功效，便落尘情。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-97",
    "text": "今人皆恕以适己而忍以制人，毋乃不可乎！",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-98",
    "text": "鹩占一枝，反笑鹏心奢侈；兔营三窟，转嗤鹤垒高危。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-99",
    "text": "看破有尽身躯，万境之尘缘自息；悟入无怀境界，一轮之心月独明。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-100",
    "text": "故知洁常自污出，明每从暗生也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-101",
    "text": "身不宜忙，而忙于闲暇之时，亦可儆惕惰气；心不可放，而放于收摄之后，亦可鼓畅天机。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-102",
    "text": "好察非明，能察能不察之谓明；必胜非勇，能胜能不胜之谓勇。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-103",
    "text": "智小者不可以谋大，趣卑者不可与谈高。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-104",
    "text": "木床石枕冷家风，拥衾时魂梦亦爽；麦饭豆羹淡滋味，放箸处齿颊犹香。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-105",
    "text": "矜高倨傲，无非客气；降伏得客气下，而后正气伸；情欲意识，尽属妄心。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-106",
    "text": "钟鼓体虚，为声闻而招击撞；麋鹿性逸，因豢养而受羁縻。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-107",
    "text": "随时之内善救时，若和风之消酷暑；混俗之中能脱俗，似淡月之映轻云。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-108",
    "text": "贫贱骄人，虽涉虚骄，还有几分侠气；英雄欺世，纵似挥霍，全没半点真心。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-109",
    "text": "谈纷华而厌者，或见纷华而喜；语淡泊而欣者，或处淡泊而厌。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-110",
    "text": "消杀得妄心尽，而后真心现。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-111",
    "text": "可见名为招祸之本，欲乃散志之媒。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-112",
    "text": "思入世而有为者，须先领得世外风光，否则无以脱垢浊之尘缘；思出世而无染者，须先谙尽世中滋味。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-113",
    "text": "糟糠不为彘肥，何事偏贪钩下饵；锦绮岂因牺贵，谁人能解笼中囮。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-114",
    "text": "须扫除浓淡之见，灭却欣厌之情，才可以忘纷华而甘淡泊也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-115",
    "text": "饱后思味，则浓淡之境都消；色后思淫，则男女之见尽绝。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  },
  {
    "id": "cgt-116",
    "text": "学者不可不力为扫除也。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "修身第一"
  },
  {
    "id": "cgt-117",
    "text": "否则无以持空寂之苦趣。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "应酬第二"
  },
  {
    "id": "cgt-118",
    "text": "琴书诗画，达士以之养性灵，而庸夫徒赏其迹象；山川云物，高人以之助学识，而俗子徒玩其光华。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "评议第三"
  },
  {
    "id": "cgt-119",
    "text": "鸟惊心花溅泪，怀此热肝肠，如何领取得冷风月；山写照水传神，识吾真面目，方可摆脱得幻乾坤。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "闲适第四"
  },
  {
    "id": "cgt-120",
    "text": "故人当以事后之悔悟，破临事之痴迷，则性定而动无不正。",
    "source": "《菜根谭》",
    "book": "菜根谭",
    "chapter": "概论第五"
  }
]