[
  {
    "id": "qzw-1",
    "text": "天地玄黄，宇宙洪荒。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "天地玄黄"
  },
  {
    "id": "qzw-2",
    "text": "日月盈昃，辰宿列张。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "天地玄黄"
  },
  {
    "id": "qzw-3",
    "text": "寒来暑往，秋收冬藏。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "天地玄黄"
  },
  {
    "id": "qzw-4",
    "text": "闰余成岁，律吕调阳。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "天地玄黄"
  },
  {
    "id": "qzw-5",
    "text": "云腾致雨，露结为霜。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "云腾致雨"
  },
  {
    "id": "qzw-6",
    "text": "金生丽水，玉出昆冈。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "云腾致雨"
  },
  {
    "id": "qzw-7",
    "text": "剑号巨阙，珠称夜光。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "云腾致雨"
  },
  {
    "id": "qzw-8",
    "text": "果珍李柰，菜重芥姜。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "云腾致雨"
  },
  {
    "id": "qzw-9",
    "text": "海咸河淡，鳞潜羽翔。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "海咸河淡"
  },
  {
    "id": "qzw-10",
    "text": "龙师火帝，鸟官人皇。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "海咸河淡"
  },
  {
    "id": "qzw-11",
    "text": "始制文字，乃服衣裳。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "海咸河淡"
  },
  {
    "id": "qzw-12",
    "text": "推位让国，有虞陶唐。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "海咸河淡"
  },
  {
    "id": "qzw-13",
    "text": "吊民伐罪，周发殷汤。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "吊民伐罪"
  },
  {
    "id": "qzw-14",
    "text": "坐朝问道，垂拱平章。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "吊民伐罪"
  },
  {
    "id": "qzw-15",
    "text": "爱育黎首，臣伏戎羌。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "吊民伐罪"
  },
  {
    "id": "qzw-16",
    "text": "遐迩一体，率宾归王。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "吊民伐罪"
  },
  {
    "id": "qzw-17",
    "text": "鸣凤在竹，白驹食场。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "鸣凤在竹"
  },
  {
    "id": "qzw-18",
    "text": "化被草木，赖及万方。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "鸣凤在竹"
  },
  {
    "id": "qzw-19",
    "text": "盖此身发，四大五常。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "鸣凤在竹"
  },
  {
    "id": "qzw-20",
    "text": "恭惟鞠养，岂敢毁伤。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "鸣凤在竹"
  },
  {
    "id": "qzw-21",
    "text": "女慕贞洁，男效才良。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "女慕贞洁"
  },
  {
    "id": "qzw-22",
    "text": "知过必改，得能莫忘。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "女慕贞洁"
  },
  {
    "id": "qzw-23",
    "text": "罔谈彼短，靡恃己长。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "女慕贞洁"
  },
  {
    "id": "qzw-24",
    "text": "信使可覆，器欲难量。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "女慕贞洁"
  },
  {
    "id": "qzw-25",
    "text": "墨悲丝染，诗赞羔羊。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "墨悲丝染"
  },
  {
    "id": "qzw-26",
    "text": "景行维贤，克念作圣。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "墨悲丝染"
  },
  {
    "id": "qzw-27",
    "text": "德建名立，形端表正。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "墨悲丝染"
  },
  {
    "id": "qzw-28",
    "text": "空谷传声，虚堂习听。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "墨悲丝染"
  },
  {
    "id": "qzw-29",
    "text": "祸因恶积，福缘善庆。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "祸因恶积"
  },
  {
    "id": "qzw-30",
    "text": "尺璧非宝，寸阴是竞。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "祸因恶积"
  },
  {
    "id": "qzw-31",
    "text": "资父事君，曰严与敬。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "祸因恶积"
  },
  {
    "id": "qzw-32",
    "text": "孝当竭力，忠则尽命。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "祸因恶积"
  },
  {
    "id": "qzw-33",
    "text": "临深履薄，夙兴温凊。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "临深履薄"
  },
  {
    "id": "qzw-34",
    "text": "似兰斯馨，如松之盛。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "临深履薄"
  },
  {
    "id": "qzw-35",
    "text": "川流不息，渊澄取映。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "临深履薄"
  },
  {
    "id": "qzw-36",
    "text": "容止若思，言辞安定。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "临深履薄"
  },
  {
    "id": "qzw-37",
    "text": "笃初诚美，慎终宜令。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "笃初诚美"
  },
  {
    "id": "qzw-38",
    "text": "荣业所基，籍甚无竟。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "笃初诚美"
  },
  {
    "id": "qzw-39",
    "text": "学优登仕，摄职从政。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "笃初诚美"
  },
  {
    "id": "qzw-40",
    "text": "存以甘棠，去而益咏。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "笃初诚美"
  },
  {
    "id": "qzw-41",
    "text": "乐殊贵贱，礼别尊卑。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "乐殊贵贱"
  },
  {
    "id": "qzw-42",
    "text": "上和下睦，夫唱妇随。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "乐殊贵贱"
  },
  {
    "id": "qzw-43",
    "text": "外受傅训，入奉母仪。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "乐殊贵贱"
  },
  {
    "id": "qzw-44",
    "text": "诸姑伯叔，犹子比儿。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "乐殊贵贱"
  },
  {
    "id": "qzw-45",
    "text": "孔怀兄弟，同气连枝。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孔怀兄弟"
  },
  {
    "id": "qzw-46",
    "text": "交友投分，切磨箴规。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孔怀兄弟"
  },
  {
    "id": "qzw-47",
    "text": "仁慈隐恻，造次弗离。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孔怀兄弟"
  },
  {
    "id": "qzw-48",
    "text": "节义廉退，颠沛匪亏。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孔怀兄弟"
  },
  {
    "id": "qzw-49",
    "text": "性静情逸，心动神疲。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "性静情逸"
  },
  {
    "id": "qzw-50",
    "text": "守真志满，逐物意移。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "性静情逸"
  },
  {
    "id": "qzw-51",
    "text": "坚持雅操，好爵自縻。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "性静情逸"
  },
  {
    "id": "qzw-52",
    "text": "都邑华夏，东西二京。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "性静情逸"
  },
  {
    "id": "qzw-53",
    "text": "背邙面洛，浮渭据泾。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "背邙面洛"
  },
  {
    "id": "qzw-54",
    "text": "宫殿盘郁，楼观飞惊。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "背邙面洛"
  },
  {
    "id": "qzw-55",
    "text": "图写禽兽，画彩仙灵。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "背邙面洛"
  },
  {
    "id": "qzw-56",
    "text": "丙舍旁启，甲帐对楹。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "背邙面洛"
  },
  {
    "id": "qzw-57",
    "text": "肆筵设席，鼓瑟吹笙。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "肆筵设席"
  },
  {
    "id": "qzw-58",
    "text": "升阶纳陛，弁转疑星。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "肆筵设席"
  },
  {
    "id": "qzw-59",
    "text": "右通广内，左达承明。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "肆筵设席"
  },
  {
    "id": "qzw-60",
    "text": "既集坟典，亦聚群英。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "肆筵设席"
  },
  {
    "id": "qzw-61",
    "text": "杜稿钟隶，漆书壁经。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "杜稿钟隶"
  },
  {
    "id": "qzw-62",
    "text": "府罗将相，路侠槐卿。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "杜稿钟隶"
  },
  {
    "id": "qzw-63",
    "text": "户封八县，家给千兵。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "杜稿钟隶"
  },
  {
    "id": "qzw-64",
    "text": "高冠陪辇，驱毂振缨。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "杜稿钟隶"
  },
  {
    "id": "qzw-65",
    "text": "世禄侈富，车驾肥轻。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "世禄侈富"
  },
  {
    "id": "qzw-66",
    "text": "策功茂实，勒碑刻铭。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "世禄侈富"
  },
  {
    "id": "qzw-67",
    "text": "磻溪伊尹，佐时阿衡。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "世禄侈富"
  },
  {
    "id": "qzw-68",
    "text": "奄宅曲阜，微旦孰营。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "世禄侈富"
  },
  {
    "id": "qzw-69",
    "text": "桓公匡合，济弱扶倾。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "桓公匡合"
  },
  {
    "id": "qzw-70",
    "text": "绮回汉惠，说感武丁。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "桓公匡合"
  },
  {
    "id": "qzw-71",
    "text": "俊乂密勿，多士寔宁。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "桓公匡合"
  },
  {
    "id": "qzw-72",
    "text": "晋楚更霸，赵魏困横。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "桓公匡合"
  },
  {
    "id": "qzw-73",
    "text": "假途灭虢，践土会盟。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "假途灭虢"
  },
  {
    "id": "qzw-74",
    "text": "何遵约法，韩弊烦刑。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "假途灭虢"
  },
  {
    "id": "qzw-75",
    "text": "起翦颇牧，用军最精。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "假途灭虢"
  },
  {
    "id": "qzw-76",
    "text": "宣威沙漠，驰誉丹青。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "假途灭虢"
  },
  {
    "id": "qzw-77",
    "text": "九州禹迹，百郡秦并。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "九州禹迹"
  },
  {
    "id": "qzw-78",
    "text": "岳宗泰岱，禅主云亭。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "九州禹迹"
  },
  {
    "id": "qzw-79",
    "text": "雁门紫塞，鸡田赤城。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "九州禹迹"
  },
  {
    "id": "qzw-80",
    "text": "昆池碣石，钜野洞庭。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "九州禹迹"
  },
  {
    "id": "qzw-81",
    "text": "旷远绵邈，岩岫杳冥。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "旷远绵邈"
  },
  {
    "id": "qzw-82",
    "text": "治本于农，务兹稼穑。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "旷远绵邈"
  },
  {
    "id": "qzw-83",
    "text": "俶载南亩，我艺黍稷。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "旷远绵邈"
  },
  {
    "id": "qzw-84",
    "text": "税熟贡新，劝赏黜陟。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "旷远绵邈"
  },
  {
    "id": "qzw-85",
    "text": "孟轲敦素，史鱼秉直。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孟轲敦素"
  },
  {
    "id": "qzw-86",
    "text": "庶几中庸，劳谦谨敕。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孟轲敦素"
  },
  {
    "id": "qzw-87",
    "text": "聆音察理，鉴貌辨色。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孟轲敦素"
  },
  {
    "id": "qzw-88",
    "text": "贻厥嘉猷，勉其祗植。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "孟轲敦素"
  },
  {
    "id": "qzw-89",
    "text": "省躬讥诫，宠增抗极。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "省躬讥诫"
  },
  {
    "id": "qzw-90",
    "text": "殆辱近耻，林皋幸即。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "省躬讥诫"
  },
  {
    "id": "qzw-91",
    "text": "两疏见机，解组谁逼。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "省躬讥诫"
  },
  {
    "id": "qzw-92",
    "text": "索居闲处，沉默寂寥。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "省躬讥诫"
  },
  {
    "id": "qzw-93",
    "text": "求古寻论，散虑逍遥。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "求古寻论"
  },
  {
    "id": "qzw-94",
    "text": "欣奏累遣，戚谢欢招。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "求古寻论"
  },
  {
    "id": "qzw-95",
    "text": "渠荷的历，园莽抽条。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "求古寻论"
  },
  {
    "id": "qzw-96",
    "text": "枇杷晚翠，梧桐早凋。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "求古寻论"
  },
  {
    "id": "qzw-97",
    "text": "陈根委翳，落叶飘摇。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "陈根委翳"
  },
  {
    "id": "qzw-98",
    "text": "游鹍独运，凌摩绛霄。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "陈根委翳"
  },
  {
    "id": "qzw-99",
    "text": "耽读玩市，寓目囊箱。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "陈根委翳"
  },
  {
    "id": "qzw-100",
    "text": "易𬨎攸畏，属耳垣墙。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "陈根委翳"
  },
  {
    "id": "qzw-101",
    "text": "具膳餐饭，适口充肠。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "具膳餐饭"
  },
  {
    "id": "qzw-102",
    "text": "饱饫烹宰，饥厌糟糠。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "具膳餐饭"
  },
  {
    "id": "qzw-103",
    "text": "亲戚故旧，老少异粮。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "具膳餐饭"
  },
  {
    "id": "qzw-104",
    "text": "妾御绩纺，侍巾帷房。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "具膳餐饭"
  },
  {
    "id": "qzw-105",
    "text": "纨扇圆絜，银烛炜煌。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "纨扇圆絜"
  },
  {
    "id": "qzw-106",
    "text": "昼眠夕寐，蓝笋象床。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "纨扇圆絜"
  },
  {
    "id": "qzw-107",
    "text": "弦歌酒宴，接杯举觞。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "纨扇圆絜"
  },
  {
    "id": "qzw-108",
    "text": "矫手顿足，悦豫且康。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "纨扇圆絜"
  },
  {
    "id": "qzw-109",
    "text": "嫡后嗣续，祭祀烝尝。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "嫡后嗣续"
  },
  {
    "id": "qzw-110",
    "text": "稽颡再拜，悚惧恐惶。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "嫡后嗣续"
  },
  {
    "id": "qzw-111",
    "text": "笺牒简要，顾答审详。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "嫡后嗣续"
  },
  {
    "id": "qzw-112",
    "text": "骸垢想浴，执热愿凉。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "嫡后嗣续"
  },
  {
    "id": "qzw-113",
    "text": "驴骡犊特，骇跃超骧。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "驴骡犊特"
  },
  {
    "id": "qzw-114",
    "text": "诛斩贼盗，捕获叛亡。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "驴骡犊特"
  },
  {
    "id": "qzw-115",
    "text": "布射僚丸，嵇琴阮啸。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "驴骡犊特"
  },
  {
    "id": "qzw-116",
    "text": "恬笔伦纸，钧巧任钓。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "驴骡犊特"
  },
  {
    "id": "qzw-117",
    "text": "释纷利俗，并皆佳妙。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "释纷利俗"
  },
  {
    "id": "qzw-118",
    "text": "毛施淑姿，工颦妍笑。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "释纷利俗"
  },
  {
    "id": "qzw-119",
    "text": "年矢每催，曦晖朗曜。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "释纷利俗"
  },
  {
    "id": "qzw-120",
    "text": "璇玑悬斡，晦魄环照。",
    "source": "《千字文》",
    "book": "千字文",
    "chapter": "释纷利俗"
  }
]