[
  {
    "id": "sslj-1",
    "text": "备周则意怠，常见则不疑。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "瞒天过海第一"
  },
  {
    "id": "sslj-2",
    "text": "共敌不如分敌，敌阳不如敌阴。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "围魏救赵第二"
  },
  {
    "id": "sslj-3",
    "text": "敌已明，友未定，引友杀敌，不自出力，以损推演。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "借刀杀人第三"
  },
  {
    "id": "sslj-4",
    "text": "困敌之势，不以战。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "以逸待劳第四"
  },
  {
    "id": "sslj-5",
    "text": "敌之害大，就势取利，刚决柔也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "趁火打劫第五"
  },
  {
    "id": "sslj-6",
    "text": "敌志乱萃，不虞。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "声东击西第六"
  },
  {
    "id": "sslj-7",
    "text": "诳也，非诳也，实其所诳也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "无中生有第七"
  },
  {
    "id": "sslj-8",
    "text": "示之以动，利其静而有主，益动而巽。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "暗渡陈仓第八"
  },
  {
    "id": "sslj-9",
    "text": "阳乖序乱，阴以待逆。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "隔岸观火第九"
  },
  {
    "id": "sslj-10",
    "text": "信而安之，阴以图之。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "笑里藏刀第十"
  },
  {
    "id": "sslj-11",
    "text": "势必有损，损阴以益阳。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "李代桃僵第十一"
  },
  {
    "id": "sslj-12",
    "text": "微隙在所必乘，微利在所必得。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "顺手牵羊第十二"
  },
  {
    "id": "sslj-13",
    "text": "疑以叩实，察而后动。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "打草惊蛇第十三"
  },
  {
    "id": "sslj-14",
    "text": "有用者，不可借；不能用者，求借。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "借尸还魂第十四"
  },
  {
    "id": "sslj-15",
    "text": "待天以困之，用人以诱之，往蹇来返。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "调虎离山第十五"
  },
  {
    "id": "sslj-16",
    "text": "逼则反兵，走则减势。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "欲擒故纵第十六"
  },
  {
    "id": "sslj-17",
    "text": "类以诱之，击蒙也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "抛砖引玉第十七"
  },
  {
    "id": "sslj-18",
    "text": "摧其坚，夺其魁，以解其体。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "擒贼擒王第十八"
  },
  {
    "id": "sslj-19",
    "text": "不敌其力，而消其势，兑下干上之象。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "釜底抽薪第十九"
  },
  {
    "id": "sslj-20",
    "text": "乘其阴乱，利其弱而无主，随，以向晦入宴息。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "混水摸鱼第二十"
  },
  {
    "id": "sslj-21",
    "text": "存其形，完其势；友不疑，敌不动。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "金蝉脱壳第二十一"
  },
  {
    "id": "sslj-22",
    "text": "剥，不利有攸往。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "关门捉贼第二十二"
  },
  {
    "id": "sslj-23",
    "text": "形禁势格，利从近取，害以远隔。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "远交近攻第二十三"
  },
  {
    "id": "sslj-24",
    "text": "两大之间，敌胁以从，我假以势。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "假道伐虢第二十四"
  },
  {
    "id": "sslj-25",
    "text": "频更其阵，抽其劲旅，待其自败，而后乘之。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "偷梁换柱第二十五"
  },
  {
    "id": "sslj-26",
    "text": "大凌小者，警以诱之。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "指桑骂槐第二十六"
  },
  {
    "id": "sslj-27",
    "text": "宁伪作不知不为，不伪作假知妄为。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "假痴不癫第二十七"
  },
  {
    "id": "sslj-28",
    "text": "假之以便，唆之使前，断其援应，陷之死地。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "上屋抽梯第二十八"
  },
  {
    "id": "sslj-29",
    "text": "借局布势，力小势大。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "树上开花第二十九"
  },
  {
    "id": "sslj-30",
    "text": "乘隙插足，扼其主机，渐之进也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "反客为主第三十"
  },
  {
    "id": "sslj-31",
    "text": "兵强者，攻其将；将智者，伐其情。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "美人计第三十一"
  },
  {
    "id": "sslj-32",
    "text": "虚者虚之，疑中生疑。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "空城计第三十二"
  },
  {
    "id": "sslj-33",
    "text": "比之自内，不自失也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "反间计第三十三"
  },
  {
    "id": "sslj-34",
    "text": "人不自害，受害必真。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "苦肉计第三十四"
  },
  {
    "id": "sslj-35",
    "text": "将多兵众，不可以敌，使其自累，以杀其势。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "连环计第三十五"
  },
  {
    "id": "sslj-36",
    "text": "左次无咎，未失常也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "走为上计第三十六"
  },
  {
    "id": "sslj-37",
    "text": "阴在阳之内，不在阳之对。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "瞒天过海第一"
  },
  {
    "id": "sslj-38",
    "text": "坤下兑上之象，利其不自主而取之。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "声东击西第六"
  },
  {
    "id": "sslj-39",
    "text": "少阴、太阴、太阳。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "无中生有第七"
  },
  {
    "id": "sslj-40",
    "text": "暴戾恣睢，其势自毙。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "隔岸观火第九"
  },
  {
    "id": "sslj-41",
    "text": "备而后动，勿使有变。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "笑里藏刀第十"
  },
  {
    "id": "sslj-42",
    "text": "少阴，少阳。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "顺手牵羊第十二"
  },
  {
    "id": "sslj-43",
    "text": "复者，阴之媒也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "打草惊蛇第十三"
  },
  {
    "id": "sslj-44",
    "text": "借不能用者而用之。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "借尸还魂第十四"
  },
  {
    "id": "sslj-45",
    "text": "紧随勿迫，累其气力，消其斗志，散而后擒，兵不血刃。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "欲擒故纵第十六"
  },
  {
    "id": "sslj-46",
    "text": "龙战于野，其道穷也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "擒贼擒王第十八"
  },
  {
    "id": "sslj-47",
    "text": "困，有言不信。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "假道伐虢第二十四"
  },
  {
    "id": "sslj-48",
    "text": "刚中而应，行险而顺。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "指桑骂槐第二十六"
  },
  {
    "id": "sslj-49",
    "text": "静不露机，云雷屯也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "假痴不癫第二十七"
  },
  {
    "id": "sslj-50",
    "text": "遇毒，位不当也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "上屋抽梯第二十八"
  },
  {
    "id": "sslj-51",
    "text": "鸿渐于陆，其羽可以为仪也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "树上开花第二十九"
  },
  {
    "id": "sslj-52",
    "text": "将弱兵颓，其势自萎。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "美人计第三十一"
  },
  {
    "id": "sslj-53",
    "text": "刚柔之际，奇而复奇。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "空城计第三十二"
  },
  {
    "id": "sslj-54",
    "text": "假真真假，间以得行。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "苦肉计第三十四"
  },
  {
    "id": "sslj-55",
    "text": "在师中吉，承天宠也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "连环计第三十五"
  },
  {
    "id": "sslj-56",
    "text": "太阳，太阴。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "瞒天过海第一"
  },
  {
    "id": "sslj-57",
    "text": "顺以动豫，豫顺以动。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "隔岸观火第九"
  },
  {
    "id": "sslj-58",
    "text": "刚中柔外也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "笑里藏刀第十"
  },
  {
    "id": "sslj-59",
    "text": "匪我求童蒙，童蒙求我。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "借尸还魂第十四"
  },
  {
    "id": "sslj-60",
    "text": "需，有孚，光。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "欲擒故纵第十六"
  },
  {
    "id": "sslj-61",
    "text": "利用御寇，顺相保也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "美人计第三十一"
  },
  {
    "id": "sslj-62",
    "text": "童蒙之吉，顺以巽也。",
    "source": "《三十六计》",
    "book": "三十六计",
    "chapter": "苦肉计第三十四"
  }
]