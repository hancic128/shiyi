[
  {
    "id": "ssxy-1",
    "text": "陈仲举言为士则，行为世范，登车揽辔，有澄清天下之志。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "德行第一"
  },
  {
    "id": "ssxy-2",
    "text": "边文礼见袁奉高，失次序。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "言语第二"
  },
  {
    "id": "ssxy-3",
    "text": "陈仲弓为太丘长，时吏有诈称母病求假。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "政事第三"
  },
  {
    "id": "ssxy-4",
    "text": "郑玄在马融门下，三年不得相见，高足弟子传授而已。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "文学第四"
  },
  {
    "id": "ssxy-5",
    "text": "陈太丘与友期行，期日中。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "方正第五"
  },
  {
    "id": "ssxy-6",
    "text": "豫章太守顾邵，是雍之子。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "雅量第六"
  },
  {
    "id": "ssxy-7",
    "text": "曹公少时见乔玄，玄谓曰：天下方乱，群雄虎争，拨而理之，非君乎？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "识鉴第七"
  },
  {
    "id": "ssxy-8",
    "text": "陈仲举尝叹曰：若周子居者，真治国之器。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "赏誉第八"
  },
  {
    "id": "ssxy-9",
    "text": "汝南陈仲举，颍川李元礼二人，共论其功德，不能定先后。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "品藻第九"
  },
  {
    "id": "ssxy-10",
    "text": "汉武帝乳母尝于外犯事，帝欲申宪，乳母求救东方朔。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "规箴第十"
  },
  {
    "id": "ssxy-11",
    "text": "杨德祖为魏武主簿，时作相国门，始构榱桷，魏武自出看，使人题门作活字，便去。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "捷悟第十一"
  },
  {
    "id": "ssxy-12",
    "text": "宾客诣陈太丘宿，太丘使元方、季方炊。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "夙惠第十二"
  },
  {
    "id": "ssxy-13",
    "text": "王大将军年少时，旧有田舍名，语音亦楚。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "豪爽第十三"
  },
  {
    "id": "ssxy-14",
    "text": "魏武将见匈奴使，自以形陋，不足雄远国，使崔季珪代，帝自捉刀立床头。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "容止第十四"
  },
  {
    "id": "ssxy-15",
    "text": "周处年少时，凶强侠气，为乡里所患。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "自新第十五"
  },
  {
    "id": "ssxy-16",
    "text": "王丞相拜司空，桓廷尉作两髻、葛裙、策杖，路边窥之，叹曰：人言阿龙超，阿龙故自超。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "企羡第十六"
  },
  {
    "id": "ssxy-17",
    "text": "王仲宣好驴鸣。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "伤逝第十七"
  },
  {
    "id": "ssxy-18",
    "text": "阮步兵啸，闻数百步。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "栖逸第十八"
  },
  {
    "id": "ssxy-19",
    "text": "陈婴者，东阳人。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "贤媛第十九"
  },
  {
    "id": "ssxy-20",
    "text": "荀勖善解音声，时论谓之暗解。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "术解第二十"
  },
  {
    "id": "ssxy-21",
    "text": "弹棋始自魏宫内，用妆奁戏。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "巧艺第二十一"
  },
  {
    "id": "ssxy-22",
    "text": "元帝正会，引王丞相登御床，王公固辞，中宗引之弥苦。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "宠礼第二十二"
  },
  {
    "id": "ssxy-23",
    "text": "陈留阮籍，谯国嵇康，河内山涛，三人年皆相比，康年少亚之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "任诞第二十三"
  },
  {
    "id": "ssxy-24",
    "text": "晋文王功德盛大，坐席严敬，拟于王者。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "简傲第二十四"
  },
  {
    "id": "ssxy-25",
    "text": "诸葛瑾为豫州，遣别驾到台，语云：小儿知谈，卿可与语。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "排调第二十五"
  },
  {
    "id": "ssxy-26",
    "text": "王太尉问眉子：汝叔名士，何以不相推重？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "轻诋第二十六"
  },
  {
    "id": "ssxy-27",
    "text": "魏武少时，尝与袁绍好为游侠，观人新婚，因潜入主人园中，夜叫呼云：有偷儿贼！",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "假谲第二十七"
  },
  {
    "id": "ssxy-28",
    "text": "诸葛宏在西朝，少有清誉，为王夷甫所重，时论亦以拟王。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "黜免第二十八"
  },
  {
    "id": "ssxy-29",
    "text": "和峤性至俭，家有好李，王武子求之，与不过数十。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "俭啬第二十九"
  },
  {
    "id": "ssxy-30",
    "text": "石崇每要客燕集，常令美人行酒。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "汰侈第三十"
  },
  {
    "id": "ssxy-31",
    "text": "魏武有一妓，声最清高，而情性酷恶。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "忿狷第三十一"
  },
  {
    "id": "ssxy-32",
    "text": "王平子形甚散朗，内实劲侠。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "谗险第三十二"
  },
  {
    "id": "ssxy-33",
    "text": "魏文帝忌弟任城王骁壮。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "尤悔第三十三"
  },
  {
    "id": "ssxy-34",
    "text": "王敦初尚主，如厕，见漆箱盛干枣，本以塞鼻，王谓厕上亦下果，食遂至尽。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "纰漏第三十四"
  },
  {
    "id": "ssxy-35",
    "text": "魏甄后惠而有色，先为袁熙妻，甚获宠。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "惑溺第三十五"
  },
  {
    "id": "ssxy-36",
    "text": "孙秀既恨石崇不与绿珠，又憾潘岳昔遇之不以礼。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "仇隙第三十六"
  },
  {
    "id": "ssxy-37",
    "text": "为豫章太守，至，便问徐孺子所在，欲先看之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "德行第一"
  },
  {
    "id": "ssxy-38",
    "text": "奉高曰：昔尧聘许由，面无怍色，先生何为颠倒衣裳？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "言语第二"
  },
  {
    "id": "ssxy-39",
    "text": "事觉收之，令吏杀焉。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "政事第三"
  },
  {
    "id": "ssxy-40",
    "text": "尝算浑天不合，诸弟子莫能解。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "文学第四"
  },
  {
    "id": "ssxy-41",
    "text": "过中不至，太丘舍去，去后乃至。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "方正第五"
  },
  {
    "id": "ssxy-42",
    "text": "邵在郡卒，雍盛集僚属，自围棋。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "雅量第六"
  },
  {
    "id": "ssxy-43",
    "text": "然君实乱世之英雄，治世之奸贼。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "识鉴第七"
  },
  {
    "id": "ssxy-44",
    "text": "譬诸宝剑，则世之干将。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "赏誉第八"
  },
  {
    "id": "ssxy-45",
    "text": "蔡伯喈评之曰：陈仲举强于犯上，李元礼严于摄下。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "品藻第九"
  },
  {
    "id": "ssxy-46",
    "text": "朔曰：此非唇舌所争，尔必望济者，将去时但当屡顾帝，慎勿言！",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "规箴第十"
  },
  {
    "id": "ssxy-47",
    "text": "杨见，即令坏之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "捷悟第十一"
  },
  {
    "id": "ssxy-48",
    "text": "客与太丘论议，二人进火，俱委而窃听。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "夙惠第十二"
  },
  {
    "id": "ssxy-49",
    "text": "武帝唤时贤共言伎蓺事。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "豪爽第十三"
  },
  {
    "id": "ssxy-50",
    "text": "匈奴使答曰：魏王雅望非常，然床头捉刀人，此乃英雄也。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "容止第十四"
  },
  {
    "id": "ssxy-51",
    "text": "又义兴水中有蛟，山中有邅迹虎，并皆暴犯百姓，义兴人谓为三横，而处尤剧。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "自新第十五"
  },
  {
    "id": "ssxy-52",
    "text": "不觉至台门。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "企羡第十六"
  },
  {
    "id": "ssxy-53",
    "text": "既葬，文帝临其丧，顾语同游曰：王好驴鸣，可各作一声以送之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "伤逝第十七"
  },
  {
    "id": "ssxy-54",
    "text": "苏门山中，忽有真人，樵伐者咸共传说。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "栖逸第十八"
  },
  {
    "id": "ssxy-55",
    "text": "少修德行，箸称乡党。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "贤媛第十九"
  },
  {
    "id": "ssxy-56",
    "text": "遂调律吕，正雅乐。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "术解第二十"
  },
  {
    "id": "ssxy-57",
    "text": "文帝于此戏特妙，用手巾角拂之，无不中。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "巧艺第二十一"
  },
  {
    "id": "ssxy-58",
    "text": "王公曰：使太阳与万物同晖，臣下何以瞻仰？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "宠礼第二十二"
  },
  {
    "id": "ssxy-59",
    "text": "预此契者：沛国刘伶，陈留阮咸，河内向秀，琅邪王戎。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "任诞第二十三"
  },
  {
    "id": "ssxy-60",
    "text": "唯阮籍在坐，箕踞啸歌，酣放自若。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "简傲第二十四"
  },
  {
    "id": "ssxy-61",
    "text": "连往诣恪，恪不与相见。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "排调第二十五"
  },
  {
    "id": "ssxy-62",
    "text": "眉子曰：何有名士终日妄语？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "轻诋第二十六"
  },
  {
    "id": "ssxy-63",
    "text": "青庐中人皆出观，魏武乃入，抽刃劫新妇与绍还出，失道，坠枳棘中，绍不能得动，复大叫云：偷儿在此！",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "假谲第二十七"
  },
  {
    "id": "ssxy-64",
    "text": "后为继母族党所谗，诬之为狂逆。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "黜免第二十八"
  },
  {
    "id": "ssxy-65",
    "text": "王武子因其上直，率将少年能食之者，持斧诣园，饱共啖毕，伐之，送一车枝与和公。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "俭啬第二十九"
  },
  {
    "id": "ssxy-66",
    "text": "客饮酒不尽者，使黄门交斩美人。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "汰侈第三十"
  },
  {
    "id": "ssxy-67",
    "text": "欲杀则爱才，欲置则不堪。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "忿狷第三十一"
  },
  {
    "id": "ssxy-68",
    "text": "袁悦有口才，能短长说，亦有精理。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "谗险第三十二"
  },
  {
    "id": "ssxy-69",
    "text": "因在卞太后合共围棋，并啖枣，文帝以毒置诸枣蔕中。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "尤悔第三十三"
  },
  {
    "id": "ssxy-70",
    "text": "既还，婢擎金澡盘盛水，琉璃碗盛澡豆，因倒箸水中而饮之，谓是干饭。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "纰漏第三十四"
  },
  {
    "id": "ssxy-71",
    "text": "曹公之屠邺也，令疾召甄，左右白：五官中郎已将去。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "惑溺第三十五"
  },
  {
    "id": "ssxy-72",
    "text": "后秀为中书令，岳省内见之，因唤曰：孙令，忆畴昔周旋不？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "仇隙第三十六"
  },
  {
    "id": "ssxy-73",
    "text": "主簿曰：群情欲府君先入廨。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "德行第一"
  },
  {
    "id": "ssxy-74",
    "text": "文礼答曰：明府初临，尧德未彰，是以贱民颠倒衣裳耳。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "言语第二"
  },
  {
    "id": "ssxy-75",
    "text": "主簿请付狱，考众奸。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "政事第三"
  },
  {
    "id": "ssxy-76",
    "text": "或言玄能者，融召令算，一转便决，众咸骇服。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "文学第四"
  },
  {
    "id": "ssxy-77",
    "text": "元方时年七岁，门外戏。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "方正第五"
  },
  {
    "id": "ssxy-78",
    "text": "外启信至，而无儿书，虽神气不变，而心了其故。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "雅量第六"
  },
  {
    "id": "ssxy-79",
    "text": "恨吾老矣，不见君富贵，当以子孙相累。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "识鉴第七"
  },
  {
    "id": "ssxy-80",
    "text": "世目李元礼：谡谡如劲松下风。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "赏誉第八"
  },
  {
    "id": "ssxy-81",
    "text": "犯上难，摄下易。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "品藻第九"
  },
  {
    "id": "ssxy-82",
    "text": "此或可万一冀耳。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "规箴第十"
  },
  {
    "id": "ssxy-83",
    "text": "既竟，曰：门中‘活’，‘阔’字。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "捷悟第十一"
  },
  {
    "id": "ssxy-84",
    "text": "炊忘著箄，饭落釜中。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "夙惠第十二"
  },
  {
    "id": "ssxy-85",
    "text": "人皆多有所知，唯王都无所关，意色殊恶，自言知打鼓吹。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "豪爽第十三"
  },
  {
    "id": "ssxy-86",
    "text": "魏武闻之，追杀此使。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "容止第十四"
  },
  {
    "id": "ssxy-87",
    "text": "或说处杀虎斩蛟，实冀三横唯余其一。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "自新第十五"
  },
  {
    "id": "ssxy-88",
    "text": "王丞相过江，自说昔在洛水边，数与裴成公、阮千里诸贤共谈道。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "企羡第十六"
  },
  {
    "id": "ssxy-89",
    "text": "赴客皆一作驴鸣。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "伤逝第十七"
  },
  {
    "id": "ssxy-90",
    "text": "阮籍往观，见其人拥膝岩侧。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "栖逸第十八"
  },
  {
    "id": "ssxy-91",
    "text": "秦末大乱，东阳人欲奉婴为主，母曰：不可！",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "贤媛第十九"
  },
  {
    "id": "ssxy-92",
    "text": "每至正会，殿庭作乐，自调宫商，无不谐韵。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "术解第二十"
  },
  {
    "id": "ssxy-93",
    "text": "有客自云能，帝使为之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "巧艺第二十一"
  },
  {
    "id": "ssxy-94",
    "text": "桓宣武尝请参佐入宿，袁宏、伏滔相次而至，莅名府中，复有袁参军，彦伯疑焉，令传教更质。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "宠礼第二十二"
  },
  {
    "id": "ssxy-95",
    "text": "七人常集于竹林之下，肆意酣畅，故世谓竹林七贤。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "任诞第二十三"
  },
  {
    "id": "ssxy-96",
    "text": "王戎弱冠诣阮籍，时刘公荣在坐。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "简傲第二十四"
  },
  {
    "id": "ssxy-97",
    "text": "后于张辅吴坐中相遇，别驾唤恪：咄咄郎君。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "排调第二十五"
  },
  {
    "id": "ssxy-98",
    "text": "庾元规语周伯仁：诸人皆以君方乐。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "轻诋第二十六"
  },
  {
    "id": "ssxy-99",
    "text": "绍遑迫自掷出，遂以俱免。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "假谲第二十七"
  },
  {
    "id": "ssxy-100",
    "text": "将远徙，友人王夷甫之徒，诣槛车与别。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "黜免第二十八"
  },
  {
    "id": "ssxy-101",
    "text": "和既得，唯笑而已。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "俭啬第二十九"
  },
  {
    "id": "ssxy-102",
    "text": "王丞相与大将军尝共诣崇。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "汰侈第三十"
  },
  {
    "id": "ssxy-103",
    "text": "于是选百人一时俱教。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "忿狷第三十一"
  },
  {
    "id": "ssxy-104",
    "text": "始作谢玄参军，颇被礼遇。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "谗险第三十二"
  },
  {
    "id": "ssxy-105",
    "text": "自选可食者而进，王弗悟，遂杂进之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "尤悔第三十三"
  },
  {
    "id": "ssxy-106",
    "text": "群婢莫不掩口而笑之。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "纰漏第三十四"
  },
  {
    "id": "ssxy-107",
    "text": "公曰：今年破贼正为奴。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "惑溺第三十五"
  },
  {
    "id": "ssxy-108",
    "text": "秀曰：中心藏之，何日忘之？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "仇隙第三十六"
  },
  {
    "id": "ssxy-109",
    "text": "陈曰：武王式商容之闾，席不暇暖。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "德行第一"
  },
  {
    "id": "ssxy-110",
    "text": "徐孺子年九岁，尝月下戏。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "言语第二"
  },
  {
    "id": "ssxy-111",
    "text": "仲弓曰：欺君不忠，病母不孝。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "政事第三"
  },
  {
    "id": "ssxy-112",
    "text": "及玄业成辞归，既而融有礼乐皆东之叹。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "文学第四"
  },
  {
    "id": "ssxy-113",
    "text": "客问元方：尊君在不？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "方正第五"
  },
  {
    "id": "ssxy-114",
    "text": "以爪掐掌，血流沾褥。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "雅量第六"
  },
  {
    "id": "ssxy-115",
    "text": "潜曰：使居中国，能乱人，不能为治。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "识鉴第七"
  },
  {
    "id": "ssxy-116",
    "text": "谢子微见许子将兄弟曰：平舆之渊，有二龙焉。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "赏誉第八"
  },
  {
    "id": "ssxy-117",
    "text": "仲举遂在三君之下，元礼居八俊之上。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "品藻第九"
  },
  {
    "id": "ssxy-118",
    "text": "乳母既至，朔亦侍侧，因谓曰：汝痴耳！",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "规箴第十"
  },
  {
    "id": "ssxy-119",
    "text": "王正嫌门大也。",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "捷悟第十一"
  },
  {
    "id": "ssxy-120",
    "text": "太丘问：炊何不馏？",
    "source": "《世说新语》",
    "book": "世说新语",
    "chapter": "夙惠第十二"
  }
]