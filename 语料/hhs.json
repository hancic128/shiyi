[
  {
    "id": "hhs-1",
    "text": "世祖光武皇帝讳秀，字文叔，南阳蔡阳人，高祖九世之孙也，出自景帝生长沙定王发。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "光武帝纪上第一"
  },
  {
    "id": "hhs-2",
    "text": "六年春正月丙辰，改舂陵乡为章陵县。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "光武帝纪下第二"
  },
  {
    "id": "hhs-3",
    "text": "显宗孝明皇帝讳庄，光武第四子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "显宗孝明帝纪第三"
  },
  {
    "id": "hhs-4",
    "text": "肃宗孝章皇帝讳炟，显宗第五子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "肃宗孝章帝纪第四"
  },
  {
    "id": "hhs-5",
    "text": "孝和皇帝讳肇，肃宗第四子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝和孝殇帝纪第五"
  },
  {
    "id": "hhs-6",
    "text": "恭宗孝安皇帝讳祜，肃宗孙也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝安帝纪第六"
  },
  {
    "id": "hhs-7",
    "text": "孝顺皇帝讳保，安帝之子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝顺孝冲孝质帝纪第七"
  },
  {
    "id": "hhs-8",
    "text": "孝桓皇帝讳志，肃宗曾孙也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝桓帝纪第八"
  },
  {
    "id": "hhs-9",
    "text": "孝灵皇帝讳宏，肃宗玄孙也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝灵帝纪第九"
  },
  {
    "id": "hhs-10",
    "text": "孝献皇帝讳协，灵帝中子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝献帝纪第十"
  },
  {
    "id": "hhs-11",
    "text": "夏、殷以上，后妃之制，其文略矣。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "皇后纪上第十一"
  },
  {
    "id": "hhs-12",
    "text": "安思阎皇后讳姬，河南荥阳人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "皇后纪下第十二"
  },
  {
    "id": "hhs-13",
    "text": "刘玄字圣公，光武族兄也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "刘玄刘盆子列传第一"
  },
  {
    "id": "hhs-14",
    "text": "王昌一名郎，赵国邯郸人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "王刘张李彭卢列传第二"
  },
  {
    "id": "hhs-15",
    "text": "隗嚣字季孟，天水成纪人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "隗嚣公孙述列传第三"
  },
  {
    "id": "hhs-16",
    "text": "齐武王𬙂字伯升，光武之长兄也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "宗室四王三侯列传第四"
  },
  {
    "id": "hhs-17",
    "text": "李通，字次元，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "李王邓来列传第五"
  },
  {
    "id": "hhs-18",
    "text": "邓禹字仲华，南阳新野人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "邓寇列传第六"
  },
  {
    "id": "hhs-19",
    "text": "冯异字公孙，颍川父城人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "冯岑贾列传第七"
  },
  {
    "id": "hhs-20",
    "text": "吴汉字子颜，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "吴盖陈臧列传第八"
  },
  {
    "id": "hhs-21",
    "text": "耿弇字伯昭，扶风茂陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "耿弇列传第九"
  },
  {
    "id": "hhs-22",
    "text": "铫期字次况，颍川郏人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "铫期王霸祭遵列传第十"
  },
  {
    "id": "hhs-23",
    "text": "任光字伯卿，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "任李万邳刘耿列传第十一"
  },
  {
    "id": "hhs-24",
    "text": "朱祐字仲先，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "朱景王杜马刘傅坚马列传第十二"
  },
  {
    "id": "hhs-25",
    "text": "窦融字周公，扶风平陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "窦融列传第十三"
  },
  {
    "id": "hhs-26",
    "text": "马援字文渊，扶风茂陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "马援列传第十四"
  },
  {
    "id": "hhs-27",
    "text": "卓茂字子康，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "卓鲁魏刘列传第十五"
  },
  {
    "id": "hhs-28",
    "text": "桓谭字君山，沛国相人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "桓谭冯衍列传上第十八"
  },
  {
    "id": "hhs-29",
    "text": "臣伏念高祖之略而陈平之谋，毁之则疏，誉之则亲。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "桓谭冯衍列传下第十九"
  },
  {
    "id": "hhs-30",
    "text": "苏竟字伯况，扶风平陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "苏竟杨厚列传上第二十一"
  },
  {
    "id": "hhs-31",
    "text": "郎𫖮字雅光，北海安丘人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "郎顗襄楷列传下第二十二"
  },
  {
    "id": "hhs-32",
    "text": "班彪字叔皮，扶风安陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "班彪列传上第三十二"
  },
  {
    "id": "hhs-33",
    "text": "主人喟然而叹曰痛乎风俗之移人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "班彪列传下第三十三"
  },
  {
    "id": "hhs-34",
    "text": "第五伦字伯鱼，京兆长陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "第五钟离宋寒列传第三十四"
  },
  {
    "id": "hhs-35",
    "text": "张衡字平子，南阳西鄂人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "张衡列传第五十二"
  },
  {
    "id": "hhs-36",
    "text": "马融字季长，扶风茂陵人也，将作大匠严之子。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "马融列传上第五十三"
  },
  {
    "id": "hhs-37",
    "text": "蔡邕字伯喈，陈留圉人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "蔡邕列传下第五十四"
  },
  {
    "id": "hhs-38",
    "text": "吴祐字季英，陈留长垣人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "吴延史卢赵列传第五十八"
  },
  {
    "id": "hhs-39",
    "text": "陈蕃字仲举，汝南平舆人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "陈王列传第六十"
  },
  {
    "id": "hhs-40",
    "text": "窦武字游平，扶风平陵人，安丰戴侯融之玄孙也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "窦何列传第六十三"
  },
  {
    "id": "hhs-41",
    "text": "皇甫嵩字义真，安定朝那人，度辽将军规之兄子也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "皇甫嵩朱儁列传第六十五"
  },
  {
    "id": "hhs-42",
    "text": "袁绍字本初，汝南阳人，司徒汤之孙。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "袁绍刘表列传上第六十八"
  },
  {
    "id": "hhs-43",
    "text": "谭自称车骑将军，出军黎阳。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "袁绍刘表列传下第六十九"
  },
  {
    "id": "hhs-44",
    "text": "乌桓者，本东胡也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "乌桓鲜卑列传第八十八"
  },
  {
    "id": "hhs-45",
    "text": "古之人论数也，曰物生而后有象，象而后有滋，滋而后有数。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "律历上第一"
  },
  {
    "id": "hhs-46",
    "text": "昔者圣人之作历也，观琁玑之运，三光之行，道之发敛，景之长短，斗纲所建，青龙所躔，参伍以变，错综其数，而制术焉。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "律历下第三"
  },
  {
    "id": "hhs-47",
    "text": "董卓字仲颖，陇西临洮人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "董卓列传第六十六"
  },
  {
    "id": "hhs-48",
    "text": "发生舂陵节侯买，买生郁林太守外，外生巨鹿都尉回，回生南顿令钦，钦生光武。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "光武帝纪上第一"
  },
  {
    "id": "hhs-49",
    "text": "世世复徭役，比丰、沛，无有所豫。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "光武帝纪下第二"
  },
  {
    "id": "hhs-50",
    "text": "帝生而丰下，十岁能通春秋，光武奇之。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "显宗孝明帝纪第三"
  },
  {
    "id": "hhs-51",
    "text": "永平三年，立为皇太子。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "肃宗孝章帝纪第四"
  },
  {
    "id": "hhs-52",
    "text": "母梁贵人，为窦皇后所谮，忧卒，窦后养帝以为己子。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝和孝殇帝纪第五"
  },
  {
    "id": "hhs-53",
    "text": "父清河孝王庆，母左姬。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝安帝纪第六"
  },
  {
    "id": "hhs-54",
    "text": "母李氏，为阎皇后所害。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝顺孝冲孝质帝纪第七"
  },
  {
    "id": "hhs-55",
    "text": "祖父河间孝王开，父蠡吾侯翼，母匽氏。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝桓帝纪第八"
  },
  {
    "id": "hhs-56",
    "text": "曾祖河间孝王开，祖淑，父苌。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝灵帝纪第九"
  },
  {
    "id": "hhs-57",
    "text": "母王美人，为何皇后所害。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "孝献帝纪第十"
  },
  {
    "id": "hhs-58",
    "text": "周礼王者立后，三夫人，九嫔，二十七世妇，八十一女御，以备内职焉。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "皇后纪上第十一"
  },
  {
    "id": "hhs-59",
    "text": "祖父章，永平中为尚书，以二妹为贵人。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "皇后纪下第十二"
  },
  {
    "id": "hhs-60",
    "text": "弟为人所杀，圣公结客欲报之。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "刘玄刘盆子列传第一"
  },
  {
    "id": "hhs-61",
    "text": "素为卜相工，明星历，常以为河北有天子气。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "王刘张李彭卢列传第二"
  },
  {
    "id": "hhs-62",
    "text": "王莽国师刘歆引嚣为士。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "隗嚣公孙述列传第三"
  },
  {
    "id": "hhs-63",
    "text": "性刚毅，慷慨有大节。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "宗室四王三侯列传第四"
  },
  {
    "id": "hhs-64",
    "text": "世以贷殖著姓。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "李王邓来列传第五"
  },
  {
    "id": "hhs-65",
    "text": "年十三，能诵诗，受业长安。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "邓寇列传第六"
  },
  {
    "id": "hhs-66",
    "text": "好读书，通左氏春秋孙子兵法。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "冯岑贾列传第七"
  },
  {
    "id": "hhs-67",
    "text": "家贫，给事县为亭长。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "吴盖陈臧列传第八"
  },
  {
    "id": "hhs-68",
    "text": "其先武帝时以吏二千石自巨鹿徙焉。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "耿弇列传第九"
  },
  {
    "id": "hhs-69",
    "text": "长八尺二寸，容貌绝异，矜严有威。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "铫期王霸祭遵列传第十"
  },
  {
    "id": "hhs-70",
    "text": "少忠厚，为乡里所爱。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "任李万邳刘耿列传第十一"
  },
  {
    "id": "hhs-71",
    "text": "少孤，归外家复阳刘氏，往来舂陵，世祖与伯升皆亲爱之。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "朱景王杜马刘傅坚马列传第十二"
  },
  {
    "id": "hhs-72",
    "text": "七世祖广国，孝文皇后之弟，封章武侯。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "窦融列传第十三"
  },
  {
    "id": "hhs-73",
    "text": "其先赵奢为赵将，号曰马服君，子孙因为氏。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "马援列传第十四"
  },
  {
    "id": "hhs-74",
    "text": "父祖皆至郡守。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "卓鲁魏刘列传第十五"
  },
  {
    "id": "hhs-75",
    "text": "伏湛字惠公，琅邪东武人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "伏侯宋蔡冯赵牟韦列传第十六"
  },
  {
    "id": "hhs-76",
    "text": "宣秉字巨公，冯翊云阳人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "宣张二王杜郭吴承郑赵列传第十七"
  },
  {
    "id": "hhs-77",
    "text": "父成帝时为太乐令。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "桓谭冯衍列传上第十八"
  },
  {
    "id": "hhs-78",
    "text": "以文帝以明而魏尚之忠，绳之以法则为罪，施之以德则为功。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "桓谭冯衍列传下第十九"
  },
  {
    "id": "hhs-79",
    "text": "申屠刚字巨卿，扶风茂陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "申屠刚鲍永郅恽列传第二十"
  },
  {
    "id": "hhs-80",
    "text": "平帝世，竟以明易为博士讲书祭酒。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "苏竟杨厚列传上第二十一"
  },
  {
    "id": "hhs-81",
    "text": "父宗，字仲绥，学京氏易，善风角、星算、六日七分，能望气占候吉凶，常卖卜自奉。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "郎顗襄楷列传下第二十二"
  },
  {
    "id": "hhs-82",
    "text": "郭伋字细侯，扶风茂陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "郭杜孔张廉王苏羊贾陆列传第二十三"
  },
  {
    "id": "hhs-83",
    "text": "樊宏字靡卿，南阳湖阳人也，世祖之舅。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "樊宏阴识列传第二十四"
  },
  {
    "id": "hhs-84",
    "text": "朱浮字叔元，沛国萧人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "朱冯虞郑周列传第二十五"
  },
  {
    "id": "hhs-85",
    "text": "梁统字仲宁，安定乌氏人，晋大夫梁益耳，即其先也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "梁统列传第二十六"
  },
  {
    "id": "hhs-86",
    "text": "张纯字伯仁，京兆杜陵人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "张曹郑列传第二十七"
  },
  {
    "id": "hhs-87",
    "text": "郑兴字少赣，河南开封人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "郑范陈贾张列传第二十八"
  },
  {
    "id": "hhs-88",
    "text": "桓荣字春卿，沛郡龙亢人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "桓荣丁鸿列传第二十九"
  },
  {
    "id": "hhs-89",
    "text": "张宗字诸君，南阳鲁阳人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "张法滕冯度杨列传第三十"
  },
  {
    "id": "hhs-90",
    "text": "孔子曰夫孝莫大于严父，严父莫大于配天，则周公其人也子路曰伤哉贫也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "刘赵淳于江刘周赵列传第三十一"
  },
  {
    "id": "hhs-91",
    "text": "祖况，成帝时为越骑校尉。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "班彪列传上第三十二"
  },
  {
    "id": "hhs-92",
    "text": "子实秦人，矜夸馆室，保界河山，信识昭、襄而知始皇矣，恶睹大汉之云为乎。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "班彪列传下第三十三"
  },
  {
    "id": "hhs-93",
    "text": "其先齐诸田，诸田徙园陵者多，故以次第为氏。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "第五钟离宋寒列传第三十四"
  },
  {
    "id": "hhs-94",
    "text": "光武皇帝十一子：郭皇后生东海恭王彊、沛献王辅、济南安王康、阜陵质王延、中山简王焉，许美人生楚王英，光烈皇后生显宗、东平宪王苍、广陵思王荆、临淮怀公衡、琅邪孝王京。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "光武十王列传第三十五"
  },
  {
    "id": "hhs-95",
    "text": "朱晖字文季，南阳宛人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "朱乐何列传第三十六"
  },
  {
    "id": "hhs-96",
    "text": "邓彪字智伯，南阳新野人，太傅禹之宗也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "邓张徐张胡列传第三十七"
  },
  {
    "id": "hhs-97",
    "text": "袁安字邵公，汝南汝阳人也。",
    "source": "《后汉书》",
    "book": "后汉书",
    "chapter": "袁张韩周列传第三十八"
  }
]