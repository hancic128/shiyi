[
  {
    "id": "sny-1",
    "text": "心要如天平，称物时物忙而衡不忙，物去时即悬空在此。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-2",
    "text": "宇宙内大情种，男女居其第一。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-3",
    "text": "大道有一条正路，进道有一定等级。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-4",
    "text": "六合是我底六合，那个是人？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-5",
    "text": "学必相讲而后明，讲必相宜而后尽。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-6",
    "text": "闲暇时留心不成，仓卒时措手不得。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-7",
    "text": "夫水遏之，乃所以多之；泄之，乃所以竭之。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-8",
    "text": "湿温生物，湿热长物，燥热成物，凄凉杀物，严寒养物。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-9",
    "text": "势之所在，天地圣人不能违也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-10",
    "text": "孔子是五行造身，两仪成性。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-11",
    "text": "独处看不破，忽处看不破，劳倦时看不破，急遽仓卒时看不破，惊忧骤感时看不破，重大独当时看不破，吾必以为圣人。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-12",
    "text": "庙堂之上，以养正气为先；海字之内，以养元气为本。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-13",
    "text": "无所乐有所苦，即父子不相保也，而况民乎？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-14",
    "text": "鸱鸦，其本声也如鹊鸠然，第其声可憎，闻者以为不祥，每弹杀之。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  },
  {
    "id": "sny-15",
    "text": "剑长三尺，用在一丝之铦刃；笔长三寸，用在一端之锐毫，其余皆无用之羡物也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·广喻"
  },
  {
    "id": "sny-16",
    "text": "六经之文不相师也，而后世不敢轩轾。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·词章"
  },
  {
    "id": "sny-17",
    "text": "正命者，完却正理，全却初气，未尝以我害之，虽桎梏而死，不害其人正命。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·性命"
  },
  {
    "id": "sny-18",
    "text": "只恁静虚中，正何等自在！",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-19",
    "text": "圣王不欲裁割而矫拂之，亦不能裁割矫拂也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-20",
    "text": "圣人教人只示以一定之成法，在人自理会；理会得一步再说与一步，其第一步不理会到十分，也不说与第二步。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-21",
    "text": "我是六合底我，那个是我？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-22",
    "text": "孔门师友不厌穷问极言，不相然诺承顺，所谓审问明辨也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-23",
    "text": "胡乱支吾，任其成败，或悔或不悔，事过后依然如昨世之人。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-24",
    "text": "惟仁者能泄。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-25",
    "text": "湿温，冲和之气也；湿热，蒸发之气也；燥热，燔灼之气也；凄凉，杀气，阴壮而阳微也，严寒，敛气，阴外激而阳内培也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-26",
    "text": "势来时即摧之，未必遽坏；势去时即挽之，未必能回。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-27",
    "text": "其余圣人得金气多者则刚明果断，得木气多者则朴素质直，得火气多者则发扬奋迅，得水气多者则明彻圆融，得土气多者则镇静浑厚，得阳气多者则光明轩豁，得阴气多者则沉默精细。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-28",
    "text": "圣人做出来都是德性，贤人做出来都是气质，众人做出来都是习俗，小人做出来都是私欲。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-29",
    "text": "能使贤人君子无郁心之言，则正气培矣；能使群黎百姓无腹诽之语，则元气固矣。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-30",
    "text": "有所乐无所苦，即戎狄且相亲也，而况民乎？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-31",
    "text": "夫物之飞鸣，何尝择地哉？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  },
  {
    "id": "sny-32",
    "text": "虽然，使剑与笔但有其铦者锐者焉，则其用不可施。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·广喻"
  },
  {
    "id": "sny-33",
    "text": "后之为文者，吾惑矣。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·词章"
  },
  {
    "id": "sny-34",
    "text": "德性以收敛沉着为第一，收敛沉着中又以精明平易为第一。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·性命"
  },
  {
    "id": "sny-35",
    "text": "收放心，休要如追放豚，既入笠了，便要使他从容闲畅，无拘迫懊憹之状。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-36",
    "text": "故通之以不可已之情，约之以不可犯之礼，绳之以必不赦之法，使纵之而相安相久也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-37",
    "text": "非是苦人，等级原是如此。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-38",
    "text": "世上没个分外好底，便到天地位，万物育底功用，也是性分中应尽底事业。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-39",
    "text": "故当其时，道学大明，如拨云披雾，白日青天，无纤毫障蔽。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-40",
    "text": "凡事豫则立，此五字极当理会。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-41",
    "text": "惟智者知泄。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-42",
    "text": "五气惟严寒最仁。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-43",
    "text": "然而圣人每与势忤，而不肯甘心从之者，人事宜然也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-44",
    "text": "气质既有所限，虽造其极，终是一偏底圣人。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-45",
    "text": "汉儒杂道，宋儒隘道。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-46",
    "text": "此万世帝王保天下之要道也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-47",
    "text": "世之人，闻人过失，便喜谈而乐道之；见人规已之过，既掩护之，又痛疾之；闻人称誉，便欣喜而夸张之；见人称人之善，既盖藏之，又搜索之。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-48",
    "text": "集屋鸣屋，集树鸣树。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  },
  {
    "id": "sny-49",
    "text": "易牙不能无爨子，欧冶不能无砧手，工输不能无钻厮。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·广喻"
  },
  {
    "id": "sny-50",
    "text": "拟韩临柳，效马学班，代相祖述，窃其糟粕，谬矣。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·词章"
  },
  {
    "id": "sny-51",
    "text": "大叚收敛沉着人怕含糊，怕深险。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·性命"
  },
  {
    "id": "sny-52",
    "text": "同归于无得也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-53",
    "text": "圣人亦不若是之亟也，故五伦中父子、君臣、兄弟、朋友，笃了又笃，厚了又厚，惟恐情意之薄。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-54",
    "text": "第一步差一寸，也到第二步不得。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-55",
    "text": "今人才有一善，便向人有矜色，便见得世上人都有不是，余甚耻之。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-56",
    "text": "讲学须要如此，无坚自是之心，恶人相直也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-57",
    "text": "道眼在是非上见，情眼在爱憎上见，物眼无别白，浑沌而已。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-58",
    "text": "天地间之祸人者，莫如多；令人易多者，莫如美。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-59",
    "text": "浑厚，天之道也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-60",
    "text": "世人贱老，而圣王尊之；世人弃愚，而君子取之；世人耻贫，而高士清之；世人厌淡，而智者味之；世人恶冷，而幽人宝之；世人薄素，而有道者尚之。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-61",
    "text": "此七子者，共事多不相合，共言多不相入，所同者大根本大节目耳。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-62",
    "text": "宋儒自有宋儒局面，学者若入道，且休着宋儒横其胸中，只读六经四书而体玩之，久久胸次自是不同。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-63",
    "text": "六合之内，有一事一物相凌夺假借，而不各居其正位，不成清世界；有匹夫匹妇冤抑愤懑，而不得其分愿，不成平世界。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-64",
    "text": "试思这个念头是君子乎？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-65",
    "text": "彼鸣屋者，主人疑之矣，不知其鸣于野树，主何人不祥也？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  },
  {
    "id": "sny-66",
    "text": "苟不能无，则与有用者等也，若之何而可以相病也？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·广喻"
  },
  {
    "id": "sny-67",
    "text": "夫文以载道也，苟文足以明道，谓吾之文为六经可也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·词章"
  },
  {
    "id": "sny-68",
    "text": "浅浮子虽光明洞达，非蓄得罪之器也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·性命"
  },
  {
    "id": "sny-69",
    "text": "故再放便奔逸不可收拾。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-70",
    "text": "惟男女一伦是圣人苦心处，故有别先自夫妇始。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-71",
    "text": "孔子于赐，才说与他一贯，又先难他多学而识一语。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-72",
    "text": "率真者无心过，殊多躁言轻举之失；慎密者无口过，不免厚貌深情之累。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-73",
    "text": "熟思审处，此四字德业之首务；锐意极力，此四字德业之要务；有渐无已，此四字德业之成务；深忧过计，此四字德业之终务。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-74",
    "text": "实见得是时，便要斩钉截铁，脱然爽洁，做成一件事，不可拖泥带水，靠壁倚墙。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-75",
    "text": "美味令人多食，美色令人多欲，美声令人多听，美物令人多贪，美官令人多求，美室令人多居，美田令人多置，美寝令人多逸，美言令人多入，美事令人多恋，美景令人多留，美趣令人多思，皆祸媒也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-76",
    "text": "是故处万物而忘言，然不能无日月星辰以昭示之，是寓精明于浑厚之中。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-77",
    "text": "世之人难与言矣。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-78",
    "text": "孔颜穷居，不害其为仁覆天下，何则？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-79",
    "text": "一种人难悦亦难事，只是度量褊狭，不失为君子；一种人易事亦易悦，这是贪污软弱，不失为小人。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-80",
    "text": "天下万事万物皆要求个实用。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-81",
    "text": "乍见之患，愚者所惊；渐至之殃，智者所忽也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-82",
    "text": "至于犬人行、鼠人言、豕人立，真大异事，然不祥在物，无与于人。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  },
  {
    "id": "sny-83",
    "text": "坐井者不可与言一度之天，出而四顾，则始觉其大矣。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·广喻"
  },
  {
    "id": "sny-84",
    "text": "与六经不相叛也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·词章"
  },
  {
    "id": "sny-85",
    "text": "或问：人将死而见鬼神，真耶？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·性命"
  },
  {
    "id": "sny-86",
    "text": "君子之心如习鹰驯雉，搏击飞腾，主人略不防闲，及上臂归庭，却恁忘机自得，略不惊畏。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·存心"
  },
  {
    "id": "sny-87",
    "text": "本与之以无别也，而又教之以有别，况有别者而肯使之混乎？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·伦理"
  },
  {
    "id": "sny-88",
    "text": "至于仁者之事，又说：赐也，非尔所及。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷一内篇礼集·谈道"
  },
  {
    "id": "sny-89",
    "text": "心事如青天白，言动如履薄临深，其惟君子乎？",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·修身"
  },
  {
    "id": "sny-90",
    "text": "静是个见道的妙诀，只在静处潜观，六合中动的机括都解破。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷二内篇乐集·问学"
  },
  {
    "id": "sny-91",
    "text": "人定真足胜天。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·应务"
  },
  {
    "id": "sny-92",
    "text": "不美则不令人多。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷三内篇射集·养生"
  },
  {
    "id": "sny-93",
    "text": "精存则生神，精散则生形。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·天地"
  },
  {
    "id": "sny-94",
    "text": "坏世教者，不是宦官宫安，不是农工商贸，不是衙门市井，不是囗囗。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·世运"
  },
  {
    "id": "sny-95",
    "text": "仁覆天下之具在我，而仁覆天下之心未尝一日忘也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·圣贤"
  },
  {
    "id": "sny-96",
    "text": "为小人所荐者，辱也；为君子所弃者，耻也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷四外篇御集·品藻"
  },
  {
    "id": "sny-97",
    "text": "实用者，与吾身心关损益者也。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷五外篇书集·治道"
  },
  {
    "id": "sny-98",
    "text": "以愚者而当智者之所忽，可畏哉！",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·人情"
  },
  {
    "id": "sny-99",
    "text": "即使于人为凶，然亦不过感戾气而呈兆，在物亦莫知所以然耳。",
    "source": "《呻吟语》",
    "book": "呻吟语",
    "chapter": "卷六外篇数集·物理"
  }
]