[
  {
    "id": "lfsx-1",
    "text": "余童年丧父，老母命弃举业学医，谓可以养生，可以济人，且习一艺以成名，尔父夙心也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-2",
    "text": "春秋诸大夫，见人言动，亿而谈其祸福，靡不验者，左国诸记可观也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-3",
    "text": "易曰：积善之家，必有馀庆。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-4",
    "text": "易曰：天道亏盈而益谦；地道变盈而流谦；鬼神害盈而福谦；人道恶盈而好谦。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-5",
    "text": "后余在慈云寺，遇一老者，修髯伟貌，飘飘若仙，余敬礼之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-6",
    "text": "大都吉凶之兆，萌乎心而动乎四体，其过于厚者常获福，过于薄者常近祸，俗眼多翳，谓有未定而不可测者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-7",
    "text": "昔颜氏将以女妻叔梁纥，而历叙其祖宗积德之长，逆知其子孙必有兴者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-8",
    "text": "是故谦之一卦，六爻皆吉。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-9",
    "text": "语余曰：子仕路中人也，明年即进学，何不读书？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-10",
    "text": "至诚合天，福之将至，观其善而必先知之矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-11",
    "text": "孔子称舜之大孝，曰：宗庙飨之，子孙保之，皆至论也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-12",
    "text": "书曰：满招损，谦受益。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-13",
    "text": "余告以故，并叩老者姓氏里居。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-14",
    "text": "祸之将至，观其不善而必先知之矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-15",
    "text": "试以往事征之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-16",
    "text": "予屡同诸公应试，每见寒士将达，必有一段谦光可掬。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-17",
    "text": "今欲获福而远祸，未论行善，先须改过。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-18",
    "text": "杨少师荣，建宁人。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-19",
    "text": "辛未计偕，我嘉善同袍凡十人，惟丁敬宇宾，年最少，极其谦虚。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-20",
    "text": "得邵子皇极数正传，数该传汝。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-21",
    "text": "但改过者，第一，要发耻心。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-22",
    "text": "世以济渡为生，久雨溪涨，横流冲毁民居，溺死者顺流而下，他舟皆捞取货物，独少师曾祖及祖，惟救人，而货物一无所取，乡人嗤其愚。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-23",
    "text": "予告费锦坡曰：此兄今年必第。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-24",
    "text": "余引之归，告母。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-25",
    "text": "思古之圣贤，与我同为丈夫，彼何以百世可师？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-26",
    "text": "逮少师父生，家渐裕，有神人化为道者，语之曰：汝祖父有阴功，子孙当贵显，宜葬某地。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-27",
    "text": "费曰：何以见之？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-28",
    "text": "母曰：善待之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-29",
    "text": "我何以一身瓦裂？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-30",
    "text": "遂依其所指而窆之，即今白兔坟也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-31",
    "text": "予曰：惟谦受福。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-32",
    "text": "试其数，纤悉皆验。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-33",
    "text": "耽染尘情，私行不义，谓人不知，傲然无愧，将日沦于禽兽而不自知矣；世之可羞可耻者，莫大乎此。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-34",
    "text": "后生少师，弱冠登第，位至三公，加曾祖，祖，父，如其官。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-35",
    "text": "兄看十人中，有恂恂款款，不敢先人，如敬宇者乎？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-36",
    "text": "余遂起读书之念，谋之表兄沈称，言：郁海谷先生在沈友夫家开馆，我送汝寄学甚便。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-37",
    "text": "孟子曰：耻之于人大矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-38",
    "text": "子孙贵盛，至今尚多贤者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-39",
    "text": "有恭敬顺承，小心谦畏，如敬宇者乎？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-40",
    "text": "余遂礼郁为师。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-41",
    "text": "以其得之则圣贤，失之则禽兽耳。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-42",
    "text": "鄞人杨自惩，初为县吏，存心仁厚，守法公平。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-43",
    "text": "有受侮不答，闻谤不辩，如敬宇者乎？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-44",
    "text": "孔为余起数：县考童生，当十四名；府考七十一名，提学考第九名。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-45",
    "text": "此改过之要机也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-46",
    "text": "时县宰严肃，偶挞一囚，血流满前，而怒犹未息，杨跪而宽解之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-47",
    "text": "人能如此，即天地鬼神，犹将佑之，岂有不发者？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-48",
    "text": "明年赴考，三处名数皆合。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-49",
    "text": "第二，要发畏心。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-50",
    "text": "宰曰：怎奈此人越法悖理，不由人不怒。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-51",
    "text": "及开榜，丁果中式。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-52",
    "text": "复为卜终身休咎，言：某年考第几名，某年当补廪，某年当贡，贡后某年当选四川一大尹，在任三年半，即宜告归。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-53",
    "text": "天地在上，鬼神难欺，吾虽过在隐微，而天地鬼神，实鉴临之，重则降之百殃，轻则损其现福，吾何可以不惧？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-54",
    "text": "自惩叩首曰：上失其道，民散久矣，如得其情，哀矜勿喜；喜且不可，而况怒乎？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-55",
    "text": "丁丑在京，与冯开之同处，见其虚己敛容，大变其幼年之习。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-56",
    "text": "五十三岁八月十四日丑时，当终于正寝，惜无子。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-57",
    "text": "闲居之地，指视昭然；吾虽掩之甚密，文之甚巧，而肺肝早露，终难自欺；被人觑破，不值一文矣，乌得不懔懔？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-58",
    "text": "宰为之霁颜。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-59",
    "text": "李霁岩直谅益友，时面攻其非，但见其平怀顺受，未尝有一言相报。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-60",
    "text": "余备录而谨记之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-61",
    "text": "一息尚存，弥天之恶，犹可悔改；古人有一生作恶，临死悔悟，发一善念，遂得善终者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-62",
    "text": "家甚贫，馈遗一无所取，遇囚人乏粮，常多方以济之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-63",
    "text": "予告之曰：福有福始，祸有祸先，此心果谦，天必相之，兄今年决第矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-64",
    "text": "自此以后，凡遇考校，其名数先后，皆不出孔公所悬定者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-65",
    "text": "谓一念猛厉，足以涤百年之恶也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-66",
    "text": "一日，有新囚数人待哺，家又缺米；给囚则家人无食；自顾则囚人堪悯；与其妇商之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-67",
    "text": "赵裕峰，光远，山东冠县人，童年举于乡，久不第。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-68",
    "text": "独算余食廪米九十一石五斗当出贡；及食米七十余石，屠宗师即批准补贡，余窃疑之。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-69",
    "text": "譬如千年幽谷，一灯才照，则千年之暗俱除；故过不论久近，惟以改为贵。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-70",
    "text": "妇曰：囚从何来？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-71",
    "text": "其父为嘉善三尹，随之任。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-72",
    "text": "后果为署印杨公所驳，直至丁卯年，殷秋溟宗师见余场中备卷，叹曰：五策，即五篇奏议也，岂可使博洽淹贯之儒，老于窗下乎！",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-73",
    "text": "但尘世无常，肉身易殒，一息不属，欲改无由矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-74",
    "text": "慕钱明吾，而执文见之，明吾悉抹其文，赵不惟不怒，且心服而速改焉。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-75",
    "text": "遂依县申文准贡，连前食米计之，实九十一石五斗也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-76",
    "text": "明则千百年担负恶名，虽孝子慈孙，不能洗涤；幽则千百劫沉沦狱报，虽圣贤佛菩萨，不能援引。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-77",
    "text": "沿路忍饥，菜色可掬。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-78",
    "text": "明年，遂登第。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-79",
    "text": "余因此益信进退有命，迟速有时，澹然无求矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-80",
    "text": "第三，须发勇心。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-81",
    "text": "因撤己之米，煮粥以食囚。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-82",
    "text": "壬辰岁，予入觐，晤夏建所，见其人气虚意下，谦光逼人，归而告友人曰：凡天将发斯人也，未发其福，先发其慧；此慧一发，则浮者自实，肆者自敛；建所温良若此，天启之矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-83",
    "text": "贡入燕都，留京一年，终日静坐，不阅文字。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-84",
    "text": "人不改过，多是因循退缩；吾须奋然振作，不用迟疑，不烦等待。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-85",
    "text": "后生二子，长曰守陈，次曰守址，为南北吏部侍郎；长孙为刑部侍郎；次孙为四川廉宪，又俱为名臣；今楚亭，德政，亦其裔也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-86",
    "text": "及开榜，果中式。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-87",
    "text": "己巳归，游南雍，未入监，先访云谷会禅师于栖霞山中，对坐一室，凡三昼夜不瞑目。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-88",
    "text": "小者如芒刺在肉，速与抉剔；大者如毒蛇啮指，速与斩除，无丝毫凝滞，此风雷之所以为益也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-89",
    "text": "莆田林氏，先世有老母好善，常作粉团施人，求取即与之，无倦色；一仙化为道人，每旦索食六七团。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-90",
    "text": "江阴张畏岩，积学工文，有声艺林。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-91",
    "text": "汝坐三日，不见起一妄念，何也？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-92",
    "text": "具是三心，则有过斯改，如春冰遇日，何患不消乎？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-93",
    "text": "母日日与之，终三年如一日，乃知其诚也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-94",
    "text": "甲午，南京乡试，寓一寺中，揭晓无名，大骂试官，以为眯目。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-95",
    "text": "余曰：吾为孔先生算定，荣辱死生，皆有定数，即要妄想，亦无可妄想。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-96",
    "text": "然人之过，有从事上改者，有从理上改者，有从心上改者；工夫不同，效验亦异。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-97",
    "text": "因谓之曰：吾食汝三年粉团，何以报汝？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-98",
    "text": "时有一道者，在傍微笑，张遽移怒道者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-99",
    "text": "云谷笑曰：我待汝是豪杰，原来只是凡夫。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-100",
    "text": "强制于外，其难百倍，且病根终在，东灭西生，非究竟廓然之道也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-101",
    "text": "府后有一地，葬之，子孙官爵，有一升麻子之数。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-102",
    "text": "道者曰：相公文必不佳。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-103",
    "text": "但惟凡人有数：极善之人，数固拘他不定；极恶之人，数亦拘他不定。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-104",
    "text": "善改过者，未禁其事，先明其理；如过在杀生，即思曰：上帝好生，物皆恋命，杀彼养己，岂能自安？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-105",
    "text": "其子依所点葬之，初世即有九人登第，累代簪缨甚盛，福建有无林不开榜之谣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-106",
    "text": "张怒曰：汝不见我文，乌知不佳？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-107",
    "text": "汝二十年来，被他算定，不曾转动一毫，岂非是凡夫？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-108",
    "text": "又思血气之属，皆含灵知，既有灵知，皆我一体；纵不能躬修至德，使之尊我亲我，岂可日戕物命，使之仇我憾我于无穷也？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-109",
    "text": "冯琢庵太史之父，为邑庠生。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-110",
    "text": "道者曰：闻作文，贵心气和平，今听公骂詈，不平甚矣，文安得工？",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-111",
    "text": "一思及此，将有对食痛心，不能下咽者矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-112",
    "text": "隆冬早起赴学，路遇一人，倒卧雪中，扪之，半僵矣。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-113",
    "text": "张不觉屈服，因就而请教焉。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  },
  {
    "id": "lfsx-114",
    "text": "诗书所称，的为明训。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "立命之学第一"
  },
  {
    "id": "lfsx-115",
    "text": "本无可怒者。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "改过之法第二"
  },
  {
    "id": "lfsx-116",
    "text": "遂解己绵裘衣之，且扶归救苏。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "积善之方第三"
  },
  {
    "id": "lfsx-117",
    "text": "道者曰：中全要命；命不该中，文虽工，无益也。",
    "source": "《了凡四训》",
    "book": "了凡四训",
    "chapter": "谦德之效第四"
  }
]