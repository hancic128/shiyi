[
  {
    "id": "smf-1",
    "text": "古者，以仁为本，以义治之之谓正。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-2",
    "text": "天子之义，必纯取法天地而观于先圣。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-3",
    "text": "凡战，定爵位，著功罪，收游士，申教诏，询厥众，求厥技，方虑极物，变嫌推疑，养力索巧，因心之动。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-4",
    "text": "凡战之道，位欲严，政欲栗，力欲窕，气欲闲，心欲一。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-5",
    "text": "凡战之道，用寡固，用众治；寡利烦，众利正。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-6",
    "text": "正不获意则权。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-7",
    "text": "士庶之义，必奉于父母而正于君长。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-8",
    "text": "凡战，固众，相利，治乱，进止服正，成耻，约法，省罚，小罪乃杀，小罪胜，大罪因。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-9",
    "text": "凡战之道，等道义，立卒伍，定行列，正纵横，察名实。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-10",
    "text": "用众进止，用寡进退。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-11",
    "text": "权出于战，不出于中人。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-12",
    "text": "故虽有明君，士不先教，不可用也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-13",
    "text": "顺天、阜财、怿众、利地、右兵，是谓五虑。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-14",
    "text": "立进俯，坐进跪。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-15",
    "text": "众以合寡，则远裹而阙之；若分而迭击，寡以待众；若众疑之，则自用之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-16",
    "text": "是故杀人安人，杀之可也；攻其国，爱其民，攻之可也；以战止战，虽战可也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-17",
    "text": "古之教民，必立贵贱之伦经，使不相陵。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-18",
    "text": "顺天奉时，阜财因敌。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-19",
    "text": "畏则密，危则坐。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-20",
    "text": "擅利则释旗，迎而反之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-21",
    "text": "故仁见亲，义见说，智见恃，勇见身，信见信。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-22",
    "text": "德义不相逾，材技不相掩，勇力不相犯，故力同而意和也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-23",
    "text": "利地，守隘险阻。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-24",
    "text": "远者视之则不畏，迹者勿视则不散。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-25",
    "text": "敌若众，则相众而受裹。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-26",
    "text": "内得爱焉，所以守也；外得威焉，所以战也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-27",
    "text": "古者，国容不入军，军容不入国，故德义不相逾。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-28",
    "text": "右兵，弓矢御、殳矛守、戈戟助。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-29",
    "text": "位，下左右，下甲坐，誓徐行之，位逮徒甲，筹以轻重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-30",
    "text": "敌若寡若畏，则避之开之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-31",
    "text": "战道：不违时，不历民病，所以爱吾民也；不加丧，不因凶，所以爱夫其民也；冬夏不兴师，所以兼爱其民也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-32",
    "text": "上贵不伐之士，不伐之士，上之器也，苟不伐则无求，无求则不争。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-33",
    "text": "凡五兵五当，长以卫短，短以救长。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-34",
    "text": "振马躁，徒甲畏亦密之，跪坐、坐伏，则膝行而宽誓之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-35",
    "text": "凡战，背风，背高，右高左险；历沛历圮，兼舍环龟。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-36",
    "text": "故国虽大，好战必亡；天下虽安，忘战必危。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-37",
    "text": "国中之听，必得其情，军旅之听，必得其宜，故材技不相掩。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-38",
    "text": "迭战则久，皆战则强。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-39",
    "text": "起、躁，鼓而进，则以铎止之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-40",
    "text": "凡战，设而观其作，视敌而举。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-41",
    "text": "天下既平，天下大恺，春搜秋狝，诸侯春振旅，秋治兵，所以不忘战也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-42",
    "text": "从命为士上赏，犯命为士上戮，故勇力不相犯。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-43",
    "text": "见物与侔，是谓两之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-44",
    "text": "衔枚、誓、糗、坐，膝行而推之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-45",
    "text": "待则循而勿鼓，待众之作；攻则屯而伺之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-46",
    "text": "古者，逐奔不过百步，纵绥不过三舍，是以明其礼也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-47",
    "text": "既致教其民，然后谨选而使之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-48",
    "text": "主固勉若，视敌而举。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-49",
    "text": "执戮禁顾，噪以先之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-50",
    "text": "凡战，众寡以观其变，进退以观其固，危而观其惧，静而观其怠，动而观其疑，袭而观其治。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-51",
    "text": "不穷不能而哀怜伤病，是以明其仁也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-52",
    "text": "事极修，则百官给矣，教极省，则民兴良矣，习贯成，则民体俗矣，教化之至也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-53",
    "text": "将心，心也，众心，心也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-54",
    "text": "凡三军：人戒分日；人禁不息，不可以分食；方其疑惑，可师可服。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-55",
    "text": "击其疑，加其卒，致其屈，袭其规。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-56",
    "text": "成列而鼓是以明其信也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-57",
    "text": "古者，逐奔不远，纵绥不及。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-58",
    "text": "马、牛、车、兵、佚饱，力也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-59",
    "text": "凡战：以力久，以气胜。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-60",
    "text": "因其不避，阻其图，夺其虑，乘其惧。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-61",
    "text": "争义不争利，是以明其义也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-62",
    "text": "不远则难诱，不及则难陷。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-63",
    "text": "教惟豫，战惟节。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-64",
    "text": "以固久，以后胜，本心固，新气胜。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-65",
    "text": "凡从奔勿息，敌人或止于路，则虑之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-66",
    "text": "又能舍服，是以明其勇也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-67",
    "text": "以礼为固，以仁为胜。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-68",
    "text": "将军，身也，卒，支也，伍，指姆也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-69",
    "text": "以甲固，以兵胜。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-70",
    "text": "凡近敌都，必有进路，退必有反虑。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-71",
    "text": "知终知始，是以明其智也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-72",
    "text": "既胜之后，其教可复，是以君子贵之也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-73",
    "text": "凡战，智也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-74",
    "text": "凡车以密固，徒以坐固，甲以重固，兵以轻胜。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-75",
    "text": "凡战，先则弊，后则慑；息则怠，不息亦弊，息久亦反。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-76",
    "text": "六德以时合教，以为民纪之道也，自古之政也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-77",
    "text": "有虞氏戒于国中，欲民体其命也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-78",
    "text": "用其所欲，行其所能，废其不欲不能。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-79",
    "text": "人有胜心，惟敌之视。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-80",
    "text": "其慑书亲绝，是谓绝顾之虑；选良次兵，是谓益人之强；弃任节食，是谓开人之意；自古之政也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "用众第五"
  },
  {
    "id": "smf-81",
    "text": "先王之治，顺天之道，设地之宜，官司之德，而正名治物，立国辨职，以爵分禄，诸侯说怀，海外来服，狱弭而兵寝，圣德之治也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-82",
    "text": "夏后氏誓于军中，欲民先成其虑也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-83",
    "text": "凡战，有天，有财，有善。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-84",
    "text": "人有畏心，惟畏之视。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-85",
    "text": "其次，贤王制礼乐法度，乃作五刑，兴甲兵以讨不义。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-86",
    "text": "殷誓于军门之外，欲民先意以行事也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-87",
    "text": "时日不迁，龟胜微行，是谓有天。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-88",
    "text": "两心交定，两利若一。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-89",
    "text": "巡狩省方，会诸侯，考不同。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-90",
    "text": "周将交刃而誓之，以致民志也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-91",
    "text": "众有有，因生美，是谓有财。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-92",
    "text": "两为之职，惟权视之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-93",
    "text": "其有失命、乱常、背德、逆天之时，而危有功之君，徧告于诸侯，彰明有罪。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-94",
    "text": "夏后氏正其德也，未用兵之刃，故其兵不杂。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-95",
    "text": "人习陈利，极物以豫，是调有善。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-96",
    "text": "凡战：以轻行轻则危，以重行重则无功，以轻行重则败，以重行轻则战，故战相为轻重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-97",
    "text": "然后冢宰征师于诸侯曰：某国为不道，征之，以某年月日师至于某国，会天于正刑。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-98",
    "text": "殷义也，始用兵之刃矣。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-99",
    "text": "人勉及任，是谓乐人。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-100",
    "text": "舍谨甲兵，行慎行列，战谨进止。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-101",
    "text": "冢宰与百官布令于军曰：入罪人之地，无暴圣祗，无行田猎，无毁土功，无燔墙屋，无伐林木，无取六畜，禾黍、器械，见其老幼，奉归勿伤。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-102",
    "text": "周力也，尽用兵之刃矣。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-103",
    "text": "大军以固，多力以烦，堪物简治，见物应卒，是谓行豫。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-104",
    "text": "凡战，敬则慊，率则服。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-105",
    "text": "虽遇壮者，不校勿敌，敌若伤之，医药归之。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-106",
    "text": "夏赏于朝，贵善也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-107",
    "text": "轻车轻徒，弓矢固御，是谓大军。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-108",
    "text": "上烦轻，上暇重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-109",
    "text": "既诛有罪，王及诸侯修正其国，举贤立明，正复厥职。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-110",
    "text": "殷戮于市，威不善也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-111",
    "text": "密静多内力，是谓固陈。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-112",
    "text": "奏鼓轻舒鼓重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-113",
    "text": "王霸之所以治诸侯者六：以土地形诸侯，以政令平诸侯，以礼信亲诸侯，以礼力说诸侯，以谋人维诸侯，以兵革服诸侯。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-114",
    "text": "周赏于朝，戮于市，劝君子惧小人也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-115",
    "text": "因是进退，是谓多力。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-116",
    "text": "服肤轻，服美重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  },
  {
    "id": "smf-117",
    "text": "同患同利以台诸侯，比小事大以和诸侯。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "仁本第一"
  },
  {
    "id": "smf-118",
    "text": "三王彰其德一也。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "天子之义第二"
  },
  {
    "id": "smf-119",
    "text": "上暇人数，是谓烦陈。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "定爵第三"
  },
  {
    "id": "smf-120",
    "text": "凡马车坚，甲兵利，轻乃重。",
    "source": "《司马法》",
    "book": "司马法",
    "chapter": "严位第四"
  }
]