[
  {
    "id": "lh-1",
    "text": "操行有常贤，仕宦无常遇。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "逢遇篇第一"
  },
  {
    "id": "lh-2",
    "text": "凡人仕宦有稽留不进，行节有毁伤不全，罪过有累积不除，声名有暗昧不明，才非下，行非悖也；又知非昬，策非昧也；逢遭外祸，累害之也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "累害篇第二"
  },
  {
    "id": "lh-3",
    "text": "凡人遇偶及遭累害，皆由命也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "命禄篇第三"
  },
  {
    "id": "lh-4",
    "text": "凡人禀命有二品，一曰所当触值之命，二曰强弱寿夭之命。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "气寿篇第四"
  },
  {
    "id": "lh-5",
    "text": "凡人操行，有贤有愚，及遭祸福，有幸有不幸；举事有是有非，及触赏罚，有偶有不偶。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "幸偶篇第五"
  },
  {
    "id": "lh-6",
    "text": "墨家之论，以为人死无命；儒家之议，以为人死有命。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "命义篇第六"
  },
  {
    "id": "lh-7",
    "text": "人禀元气于天，各受寿夭之命，以立长短之形，犹陶者用土为簋廉，冶者用铜为柈杅矣。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "无形篇第七"
  },
  {
    "id": "lh-8",
    "text": "论人之性，定有善有恶。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "率性篇第八"
  },
  {
    "id": "lh-9",
    "text": "凡人禀贵命于天，必有吉验见于地。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "吉验篇第九"
  },
  {
    "id": "lh-10",
    "text": "命，吉凶之主也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "偶会篇第十"
  },
  {
    "id": "lh-11",
    "text": "人曰命难知。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "骨相篇第十一"
  },
  {
    "id": "lh-12",
    "text": "人生性命当富贵者，初禀自然之气，养育长大，富贵之命效矣。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "初禀篇第十二"
  },
  {
    "id": "lh-13",
    "text": "情性者，人治之本，礼乐所由生也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "本性篇第十三"
  },
  {
    "id": "lh-14",
    "text": "儒者论曰：天地故生人。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "物势篇第十四"
  },
  {
    "id": "lh-15",
    "text": "儒者称圣人之生，不因人气，更禀精于天。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "奇怪篇第十五"
  },
  {
    "id": "lh-16",
    "text": "世信虚妄之书，以为载于竹帛上者，皆贤圣所传，无不然之事，故信而是之，讽而读之；睹真是之传，与虚妄之书相违，则并谓短书不可信用。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "书虚篇第十六"
  },
  {
    "id": "lh-17",
    "text": "传书曰：宋景公之时，荧惑守心，公惧，召子韦而问之曰：荧惑在心，何也？",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "变虚篇第十七"
  },
  {
    "id": "lh-18",
    "text": "殷高宗之时，桑谷俱生于朝，七日而大拱。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "异虚篇第十八"
  },
  {
    "id": "lh-19",
    "text": "儒者传书言：尧之时，十日并出，万物焦枯。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "感虚篇第十九"
  },
  {
    "id": "lh-20",
    "text": "世论行善者福至，为恶者祸来。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "福虚篇第二十"
  },
  {
    "id": "lh-21",
    "text": "世谓受福佑者，既以为行善所致；又谓被祸害者，为恶所得。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "祸虚篇第二十一"
  },
  {
    "id": "lh-22",
    "text": "盛夏之时，雷电击折树木，发坏室屋，俗谓天取龙，谓龙藏于树木之中，匿于屋室之间也，雷电击折树木，发坏屋室，则龙见于外。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "龙虚篇第二十二"
  },
  {
    "id": "lh-23",
    "text": "盛夏之时，雷电迅疾，击折树木，坏败室屋，时犯杀人。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "雷虚篇第二十三"
  },
  {
    "id": "lh-24",
    "text": "儒书言：黄帝采首山铜，铸鼎于荆山下。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "道虚篇第二十四"
  },
  {
    "id": "lh-25",
    "text": "传语曰：圣人忧世，深思事勤，愁扰精神，感动形体，故称尧若腊，舜若腒，桀、纣之君，垂腴尺余。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "语增篇第二十五"
  },
  {
    "id": "lh-26",
    "text": "儒书称：尧、舜之德，至优至大，天下太平，一人不刑。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "儒增篇第二十六"
  },
  {
    "id": "lh-27",
    "text": "世谷所患，患言事增其实；著文垂辞，辞出溢其真，称美过其善，进恶没其罪。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "艺增篇第二十七"
  },
  {
    "id": "lh-28",
    "text": "世儒学者，好信师而是古，以为贤圣所言皆无非，专精讲习，不知难问。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "问孔篇第二十八"
  },
  {
    "id": "lh-29",
    "text": "韩子之术，明法尚功。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "非韩篇第二十九"
  },
  {
    "id": "lh-30",
    "text": "孟子见梁惠王，王曰：叟！",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "刺孟篇第三十"
  },
  {
    "id": "lh-31",
    "text": "儒书言：共工与颛顼争为天子不胜，怒而触不周之山，使天柱折，地维绝。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "谈天篇第三十一"
  },
  {
    "id": "lh-32",
    "text": "儒者曰：日朝见，出阴中；暮不见，入阴中。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "说日篇第三十二"
  },
  {
    "id": "lh-33",
    "text": "论者多谓儒生不及彼文吏，见文吏利便，而儒生陆落，则诋訾儒生以为浅短，称誉文吏谓之深长。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "程材篇第三十四"
  },
  {
    "id": "lh-34",
    "text": "程材所论，论材能行操，未言学知之殊奇也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "量知篇第三十五"
  },
  {
    "id": "lh-35",
    "text": "程材、量知，言儒生、文吏之材不能相过；以儒生修大道，以文吏晓簿书，道胜于事，故谓儒生颇愈文吏也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "谢短篇第三十六"
  },
  {
    "id": "lh-36",
    "text": "程才、量知之篇，徒言知学，未言才力也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "效力篇第三十七"
  },
  {
    "id": "lh-37",
    "text": "富人之宅，以一丈之地为内。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "别通篇第三十八"
  },
  {
    "id": "lh-38",
    "text": "通书千篇以上，万卷以下，弘畅雅闲，审定文读，而以教授为人师者，通人也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "超奇篇第三十九"
  },
  {
    "id": "lh-39",
    "text": "论贤儒之才，既超程矣，世人怪其仕宦不进，官爵卑细。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "状留篇第四十"
  },
  {
    "id": "lh-40",
    "text": "说寒温者曰：人君喜则温，怒则寒。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "寒温篇第四十一"
  },
  {
    "id": "lh-41",
    "text": "论灾异，谓古之人君为政失道，天用灾异谴告之也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "谴告篇第四十二"
  },
  {
    "id": "lh-42",
    "text": "论灾异者，已疑于天用灾异谴告人矣。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "变动篇第四十三"
  },
  {
    "id": "lh-43",
    "text": "变复之家，以久雨为湛，久旸为旱。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "明雩篇第四十五"
  },
  {
    "id": "lh-44",
    "text": "春秋之义，大水，鼓用牲于社。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "顺鼓篇第四十六"
  },
  {
    "id": "lh-45",
    "text": "董仲舒申春秋之雩，设土龙以招雨，其意以云龙相致。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "乱龙篇第四十七"
  },
  {
    "id": "lh-46",
    "text": "变复之家，谓虎食人者，功曹为奸所致也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "遭虎篇第四十八"
  },
  {
    "id": "lh-47",
    "text": "变复之家谓虫食谷者，部吏所致也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "商虫篇第四十九"
  },
  {
    "id": "lh-48",
    "text": "儒者之论，自说见凤皇骐𬴊而知之。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "讲瑞篇第五十"
  },
  {
    "id": "lh-49",
    "text": "儒者说凤皇、骐𬴊为圣王来，以为凤皇、骐仁圣禽也，思虑深，避害远，中国有道则来，无道则隐。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "指瑞篇第五十一"
  },
  {
    "id": "lh-50",
    "text": "夫儒者之言，有溢美过实。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "是应篇第五十二"
  },
  {
    "id": "lh-51",
    "text": "世谓古人君贤，则道德施行，施行则功成治安；人君不肖，则道德顿废，顿废则功败治乱。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "治期篇第五十三"
  },
  {
    "id": "lh-52",
    "text": "天地合气，万物自生，犹夫妇合气，子自生矣。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "自然篇第五十四"
  },
  {
    "id": "lh-53",
    "text": "阴阳不和，灾变发起，或时先世遗咎，或时气自然。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "感类篇第五十五"
  },
  {
    "id": "lh-54",
    "text": "语称上世之人，侗长佼好，坚强老寿，百岁左右；下世之人短小陋丑，夭折早死。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "齐世篇第五十六"
  },
  {
    "id": "lh-55",
    "text": "儒者称五帝、三王致天下太平，汉兴已来，未有太平。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "宣汉篇第五十七"
  },
  {
    "id": "lh-56",
    "text": "颜渊喟然叹曰：仰之弥高，钻之弥坚。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "恢国篇第五十八"
  },
  {
    "id": "lh-57",
    "text": "永平十一年，庐江皖侯国际有湖。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "验符篇第五十九"
  },
  {
    "id": "lh-58",
    "text": "古之帝王建鸿德者，须鸿笔之臣褒颂纪载，鸿德乃彰，万世乃闻。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "须颂篇第六十"
  },
  {
    "id": "lh-59",
    "text": "孝武皇帝封弟为鲁恭王。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "佚文篇第六十一"
  },
  {
    "id": "lh-60",
    "text": "世谓人为鬼，有知，能害人。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "论死篇第六十二"
  },
  {
    "id": "lh-61",
    "text": "传曰：周宣王杀其臣杜伯而不辜，宣王将田于囿，杜伯起于道左，执彤弓而射宣王，宣王伏而死。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "死伪篇第六十三"
  },
  {
    "id": "lh-62",
    "text": "卫灵公将之晋，至濮水之上，夜闻鼓新声者，说之，使人问之，左右皆报弗闻。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "纪妖篇第六十四"
  },
  {
    "id": "lh-63",
    "text": "凡天地之间有鬼，非人死精神为之也，皆人思念存想之所致也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "订鬼篇第六十五"
  },
  {
    "id": "lh-64",
    "text": "不知此物，禀何气于天？",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "言毒篇第六十六"
  },
  {
    "id": "lh-65",
    "text": "圣贤之业，皆以薄葬省用为务。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "薄葬篇第六十七"
  },
  {
    "id": "lh-66",
    "text": "俗有大讳四：一曰讳西益宅。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "四讳篇第六十八"
  },
  {
    "id": "lh-67",
    "text": "世俗起土兴功，岁月有所食，所食之地，必有死者。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "间时篇第六十九"
  },
  {
    "id": "lh-68",
    "text": "世俗既信岁时，而又信日。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "讥日篇第七十"
  },
  {
    "id": "lh-69",
    "text": "俗信卜筮，谓卜者问天，筮者问地，蓍神龟灵，兆数报应，故舍人议而就卜筮，违可否而信吉凶。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "卜筮篇第七十一"
  },
  {
    "id": "lh-70",
    "text": "世俗信祸祟，以为人之疾病死亡，及更患被罪，戮辱欢笑，皆有所犯。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "辨祟篇第七十二"
  },
  {
    "id": "lh-71",
    "text": "俗人险心，好信禁忌，知者亦疑，莫能实定。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "难岁篇第七十三"
  },
  {
    "id": "lh-72",
    "text": "图宅术曰宅有八术，以六甲之名，数而第之，第定名立，宫商殊别。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "诘术篇第七十四"
  },
  {
    "id": "lh-73",
    "text": "世信祭祀，谓祭祀必有福。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "解除篇第七十五"
  },
  {
    "id": "lh-74",
    "text": "世信祭祀，以为祭祀者必有福，不祭祀者必有祸。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "祀义篇第七十六"
  },
  {
    "id": "lh-75",
    "text": "礼，王者祭天地，诸侯祭山川，卿大夫祭五祀，土庶人祭其先；宗庙社稷之祀，自天子达于庶人。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "祭意篇第七十七"
  },
  {
    "id": "lh-76",
    "text": "儒者论圣人，以为前知千岁，后知万事，有独见之明，独听之聪，事来则名，不学自知，不问自晓，故称圣，则神矣。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "实知篇第七十八"
  },
  {
    "id": "lh-77",
    "text": "凡论事者，违实不引效验，则虽甘义繁说，众不见信。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "知实篇第七十九"
  },
  {
    "id": "lh-78",
    "text": "圣人难知，贤者比于圣人为易知。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "定贤篇第八十"
  },
  {
    "id": "lh-79",
    "text": "儒者说五经，多失其实。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "正说篇第八十一"
  },
  {
    "id": "lh-80",
    "text": "或曰：士之论高，何必以文？",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "书解篇第八十二"
  },
  {
    "id": "lh-81",
    "text": "儒家之宗，孔子也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "案书篇第八十三"
  },
  {
    "id": "lh-82",
    "text": "上自孔、墨之党，下至苟、孟之徒，教训必作垂文。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "对作篇第八十四"
  },
  {
    "id": "lh-83",
    "text": "王充者，会稽上虞人也，字仲任。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "自纪篇第八十五"
  },
  {
    "id": "lh-84",
    "text": "贤不贤，才也；遇不遇，时也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "逢遇篇第一"
  },
  {
    "id": "lh-85",
    "text": "非唯人行，凡物皆然，生动之类，咸被累害。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "累害篇第二"
  },
  {
    "id": "lh-86",
    "text": "有死生寿夭之命，亦有贵贱贫富之命。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "命禄篇第三"
  },
  {
    "id": "lh-87",
    "text": "所当触值，谓兵烧压溺也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "气寿篇第四"
  },
  {
    "id": "lh-88",
    "text": "并时遭兵，隐者不中。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "幸偶篇第五"
  },
  {
    "id": "lh-89",
    "text": "言有命者，见子夏言死生有命，富贵在天。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "命义篇第六"
  },
  {
    "id": "lh-90",
    "text": "器形已成，不可小大；人体已定，不可减增。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "无形篇第七"
  },
  {
    "id": "lh-91",
    "text": "其善者，固自善矣；其恶者，故可教告率勉，使之为善。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "率性篇第八"
  },
  {
    "id": "lh-92",
    "text": "见于地，故有天命也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "吉验篇第九"
  },
  {
    "id": "lh-93",
    "text": "自然之道，适偶之数，非有他气旁物厌胜感动使之然也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "偶会篇第十"
  },
  {
    "id": "lh-94",
    "text": "人命禀于天，则有表候见于体。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "骨相篇第十一"
  },
  {
    "id": "lh-95",
    "text": "文王得赤雀，武王得白鱼赤乌。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "初禀篇第十二"
  },
  {
    "id": "lh-96",
    "text": "故原情性之极，礼为之防，乐为之节。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "本性篇第十三"
  },
  {
    "id": "lh-97",
    "text": "夫天地合气，人偶自生也；犹夫妇合气，子则自生也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "物势篇第十四"
  },
  {
    "id": "lh-98",
    "text": "禹母吞薏苡而生禹，故夏姓曰姒；卨母吞燕卵而生卨，故殷姓曰子。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "奇怪篇第十五"
  },
  {
    "id": "lh-99",
    "text": "夫幽冥之实尚可知，沈隐之情尚可定，显文露书，是非易见，笼总并传，非实事，用精不专，无思于事也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "书虚篇第十六"
  },
  {
    "id": "lh-100",
    "text": "子韦曰：荧惑，天罚也，心，宋分野也，祸当君。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "变虚篇第十七"
  },
  {
    "id": "lh-101",
    "text": "高宗恐骇，侧身而行道，思索先王之政，明养老之义，兴灭国，继绝世，举佚民。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "异虚篇第十八"
  },
  {
    "id": "lh-102",
    "text": "尧上射十日，九日去，一日常出。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "感虚篇第十九"
  },
  {
    "id": "lh-103",
    "text": "福祸之应，皆天也，人为之，天应之。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "福虚篇第二十"
  },
  {
    "id": "lh-104",
    "text": "以为有沉恶伏过，天地罚之，鬼神报之。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "祸虚篇第二十一"
  },
  {
    "id": "lh-105",
    "text": "龙见，雷取以升天。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "龙虚篇第二十二"
  },
  {
    "id": "lh-106",
    "text": "世俗以为击折树木、坏败室屋者，天取龙；其犯杀人也，谓之阴过，饮食人以不洁净，天怒，击而杀之。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "雷虚篇第二十三"
  },
  {
    "id": "lh-107",
    "text": "鼎既成，有龙垂胡髯，下迎黄帝。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "道虚篇第二十四"
  },
  {
    "id": "lh-108",
    "text": "夫言圣人忧世念人，身体赢恶，不能身体肥泽，可也；言尧、舜若腊与腒，桀、纣垂腴尺余，增之也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "语增篇第二十五"
  },
  {
    "id": "lh-109",
    "text": "又言：文、武之隆，遗在成、康，刑错不用四十余年。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "儒增篇第二十六"
  },
  {
    "id": "lh-110",
    "text": "不奇，言不用也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "艺增篇第二十七"
  },
  {
    "id": "lh-111",
    "text": "夫贤圣下笔造文，用意详审，尚未可谓尽得实，况仓卒吐言，安能皆是？",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "问孔篇第二十八"
  },
  {
    "id": "lh-112",
    "text": "贤无益于国不加赏；不肖无害于治不施罚。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "非韩篇第二十九"
  },
  {
    "id": "lh-113",
    "text": "不远千里而来，将何以利吾国乎？",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "刺孟篇第三十"
  },
  {
    "id": "lh-114",
    "text": "女娲销炼五色石以补苍天，断鳌足以立四极。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "谈天篇第三十一"
  },
  {
    "id": "lh-115",
    "text": "阴气晦冥，故没不见。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "说日篇第三十二"
  },
  {
    "id": "lh-116",
    "text": "以礼进退也，人莫之贵，然而违礼者众，尊义者希，心情贪欲，志虑乱溺也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "答佞篇第三十三"
  },
  {
    "id": "lh-117",
    "text": "是不知儒生，亦不知文吏也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "程材篇第三十四"
  },
  {
    "id": "lh-118",
    "text": "夫儒生之所以过文吏者，学问日多，简练其性，雕琢其材也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "量知篇第三十五"
  },
  {
    "id": "lh-119",
    "text": "此职业外相程相量也，其内各有所以为短，未实谢也。",
    "source": "《论衡》",
    "book": "论衡",
    "chapter": "谢短篇第三十六"
  }
]