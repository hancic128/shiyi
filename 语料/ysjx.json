[
  {
    "id": "ysjx-1",
    "text": "夫圣贤之书，教人诚孝，慎言检迹，立身扬名，亦已备矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-2",
    "text": "上智不教而成，下愚虽教无益，中庸之人，不教不知也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-3",
    "text": "夫有人民而后有夫妇，有夫妇而后有父子，有父子而后有兄弟：一家之亲，此三而已矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-4",
    "text": "吉甫，贤父也，伯奇，孝子也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-5",
    "text": "夫风化者，自上而行于下者也，自先而施于后者也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-6",
    "text": "吾观礼经，圣人之教：箕帚匕箸，咳唾唯诺，执烛沃盥，皆有节文，亦为至矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-7",
    "text": "古人云：千载一圣，犹旦暮也；五百年一贤，犹比髆也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-8",
    "text": "自古明王圣帝，犹须勤学，况凡庶乎！",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-9",
    "text": "夫文章者，原出五经：诏命策檄，生于书者也；序述论议，生于易者也；歌咏赋颂，生于诗者也；祭祀哀诔，生于礼者也；书奏箴铭，生于春秋者也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-10",
    "text": "名之与实，犹形之与影也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-11",
    "text": "士君子之处世，贵能有益于物耳，不徒高谈虚论，左琴右书，以费人君禄位也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-12",
    "text": "铭金人云：无多言，多言多败；无多事，多事多患。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-13",
    "text": "礼云：欲不可纵，志不可满。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-14",
    "text": "颜氏之先，本乎邹、鲁，或分入齐，世以儒雅为业，遍在书记。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-15",
    "text": "神仙之事，未可全诬；但性命在天，或难钟值。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-16",
    "text": "三世之事，信而有征，家世归心，勿轻慢也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-17",
    "text": "诗云：​参差荇菜。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-18",
    "text": "夫九州之人，言语不同，生民已来，固常然矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-19",
    "text": "真草书迹，微须留意。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-20",
    "text": "死者，人之常分，不可免也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  },
  {
    "id": "ysjx-21",
    "text": "魏、晋已来，所著诸子，理重事复，递相模效，犹屋下架屋，床上施床耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-22",
    "text": "古者，圣王有胎教之法：怀子三月，出居别宫，目不邪视，耳不妄听，音声滋味，以礼节之。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-23",
    "text": "自兹以往，至于九族，皆本于三亲焉，故于人伦为重者也，不可不笃。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-24",
    "text": "以贤父御孝子，合得终于天性，而后妻间之，伯奇遂放。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-25",
    "text": "是以父不慈则子不孝，兄不友则弟不恭，夫不义则妇不顺矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-26",
    "text": "但既残缺，非复全书；其有所不载，及世事变改者，学达君子，自为节度，相承行之，故世号士大夫风操。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-27",
    "text": "言圣贤之难得疏阔如此。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-28",
    "text": "此事遍于经史，吾亦不能郑重，聊举近世切要，以启寤汝耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-29",
    "text": "朝廷宪章，军旅誓诰，敷显仁义，发明功德，牧民建国，施用多途。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-30",
    "text": "德艺周厚，则名必善焉；容色姝丽，则影必美焉。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-31",
    "text": "人性有长短，岂责具美于六涂哉？",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-32",
    "text": "至哉斯戒也！",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-33",
    "text": "宇宙可臻其极，情性不知其穷，唯在少欲知止，为立涯限尔。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-34",
    "text": "仲尼门徒，升堂者七十有二，颜氏居八人焉。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-35",
    "text": "人生居世，触途牵絷；幼少之日，既有供养之勤；成立之年，便增妻孥之累。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-36",
    "text": "其间妙旨，具诸经论，不复于此少能赞述；但惧汝曹犹未牢固，略重劝诱尔。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-37",
    "text": "​​尔雅云：​荇，接余也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-38",
    "text": "自春秋标齐言之传，离骚目楚词之经，此盖其较明之初也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-39",
    "text": "江南谚云：尺牍书疏，千里面目也承晋宋馀俗，相与事之，故无顿狼狈者。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-40",
    "text": "吾年十九，值梁家丧乱，其间与白刃为伍者，亦常数辈，幸承馀福，得至于今。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  },
  {
    "id": "ysjx-41",
    "text": "吾今所以复为此者，非敢轨物范世也，业以整齐门内，提撕子孙。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-42",
    "text": "书之玉版，藏诸金匮。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-43",
    "text": "兄弟者，分形连气之人也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-44",
    "text": "曾参妇死，谓其子曰：吾不及吉甫，汝不及伯奇。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-45",
    "text": "父慈而子逆，兄友而弟傲，夫义而妇陵，则天之凶民，乃刑戮之所摄，非训导之所移也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-46",
    "text": "昔在江南，目能视而见之，耳能听而闻之；蓬生麻中，不劳翰墨。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-47",
    "text": "傥遭不世明达君子，安可不攀附景仰之乎！",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-48",
    "text": "士大夫之弟，数岁已上，莫不被教，多者或至礼、传，少者不失诗、论。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-49",
    "text": "至于陶冶性灵，从容讽谏，入其滋味，亦乐事也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-50",
    "text": "今不修身而求令名于世者，犹貌甚恶而责妍影于镜也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-51",
    "text": "但当皆晓指趣，能守一职，便无愧耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-52",
    "text": "能走者夺其翼，善飞者减其指，有角者无上齿，丰后者无前足，盖天道不使物有兼焉也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-53",
    "text": "先祖靖侯戒子侄曰：汝家书生门户，世无富贵，自今仕宦不可过二千石，婚姻勿贪势家。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-54",
    "text": "秦汉魏晋，下逮齐梁，未有用兵以取达者。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-55",
    "text": "衣食资须，公私驱役；而望遁迹山林，超然尘滓，千万不遇一尔。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-56",
    "text": "原夫四尘五荫，剖析形有；六舟三驾，运载群生：万行归空，千门入善，辩才智惠，岂徒七经、百氏之博哉？",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-57",
    "text": "​字或为莕。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-58",
    "text": "后有扬雄着方言，其言大备。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-59",
    "text": "吾幼承门业，加性爱重，所见法书亦多，而玩习功夫颇至，遂不能佳者，良由无分故也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-60",
    "text": "古人云：五十不为夭。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  },
  {
    "id": "ysjx-61",
    "text": "夫同言而信，信其所亲；同命而行，行其所服。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-62",
    "text": "生子咳提，师保固明孝仁礼义，导习之矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-63",
    "text": "方其幼也，父母左提右挈，前襟后裾，食则同案，衣则传服，学则连业，游则共方，虽有悖乱之人，不能不相爱也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-64",
    "text": "王骏丧妻，亦谓人曰：我不及曾参，子不如华、元。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-65",
    "text": "笞怒废于家，则竖子之过立见；刑罚不中，则民无所措手足。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-66",
    "text": "汝曹生于戎马之间，视听之所不晓，故聊记录，以传示子孙。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-67",
    "text": "吾生于乱世，长于戎马，流离播越，闻见已多，所值名贤，未尝不心醉魂迷向慕之也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-68",
    "text": "及至冠婚，体性稍定，因此天机，倍须训诱。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-69",
    "text": "行有余力，则可习之。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-70",
    "text": "上士忘名，中士立名，下士窃名。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-71",
    "text": "吾见世中文学之士，品藻古今，若指诸掌，及有试用，多无所堪。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-72",
    "text": "古人云：多为少善，不如执一；鼫鼠五能，不成伎术。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-73",
    "text": "吾终身服膺，以为名言也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-74",
    "text": "春秋世颜高、颜鸣、颜息、颜羽之徒，皆一斗夫耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-75",
    "text": "加以金玉之费，炉器所须，益非贫士所办。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-76",
    "text": "明非尧、舜、周、孔所及也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-77",
    "text": "先儒解释皆云：水草，圆叶细茎，随水浅深。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-78",
    "text": "然皆考名物之同异，不显声读之是非也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-79",
    "text": "然而此艺不须过精。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-80",
    "text": "吾已六十馀，故心坦然，不以残年为念。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  },
  {
    "id": "ysjx-81",
    "text": "禁童子之暴谑，则师友之诫不如傅婢之指挥；止凡人之斗阋，则尧、舜之道不如寡妻之诲谕。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-82",
    "text": "凡庶纵不能尔，当及婴稚，识人颜色，知人喜怒，便加教诲，使为则为，使止则止。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-83",
    "text": "及其壮也，各妻其妻，各子其子，虽有笃厚之人，不能不少衰也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-84",
    "text": "并终身不娶，此等足以为诫。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-85",
    "text": "治家之宽猛，亦犹国焉。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-86",
    "text": "礼曰：见似目瞿，闻名心瞿。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-87",
    "text": "人在年少，神情未定，所与款狎，熏渍陶染，言笑举动，无心于学，潜移暗化，自然似之，何况操履艺能，较明易习者也！",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-88",
    "text": "有志向者，遂能磨砺，以就素业；无履立者，自兹堕慢，便为凡人。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-89",
    "text": "凡此诸人，皆其翘秀者，不能悉记，大较如此。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-90",
    "text": "忘名者，体道合德，享鬼神之福祜，非所以求名也；立名者，修身慎行，惧荣观之不显，非所以让名也；窃名者，厚貌深奸，于浮华之虚称，非所以得名也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-91",
    "text": "居承平之世，不知有丧乱之祸；处庙堂之下，不知有战陈之急；保俸禄之资，不知有耕稼之苦；肆吏民之上，不知有劳役之勤，故难可以应世经务也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-92",
    "text": "近世有两人，朗悟士也，性多营综，略无成名。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-93",
    "text": "天地鬼神之道，皆恶满盈，谦虚冲损，可以免害。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-94",
    "text": "齐有颜涿聚，赵有颜最，汉末有颜良，宋有颜延之，并处将军之任，竟以颠覆。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-95",
    "text": "学如牛毛，成如麟角。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-96",
    "text": "内外两教，本为一体，渐极为异，深浅不同。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-97",
    "text": "今是水悉有之，黄花似莼，江南俗亦呼猪莼，或呼为荇菜。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-98",
    "text": "逮郑玄注六经，高诱解吕览、淮南，许慎造说文，刘熹制释名，始有譬况假借以证音字耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-99",
    "text": "夫巧者劳而智者忧，常为人所役使，更觉为累。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-100",
    "text": "先有风气之疾，常疑奄然，聊书素怀，以为汝诫。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  },
  {
    "id": "ysjx-101",
    "text": "吾望此书为汝曹之所信，犹贤于傅婢寡妻耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "序致篇第一"
  },
  {
    "id": "ysjx-102",
    "text": "比及数岁，可省笞罚。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "教子篇第二"
  },
  {
    "id": "ysjx-103",
    "text": "娣姒之比兄弟，则疏薄矣；今使疏薄之人，而节量亲厚之恩，犹方底而圆盖，必不合矣。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "兄弟篇第三"
  },
  {
    "id": "ysjx-104",
    "text": "其后，假继惨虐孤遗，离间骨肉，伤心断肠者，何可胜数。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "后娶篇第四"
  },
  {
    "id": "ysjx-105",
    "text": "孔子曰：奢则不孙，俭则固；与其不孙也，宁固。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "治家篇第五"
  },
  {
    "id": "ysjx-106",
    "text": "有所感触，恻怆心眼；若在从容平常之地，幸须申其情耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "风操篇第六"
  },
  {
    "id": "ysjx-107",
    "text": "是以与善人居，如入芝兰之室，久而自芳也；与恶人居，如入鲍鱼之肆，久而自臭也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "慕贤篇第七"
  },
  {
    "id": "ysjx-108",
    "text": "人生在世，会当有业，农民则计量耕稼，商贾则讨论货贿，工巧则致精器用，伎艺则沉思法术，武夫则惯习弓马，文士则讲议经书。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "勉学篇第八"
  },
  {
    "id": "ysjx-109",
    "text": "至于帝王，亦或未免。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "文章篇第九"
  },
  {
    "id": "ysjx-110",
    "text": "人足所履，不过数寸，然而咫尺之途，必颠蹶于崖岸，拱把之梁，每沈溺于川谷者，何哉？",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "名实篇第十"
  },
  {
    "id": "ysjx-111",
    "text": "晋朝南渡，优借士族；故江南冠带，有才干者，擢为令仆已下尚书郎中书舍人已上，典掌机要。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "涉务篇第十一"
  },
  {
    "id": "ysjx-112",
    "text": "惜乎，以彼神明，若省其异端，当精妙也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "省事篇第十二"
  },
  {
    "id": "ysjx-113",
    "text": "人生衣趣以覆寒露，食趣以塞饥乏耳。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "止足篇第十三"
  },
  {
    "id": "ysjx-114",
    "text": "汉郎颜驷，自称好武，更无事迹。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "诫兵篇第十四"
  },
  {
    "id": "ysjx-115",
    "text": "华山之下，白骨如莽，何有可遂之理？",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "养生篇第十五"
  },
  {
    "id": "ysjx-116",
    "text": "内典初门，设五种禁；外典仁义礼智信，皆与之符。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "归心篇第十六"
  },
  {
    "id": "ysjx-117",
    "text": "刘芳具有注释。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "书证篇第十七"
  },
  {
    "id": "ysjx-118",
    "text": "孙叔言创尔雅音义，是汉末人独知反语。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "音辞篇第十八"
  },
  {
    "id": "ysjx-119",
    "text": "韦仲将遗戒，深有以也。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "杂艺篇第十九"
  },
  {
    "id": "ysjx-120",
    "text": "先君先夫人皆未还建邺旧山，旅葬江陵东郭。",
    "source": "《颜氏家训》",
    "book": "颜氏家训",
    "chapter": "终制篇第二十"
  }
]