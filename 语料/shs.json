[
  {
    "id": "shs-1",
    "text": "南山经之首曰䧿山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-2",
    "text": "西山经华山之首，曰钱来之山，其上多松，其下多洗石。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-3",
    "text": "北山经之首，曰单狐之山，多机木，其上多华草。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-4",
    "text": "东山之首，曰樕𧑤之山，北临干昧。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-5",
    "text": "中山经薄山之首，曰甘枣之山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-6",
    "text": "地之所载，六合之间，四海之内，照之以日月，经之以星辰，纪之以四时，要之以太岁，神灵所生，其物异形，或夭或寿，唯圣人能通其道。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-7",
    "text": "海外自西南陬西北陬者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-8",
    "text": "海外自东北陬至西北陬者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-9",
    "text": "海外自东南陬至东北陬者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-10",
    "text": "海内东南陬以西者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  },
  {
    "id": "shs-11",
    "text": "海内西南陬以北者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内西经第六"
  },
  {
    "id": "shs-12",
    "text": "海内西北陬以东者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内北经第七"
  },
  {
    "id": "shs-13",
    "text": "海内东北陬以南者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内东经第八"
  },
  {
    "id": "shs-14",
    "text": "东海之外大壑，少昊之国。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒东经第九"
  },
  {
    "id": "shs-15",
    "text": "南海之外，赤水之西，流沙之东，有兽，左右有首，名曰䟣踢。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒南经第十"
  },
  {
    "id": "shs-16",
    "text": "西北海之外，大荒之隅，有山而不合，名曰不周负子，有两黄兽守之。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒西经第十一"
  },
  {
    "id": "shs-17",
    "text": "东北海之外，大荒之中，河水之间，附禺之山，帝颛顼与九嫔葬焉。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒北经第十二"
  },
  {
    "id": "shs-18",
    "text": "东海之内，北海之隅，有国名曰朝鲜；天毒，其人水居，偎人爱之。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内经第十三"
  },
  {
    "id": "shs-19",
    "text": "其首曰招摇之山，临于西海之上，多桂，多金玉。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-20",
    "text": "有兽焉，其状如羊而马尾，名曰羬羊，其脂可以已腊。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-21",
    "text": "逢漨水出焉，而西流注于泑水，其中多芘石文石。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-22",
    "text": "食水出焉，而东北流注于海。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-23",
    "text": "共水出焉，而西流注于河。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-24",
    "text": "海外自西南陬至东南陬者。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-25",
    "text": "灭蒙鸟在结匈国北，为鸟青，赤尾。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-26",
    "text": "无启之国在长股东，为人无启。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-27",
    "text": "𨲠丘，爰有遗玉、青马、视肉、杨柳、甘华。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-28",
    "text": "闽在海中，其西北有山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  },
  {
    "id": "shs-29",
    "text": "贰负之臣曰危，危与贰负窫窳。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内西经第六"
  },
  {
    "id": "shs-30",
    "text": "蛇巫之山，上有人操柸而东向立。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内北经第七"
  },
  {
    "id": "shs-31",
    "text": "钜燕在东北陬。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内东经第八"
  },
  {
    "id": "shs-32",
    "text": "少昊孺帝颛顼于此，弃其琴瑟。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒东经第九"
  },
  {
    "id": "shs-33",
    "text": "有三青兽相并，名曰双双。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒南经第十"
  },
  {
    "id": "shs-34",
    "text": "有水曰寒署之水。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒西经第十一"
  },
  {
    "id": "shs-35",
    "text": "爰有𩿨久、文贝、离俞、鸾鸟、皇鸟、大物、小物。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒北经第十二"
  },
  {
    "id": "shs-36",
    "text": "西海之内，流沙之中，有国名曰壑市。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内经第十三"
  },
  {
    "id": "shs-37",
    "text": "有草焉，其状如韭而青华，其名曰祝馀，食之不饥。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-38",
    "text": "西四十五里，曰松果之山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-39",
    "text": "又北二百五十里，曰求如之山，其上多玉，无草木。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-40",
    "text": "其中多鳙鳙之鱼，其状如犁牛，其音如彘鸣。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-41",
    "text": "其上多杻木，其下有草焉，葵本而杏叶，黄华而荚实，名曰箨，可以已瞢。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-42",
    "text": "结匈国在其西南，其为人结匈。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-43",
    "text": "大运山高三百仞，在灭蒙鸟北。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-44",
    "text": "钟山之神，名曰烛阴，视为昼，瞑为夜，吹为冬，呼为夏，不饮，不食，不息，息为风。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-45",
    "text": "甘果所生，在东海。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-46",
    "text": "一曰闽中山在海中。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  },
  {
    "id": "shs-47",
    "text": "帝乃梏之疏属之山，桎其右足，反缚两手与发，系之山上木。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内西经第六"
  },
  {
    "id": "shs-48",
    "text": "西王母梯几而戴胜杖。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内北经第七"
  },
  {
    "id": "shs-49",
    "text": "国在流沙中者埻端、玺㬇，在昆仑虚东南。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内东经第八"
  },
  {
    "id": "shs-50",
    "text": "有甘山者，甘水出焉，生甘渊。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒东经第九"
  },
  {
    "id": "shs-51",
    "text": "南海之中，有泛天之山，赤水穷焉。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒南经第十"
  },
  {
    "id": "shs-52",
    "text": "水西有湿山，水东有幕山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒西经第十一"
  },
  {
    "id": "shs-53",
    "text": "有青鸟、琅鸟、玄鸟、黄鸟、虎、豹、熊、罴、黄蛇、视肉、璇瑰、瑶碧，皆出卫于山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒北经第十二"
  },
  {
    "id": "shs-54",
    "text": "西海之内，流沙之西，有国名曰泛叶。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内经第十三"
  },
  {
    "id": "shs-55",
    "text": "有木焉，其状如榖而黑理，其华四照。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-56",
    "text": "濩水出焉，北流注于渭，其中多铜。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-57",
    "text": "滑水出焉，而西流注于诸𣬈之水。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-58",
    "text": "又南三百里，曰藟山，其上有玉，其下有金。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-59",
    "text": "有兽焉，其状如囗鼠而文题，其名曰㔮，食之已瘿。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-60",
    "text": "南山在其东南。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-61",
    "text": "大乐之野，夏后启于此儛九代，乘两龙，云盖三层。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-62",
    "text": "在无䏿之东。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-63",
    "text": "两山夹丘，上有树木。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-64",
    "text": "三天子鄣山在闽西海北。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  },
  {
    "id": "shs-65",
    "text": "在开题西北。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内西经第六"
  },
  {
    "id": "shs-66",
    "text": "其南有三青鸟，为西王母取食。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内北经第七"
  },
  {
    "id": "shs-67",
    "text": "一曰海内之郡，不为郡县，在流沙中。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内东经第八"
  },
  {
    "id": "shs-68",
    "text": "大荒东南隅有，名皮母地丘。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒东经第九"
  },
  {
    "id": "shs-69",
    "text": "赤水之东，有苍梧之野，舜与叔均之所葬也。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒南经第十"
  },
  {
    "id": "shs-70",
    "text": "有禹攻共工国山。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒西经第十一"
  },
  {
    "id": "shs-71",
    "text": "丘方员三百里，丘南帝俊竹林在焉，大可为舟。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒北经第十二"
  },
  {
    "id": "shs-72",
    "text": "流沙之西，有鸟山者，三水出焉。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内经第十三"
  },
  {
    "id": "shs-73",
    "text": "其名曰迷榖，佩之不迷。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-74",
    "text": "有鸟焉，其名曰䳋渠，其状如山鸡，黑身赤足，可以已𦢊。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-75",
    "text": "其中多滑鱼。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-76",
    "text": "湖水出焉，东流注于食水，其中多活师。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-77",
    "text": "又东二十里，曰历儿之山，其上多橿，多栃木，是木也，方茎而员叶，黄华而毛，其实如楝，服之不忘。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-78",
    "text": "自此山来，虫为蛇，蛇号为鱼。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-79",
    "text": "左手操翳，右手操环，佩玉璜。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-80",
    "text": "其为物，人面，蛇身，赤色，居钟山下。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-81",
    "text": "一曰百果所在，在尧葬东。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-82",
    "text": "一曰在海中。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  },
  {
    "id": "shs-83",
    "text": "大泽方百里，群鸟所生及所解。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内西经第六"
  },
  {
    "id": "shs-84",
    "text": "在昆仑虚北。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内北经第七"
  },
  {
    "id": "shs-85",
    "text": "国在流沙外者，大夏、竖沙、居繇、月支之国。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内东经第八"
  },
  {
    "id": "shs-86",
    "text": "东海之外，大荒之中，有山名曰大言，日月所出。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒东经第九"
  },
  {
    "id": "shs-87",
    "text": "爰有文贝、离俞、嶋久、鹰、贾、委维、熊、罴、象、虎、豹、狼、视肉。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒南经第十"
  },
  {
    "id": "shs-88",
    "text": "有国名曰淑士，颛顼之子。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒西经第十一"
  },
  {
    "id": "shs-89",
    "text": "竹南有赤泽水，名曰封渊。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "大荒北经第十二"
  },
  {
    "id": "shs-90",
    "text": "爰有黄金、璇瑰、丹货、银铁，皆流于此中。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内经第十三"
  },
  {
    "id": "shs-91",
    "text": "有兽焉，其状如禺而白耳，伏行人走，其名曰狌狌，食之善走。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "南山经第一"
  },
  {
    "id": "shs-92",
    "text": "又西六十里，曰太华之山，削成而四方，其高五千仞，其广十里，鸟兽莫居。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "西山经第二"
  },
  {
    "id": "shs-93",
    "text": "其状如鱓，赤背，其音如梧，食之已疣。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "北山经第三"
  },
  {
    "id": "shs-94",
    "text": "又南三百里，曰栒状之山，其上多金玉，其下多青碧石。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "东山经第四"
  },
  {
    "id": "shs-95",
    "text": "又东十五里，曰渠猪之山，其上多竹，渠猪之水出焉，而南流注于河。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "中山经第五"
  },
  {
    "id": "shs-96",
    "text": "一曰南山在结匈东南。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外南经第一"
  },
  {
    "id": "shs-97",
    "text": "在大运山北。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外西经第二"
  },
  {
    "id": "shs-98",
    "text": "一目国在其东，一目中其面而居。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外北经第三"
  },
  {
    "id": "shs-99",
    "text": "大人国在其北，为人大，坐而削船。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海外东经第四"
  },
  {
    "id": "shs-100",
    "text": "桂林八树在番隅东。",
    "source": "《山海经》",
    "book": "山海经",
    "chapter": "海内南经第五"
  }
]