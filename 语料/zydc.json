[
  {
    "id": "zydc-1",
    "text": "大哉乾元、万物资始，乃统天。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "乾第一"
  },
  {
    "id": "zydc-2",
    "text": "至哉坤元，万物资生，乃顺承天。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "坤第二"
  },
  {
    "id": "zydc-3",
    "text": "屯，刚柔始交而难生，动乎险中，大亨贞。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "屯第三"
  },
  {
    "id": "zydc-4",
    "text": "蒙，山下有险，险而止，蒙。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蒙第四"
  },
  {
    "id": "zydc-5",
    "text": "需，须也，险在前也，刚健而不陷，其义不困穷矣。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "需第五"
  },
  {
    "id": "zydc-6",
    "text": "讼，上刚下险，险而健，讼。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "讼第六"
  },
  {
    "id": "zydc-7",
    "text": "师，众也；贞，正也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "师第七"
  },
  {
    "id": "zydc-8",
    "text": "比，吉也；比，辅也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "比第八"
  },
  {
    "id": "zydc-9",
    "text": "小畜，柔得位而上下应之，曰小畜。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "小畜第九"
  },
  {
    "id": "zydc-10",
    "text": "履，柔履刚也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "履第十"
  },
  {
    "id": "zydc-11",
    "text": "泰，小往大来，吉，亨。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "泰第十一"
  },
  {
    "id": "zydc-12",
    "text": "否之匪人，不利君子贞，大往小来。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "否第十二"
  },
  {
    "id": "zydc-13",
    "text": "同人，柔得位得中，而应乎干，曰同人。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "同人第十三"
  },
  {
    "id": "zydc-14",
    "text": "大有，柔得尊位，大中而上下应之，曰大有。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大有第十四"
  },
  {
    "id": "zydc-15",
    "text": "谦亨，天道下济而光明，地道卑而上行。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "谦第十五"
  },
  {
    "id": "zydc-16",
    "text": "豫，刚应而志行，顺以动，豫。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "豫第十六"
  },
  {
    "id": "zydc-17",
    "text": "随，刚来而下柔，动而说，随。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "随第十七"
  },
  {
    "id": "zydc-18",
    "text": "蛊，刚上而柔下，巽而止，蛊。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蛊第十八"
  },
  {
    "id": "zydc-19",
    "text": "临，刚浸而长，说而顺，刚中而应，大亨以正，天之道也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "临第十九"
  },
  {
    "id": "zydc-20",
    "text": "大观在上，顺而巽，中正以观天下。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "观第二十"
  },
  {
    "id": "zydc-21",
    "text": "颐中有物，曰噬嗑。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "噬嗑第二十一"
  },
  {
    "id": "zydc-22",
    "text": "贲，亨，柔来而文刚，故亨；分刚上而文柔，故小利有攸往。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "贲第二十二"
  },
  {
    "id": "zydc-23",
    "text": "剥，剥也，柔变刚也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "剥第二十三"
  },
  {
    "id": "zydc-24",
    "text": "复亨，刚反，动而以顺行，是以出入无疾，朋来无咎。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "复第二十四"
  },
  {
    "id": "zydc-25",
    "text": "无妄，刚自外来，而为主于内。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "无妄第二十五"
  },
  {
    "id": "zydc-26",
    "text": "大畜，刚健笃实辉光，日新其德，刚上而尚贤。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大畜第二十六"
  },
  {
    "id": "zydc-27",
    "text": "颐贞吉，养正则吉也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "颐第二十七"
  },
  {
    "id": "zydc-28",
    "text": "大过，大者过也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大过第二十八"
  },
  {
    "id": "zydc-29",
    "text": "习坎，重险也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "坎第二十九"
  },
  {
    "id": "zydc-30",
    "text": "离，丽也；日月丽乎天，百谷草木丽乎土，重明以丽乎正，乃化成天下。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "离第三十"
  },
  {
    "id": "zydc-31",
    "text": "柔上而刚下，二气感应以相与。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "咸第三十一"
  },
  {
    "id": "zydc-32",
    "text": "刚上而柔下，雷风相与，巽而动，刚柔皆应，恒。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "恒第三十二"
  },
  {
    "id": "zydc-33",
    "text": "遯亨，遯而亨也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "遯第三十三"
  },
  {
    "id": "zydc-34",
    "text": "大壮，大者壮也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大壮第三十四"
  },
  {
    "id": "zydc-35",
    "text": "晋，进也，明出地上，顺而丽乎大明，柔进而上行，是以康侯用锡马蕃庶，昼日三接也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "晋第三十五"
  },
  {
    "id": "zydc-36",
    "text": "明入地中，明夷。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "明夷第三十六"
  },
  {
    "id": "zydc-37",
    "text": "家人，女正位乎内，男正位乎外。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "家人第三十七"
  },
  {
    "id": "zydc-38",
    "text": "睽，火动而上，泽动而下。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "睽第三十八"
  },
  {
    "id": "zydc-39",
    "text": "蹇，难也，险在前也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蹇第三十九"
  },
  {
    "id": "zydc-40",
    "text": "解，险以动，动而免乎险，解。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "解第四十"
  },
  {
    "id": "zydc-41",
    "text": "损，损下益上，其道上行。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "损第四十一"
  },
  {
    "id": "zydc-42",
    "text": "益，损上益下，民说无疆。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "益第四十二"
  },
  {
    "id": "zydc-43",
    "text": "夬，决也，刚决柔也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "夬第四十三"
  },
  {
    "id": "zydc-44",
    "text": "姤，遇也，柔遇刚也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "姤第四十四"
  },
  {
    "id": "zydc-45",
    "text": "顺以说，刚中而应，故聚也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "萃第四十五"
  },
  {
    "id": "zydc-46",
    "text": "柔以时升，巽而顺，刚中而应，是以大亨。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "升第四十六"
  },
  {
    "id": "zydc-47",
    "text": "困，刚揜也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "困第四十七"
  },
  {
    "id": "zydc-48",
    "text": "巽乎水而上水，井。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "井第四十八"
  },
  {
    "id": "zydc-49",
    "text": "革，水火相息，二女同居，其志不相得，曰革。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "革第四十九"
  },
  {
    "id": "zydc-50",
    "text": "以木巽火，亨饪也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "鼎第五十"
  },
  {
    "id": "zydc-51",
    "text": "震亨，震来虩虩，恐致福也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "震第五十一"
  },
  {
    "id": "zydc-52",
    "text": "时止则止，时行则行，动静不失其时，其道光明。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "艮第五十二"
  },
  {
    "id": "zydc-53",
    "text": "渐，之进也，女归吉也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "渐第五十三"
  },
  {
    "id": "zydc-54",
    "text": "归妹，天地之大义也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "归妹第五十四"
  },
  {
    "id": "zydc-55",
    "text": "明以动，故丰。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "丰第五十五"
  },
  {
    "id": "zydc-56",
    "text": "旅，小亨，柔得中乎外，而顺乎刚，止而丽乎明，是以小亨旅贞吉也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "旅第五十六"
  },
  {
    "id": "zydc-57",
    "text": "重巽以申命，刚巽乎中正而志行。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "巽第五十七"
  },
  {
    "id": "zydc-58",
    "text": "刚中而柔外，说以利贞，是以顺乎天，而应乎人。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "兑第五十八"
  },
  {
    "id": "zydc-59",
    "text": "涣亨，刚来而不穷，柔得位乎外，而上同。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "涣第五十九"
  },
  {
    "id": "zydc-60",
    "text": "节亨，刚柔分而刚得中。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "节第六十"
  },
  {
    "id": "zydc-61",
    "text": "中孚，柔在内而刚得中，说而巽，孚乃化邦也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "中孚第六十一"
  },
  {
    "id": "zydc-62",
    "text": "小过，小者过而亨也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "小过第六十二"
  },
  {
    "id": "zydc-63",
    "text": "既济亨，小者亨也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "既济第六十三"
  },
  {
    "id": "zydc-64",
    "text": "未济亨，柔得中也。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "未济第六十四"
  },
  {
    "id": "zydc-65",
    "text": "天行健；君子以自强不息。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "乾第六十五"
  },
  {
    "id": "zydc-66",
    "text": "地势坤；君子以厚德载物。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "坤第六十六"
  },
  {
    "id": "zydc-67",
    "text": "云雷，屯；君子以经纶。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "屯第六十七"
  },
  {
    "id": "zydc-68",
    "text": "山下出泉，蒙；君子以果行育德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蒙第六十八"
  },
  {
    "id": "zydc-69",
    "text": "云上于天，需；君子以饮食宴乐。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "需第六十九"
  },
  {
    "id": "zydc-70",
    "text": "天与水违行，讼；君子以作事谋始。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "讼第七十"
  },
  {
    "id": "zydc-71",
    "text": "地中有水，师；君子以容民畜众。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "师第七十一"
  },
  {
    "id": "zydc-72",
    "text": "地上有水，比；先王以建万国，亲诸侯。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "比第七十二"
  },
  {
    "id": "zydc-73",
    "text": "风行天上，小畜；君子以懿文德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "小畜第七十三"
  },
  {
    "id": "zydc-74",
    "text": "上天下泽，履；君子以辩上下，定民志。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "履第七十四"
  },
  {
    "id": "zydc-75",
    "text": "天地交，泰；后以财成天地之道，辅相天地之宜，以左右民。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "泰第七十五"
  },
  {
    "id": "zydc-76",
    "text": "天地不交，否；君子以俭德辟难，不可荣以禄。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "否第七十六"
  },
  {
    "id": "zydc-77",
    "text": "天与火，同人；君子以类族辨物。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "同人第七十七"
  },
  {
    "id": "zydc-78",
    "text": "火在天上，大有；君子以遏恶扬善，顺天休命。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大有第七十八"
  },
  {
    "id": "zydc-79",
    "text": "地中有山，谦；君子以裒多益寡，称物平施。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "谦七十九"
  },
  {
    "id": "zydc-80",
    "text": "雷出地奋，豫；先王以作乐崇德，殷荐之上帝，以配祖考。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "豫第八十"
  },
  {
    "id": "zydc-81",
    "text": "泽中有雷，随；君子以向晦入宴息。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "随第八十一"
  },
  {
    "id": "zydc-82",
    "text": "山下有风，蛊；君子以振民育德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蛊第八十二"
  },
  {
    "id": "zydc-83",
    "text": "泽上有地，临；君子以教思无穷，容保民无疆。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "临第八十三"
  },
  {
    "id": "zydc-84",
    "text": "风行地上，观；先王以省方观民设教。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "观第八十四"
  },
  {
    "id": "zydc-85",
    "text": "雷电，噬嗑；先王以明罚勅法。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "噬嗑第八十五"
  },
  {
    "id": "zydc-86",
    "text": "山下有火，贲；君子以明庶政，无敢折狱。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "贲第八十六"
  },
  {
    "id": "zydc-87",
    "text": "山附于地，剥；上以厚下安宅。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "剥第八十七"
  },
  {
    "id": "zydc-88",
    "text": "雷在地中，复；先王以至日闭关，商旅不行，后不省方。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "复第八十八"
  },
  {
    "id": "zydc-89",
    "text": "天下雷行，物与无妄；先王以茂对时育万物。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "无妄第八十九"
  },
  {
    "id": "zydc-90",
    "text": "天在山中，大畜；君子以多识前贤往行，以畜其德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大畜第九十"
  },
  {
    "id": "zydc-91",
    "text": "山下有雷，颐；君子以慎言语，节饮食。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "颐第九十一"
  },
  {
    "id": "zydc-92",
    "text": "泽灭木，大过；君子以独立不惧，遁世无闷。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大过第九十二"
  },
  {
    "id": "zydc-93",
    "text": "水洊至，习坎；君子以常德行，习教事。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "坎第九十三"
  },
  {
    "id": "zydc-94",
    "text": "明两作，离；大人以继明照于四方。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "离第九十四"
  },
  {
    "id": "zydc-95",
    "text": "山上有泽，咸；君子以虚受人。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "咸第九十五"
  },
  {
    "id": "zydc-96",
    "text": "雷风，恒；君子以立不易方。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "恒第九十六"
  },
  {
    "id": "zydc-97",
    "text": "天下有山，遯；君子以远小人，不恶而严。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "遯第九十七"
  },
  {
    "id": "zydc-98",
    "text": "雷在天上，大壮；君子以非礼弗履。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "大壮第九十八"
  },
  {
    "id": "zydc-99",
    "text": "明出地上，晋；君子以自昭明德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "晋第九十九"
  },
  {
    "id": "zydc-100",
    "text": "明入地中，明夷；君子以莅众，用晦而明。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "明夷第一百"
  },
  {
    "id": "zydc-101",
    "text": "风自火出，家人；君子以言有物而行有恒。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "家人第一百零一"
  },
  {
    "id": "zydc-102",
    "text": "上火下泽，睽；君子以同而异。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "睽第一百零二"
  },
  {
    "id": "zydc-103",
    "text": "山上有水，蹇；君子以反身修德。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "蹇第一百零三"
  },
  {
    "id": "zydc-104",
    "text": "雷雨作，解；君子以赦过宥罪。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "解第一百零四"
  },
  {
    "id": "zydc-105",
    "text": "山下有泽，损；君子以惩忿窒欲。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "损第一百零五"
  },
  {
    "id": "zydc-106",
    "text": "风雷，益；君子以见善则迁，有过则改。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "益第一百零六"
  },
  {
    "id": "zydc-107",
    "text": "泽上于天，夬；君子以施禄及下，居德则忌。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "夬第一百零七"
  },
  {
    "id": "zydc-108",
    "text": "天下有风，姤；后以施命诰四方。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "姤第一百零八"
  },
  {
    "id": "zydc-109",
    "text": "泽上于地，萃；君子以除戎器，戒不虞。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "萃第一百零九"
  },
  {
    "id": "zydc-110",
    "text": "地中生木，升；君子以顺德，积小以高大。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "升第一百一十"
  },
  {
    "id": "zydc-111",
    "text": "泽无水，困；君子以致命遂志。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "困第一百一十一"
  },
  {
    "id": "zydc-112",
    "text": "木上有水，井；君子以劳民劝相。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "井第一百一十二"
  },
  {
    "id": "zydc-113",
    "text": "泽中有火，革；君子以治历明时。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "革第一百一十三"
  },
  {
    "id": "zydc-114",
    "text": "木上有火，鼎；君子以正位凝命。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "鼎第一百一十四"
  },
  {
    "id": "zydc-115",
    "text": "洊雷，震；君子以恐惧修省。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "震第一百一十五"
  },
  {
    "id": "zydc-116",
    "text": "兼山，艮；君子以思不出其位。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "艮第一百一十六"
  },
  {
    "id": "zydc-117",
    "text": "山上有木，渐；君子以居贤德善俗。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "渐第一百一十七"
  },
  {
    "id": "zydc-118",
    "text": "泽上有雷，归妹；君子以永终知敝。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "归妹第一百一十八"
  },
  {
    "id": "zydc-119",
    "text": "雷电皆至，丰；君子以折狱致刑。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "丰第一百一十九"
  },
  {
    "id": "zydc-120",
    "text": "山上有火，旅；君子以明慎用刑，而不留狱。",
    "source": "《周易》",
    "book": "周易",
    "chapter": "旅第一百二十"
  }
]