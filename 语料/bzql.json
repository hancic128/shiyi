[
  {
    "id": "bzql-1",
    "text": "凡用兵之道，以计为首。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "计战第一"
  },
  {
    "id": "bzql-2",
    "text": "凡敌始有谋，我从而攻之，使彼计穷而屈服。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "谋战第二"
  },
  {
    "id": "bzql-3",
    "text": "凡欲征伐，先用间谍，觇敌之众寡、虚实、动静，然后兴师，则大功可立，战无不胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "间战第三"
  },
  {
    "id": "bzql-4",
    "text": "凡与敌战，须要选拣勇将锐卒，使为先锋，一则壮我志，一则挫敌威。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "选战第四"
  },
  {
    "id": "bzql-5",
    "text": "凡步兵与车、骑战者，必依丘陵、险阻、林木而战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "步战第五"
  },
  {
    "id": "bzql-6",
    "text": "凡骑兵与步兵战者，若遇山林、险阻、陂泽之地，疾行急去，是必败之地，勿得与战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "骑战第六"
  },
  {
    "id": "bzql-7",
    "text": "凡与敌战于江湖之间，必有舟楫，须居上风、上流。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "舟战第七"
  },
  {
    "id": "bzql-8",
    "text": "凡与步、骑战于平原旷野，必须用偏箱、鹿角车为方阵，以战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "车战第八"
  },
  {
    "id": "bzql-9",
    "text": "凡与敌战，士卒蹈万死一生之地，而无悔惧之心者，皆信令使然也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "信战第九"
  },
  {
    "id": "bzql-10",
    "text": "凡欲兴师，必先教战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "教战第十"
  },
  {
    "id": "bzql-11",
    "text": "凡战，若我众敌寡，不可战于险阻之间，须要平易宽广之地。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "众战第十一"
  },
  {
    "id": "bzql-12",
    "text": "凡战，若以寡敌众，必以日暮，或伏于深草，或邀于隘路，战则必胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "寡战第十二"
  },
  {
    "id": "bzql-13",
    "text": "凡与敌战，士卒宁进死，而不肯退生者，皆将恩惠使然也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "爱战第十三"
  },
  {
    "id": "bzql-14",
    "text": "凡与敌战，士卒前进而不敢退后，是畏我而不畏敌也；若敢退而不敢进者，是畏敌而不畏我也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "威战第十四"
  },
  {
    "id": "bzql-15",
    "text": "凡高城深池，矢石繁下，士卒争先登；白刃始合，士卒争先赴者，必诱之以重赏，则敌无不克焉。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "赏战第十五"
  },
  {
    "id": "bzql-16",
    "text": "凡战，使士卒敢进而不敢退，退一寸者，必惩之以重刑，故可以取胜也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "罚战第十六"
  },
  {
    "id": "bzql-17",
    "text": "凡战，若彼为客、我为主，不可轻战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "主战第十七"
  },
  {
    "id": "bzql-18",
    "text": "凡战，若彼为主、我为客，唯务深入。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "客战第十八"
  },
  {
    "id": "bzql-19",
    "text": "凡与敌战，若我众强，可伪示怯弱以诱之，敌必轻来与我战，吾以锐卒击之，其军必败。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "强战第十九"
  },
  {
    "id": "bzql-20",
    "text": "凡与敌战，若敌众我寡，敌强我弱，须多设旌旗，倍增火灶，示强于敌，使彼莫能测我众寡、强弱之形，则敌必不轻与我战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "弱战第二十"
  },
  {
    "id": "bzql-21",
    "text": "凡敌人强大，未能必取，须当卑辞厚礼，以骄其志。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "骄战第二十一"
  },
  {
    "id": "bzql-22",
    "text": "凡与敌战，傍与邻国，当卑辞厚赂以结之，引为己援。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "交战第二十二"
  },
  {
    "id": "bzql-23",
    "text": "凡与敌战，若彼众多，则虚设形以分其势，彼不敢不分兵以备我。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "形战第二十三"
  },
  {
    "id": "bzql-24",
    "text": "凡战，所谓势者，乘势也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "势战第二十四"
  },
  {
    "id": "bzql-25",
    "text": "凡与敌昼战，须多设旌旗，以为疑兵，使敌莫能测其众寡，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "昼战第二十五"
  },
  {
    "id": "bzql-26",
    "text": "凡与敌夜战，须多用火鼓，所以变乱敌之耳目，使其不知所以备我之计，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "夜战第二十六"
  },
  {
    "id": "bzql-27",
    "text": "凡出师征讨，行则备其邀截，止则御其掩袭，营则防其偷盗，风则恐其火攻。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "备战第二十七"
  },
  {
    "id": "bzql-28",
    "text": "凡与敌对垒，胜负未决，有粮则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "粮战第二十八"
  },
  {
    "id": "bzql-29",
    "text": "凡与敌战，山川之夷险，道路之迂直，必用乡人引而导之，乃知其利，而战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "导战第二十九"
  },
  {
    "id": "bzql-30",
    "text": "凡兴兵伐敌，所战之地，必预知之。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "知战第三十"
  },
  {
    "id": "bzql-31",
    "text": "凡行兵之法，斥候为先。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "斥战第三十一"
  },
  {
    "id": "bzql-32",
    "text": "凡出军行师，或遇沮泽、圮毁之地，宜倍道兼行速过，不可稽留也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "泽战第三十二"
  },
  {
    "id": "bzql-33",
    "text": "凡与敌战，若有形势便利之处，宜争先据之，以战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "争战第三十三"
  },
  {
    "id": "bzql-34",
    "text": "凡与敌战，三军必要得其地利，则可以寡敌众，以弱胜强。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "地战第三十三"
  },
  {
    "id": "bzql-35",
    "text": "凡与敌战，或居山林，或在平陆，须居高阜，恃其形势，顺于击刺，便于奔冲，以战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "山战第三十五"
  },
  {
    "id": "bzql-36",
    "text": "凡行军越过山险而阵，必依附山谷，一则利水草，一则附险固，以战则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "谷战第三十六"
  },
  {
    "id": "bzql-37",
    "text": "凡战，所谓攻者，知彼者也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "攻战第三十七"
  },
  {
    "id": "bzql-38",
    "text": "凡战，所谓守者，知己者也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "守战第三十八"
  },
  {
    "id": "bzql-39",
    "text": "凡与敌战，若敌人初来，阵势未定，行阵未整，先以兵急击之，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "先战第三十九"
  },
  {
    "id": "bzql-40",
    "text": "凡战，若敌人行阵整而且锐，未可与战，宜坚壁待之；候其阵久气衰，起而击之，无有不胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "后战第四十"
  },
  {
    "id": "bzql-41",
    "text": "凡战，所谓奇者，攻其无备，出其不意也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "奇战第四十一"
  },
  {
    "id": "bzql-42",
    "text": "凡与敌战，若道路不能通，粮饷不能进，推计不能诱，利害不能惑，须用正兵。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "正战第四十二"
  },
  {
    "id": "bzql-43",
    "text": "凡与敌战，若我势虚，当伪示以实形，使敌莫能测其虚实所在，必不敢轻与我战，则我可以全师保军。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "虚战第四十三"
  },
  {
    "id": "bzql-44",
    "text": "凡与敌战，若敌人势实，我当严兵以备之，则敌人必不轻动。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "实战第四十四"
  },
  {
    "id": "bzql-45",
    "text": "凡与敌战，必须料敌详审而后出兵。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "轻战第四十五"
  },
  {
    "id": "bzql-46",
    "text": "凡与敌战，必务持重，见利则动，不见利则止，慎不可轻举也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "重战第四十六"
  },
  {
    "id": "bzql-47",
    "text": "凡与敌战，其将愚而不知变，可诱之以利。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "利战第四十七"
  },
  {
    "id": "bzql-48",
    "text": "凡与敌各守疆界，若敌人寇抄我境，以扰边民，可于要害处设伏兵，或筑障塞以邀之，敌必不敢轻犯。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "害战第四十八"
  },
  {
    "id": "bzql-49",
    "text": "凡敌人远来气锐，利于速战；我深沟高垒，安守勿应，以待其敝。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "安战第四十九"
  },
  {
    "id": "bzql-50",
    "text": "凡与敌战，若陷在危亡之地，当激励将士决死而战，不可怀生，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "危战第五十"
  },
  {
    "id": "bzql-51",
    "text": "凡与敌战，若地利已得，士卒已阵，法令已行，奇兵已设，要当割弃性命而战，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "生战第五十一"
  },
  {
    "id": "bzql-52",
    "text": "凡敌人强盛，吾士卒疑惑，未肯用命，须置之死地，告令三军，示不获已。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "死战第五十二"
  },
  {
    "id": "bzql-53",
    "text": "凡兴兵征讨，深入敌地，刍粮乏阙，必须分兵抄掠，据其仓廪，夺其蓄积，以继军饷，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "饥战第五十三"
  },
  {
    "id": "bzql-54",
    "text": "凡敌人远来，粮食不继，敌饥我饱，可坚壁不战，持久以敝之，绝其粮道。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "饱战第五十四"
  },
  {
    "id": "bzql-55",
    "text": "凡与敌战，若便利之地，敌先结阵而据之，我后去趋战，则我劳而为敌所胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "劳战第五十五"
  },
  {
    "id": "bzql-56",
    "text": "凡与敌战，不可恃己胜而放佚，当益加严厉以待敌，佚而犹劳。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "佚战第五十六"
  },
  {
    "id": "bzql-57",
    "text": "凡与敌战，若我胜彼负，不可骄惰，当日夜严备以待之。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "胜战第五十七"
  },
  {
    "id": "bzql-58",
    "text": "凡与敌战，若彼胜我负，未可畏怯，须思害中之利，当整励器械，激扬士卒，候彼懈怠而击之，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "败战第五十八"
  },
  {
    "id": "bzql-59",
    "text": "凡与敌战，若审知敌人有可胜之理，则宜速进兵以捣之，无有不胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "进战第五十九"
  },
  {
    "id": "bzql-60",
    "text": "凡与敌战，若敌众我寡，地形不利，力不可争，当急退以避之，可以全军。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "退战第六十"
  },
  {
    "id": "bzql-61",
    "text": "凡与敌战，营垒相远，势力相均，可轻骑挑攻之，伏兵以待之，其军可破。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "挑战第六十一"
  },
  {
    "id": "bzql-62",
    "text": "凡致敌来战，则彼势常虚；不能赴战，则我势常实。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "致战第六十二"
  },
  {
    "id": "bzql-63",
    "text": "凡与敌阻水相拒，我欲远渡，可多设舟楫，示之若近济，则敌必并众应之，我出其空虚以济。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "远战第六十三"
  },
  {
    "id": "bzql-64",
    "text": "凡与敌夹水为阵，我欲攻近，反示以远，须多设疑兵，上下远渡，敌必分兵来应，我可以潜师近袭之，其军可破。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "近战第六十四"
  },
  {
    "id": "bzql-65",
    "text": "凡与敌战，或岸边为阵，或水上泊舟，皆谓之水战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "水战第六十五"
  },
  {
    "id": "bzql-66",
    "text": "凡战，若敌人居近草莽，营舍茅竹，积刍聚粮，天时燥旱，因风纵火以焚之，选精兵以击之，其军可破。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "火战第六十六"
  },
  {
    "id": "bzql-67",
    "text": "凡攻城之法，最为下策，不得已而为之。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "缓战第六十七"
  },
  {
    "id": "bzql-68",
    "text": "凡攻城围邑，若敌粮多人少，外有救援，可以速攻，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "速战第六十八"
  },
  {
    "id": "bzql-69",
    "text": "凡与敌战，若敌人行阵整齐，士卒安静，未可轻战，伺其变动击之，则利。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "整战第六十九"
  },
  {
    "id": "bzql-70",
    "text": "凡与敌战，若敌人行阵不整，士卒喧哗，宜急出兵以击之，则利。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "乱战第七十"
  },
  {
    "id": "bzql-71",
    "text": "凡与敌战，若我众敌寡，当择平易宽广之地以胜之。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "分战第七十一"
  },
  {
    "id": "bzql-72",
    "text": "凡兵散则势弱，聚则势强，兵家之常情也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "合战第七十二"
  },
  {
    "id": "bzql-73",
    "text": "凡与敌战，须激励士卒，使忿怒而后出战。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "怒战第七十三"
  },
  {
    "id": "bzql-74",
    "text": "夫将之所以战者，兵也；兵之所以战者，气也；气之所以盛者，鼓也。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "气战第七十四"
  },
  {
    "id": "bzql-75",
    "text": "凡追奔逐北，须审真伪。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "逐战第七十五"
  },
  {
    "id": "bzql-76",
    "text": "凡与敌相攻，若敌无故退归，必须审察，果力疲粮竭，可选轻锐蹑之。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "归战第七十六"
  },
  {
    "id": "bzql-77",
    "text": "凡战，若敌众我寡，敌强我弱，兵势不利；彼或远来，粮饷不绝，皆不可与战，宜坚壁持久以敝之，则敌可破。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "不战第七十七"
  },
  {
    "id": "bzql-78",
    "text": "凡兴师深入敌境，若彼坚壁不与我战，欲老我师，当攻其君主，捣其巢穴，截其归路，断其粮草，彼必不得已而须战，我以锐卒击之，可败。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "必战第七十八"
  },
  {
    "id": "bzql-79",
    "text": "凡战，若敌强我弱，敌初来气锐，我之势弱，难以相持，且当避之，伺其疲敝而击之，则胜。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "避战第七十九"
  },
  {
    "id": "bzql-80",
    "text": "凡围战之道，围其四面，须开一角，以示生路，使敌战不坚，则城可拔，军可破。",
    "source": "《百战奇略》",
    "book": "百战奇略",
    "chapter": "围战第八十"
  }
]