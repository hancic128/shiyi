[
  {
    "id": "hdjj-1",
    "text": "昔在黄帝，生而神灵，弱而能言，幼而徇齐，长而敦敏，成而登天。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "上古天真论第一"
  },
  {
    "id": "hdjj-2",
    "text": "春三月，此谓发陈。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "四气调神大论第二"
  },
  {
    "id": "hdjj-3",
    "text": "天地之间，六合之内，其气九州、九窍、五脏十二节，皆通乎天气。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "生气通天论第三"
  },
  {
    "id": "hdjj-4",
    "text": "所谓得四时之胜者，春胜长夏，长夏胜冬，冬胜夏，夏胜秋，秋胜春，所谓四时之胜也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "金匮真言论第四"
  },
  {
    "id": "hdjj-5",
    "text": "治病必求于本。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "阴阳应象大论第五"
  },
  {
    "id": "hdjj-6",
    "text": "大小月三百六十日成一岁，人亦应之。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "阴阳离合论第六"
  },
  {
    "id": "hdjj-7",
    "text": "脉有阴阳，知阳者知阴，知阴者知阳。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "阴阳别论第七"
  },
  {
    "id": "hdjj-8",
    "text": "心者，君主之官也，神明出焉。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "灵兰秘典论第八"
  },
  {
    "id": "hdjj-9",
    "text": "不知其所谓也？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "六节藏象论第九"
  },
  {
    "id": "hdjj-10",
    "text": "心之合脉也，其荣色也，其主肾也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五藏生成第十"
  },
  {
    "id": "hdjj-11",
    "text": "敢问更相反，皆自谓是，不知其道，愿闻其说。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五藏别论第十一"
  },
  {
    "id": "hdjj-12",
    "text": "故东方之域，天地之所始生也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "异法方宜论第十二"
  },
  {
    "id": "hdjj-13",
    "text": "今世治病，毒药治其内，针石治其外，或愈或不愈，何也？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "移精变气论第十三"
  },
  {
    "id": "hdjj-14",
    "text": "夫上古作汤液，故为而弗服也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "汤液醪醴论第十四"
  },
  {
    "id": "hdjj-15",
    "text": "奇恒者，言奇病也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "玉版论要第十五"
  },
  {
    "id": "hdjj-16",
    "text": "三月四月，天气正方，地气定发，人气在脾。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "诊要经终论第十六"
  },
  {
    "id": "hdjj-17",
    "text": "切脉动静而视精明，察五色，观五脏有余不足，六腑强弱，形之盛衰，以此参伍，决死生之分。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "脉要精微论第十七"
  },
  {
    "id": "hdjj-18",
    "text": "平人者，不病也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "平人气象论第十八"
  },
  {
    "id": "hdjj-19",
    "text": "其气来不实而微，此谓不及，病在中。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "玉机真藏论第十九"
  },
  {
    "id": "hdjj-20",
    "text": "余愿闻要道，以属子孙，传之后世，着之骨髓，藏之肝肺，歃血而受，不敢妄泄，令合天道，必有终始。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "三部九候论第二十"
  },
  {
    "id": "hdjj-21",
    "text": "是以夜行则喘出于肾，淫气病肺。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经脉别论第二十一"
  },
  {
    "id": "hdjj-22",
    "text": "得失之意，愿闻其事！",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "藏气法时论第二十二"
  },
  {
    "id": "hdjj-23",
    "text": "五味所入：酸入肝，辛入肺，苦入心，咸入肾，甘入脾。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "宣明五气第二十三"
  },
  {
    "id": "hdjj-24",
    "text": "夫人之常数，太阳常多血少气，少阳常少血多气，阳明常多气多血，少阴常少血多气，厥阴常多血少气，太阴常多气少血，此天之常数。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "血气形志第二十四"
  },
  {
    "id": "hdjj-25",
    "text": "人以天地之气生，四时之法成。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "宝命全形论第二十五"
  },
  {
    "id": "hdjj-26",
    "text": "是故天温日明，则人血淖液而卫气浮，故血易泻，气易行；天寒日阴，则人血凝泣而卫气沉。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "八正神明论第二十六"
  },
  {
    "id": "hdjj-27",
    "text": "经言气之盛衰，左右倾移，以上调下，以左调右，有余不足，补泻于荣、输，余知之矣。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "离合真邪论第二十七"
  },
  {
    "id": "hdjj-28",
    "text": "气逆者，足寒也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "通评虚实论第二十八"
  },
  {
    "id": "hdjj-29",
    "text": "故阳道实，阴道虚。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "太阴阳明论第二十九"
  },
  {
    "id": "hdjj-30",
    "text": "闻木音而惊，何也？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "阳明脉解第三十"
  },
  {
    "id": "hdjj-31",
    "text": "不知其解，愿闻其故。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "热论第三十一"
  },
  {
    "id": "hdjj-32",
    "text": "肝热病者，小便先黄，腹痛，多卧，身热。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺热第三十二"
  },
  {
    "id": "hdjj-33",
    "text": "精胜则当能食而不复热。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "评热病论第三十三"
  },
  {
    "id": "hdjj-34",
    "text": "阳气少，阴气多，故身寒如从水中出。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "逆调论第三十四"
  },
  {
    "id": "hdjj-35",
    "text": "阳并于阴，则阴实而阳虚，阳明虚则寒栗，鼓颔也；巨阳虚则腰背头项痛；三阳俱虚则阴气胜，阴气胜则骨寒而痛；寒生于内，故中外皆寒；阳盛则外热，阴虚则内热，外内皆热则喘而渴，故欲冷饮也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "疟论第三十五"
  },
  {
    "id": "hdjj-36",
    "text": "足太阳之疟，令人腰痛头重，寒从背起，先寒后热，熇熇暍暍然，热止汗出，难已，刺郄中出血。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺疟第三十六"
  },
  {
    "id": "hdjj-37",
    "text": "脾移寒于肝，痈肿、筋挛。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "气厥论第三十七"
  },
  {
    "id": "hdjj-38",
    "text": "皮毛先受邪气，邪气以从其合也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "咳论第三十八"
  },
  {
    "id": "hdjj-39",
    "text": "今余问于夫子，令言而可知，视而可见，扪而可得，令验于己而发蒙解惑，可得而闻乎？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "举痛论第三十九"
  },
  {
    "id": "hdjj-40",
    "text": "虽然其病且已，时故当病，气聚于腹也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "腹中论第四十"
  },
  {
    "id": "hdjj-41",
    "text": "足太阳脉令人腰痛，引项脊尻背如重状，刺其郄中。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺腰痛第四十一"
  },
  {
    "id": "hdjj-42",
    "text": "其病各异，其名不同。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "风论第四十二"
  },
  {
    "id": "hdjj-43",
    "text": "其风气胜者为行痹，寒气胜者为痛痹，湿气胜者为着痹也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "痹论第四十三"
  },
  {
    "id": "hdjj-44",
    "text": "故肺热叶焦，则皮毛虚弱，急薄，着则生痿躄也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "痿论第四十四"
  },
  {
    "id": "hdjj-45",
    "text": "春夏则阳气多而阴气少，秋冬则阴气胜而阳气衰。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "厥论第四十五"
  },
  {
    "id": "hdjj-46",
    "text": "人迎者，胃脉也，逆而盛，则热聚于胃口而不行，故胃脘为痈也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "病能论第四十六"
  },
  {
    "id": "hdjj-47",
    "text": "肝满、肾满、肺满皆实，即为肿。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "大奇论第四十八"
  },
  {
    "id": "hdjj-48",
    "text": "太阳所谓肿腰脽痛者，正月太阳寅，寅，太阳也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "脉解第四十九"
  },
  {
    "id": "hdjj-49",
    "text": "浅深不得，反为大贼，内动五脏，后生大病。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺要论第五十"
  },
  {
    "id": "hdjj-50",
    "text": "刺筋无伤肉者，至肉而去，不及筋也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺齐论第五十一"
  },
  {
    "id": "hdjj-51",
    "text": "肝生于左，肺藏于右，心部于表，肾治于里，脾为之使，胃为之市。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺禁论第五十二"
  },
  {
    "id": "hdjj-52",
    "text": "谷盛气盛，谷虚气虚，此其常也，反此者病。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺志论第五十三"
  },
  {
    "id": "hdjj-53",
    "text": "满而泄之者，针下寒也，气虚乃寒也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "针解第五十四"
  },
  {
    "id": "hdjj-54",
    "text": "刺家不诊，听病者言。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "长刺节论第五十五"
  },
  {
    "id": "hdjj-55",
    "text": "阳明之阳，名曰害蜚。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "皮部论第五十六"
  },
  {
    "id": "hdjj-56",
    "text": "寒多则凝泣，凝泣则青黑；热多则淖泽，淖泽则黄赤。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经络论第五十七"
  },
  {
    "id": "hdjj-57",
    "text": "其非圣帝，孰能穷其道焉！",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "气穴论第五十八"
  },
  {
    "id": "hdjj-58",
    "text": "足太阳脉气所发者，七十八穴：两眉头各一。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "气府论第五十九"
  },
  {
    "id": "hdjj-59",
    "text": "大风，颈项痛，刺风府，风府在上椎。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "骨空论第六十"
  },
  {
    "id": "hdjj-60",
    "text": "肾何以主水？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "水热穴论第六十一"
  },
  {
    "id": "hdjj-61",
    "text": "何谓有余，何谓不足？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "调经论第六十二"
  },
  {
    "id": "hdjj-62",
    "text": "此邪之从皮毛而入，极于五脏之次也，如此则治其经焉。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "缪刺论第六十三"
  },
  {
    "id": "hdjj-63",
    "text": "厥阴有余病阴痹，不足病生热痹；滑则病狐疝风；濇则病少腹积气。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "四时刺逆从论第六十四"
  },
  {
    "id": "hdjj-64",
    "text": "故治有取标而得者，有取本而得者，有逆取而得者，有从取而得者。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "标本病传论第六十五"
  },
  {
    "id": "hdjj-65",
    "text": "论言五运相袭，而皆治之，终期之日，周而复始，予已知之矣。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "天元纪大论第六十六"
  },
  {
    "id": "hdjj-66",
    "text": "黄帝坐明堂，始正天纲，临观八极，考建五常。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五运行大论第六十七"
  },
  {
    "id": "hdjj-67",
    "text": "夫子数言谨奉天道，予闻而藏之，心私异之，不知其所谓也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "六微旨大论第六十八"
  },
  {
    "id": "hdjj-68",
    "text": "此上帝所贵，先师传之，臣虽不敏，往闻其旨。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "气交变大论第六十九"
  },
  {
    "id": "hdjj-69",
    "text": "何如而纪也？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五常政大论第七十"
  },
  {
    "id": "hdjj-70",
    "text": "夫五运之化，或从天气，或逆天气，或从天气而逆地气，或从地气而逆天气，或相得，或不相得，余未能明其事。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "六元正纪大论第七十一"
  },
  {
    "id": "hdjj-71",
    "text": "何如预救生灵，可得却乎？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "刺法论第七十二"
  },
  {
    "id": "hdjj-72",
    "text": "愿闻气交何名失守？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "本病论第七十三"
  },
  {
    "id": "hdjj-73",
    "text": "六气分治，司天地者，其至何如？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "至真要大论第七十四"
  },
  {
    "id": "hdjj-74",
    "text": "黄帝坐明堂，召雷公而问之曰：子知医之道乎？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "著至教论第七十五"
  },
  {
    "id": "hdjj-75",
    "text": "余真问以自谬也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "示从容论第七十六"
  },
  {
    "id": "hdjj-76",
    "text": "闵闵乎若视深渊，若迎浮云，视深渊尚可测，迎浮云莫知其际。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "疏五过论第七十七"
  },
  {
    "id": "hdjj-77",
    "text": "黄帝在明堂，雷公侍坐，黄帝曰：夫子所通书受事众多矣，试言得失之意，所以得之，所以失之。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "徵四失论第七十八"
  },
  {
    "id": "hdjj-78",
    "text": "孟春始至，黄帝燕坐，临观八极，正八风之气，而问雷公曰：阴阳之类，经脉之道，五中所主，何藏最贵？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "阴阳类论第七十九"
  },
  {
    "id": "hdjj-79",
    "text": "雷公请问：气之多少，何者为逆，何者为从。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "方盛衰论第八十"
  },
  {
    "id": "hdjj-80",
    "text": "黄帝在明堂，雷公请曰：臣授业，传之行教以经论，从容形法，阴阳刺灸，汤药所滋，行治有贤不肖，未必能十全。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "解精微论第八十一"
  },
  {
    "id": "hdjj-81",
    "text": "余哀其不给而属有疾病。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "九针十二原第八十二"
  },
  {
    "id": "hdjj-82",
    "text": "大肠属上，小肠属下，足阳明胃脉也；大肠、小肠，皆属于胃。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "本输第八十三"
  },
  {
    "id": "hdjj-83",
    "text": "所谓易陈者，易言也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "小针解第八十四"
  },
  {
    "id": "hdjj-84",
    "text": "中于阴则溜于腑，中于阳则溜于经。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "邪气藏府病形第八十五"
  },
  {
    "id": "hdjj-85",
    "text": "发于春夏，阴气少，阳气多，阴阳不调，何补何泻？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "根结第八十六"
  },
  {
    "id": "hdjj-86",
    "text": "得病所始，刺之有理。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "寿夭刚柔第八十七"
  },
  {
    "id": "hdjj-87",
    "text": "凡刺之要，官针最妙。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "官针第八十八"
  },
  {
    "id": "hdjj-88",
    "text": "血、脉、营、气、精、神，此五脏之所藏也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "本神第八十九"
  },
  {
    "id": "hdjj-89",
    "text": "凡刺之道，毕于终始。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "终始第九十"
  },
  {
    "id": "hdjj-90",
    "text": "肺手太阴之脉，起于中焦，下络大肠，还循胃口，上膈属肺，从肺系横出腋下，下循臑内，行少阴心主之前，下肘中，循臂内上骨下廉，入寸口，上鱼，循鱼际，出大指之端。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经脉第九十一"
  },
  {
    "id": "hdjj-91",
    "text": "六律建阴阳诸经而合之十二月、十二辰、十二节、十二经水、十二时、十二经脉者，此五脏六腑之所以应天道也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经别第九十二"
  },
  {
    "id": "hdjj-92",
    "text": "夫十二经水者，其有大小、深浅、广狭、远近各不同；五脏六腑之高下、大小、受谷之多少亦不等，相应奈何？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经水第九十三"
  },
  {
    "id": "hdjj-93",
    "text": "足太阳之筋，起于足小趾上，结于踝，邪上结于膝，其下循足外侧，结于踵，上循跟，结于腘。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "经筋第九十四"
  },
  {
    "id": "hdjj-94",
    "text": "人长七尺五寸者，其骨节之大小长短各几何？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "骨度第九十五"
  },
  {
    "id": "hdjj-95",
    "text": "人经脉上下、左右、前后二十八脉，周身十六丈二尺，以应二十八宿。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五十营第九十六"
  },
  {
    "id": "hdjj-96",
    "text": "谷入于胃，乃传之肺，流溢于中，布散于外，精专者行于经隧，常营无已，终而复始，是谓天地之纪。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "营气第九十七"
  },
  {
    "id": "hdjj-97",
    "text": "手之六阴，从手至胸中，三尺五寸，三六一丈八尺，五六三尺，合二丈一尺。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "脉度第九十八"
  },
  {
    "id": "hdjj-98",
    "text": "老壮不同气，阴阳异位，愿闻其会。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "营卫生会第九十九"
  },
  {
    "id": "hdjj-99",
    "text": "故春取经、血脉、分肉之间，甚者深刺之；间者浅刺之。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "四时气第一百"
  },
  {
    "id": "hdjj-100",
    "text": "邪在肺，则病皮肤痛，寒热，上气喘，汗出，咳动肩背。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五邪第一百零一"
  },
  {
    "id": "hdjj-101",
    "text": "皮寒热者，不可附席，毛发焦，鼻槁腊，不得汗，取三阳之络，以补手太阴。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "寒热病第一百零二"
  },
  {
    "id": "hdjj-102",
    "text": "目眦外决于面者，为锐眦；在内近鼻者，为内眦；上为外眦，下为内眦。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "癫狂第一百零三"
  },
  {
    "id": "hdjj-103",
    "text": "偏枯，身偏不用而痛，言不变，志不乱，病在分腠之间，巨针取之，益其不足，损其有余，乃可复也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "热病第一百零四"
  },
  {
    "id": "hdjj-104",
    "text": "厥头痛，面若肿起而烦心，取之足阳明、太阴。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "厥病第一百零五"
  },
  {
    "id": "hdjj-105",
    "text": "先病而后逆者，治其本。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "病本第一百零六"
  },
  {
    "id": "hdjj-106",
    "text": "厥挟脊而痛至顶，头沉沉然，目吭硫然，腰脊强。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "杂病第一百零七"
  },
  {
    "id": "hdjj-107",
    "text": "将在分肉之间乎？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "周痹第一百零八"
  },
  {
    "id": "hdjj-108",
    "text": "黄帝闲居，辟左右而问于岐伯曰：余已闻九针之经，论阴阳逆顺，六经已毕，愿得口问。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "口问第一百零九"
  },
  {
    "id": "hdjj-109",
    "text": "夫治民与自治，治彼与治此，治小与治大，治国与治家，未有逆而能治之也，夫惟顺而已矣。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "师传第一百一十"
  },
  {
    "id": "hdjj-110",
    "text": "气脱者，目不明。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "决气第一百一十一"
  },
  {
    "id": "hdjj-111",
    "text": "齿以后至会厌，深三寸半，大容五合。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "肠胃第一百一十二"
  },
  {
    "id": "hdjj-112",
    "text": "肠胃之长凡五丈八尺四寸，受水榖九斗二升一合合之大半，此肠胃所受水榖之数也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "平人绝谷第一百一十三"
  },
  {
    "id": "hdjj-113",
    "text": "夫十二经脉者，内属于腑臓，外络于肢节，夫子乃合之于四海乎？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "海论第一百一十四"
  },
  {
    "id": "hdjj-114",
    "text": "十二月者，分为四时。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五乱第一百一十五"
  },
  {
    "id": "hdjj-115",
    "text": "邪气内逆，则气为之闭塞而不行，不行则为水胀。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五癃津液别第一百一十七"
  },
  {
    "id": "hdjj-116",
    "text": "五气者，五脏之使也，五时之副也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "五阅五使第一百一十八"
  },
  {
    "id": "hdjj-117",
    "text": "夫子之道，应若失而据未有坚然者也。",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "逆顺肥瘦第一百一十九"
  },
  {
    "id": "hdjj-118",
    "text": "血出而射者，何也？",
    "source": "《黄帝内经》",
    "book": "黄帝内经",
    "chapter": "血络论第一百二十"
  }
]