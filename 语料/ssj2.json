[
  {
    "id": "ssj2-1",
    "text": "昔在帝尧，聪明文思，光宅天下。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "尧典第一"
  },
  {
    "id": "ssj2-2",
    "text": "虞舜侧微，尧闻之聪明，将使嗣位，历试诸难，作舜典。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "舜典第二"
  },
  {
    "id": "ssj2-3",
    "text": "皋陶矢厥谟，禹成厥功，帝舜申之。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "大禹谟第三"
  },
  {
    "id": "ssj2-4",
    "text": "曰若稽古皋陶曰：允迪厥德，谟明弼谐。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "皋陶谟第四"
  },
  {
    "id": "ssj2-5",
    "text": "禹拜曰：都！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "益稷第五"
  },
  {
    "id": "ssj2-6",
    "text": "禹别九州，随山浚川，任土作贡。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "禹贡第一"
  },
  {
    "id": "ssj2-7",
    "text": "启与有扈战于甘之野，作甘誓。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "甘誓第二"
  },
  {
    "id": "ssj2-8",
    "text": "太康失邦，昆弟五人须于洛汭，作五子之歌。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "五子之歌第三"
  },
  {
    "id": "ssj2-9",
    "text": "羲和湎淫，废时乱日，胤往征之，作胤征。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "胤征第四"
  },
  {
    "id": "ssj2-10",
    "text": "伊尹相汤伐桀，升自陑，遂与桀战于鸣条之野，作汤誓。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "汤誓第一"
  },
  {
    "id": "ssj2-11",
    "text": "成汤放桀于南巢，惟有惭德。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "仲虺之诰第二"
  },
  {
    "id": "ssj2-12",
    "text": "汤既黜夏命，复归于亳，作汤诰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "汤诰第三"
  },
  {
    "id": "ssj2-13",
    "text": "成汤既没，太甲元年，伊尹作伊训、肆命、徂后。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "伊训第四"
  },
  {
    "id": "ssj2-14",
    "text": "太甲既立，不明，伊尹放诸桐。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲上第五"
  },
  {
    "id": "ssj2-15",
    "text": "惟三祀十有二月朔，伊尹以冕服奉嗣王归于亳，作书曰：民非后，罔克胥匡以生；后非民，罔以辟四方。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲中第六"
  },
  {
    "id": "ssj2-16",
    "text": "伊尹申诰于王曰：呜呼！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲下第七"
  },
  {
    "id": "ssj2-17",
    "text": "伊尹作咸有一德。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "咸有一德第八"
  },
  {
    "id": "ssj2-18",
    "text": "盘庚五迁，将治亳殷，民咨胥怨。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "盘庚上第九"
  },
  {
    "id": "ssj2-19",
    "text": "盘庚作，惟涉河以民迁。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "盘庚中第十"
  },
  {
    "id": "ssj2-20",
    "text": "盘庚既迁，奠厥攸居，乃正厥位，绥爰有众。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "盘庚下第十一"
  },
  {
    "id": "ssj2-21",
    "text": "高宗梦得说，使百工营求诸野，得诸傅岩，作说命三篇。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命上第十二"
  },
  {
    "id": "ssj2-22",
    "text": "惟说命总百官，乃进于王曰：呜呼！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命中第十三"
  },
  {
    "id": "ssj2-23",
    "text": "台小子旧学于甘盘，既乃遯于荒野，入宅于河。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命下第十四"
  },
  {
    "id": "ssj2-24",
    "text": "高宗祭成汤，有飞雉升鼎耳而雊，祖己训诸王，作高宗肜日、高宗之训。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "高宗肜日第十五"
  },
  {
    "id": "ssj2-25",
    "text": "殷始咎周，周人乘黎。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "西伯戡黎第十六"
  },
  {
    "id": "ssj2-26",
    "text": "殷既错天命，微子作诰父师、小师。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "微子第十七"
  },
  {
    "id": "ssj2-27",
    "text": "惟十有一年，武王伐殷。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "泰誓第一"
  },
  {
    "id": "ssj2-28",
    "text": "武王戎车三百两，虎贲三百人，与商战于牧野，作牧誓。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "牧誓第二"
  },
  {
    "id": "ssj2-29",
    "text": "往伐归兽，识其政事，作武成。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "武成第三"
  },
  {
    "id": "ssj2-30",
    "text": "武王胜殷，杀受，立武庚，以箕子归。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "洪范第四"
  },
  {
    "id": "ssj2-31",
    "text": "西旅献獒，太保作旅獒。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "旅獒第五"
  },
  {
    "id": "ssj2-32",
    "text": "武王有疾，周公作金縢。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "金縢第五"
  },
  {
    "id": "ssj2-33",
    "text": "武王崩，三监及淮夷叛，周公相成王，将黜殷，作大诰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "大诰第七"
  },
  {
    "id": "ssj2-34",
    "text": "成王既黜殷命，杀武庚，命微子启代殷后，作微子之命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "微子之命第八"
  },
  {
    "id": "ssj2-35",
    "text": "成王既伐管叔、蔡叔，以殷余民封康叔，作康诰、酒诰、梓材。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "康诰第九"
  },
  {
    "id": "ssj2-36",
    "text": "王若曰：明大命于妹邦。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "酒诰第十"
  },
  {
    "id": "ssj2-37",
    "text": "王曰：封，以厥庶民暨厥臣达大家，以厥臣达王惟邦君，汝若恒越曰：我有师师、司徒、司马、司空、尹、旅。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "梓材第十一"
  },
  {
    "id": "ssj2-38",
    "text": "成王在丰，欲宅洛邑，使召公先相宅，作召诰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "召诰第十二"
  },
  {
    "id": "ssj2-39",
    "text": "召公既相宅，周公往营成周，使来告卜，作洛诰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "洛诰第十三"
  },
  {
    "id": "ssj2-40",
    "text": "惟三月，周公初于新邑洛，用告商王士。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "多士第十四"
  },
  {
    "id": "ssj2-41",
    "text": "周公作无逸。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "无逸第十五"
  },
  {
    "id": "ssj2-42",
    "text": "召公为保，周公为师，相成王为左右。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君奭第十六"
  },
  {
    "id": "ssj2-43",
    "text": "蔡叔既没，王命蔡仲，践诸侯位，作蔡仲之命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "蔡仲之命第十七"
  },
  {
    "id": "ssj2-44",
    "text": "成王归自奄，在宗周，诰庶邦，作多方。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "多方第十八"
  },
  {
    "id": "ssj2-45",
    "text": "周公作立政。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "立政第十九"
  },
  {
    "id": "ssj2-46",
    "text": "成王既黜殷命，灭淮夷，还归在丰，作周官。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "周官第二十"
  },
  {
    "id": "ssj2-47",
    "text": "周公既没，命君陈分正东郊成周，作君陈。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君陈第二十一"
  },
  {
    "id": "ssj2-48",
    "text": "成王将崩，命召公、毕公率诸侯相康王，作顾命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "顾命第二十二"
  },
  {
    "id": "ssj2-49",
    "text": "康王既尸天子，遂诰诸侯，作康王之诰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "康王之诰第二十三"
  },
  {
    "id": "ssj2-50",
    "text": "康王命作册毕，分居里，成周郊，作毕命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "毕命第二十四"
  },
  {
    "id": "ssj2-51",
    "text": "穆王命君牙，为周大司徒，作君牙。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君牙第二十五"
  },
  {
    "id": "ssj2-52",
    "text": "王若曰：伯冏！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "冏命第二十六"
  },
  {
    "id": "ssj2-53",
    "text": "吕命穆王训夏赎刑，作吕刑。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "吕刑第二十七"
  },
  {
    "id": "ssj2-54",
    "text": "平王锡晋文侯秬鬯、圭瓒，作文侯之命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "文侯之命第二十八"
  },
  {
    "id": "ssj2-55",
    "text": "鲁侯伯禽宅曲阜，徐、夷并兴，东郊不开。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "费誓第二十九"
  },
  {
    "id": "ssj2-56",
    "text": "我士，听无哗！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "秦誓第三十"
  },
  {
    "id": "ssj2-57",
    "text": "将逊于位，让于虞舜，作尧典。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "尧典第一"
  },
  {
    "id": "ssj2-58",
    "text": "曰若稽古，帝舜曰重华，协于帝。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "舜典第二"
  },
  {
    "id": "ssj2-59",
    "text": "作大禹皋陶谟益稷。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "大禹谟第三"
  },
  {
    "id": "ssj2-60",
    "text": "禹曰：俞，如何？",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "皋陶谟第四"
  },
  {
    "id": "ssj2-61",
    "text": "帝，予何言？",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "益稷第五"
  },
  {
    "id": "ssj2-62",
    "text": "禹敷土，随山刊木，奠高山大川。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "禹贡第一"
  },
  {
    "id": "ssj2-63",
    "text": "大战于甘，乃召六卿。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "甘誓第二"
  },
  {
    "id": "ssj2-64",
    "text": "太康尸位，以逸豫灭厥德，黎民咸贰，乃盘游无度，畋于有洛之表，十旬弗反。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "五子之歌第三"
  },
  {
    "id": "ssj2-65",
    "text": "惟仲康肇位四海，胤侯命掌六师。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "胤征第四"
  },
  {
    "id": "ssj2-66",
    "text": "王曰：格尔众庶，悉听朕言，非台小子，敢行称乱！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "汤誓第一"
  },
  {
    "id": "ssj2-67",
    "text": "王归自克夏，至于亳，诞告万方。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "汤诰第三"
  },
  {
    "id": "ssj2-68",
    "text": "惟元祀十有二月乙丑，伊尹祠于先王。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "伊训第四"
  },
  {
    "id": "ssj2-69",
    "text": "三年复归于亳，思庸，伊尹作太甲三篇。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲上第五"
  },
  {
    "id": "ssj2-70",
    "text": "皇天眷佑有商，俾嗣王克终厥德，实万世无疆之休。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲中第六"
  },
  {
    "id": "ssj2-71",
    "text": "惟天无亲，克敬惟亲。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "太甲下第七"
  },
  {
    "id": "ssj2-72",
    "text": "伊尹既复政厥辟，将告归，乃陈戒于德。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "咸有一德第八"
  },
  {
    "id": "ssj2-73",
    "text": "作盘庚三篇。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "盘庚上第九"
  },
  {
    "id": "ssj2-74",
    "text": "其有众咸造，勿亵在王庭，盘庚乃登进厥民。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "盘庚中第十"
  },
  {
    "id": "ssj2-75",
    "text": "王宅忧，亮阴三祀。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命上第十二"
  },
  {
    "id": "ssj2-76",
    "text": "明王奉若天道，建邦设都，树后王君公，承以大夫师长，不惟逸豫，惟以乱民。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命中第十三"
  },
  {
    "id": "ssj2-77",
    "text": "自河徂亳，暨厥终罔显。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "说命下第十四"
  },
  {
    "id": "ssj2-78",
    "text": "高宗肜日，越有雊雉。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "高宗肜日第十五"
  },
  {
    "id": "ssj2-79",
    "text": "祖伊恐，奔告于受，作西伯戡黎。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "西伯戡黎第十六"
  },
  {
    "id": "ssj2-80",
    "text": "微子若曰：父师、少师！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "微子第十七"
  },
  {
    "id": "ssj2-81",
    "text": "一月戊午，师渡孟津，作泰誓三篇。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "泰誓第一"
  },
  {
    "id": "ssj2-82",
    "text": "时甲子昧爽，王朝至于商郊牧野，乃誓。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "牧誓第二"
  },
  {
    "id": "ssj2-83",
    "text": "惟一月壬辰，旁死魄。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "武成第三"
  },
  {
    "id": "ssj2-84",
    "text": "惟十有三祀，王访于箕子。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "洪范第四"
  },
  {
    "id": "ssj2-85",
    "text": "惟克商，遂通道于九夷八蛮。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "旅獒第五"
  },
  {
    "id": "ssj2-86",
    "text": "既克商二年，王有疾，弗豫。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "金縢第五"
  },
  {
    "id": "ssj2-87",
    "text": "王若曰：猷大诰尔多邦越尔御事，弗吊天降割于我家，不少延。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "大诰第七"
  },
  {
    "id": "ssj2-88",
    "text": "王若曰：猷！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "微子之命第八"
  },
  {
    "id": "ssj2-89",
    "text": "惟三月哉生魄，周公初基作新大邑于东国洛，四方民大和会。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "康诰第九"
  },
  {
    "id": "ssj2-90",
    "text": "厥诰毖庶邦庶士越少正御事，朝夕曰：‘祀兹酒。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "酒诰第十"
  },
  {
    "id": "ssj2-91",
    "text": "惟二月既望，越六日乙未，王朝步自周，则至于丰。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "召诰第十二"
  },
  {
    "id": "ssj2-92",
    "text": "周公拜手稽首曰：朕复子明辟。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "洛诰第十三"
  },
  {
    "id": "ssj2-93",
    "text": "王若曰：尔殷遗多士弗吊，旻天大降丧于殷，我有周佑命，将天明威，致王罚，敕殷命终于帝。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "多士第十四"
  },
  {
    "id": "ssj2-94",
    "text": "周公曰：呜呼！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "无逸第十五"
  },
  {
    "id": "ssj2-95",
    "text": "召公不说，周公作君奭。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君奭第十六"
  },
  {
    "id": "ssj2-96",
    "text": "惟周公位冢宰，正百工，群叔流言。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "蔡仲之命第十七"
  },
  {
    "id": "ssj2-97",
    "text": "惟五月丁亥，王来自奄，至于宗周。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "多方第十八"
  },
  {
    "id": "ssj2-98",
    "text": "周公若曰：拜手稽首，告嗣天子王矣。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "立政第十九"
  },
  {
    "id": "ssj2-99",
    "text": "惟周王抚万邦，巡侯、甸，四征弗庭，绥厥兆民。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "周官第二十"
  },
  {
    "id": "ssj2-100",
    "text": "王若曰：君陈，惟尔令德孝恭。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君陈第二十一"
  },
  {
    "id": "ssj2-101",
    "text": "惟四月，哉生魄，王不怿。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "顾命第二十二"
  },
  {
    "id": "ssj2-102",
    "text": "王出，在应门之内，太保率西方诸侯入应门左，毕公率东方诸侯入应门右，皆布乘黄朱。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "康王之诰第二十三"
  },
  {
    "id": "ssj2-103",
    "text": "惟十有二年，六月庚午，朏。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "毕命第二十四"
  },
  {
    "id": "ssj2-104",
    "text": "王若曰：呜呼！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "君牙第二十五"
  },
  {
    "id": "ssj2-105",
    "text": "惟予弗克于德，嗣先人宅丕后。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "冏命第二十六"
  },
  {
    "id": "ssj2-106",
    "text": "惟吕命，王享国百年，耄荒，度作刑，以诘四方。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "吕刑第二十七"
  },
  {
    "id": "ssj2-107",
    "text": "王若曰：父义和！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "文侯之命第二十八"
  },
  {
    "id": "ssj2-108",
    "text": "人无哗，听命。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "费誓第二十九"
  },
  {
    "id": "ssj2-109",
    "text": "予誓告汝群言之首。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "秦誓第三十"
  },
  {
    "id": "ssj2-110",
    "text": "曰若稽古，帝尧，曰放勋，钦、明、文、思、安安，允恭克让，光被四表，格于上下。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "尧典第一"
  },
  {
    "id": "ssj2-111",
    "text": "浚哲文明，温恭允塞，玄德升闻，乃命以位。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "舜典第二"
  },
  {
    "id": "ssj2-112",
    "text": "曰若稽古，大禹曰文命，敷于四海，祗承于帝。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "大禹谟第三"
  },
  {
    "id": "ssj2-113",
    "text": "皋陶曰：都！",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "皋陶谟第四"
  },
  {
    "id": "ssj2-114",
    "text": "予思日孜孜。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "益稷第五"
  },
  {
    "id": "ssj2-115",
    "text": "冀州：既载壶口，治梁及岐。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "禹贡第一"
  },
  {
    "id": "ssj2-116",
    "text": "六事之人，予誓告汝：有扈氏威侮五行，怠弃三正，天用剿绝其命，今予惟恭行天之罚。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "甘誓第二"
  },
  {
    "id": "ssj2-117",
    "text": "有穷后羿因民弗忍，距于河，厥弟五人御其母以从，徯于洛之汭。",
    "source": "《尚书》",
    "book": "尚书",
    "chapter": "五子之歌第三"
  }
]