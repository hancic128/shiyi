[
  {
    "id": "xlgj-1",
    "text": "有延师教其子者，师至，主人曰：家贫，多失礼于先生，奈何！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-2",
    "text": "道士、和尚、胡子三人过江。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-3",
    "text": "一人娶一老妻，坐床时，见面多皱纹，因问曰：汝有多少年纪？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-4",
    "text": "医人买得医官札付者，冠带而坐于店中。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-5",
    "text": "教官子与县丞子厮打，教官子屡负，归而哭诉其母。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-6",
    "text": "有避债者，偶以事出门，恐人见之，乃顶一笆斗而行。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-7",
    "text": "一乡官游寺，问和尚吃荤否。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-8",
    "text": "夜游神见门神夜立，怜而问之曰：汝长大乃尔，如何做人门客，早晚伺候，受此苦辛？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-9",
    "text": "金刚遇开路神，羡之曰：你我一般长大，我怎如你着好吃好。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-10",
    "text": "人问：羊肉与鹅肉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-11",
    "text": "有慕开典铺者，谋之人曰：需本几何？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-12",
    "text": "庸师惯读破句，又念白字。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-13",
    "text": "师曰：何言之谦，仆固无不可者。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-14",
    "text": "忽遇狂风大作，舟将颠覆，僧道慌甚，急把经卷投入江中，求神救护。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-15",
    "text": "妇曰：四十五六。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-16",
    "text": "过者骇曰：此何店，而有官在内？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-17",
    "text": "母曰：彼家终日吃肉，故恁般强健会打。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-18",
    "text": "为一债家所识，弹其斗曰：嘶约如何？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-19",
    "text": "门神曰：出于无奈耳。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-20",
    "text": "开路神曰：阿哥不知，我只图得些口腹耳。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-21",
    "text": "或答曰：生平吃素的。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-22",
    "text": "一日训徒，教大学序，念云：大学之，书古之，大学所以教人之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-23",
    "text": "主人曰：蔬食，可乎？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-24",
    "text": "其人曰：我在此抛毛。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-25",
    "text": "夫曰：婚书上写三十八岁，依我看来还不止四十五六。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-26",
    "text": "旁人答曰：此医官之店。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-27",
    "text": "你家终日吃腐，力气衰微，如何敌得他过？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-28",
    "text": "姑应曰：明日。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-29",
    "text": "但逢饮酒时，略用些。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-30",
    "text": "一帮闲汉途遇人家出丧，前面焦面鬼王，以为大老官人也，礼拜甚恭。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-31",
    "text": "秀才年将七十，忽生一子。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-32",
    "text": "其人大骇而去。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-33",
    "text": "主人知觉，怒而逐之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-34",
    "text": "主人曰：家无臧获，凡洒扫庭除，启闭门户，劳先生为之，可乎？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-35",
    "text": "一乡人自城中归，谓其妻曰：我在城里打了无数喷嚏。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-36",
    "text": "可实对我说。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-37",
    "text": "有写真者，绝无生意。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-38",
    "text": "教官曰：这般我儿不要忙，等祭过了丁，再与他报复便了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-39",
    "text": "已而雨大作，斗上点击无算。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-40",
    "text": "答：若他要吃饭时，又不要我上门了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-41",
    "text": "少顷，大雨如注，而鬼身上纸衣被雨濯去。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-42",
    "text": "因有年纪而生，即名年纪。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-43",
    "text": "最后一人曰：开典如何要本钱，只须店柜一张，当票数纸足亦。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-44",
    "text": "复被一荫官延请入幕，官不识律令，每事询之馆师。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-45",
    "text": "主人曰：或家人妇子欲买零星杂物，屈先生一行，可乎？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-46",
    "text": "妻曰：皆我在家想你之故。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-47",
    "text": "或劝他将自己夫妻画一幅贴出，人见方知。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-48",
    "text": "鼠与黄蜂为兄弟，邀一秀才做盟证，秀才不得已往，列为第三人。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-49",
    "text": "其人慌甚，乃曰：一概明日。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-50",
    "text": "一人家贫而不善饮，每出啖糟饼二枚，便有酣意。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-51",
    "text": "闲汉曰：白日见鬼，我只道是大老官，却原来也是个篾片。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-52",
    "text": "未几又生一子，似可读书，命名学问。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-53",
    "text": "此人乃欣然。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-54",
    "text": "一日，巡捕拿一盗钟者至，官问：何以治之？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-55",
    "text": "主人曰：如此，幸甚！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-56",
    "text": "他日挑粪过危桥，复连打数嚏几乎失足，乃骂曰：骚花娘，就是思量我，也须看什么所在！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-57",
    "text": "夫复再三诘之，只以前言对。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-58",
    "text": "画者乃依计而行。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-59",
    "text": "答曰：他两个一会钻，一会刺，我只得让他些罢了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-60",
    "text": "一人问造酒之法于酒家。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-61",
    "text": "但逢家岳妻舅来，略陪些。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-62",
    "text": "答曰：非也，吃糟饼耳。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-63",
    "text": "一闲汉咽糠而出，忽遇大老官留家早饭，答曰：适间用狗肉过饱，饭是吃不下了，有酒倒饮几杯。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-64",
    "text": "次年，又生一子。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-65",
    "text": "至日，有持物来当者。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-66",
    "text": "师曰：夫子之道忠，怒而巳矣。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-67",
    "text": "师曰：仆亦有一言，愿主人勿讶焉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-68",
    "text": "答曰：吃大蒜极好。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-69",
    "text": "上床后，更不过心。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-70",
    "text": "一日，丈人来望，因问：此女是谁？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-71",
    "text": "两道学先生议论不合，各自诧真道学而互诋为假，久之不决，乃请证于孔子。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-72",
    "text": "酒家曰：一斗米，一两曲，加二斗水。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-73",
    "text": "乡官怒曰：汝又有妻，全不像出家人的戒行。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-74",
    "text": "归以语妻，妻曰：呆子，便说酒对，也装些体面。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-75",
    "text": "既饮忽吐，而糠出焉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-76",
    "text": "笑曰：如此老年，还要生儿，真笑话也。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-77",
    "text": "验收讫，填空票计之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-78",
    "text": "又一日，获一盗席者至，官又问，师曰：朝闻道夕，死可以。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-79",
    "text": "主人问何言？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-80",
    "text": "还臭得正路。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-81",
    "text": "妇曰：倒好笑，我活了六十八岁，并不闻老鼠会偷盐吃。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-82",
    "text": "答云：就是令爱。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-83",
    "text": "孔子下阶，鞠躬致敬而言曰：吾道甚大，何必相同。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-84",
    "text": "相掺和，酿七日，便成酒。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-85",
    "text": "明日当对县官说，追你度牒。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-86",
    "text": "及出，仍遇此友，问如前。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-87",
    "text": "其人睨视良久，曰：咦，我自吃的狗肉，想必狗曾吃糠来。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-88",
    "text": "因名曰笑话。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-89",
    "text": "当者索银，答曰：省得称来称去，费坏许多手脚。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-90",
    "text": "官即将盗席者立毙杖下。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-91",
    "text": "师曰：自愧幼时不学耳！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-92",
    "text": "聋、哑二人各欲自讳。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-93",
    "text": "一母生一子一女，而女尤钟爱。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-94",
    "text": "又问：他为甚与这面生人同坐？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-95",
    "text": "二位老先生皆真正道学，丘素所钦仰，岂有伪哉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-96",
    "text": "讹诈得财，蜀人谓之敲钉锤。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-97",
    "text": "一广文善敲钉锤，见一生员在泮池旁出小恭，上前扭住吓之曰：尔身列学门，擅在泮池解手，无礼已极。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-98",
    "text": "饬门斗：押至明伦堂重惩，为大不敬者戒。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-99",
    "text": "广文云：好在是出小恭，若是出大恭，定罚银十两。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-100",
    "text": "小恭五两可也。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-101",
    "text": "一日聋见哑者，恳其唱曲，哑者知其聋也，乃以嘴唇开合而手拍板作按节状，聋者侧听良久。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-102",
    "text": "及遣嫁后，思念不已，谓其子曰：人家再不要养女儿，养得这般长成，就如被饿老鹰轻轻一爪便抓去了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-103",
    "text": "两人各大喜而退。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-104",
    "text": "其人善忘，归而用水二斗，曲一两，相掺和，七日而尝之，犹水也，乃往诮酒家，谓不传与真法。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-105",
    "text": "以吃酒对，友诘之：酒热吃乎冷吃乎？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-106",
    "text": "富儿才当饮啖，闲汉毕集。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-107",
    "text": "三人年长无事，俱命入山打柴，及归，夫问曰：三子之柴孰多？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-108",
    "text": "广文云：何必分，全给了我就是了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-109",
    "text": "见其唇住即大赞曰：妙绝妙绝，许久不听佳音，今日一发更进了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-110",
    "text": "有新妇拜堂，即产下一儿。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-111",
    "text": "一医久无生意，忽有求药者至。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-112",
    "text": "孔子曰：此辈人哄得他动身就够，惹他怎么！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-113",
    "text": "又问：尊号？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-114",
    "text": "和尚做功德回，遇虎，惧甚，以铙钹一片击之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-115",
    "text": "既归，而妻知之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-116",
    "text": "荒岁闲汉无处活口，值官府于玄妙观施粥，闲汉私议曰：我等平昔鲜衣美食，今往吃，必贻人笑。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-117",
    "text": "有势利者，每出逢冠盖，必引避。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-118",
    "text": "待你取赎时，只将利银来交便了。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-119",
    "text": "适冥王私行，察访得实，即命鬼判拿来，痛骂曰：什么都不懂的畜生！",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-120",
    "text": "生员说：老师讲明，小恭五两，因何又要十两？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-121",
    "text": "一耳聋人探友。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-122",
    "text": "婆愧甚，急取藏之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-123",
    "text": "开箱取药，中多蛀虫。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-124",
    "text": "一儒生，每作文字谒先辈。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-125",
    "text": "又问：尊居？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-126",
    "text": "复至，再投一片，亦如之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-127",
    "text": "一富人酷嗜古董，而不辨真假。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-128",
    "text": "俄延久之，无奈腹中饿甚，曰：姑待众饥民吃过，尾其后可也。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-129",
    "text": "偶逢一乞丐，亦效其引避，曰：舍亲。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-130",
    "text": "有以淡酒宴客者。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-131",
    "text": "你骗人馆谷，误人子弟，其罪不小，谪往轮回去变猪狗。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-132",
    "text": "千万不可与外人说，恐坏了我的学规。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-133",
    "text": "犬见之吠声不绝。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-134",
    "text": "有婚家女富男贫，男家虑其赖婚，率领众人抢亲，误背小姨以出。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-135",
    "text": "人问此是何物？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-136",
    "text": "某日，有友人之子结婚。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-137",
    "text": "穴中母虎问故。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-138",
    "text": "或伪以虞舜所造漆碗，周公挞伯禽之杖，与孔子杏坛所从之席求售，各以千金得之。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-139",
    "text": "远望人散而往，则粥已尽矣，乃以指拉食釜杓间余粥。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-140",
    "text": "问：为何有此令亲？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "讥刺部第十"
  },
  {
    "id": "xlgj-141",
    "text": "客尝之，极赞府上烹调之美。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  },
  {
    "id": "xlgj-142",
    "text": "山东人慕南方大桥，不辞远道来看。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "谬误部第十二"
  },
  {
    "id": "xlgj-143",
    "text": "有悍妻者，颇知书。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "古艳部第一"
  },
  {
    "id": "xlgj-144",
    "text": "其人茫然不觉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "形体第二"
  },
  {
    "id": "xlgj-145",
    "text": "快走上些，莫信他哄你哩。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "闺风部第三"
  },
  {
    "id": "xlgj-146",
    "text": "又问：僵蚕如何是活的？",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "术业部第四"
  },
  {
    "id": "xlgj-147",
    "text": "晓岚携了礼物一样去吃喜酒。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "腐流部第五"
  },
  {
    "id": "xlgj-148",
    "text": "某甲性迂拙，一日出外省戚，适门外有一车，与他讲价，因嫌价贵，宁愿步行，拟在中途雇车，价必稍廉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "殊禀部第六"
  },
  {
    "id": "xlgj-149",
    "text": "有素不信佛事者，死后坐罪甚重。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "僧道部第七"
  },
  {
    "id": "xlgj-150",
    "text": "囊资既空，乃左执虞舜之碗，右持周公之杖，身披孔子之席，而行乞于市。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贫窭部第八"
  },
  {
    "id": "xlgj-151",
    "text": "苏州人极奉承大老官，平日常谓主人曰：要小子替死，亦所甘心。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "世讳部第九"
  },
  {
    "id": "xlgj-152",
    "text": "主人自食大鱼，却烹小鱼供宾，误遗大鱼眼珠于盘，为客所觉。",
    "source": "《笑林广记》",
    "book": "笑林广记",
    "chapter": "贪吝部第十一"
  }
]