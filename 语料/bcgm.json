[
  {
    "id": "bcgm-1",
    "text": "纪称：望龙光，知古剑；觇宝气，辨明珠。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "原序第一"
  },
  {
    "id": "bcgm-2",
    "text": "气有多少，形有盛衰，治有缓急，方有大小。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "序例第二"
  },
  {
    "id": "bcgm-3",
    "text": "防风：凡腰痛项强，不可回头，乃手足太阳症，必须用此。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "主治第一"
  },
  {
    "id": "bcgm-4",
    "text": "在秋露重的时候，早晨去花草间收取。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "露水第一"
  },
  {
    "id": "bcgm-5",
    "text": "亦称方诸水。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "明水第二"
  },
  {
    "id": "bcgm-6",
    "text": "取霜法：用鸡毛扫取，装入瓶中，密封保存于阴凉处，虽成水液，历久不坏。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "冬霜第三"
  },
  {
    "id": "bcgm-7",
    "text": "粟米煮熟后，放在冷水里，浸五、六天，味变酸，面上生白花，取水作药用。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "浆水第四"
  },
  {
    "id": "bcgm-8",
    "text": "取雪法：用鸡毛扫取，装入瓶中，密封保存于阴凉处，虽成水液，历久不坏。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "腊雪第五"
  },
  {
    "id": "bcgm-9",
    "text": "甘、冷、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "夏冰第六"
  },
  {
    "id": "bcgm-10",
    "text": "亦称上池水。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "半天河第七"
  },
  {
    "id": "bcgm-11",
    "text": "亦名百沸汤、麻沸汤、太和汤。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "热汤第八"
  },
  {
    "id": "bcgm-12",
    "text": "亦名劳水、甘烂水、扬泛水。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "流水第九"
  },
  {
    "id": "bcgm-13",
    "text": "甘、微寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "井泉水第十"
  },
  {
    "id": "bcgm-14",
    "text": "泉水略有淡酒味。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "醴泉第十一"
  },
  {
    "id": "bcgm-15",
    "text": "掘地，达到黄土层，约三尺深，用新汲水灌入，搅浊，等水沉清后，取消水用。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "地浆第十二"
  },
  {
    "id": "bcgm-16",
    "text": "亦名温泉、沸泉。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "温汤第十三"
  },
  {
    "id": "bcgm-17",
    "text": "煮盐初熟时，槽中沥下来的一种黑色浓汁。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "盐胆水第十四"
  },
  {
    "id": "bcgm-18",
    "text": "阿井在今兖州阳谷县，即古东阿县也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "阿井泉第十五"
  },
  {
    "id": "bcgm-19",
    "text": "咸、平、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "雨水第十六"
  },
  {
    "id": "bcgm-20",
    "text": "金门记云：五月五日午时有雨，急伐竹竿。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "神水第十七"
  },
  {
    "id": "bcgm-21",
    "text": "咸、小温、有小毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "碧海水第十八"
  },
  {
    "id": "bcgm-22",
    "text": "此山岩土石间所出泉，流为溪涧者也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "山岩泉水第十九"
  },
  {
    "id": "bcgm-23",
    "text": "降注雨水谓之潦，又淫雨为潦。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "潦水第二十"
  },
  {
    "id": "bcgm-24",
    "text": "一年二十四节气，一节主半月，水之气味，随之变迁，此乃天地之气候相感，又非疆域之限也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "节气水第二十一"
  },
  {
    "id": "bcgm-25",
    "text": "辙，乃车行迹也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "车辙中水第二十二"
  },
  {
    "id": "bcgm-26",
    "text": "此乃作黄齑菜水也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "齑水第二十三"
  },
  {
    "id": "bcgm-27",
    "text": "太平圣惠方曰：病后劳复，或因梳头，或食物复发，取一合饮之，效。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "洗手足水第二十四"
  },
  {
    "id": "bcgm-28",
    "text": "延年秘录曰：胎衣不下，服一盏，勿令知之。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "洗儿汤第二十五"
  },
  {
    "id": "bcgm-29",
    "text": "李时珍对该药未作释名和集解，而在其附方项下转引前人吴球的活人心统曰：耳中卒痛，磨刀铁浆，滴入即愈。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "磨刀水第二十七"
  },
  {
    "id": "bcgm-30",
    "text": "李时珍在该药发明项下曰：蓝水、染布水，皆取蓝及石灰能杀虫解毒之义。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "浸蓝水第二十八"
  },
  {
    "id": "bcgm-31",
    "text": "炭能生火，但治病用的是炭或炭灰，并不是直接用炭火。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "炭火第一"
  },
  {
    "id": "bcgm-32",
    "text": "艾火可灸治许多病。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "艾火第二"
  },
  {
    "id": "bcgm-33",
    "text": "把桃树枝削成针状，如鸡蛋大，长五、六寸，放干待用。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "神灯火第三"
  },
  {
    "id": "bcgm-34",
    "text": "亦名燔针、淬针、烧针、煨针。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "针火第四"
  },
  {
    "id": "bcgm-35",
    "text": "宜煎一切滋补药。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "芦火第六"
  },
  {
    "id": "bcgm-36",
    "text": "痈疽发背不起，瘀肉不腐，燃火吹灭，日炙二次。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "桑柴火第七"
  },
  {
    "id": "bcgm-37",
    "text": "亦名白善土、白土粉、画粉。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "白垩第一"
  },
  {
    "id": "bcgm-38",
    "text": "入地三尺以下的黄土，勿沾污物，可作药。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "黄土第二"
  },
  {
    "id": "bcgm-39",
    "text": "古旧房屋东边墙上的土，叫东壁土。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "东壁土第三"
  },
  {
    "id": "bcgm-40",
    "text": "指煅铁炉中的灰，含有铁的作用。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "锻灶灰第四"
  },
  {
    "id": "bcgm-41",
    "text": "胡燕窠土，就是屋梁上构成胡燕窝的土。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "胡燕窠土第五"
  },
  {
    "id": "bcgm-42",
    "text": "巢，即细腰蜂巢。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "土蜂窠第六"
  },
  {
    "id": "bcgm-43",
    "text": "蜣螂，俗称推屎虫。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "蜣螂转丸第七"
  },
  {
    "id": "bcgm-44",
    "text": "辛、寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石碱第八"
  },
  {
    "id": "bcgm-45",
    "text": "垤，音迭，土堆之意。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "蚁垤土第九"
  },
  {
    "id": "bcgm-46",
    "text": "用松土上的白蚁泥，同黄丹一起炒，炒黑后，研细，和香油涂搽恶疮肿毒，有效。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "白蚁泥第十"
  },
  {
    "id": "bcgm-47",
    "text": "亦名蚓蝼、六一泥、蚯蚓粪、地龙粪。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "蚯蚓泥第十一"
  },
  {
    "id": "bcgm-48",
    "text": "指古屋里的倒挂尘，亦名乌龙尾、烟珠。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "梁上尘第十二"
  },
  {
    "id": "bcgm-49",
    "text": "亦名孩儿茶、乌垒泥。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "乌爹泥第十三"
  },
  {
    "id": "bcgm-50",
    "text": "指灶里正对锅底的黄土，亦名灶心土。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "伏龙肝第十四"
  },
  {
    "id": "bcgm-51",
    "text": "这是烧石灰窑中流结的土渣。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "土墼第十五"
  },
  {
    "id": "bcgm-52",
    "text": "木柴灶的灶门口，外额上，是烟火从灶里出来的必经之路。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "百草霜第十六"
  },
  {
    "id": "bcgm-53",
    "text": "用定州白瓷细末，吹少计入鼻，血立止。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "白瓷器第十七"
  },
  {
    "id": "bcgm-54",
    "text": "甘、寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "乌古瓦第十八"
  },
  {
    "id": "bcgm-55",
    "text": "用烧红的砖放入陈臭的淘米水中渍过，趁热布包，两膝夹住，上盖棉被，三、五次可愈。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "古砖第十九"
  },
  {
    "id": "bcgm-56",
    "text": "此乃熏消牛皮灶上及烧瓦窑上黑土也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "烟胶第二十"
  },
  {
    "id": "bcgm-57",
    "text": "亦称釜月中墨、铛墨、釜煤、釜、锅底墨。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "釜脐墨第二十一"
  },
  {
    "id": "bcgm-58",
    "text": "亦名乌金、陈玄、玄香、乌玉块。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "墨第二十二"
  },
  {
    "id": "bcgm-59",
    "text": "跌扑金刃伤损，罨之，止血生肌。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "香炉灰第二十三"
  },
  {
    "id": "bcgm-60",
    "text": "止金疮出血。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "门臼尘第二十四"
  },
  {
    "id": "bcgm-61",
    "text": "沙土埏埴烧成者。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "砂锅第二十五"
  },
  {
    "id": "bcgm-62",
    "text": "吴人收瓷器屑，碓舂为末，筛澄取粉，呼为滓粉，用胶水和剂作锅，以销金银者。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "甘锅第二十六"
  },
  {
    "id": "bcgm-63",
    "text": "马蝗入人耳，取一盆枕耳边，闻气自出。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "田中泥第二十七"
  },
  {
    "id": "bcgm-64",
    "text": "肘后方曰：蝎虿螫叮。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "檐溜下泥第二十八"
  },
  {
    "id": "bcgm-65",
    "text": "圣济总录曰：丁肿。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "粪坑底泥第二十九"
  },
  {
    "id": "bcgm-66",
    "text": "主蜂蝎诸虫咬，取涂之。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "尿坑泥第三十"
  },
  {
    "id": "bcgm-67",
    "text": "主治妊娠伤寒，令子不落，涂腹上，干即易。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "犬尿泥第三十一"
  },
  {
    "id": "bcgm-68",
    "text": "主治火带疮。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "白鳝泥第三十二"
  },
  {
    "id": "bcgm-69",
    "text": "甘，温，无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "赤土第三十三"
  },
  {
    "id": "bcgm-70",
    "text": "医学正传曰：人家动土犯禁，主小儿病气喘，但按九宫，看太阳在何宫，取其土煎汤饮之，喘即定。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "太阳土第三十四"
  },
  {
    "id": "bcgm-71",
    "text": "此人家行步地上高起土也，乃人往来鞋履沾积而成者。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "千步峰第三十五"
  },
  {
    "id": "bcgm-72",
    "text": "本草拾遗曰：好魇多梦，烧人灰，置枕中、履中，自止。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "烧尸场上土第三十六"
  },
  {
    "id": "bcgm-73",
    "text": "反胃吐食，取螺蛳一斗，水浸，取泥晒干，每服一钱，火酒调下。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "螺蛳泥第三十七"
  },
  {
    "id": "bcgm-74",
    "text": "辛，平，有毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "金第一"
  },
  {
    "id": "bcgm-75",
    "text": "亦名白金、鋈。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "银第二"
  },
  {
    "id": "bcgm-76",
    "text": "亦或石髓铅。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "自然铜第三"
  },
  {
    "id": "bcgm-77",
    "text": "亦名汞粉、轻粉、峭粉、腻粉。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "水银粉第四"
  },
  {
    "id": "bcgm-78",
    "text": "亦名铜绿，即铜器上所生的绿色物。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铜青第五"
  },
  {
    "id": "bcgm-79",
    "text": "又名青金、黑锡、金公、水中金。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铅第六"
  },
  {
    "id": "bcgm-80",
    "text": "用铁锈粉敷扑。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铁锈第七"
  },
  {
    "id": "bcgm-81",
    "text": "释名亦名铅白霜。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铅霜第八"
  },
  {
    "id": "bcgm-82",
    "text": "亦名汞、灵液、姹女。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "水银第九"
  },
  {
    "id": "bcgm-83",
    "text": "即铅粉，又有解锡、铅华、定粉、瓦粉、光粉、水粉、白粉、官粉、胡粉等名。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "粉锡第十"
  },
  {
    "id": "bcgm-84",
    "text": "甘，平，无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "钢第十一"
  },
  {
    "id": "bcgm-85",
    "text": "亦名没多僧、炉底。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "密陀僧第十二"
  },
  {
    "id": "bcgm-86",
    "text": "又名白镴、贺。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "锡第十三"
  },
  {
    "id": "bcgm-87",
    "text": "亦名铁液、铁屑、铁蛾。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铁落第十四"
  },
  {
    "id": "bcgm-88",
    "text": "亦称黑金、乌金。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铁第十五"
  },
  {
    "id": "bcgm-89",
    "text": "出煅铁炉中，细如尘，以色紫质轻者为佳。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铁精第十七"
  },
  {
    "id": "bcgm-90",
    "text": "久服，肠中尽为金色。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "金浆第十八"
  },
  {
    "id": "bcgm-91",
    "text": "铜钴母，一作钴母，熨斗也。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "诸铜器第十九"
  },
  {
    "id": "bcgm-92",
    "text": "本草拾遗的有铁杵、铁刀、故锯、布针、铁钉等5种；大明本草的有钥匙、铁犁尖、马衔等三种；开宝本草的有铁秤锤、车辖2种。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "诸铁器第二十"
  },
  {
    "id": "bcgm-93",
    "text": "又名黄丹、丹粉、朱粉、铅华。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铅丹第一"
  },
  {
    "id": "bcgm-94",
    "text": "朱砂，辰砂，汞砂。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "丹砂第二"
  },
  {
    "id": "bcgm-95",
    "text": "亦名石亭脂、石硫丹、石硫芝。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石硫赤第三"
  },
  {
    "id": "bcgm-96",
    "text": "亦称硫磺、黄硇砂、黄牙、阳侯、将军。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石硫磺第四"
  },
  {
    "id": "bcgm-97",
    "text": "甘、平、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "玉第五"
  },
  {
    "id": "bcgm-98",
    "text": "近者奇之，远者偶之。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "序例第二"
  },
  {
    "id": "bcgm-99",
    "text": "李时珍对该药未作释名和集解，仅在其主治项下转引宋代王怀隐等人著的太平圣惠方曰：病后劳复，或因梳头，或食物复发，取一合饮之，效。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "洗手足水第二十四"
  },
  {
    "id": "bcgm-100",
    "text": "李时珍对该药未作释名和集解，仅在其主治项下转引前人的延年秘录曰：胎衣不下，服一盏，勿令知之。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "洗儿汤第二十五"
  },
  {
    "id": "bcgm-101",
    "text": "据考，我国古代常用铜壶装水滴漏计时。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "铜壶滴漏水第二十六"
  },
  {
    "id": "bcgm-102",
    "text": "蝎有雌雄，雄者痛在一处，以井底泥封之，干则易；雌者痛牵诸处，以瓦沟下泥封之。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "檐溜下泥第二十八"
  },
  {
    "id": "bcgm-103",
    "text": "粪下土、蝉蜕、全蝎等分，捣作钱大饼，香油煎滚，温服。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "粪坑底泥第二十九"
  },
  {
    "id": "bcgm-104",
    "text": "亦名鹏砂、盆砂。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "蓬砂第八"
  },
  {
    "id": "bcgm-105",
    "text": "亦名涅石、羽涅、羽泽；煅枯者名巴石，轻白者名柳絮矾。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "矾石第九"
  },
  {
    "id": "bcgm-106",
    "text": "亦名皂矾、青矾。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "绿矾第十"
  },
  {
    "id": "bcgm-107",
    "text": "黄矾出陕西瓜州、沙州及舶上来者为上，黄色，状如胡桐泪。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "黄矾第十一"
  },
  {
    "id": "bcgm-108",
    "text": "亦名砂、狄盐、北庭砂、气砂、透骨将军。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "硇砂第十二"
  },
  {
    "id": "bcgm-109",
    "text": "亦名水银霜、白雪、白灵砂。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "粉霜第十三"
  },
  {
    "id": "bcgm-110",
    "text": "亦名猩红、紫粉霜。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "银朱第十四"
  },
  {
    "id": "bcgm-111",
    "text": "亦名二气砂。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "灵砂第十五"
  },
  {
    "id": "bcgm-112",
    "text": "亦名硭硝、苦硝、焰硝、火硝、地霜、生硝、北帝玄珠。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "硝石第十六"
  },
  {
    "id": "bcgm-113",
    "text": "亦名黄金石、石黄、熏黄。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "雄黄第十七"
  },
  {
    "id": "bcgm-114",
    "text": "辛、平、有毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "雌黄第十八"
  },
  {
    "id": "bcgm-115",
    "text": "亦名细理石、寒水石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石膏第十九"
  },
  {
    "id": "bcgm-116",
    "text": "亦称白龙粉。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "玄明粉第二十"
  },
  {
    "id": "bcgm-117",
    "text": "亦名画石、液石、石、脱石、冷石、番石、共石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "滑石第二十一"
  },
  {
    "id": "bcgm-118",
    "text": "亦名无灰木。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "不灰木第二十二"
  },
  {
    "id": "bcgm-119",
    "text": "本品质似石而性粘，故名五脂。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "五色石脂第二十三"
  },
  {
    "id": "bcgm-120",
    "text": "苦、寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "朴硝第二十四"
  },
  {
    "id": "bcgm-121",
    "text": "亦名炉先生。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "炉甘石第二十五"
  },
  {
    "id": "bcgm-122",
    "text": "亦称留公乳、虚中、芦石、鹅管石、夏石、黄砂石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石钟乳第二十七"
  },
  {
    "id": "bcgm-123",
    "text": "亦名太乙玄精石、阴精石、玄英石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "玄精石第二十八"
  },
  {
    "id": "bcgm-124",
    "text": "亦名石油、石漆、猛火油、雄黄油、硫磺油。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石脑油第二十九"
  },
  {
    "id": "bcgm-125",
    "text": "亦称煤炭、石墨、铁炭、乌金石、焦石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石炭第三十"
  },
  {
    "id": "bcgm-126",
    "text": "亦名石垩、垩灰、希灰、煅石、白虎、矿灰。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "石灰第三十一"
  },
  {
    "id": "bcgm-127",
    "text": "亦名卤盐、寒石、石碱。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "凝水石第三十二"
  },
  {
    "id": "bcgm-128",
    "text": "亦名海石、水花。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "浮石第三十三"
  },
  {
    "id": "bcgm-129",
    "text": "亦名羊起名、白石、石生。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "阳起石第三十四"
  },
  {
    "id": "bcgm-130",
    "text": "亦名玄石、处石、铁石、吸针石。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "慈石第三十五"
  },
  {
    "id": "bcgm-131",
    "text": "亦名须丸、血师、土朱、铁朱。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "代赭石第三十七"
  },
  {
    "id": "bcgm-132",
    "text": "甘、酸、寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "空青第三十九"
  },
  {
    "id": "bcgm-133",
    "text": "咸、寒、无毒。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "戎盐第四十"
  },
  {
    "id": "bcgm-134",
    "text": "曾青，即层青。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "曾青第四十一"
  },
  {
    "id": "bcgm-135",
    "text": "亦名石绿、大绿。",
    "source": "《本草纲目》",
    "book": "本草纲目",
    "chapter": "绿青第四十二"
  }
]