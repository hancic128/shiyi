[
  {
    "id": "wz-1",
    "text": "吴起儒服，以兵机见魏文侯。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-2",
    "text": "武侯谓吴起曰：今秦胁吾西，楚带吾南，赵冲吾北，齐临吾东，燕绝吾后，韩居吾前，六国兵四守，势甚不便，忧此奈何？",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-3",
    "text": "起对曰：先明四轻、二重、一信。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-4",
    "text": "吴子曰：夫总文武者，军之将也，兼刚柔者，兵之事也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-5",
    "text": "吴起对曰：凡战之法，昼以旌旗幡麾为节，夜以金鼓笳笛为节。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-6",
    "text": "起对曰：严明之事，臣不能悉。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-7",
    "text": "文侯曰：寡人不好军旅之事。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-8",
    "text": "起对曰：夫安国家之道，先戒为宝。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-9",
    "text": "凡人论将，常观于勇，勇之于将，乃数分之一尔。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-10",
    "text": "麾左而左，麾右而右。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-11",
    "text": "虽然，非所恃也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-12",
    "text": "起曰：臣以见占隐，以往察来，主君何言与心违。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-13",
    "text": "今君已戒，祸其远矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-14",
    "text": "对曰：使地轻马，马轻车，车轻人，人轻战。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-15",
    "text": "夫勇者必轻合，轻合而不知利，未可也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-16",
    "text": "鼓之则进，金之则止。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-17",
    "text": "夫发号布令而人乐闻，兴师动众而人乐战，交兵接刃而人乐死。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-18",
    "text": "今君四时使斩离皮革，掩以朱漆，画以丹青，烁以犀象。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-19",
    "text": "臣请论六国之俗：夫齐陈重而不坚，秦陈散而自斗，楚陈整而不久，燕陈守而不走，三晋陈治而不用。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-20",
    "text": "明知阴阳险易，则地轻马；刍秣以时，则马轻车；膏锏有余，则车轻人；锋锐甲坚，则人轻战。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-21",
    "text": "故将之所慎者五：一曰理，二曰备，三曰果，四曰戒，五曰约。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-22",
    "text": "一吹而行，再吹而聚。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-23",
    "text": "此三者，人主之所恃也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-24",
    "text": "冬日衣之则不温，夏日衣之则不凉。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-25",
    "text": "夫齐性刚，其国富，君臣骄奢而简于细民，其政宽而禄不均，一陈两心，前重后轻，故重而不坚。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-26",
    "text": "进有重赏，退有重刑，行之以信。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-27",
    "text": "理者，治众如治寡；备者，出门如见敌；果者，临敌不怀生；戒者，虽克如始战；约者，法令省而不烦。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-28",
    "text": "不从令者诛。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-29",
    "text": "武侯曰：致之奈何？",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-30",
    "text": "以长戟二丈四尺，短戟一丈二尺。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-31",
    "text": "击此之道，必三分之，猎其左右，胁而从之，其陈可坏。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-32",
    "text": "令制远审能达此，胜之主也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-33",
    "text": "受命而不辞，敌破而后言返，将之礼也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-34",
    "text": "三军服威，士卒用命，则战无强敌，攻无坚陈矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-35",
    "text": "起对曰：君举有功而进飨之，无功而励之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-36",
    "text": "革车奄户，缦轮笼毂，观之于目则不丽，乘之以田则不轻，不识主君安用此也？",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-37",
    "text": "秦性强，其地险，其政严，其赏罚信，其人不让，皆有斗心，故散而自战。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-38",
    "text": "起对曰：以治为胜。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-39",
    "text": "故师出之日，有死之荣，无生之辱。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-40",
    "text": "起对曰：避之于易，邀之于阨。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-41",
    "text": "于是武侯设坐庙廷，为三行，飨士大夫。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-42",
    "text": "昔承桑氏之君，修德废武，以灭其国；有扈氏之君，恃众好勇，以丧其社稷。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-43",
    "text": "击此之道，必先示之以利而引去之，士贪于得而离其将，乘乖猎散，设伏投机，其将可取。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-44",
    "text": "对曰：若法令不明，赏罚不信，金之不止，鼓之不进，虽有百万，何益于用？",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-45",
    "text": "吴子曰：凡兵有四机：一曰气机，二曰地机，三曰事机，四曰力机。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-46",
    "text": "故曰：以一击十，莫善于阨；以十击百，莫善于险；以千击万，莫善于阻。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-47",
    "text": "上功坐前行，肴席兼重器、上牢；次功坐中行，肴席器差减；无功坐后行，肴席无重器。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-48",
    "text": "明主鉴兹，必内修文德，外治武备。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-49",
    "text": "楚性弱，其地广，其政骚，其民疲，故整而不久。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-50",
    "text": "所谓治者，居则有礼，动则有威，进不可挡，退不可追，前却有节，左右应麾，虽绝成陈，虽散成行。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-51",
    "text": "三军之众，百万之师，张设轻重，在于一人，是谓气机。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-52",
    "text": "今有少卒，卒起击金鼓于阨路，虽有大众，莫不惊动。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-53",
    "text": "飨毕而出，又颁赐有功者父母妻子于庙门外，亦以功为差。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-54",
    "text": "故当敌而不进，无逮于义也；僵尸而哀之，无逮于仁也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-55",
    "text": "击此之道，袭乱其屯，先夺其气，轻进速退，弊而劳之，勿与战争，其军可败。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-56",
    "text": "与之安，与之危，其众可合而不可离，可用而不可疲，投之所往，天下莫当，名曰父子之兵。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-57",
    "text": "路狭道险，名山大塞，十夫所守，千夫不过，是谓地机。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-58",
    "text": "故曰：用众者务易，用少者务隘。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-59",
    "text": "有死事之家，岁被使者劳赐其父母，著不忘于心。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-60",
    "text": "于是文侯身自布席，夫人捧觞，醮吴起于庙，立为大将，守西河。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-61",
    "text": "燕性悫，其民慎，好勇义，寡诈谋，故守而不走。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-62",
    "text": "吴子曰：凡行军之道，无犯进止之节，无失饮食之适，无绝人马之力。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-63",
    "text": "善行间谍，轻兵往来，分散其众，使其君臣相怨，上下相咎，是为事机。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-64",
    "text": "起对曰：大哉问乎！",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-65",
    "text": "行之三年，秦人兴师，临于西河。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-66",
    "text": "与诸侯大战七十六，全胜六十四，余则钧解。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-67",
    "text": "击此之道，触而迫之，陵而远之，驰而后之，则上疑而下惧，谨我车骑必避之路，其将可虏。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-68",
    "text": "此三者，所以任其上令，任其上令，则治之所由生也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-69",
    "text": "车坚管辖，舟利橹楫，士习战陈，马闲驰逐，是谓力机。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-70",
    "text": "此非车骑之力，圣人之谋也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-71",
    "text": "魏士闻之，不待吏令，介胄而奋击之者以万数。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-72",
    "text": "辟土四面，拓地千里，皆起之功也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-73",
    "text": "三晋者，中国也，其性和，其政平，其民疲于战，习于兵，轻其将，薄其禄，士无死志，故治而不用。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-74",
    "text": "吴子曰：凡兵战之场，立尸之地，必死则生，幸生则死。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-75",
    "text": "知此四者，乃可为将。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-76",
    "text": "能备千乘万骑，兼之徒步，分为五军，各军一衢。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-77",
    "text": "武侯召吴起而谓曰：子前日之教行矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-78",
    "text": "吴子曰：昔之图国家者，必先教百姓而亲万民。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-79",
    "text": "击此之道，阻陈而压之，众来则拒之，去则追之，以倦其师。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-80",
    "text": "其善将者，如坐漏船之中，伏烧屋之下，使智者不及谋，勇者不及怒，受敌可也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-81",
    "text": "然其威、德、仁、勇，必足以率下安众，怖敌决疑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-82",
    "text": "夫五军五衢，敌人必惑，莫之所加。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-83",
    "text": "起对曰：臣闻人有短长，气有盛衰。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-84",
    "text": "有四不和：不和于国，不可以出军；不和于军，不可以出陈；不和于陈，不可以进战；不和于战，不可以决胜。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-85",
    "text": "然则一军之中，必有虎贲之士，力轻扛鼎，足轻戎马，搴旗斩将，必有能者。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-86",
    "text": "故曰：用兵之害，犹豫最大，三军之灾，生于狐疑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-87",
    "text": "施令而下不敢犯，所在而寇不敢敌。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-88",
    "text": "敌人若坚守以固其兵，急行间谍以观其虑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-89",
    "text": "君试发无功者五万人，臣请率以当之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-90",
    "text": "是以有道之主，将用其民，先和而造大事。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-91",
    "text": "其有工用五兵、材力健疾、志在吞敌者，必加其爵列，可以决胜。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-92",
    "text": "吴子曰：夫人当常死其所不能，败其所不便。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-93",
    "text": "得之国强，去之国亡。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-94",
    "text": "彼听吾说，解之而去；不听吾说，斩使焚书。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-95",
    "text": "脱其不胜，取笑于诸侯，失权于天下矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-96",
    "text": "不敢信其私谋，必告于祖庙，启于元龟，参之天时，吉乃后举。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-97",
    "text": "厚其父母妻子，劝赏畏罚，此坚陈之士，可与持久，能审料此，可以击倍。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-98",
    "text": "故用兵之法：教戎为先。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-99",
    "text": "吴子曰：夫鼙鼓金铎，所以威耳；旌旗麾帜，所以威目；禁令刑罚，所以威心。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-100",
    "text": "一人学战，教成十人；十人学战，教成百人；百人学战，教成千人；千人学战，教成万人；万人学战，教成三军。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-101",
    "text": "以近待远，以佚待劳，以饱待饥。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-102",
    "text": "圆而方之，坐而起之，行而止之，左而右之，前而后之，分而合之，结而解之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-103",
    "text": "分为五战，战胜勿追，不胜疾归。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-104",
    "text": "今使一死贼伏于旷野，千人追之，莫不枭视狼顾。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-105",
    "text": "每变皆习，乃授其兵。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-106",
    "text": "五军交至，必有其利，此击强之道也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-107",
    "text": "忌其暴起而害己。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-108",
    "text": "乡里相比，什伍相保。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-109",
    "text": "审察其政，乱则击之无疑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-110",
    "text": "是以一人投命，足惧千夫。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-111",
    "text": "民知君之爱其命，惜其死，若此之至，而与之临难，则士以尽进死为荣，退生为辱矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-112",
    "text": "一鼓整兵，二鼓习陈，三鼓趋食，四鼓严辩，五鼓就行。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-113",
    "text": "三者不立，虽有其国，必败于敌。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-114",
    "text": "募吾材士与敌相当，轻足利兵以为前行，分车列骑隐于四旁，相去数里，无见其兵，敌必坚陈，进退不敢。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-115",
    "text": "今臣以五万之众，而为以四贼，率以讨之，固难敌矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-116",
    "text": "是以圣人绥之以道，理之以义，动之以礼，抚之以仁。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-117",
    "text": "诸如此者，击之无疑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-118",
    "text": "闻鼓声合，然后举旗。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-119",
    "text": "其将愚而信人，可诈而诱。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-120",
    "text": "于是出旌列旆，行出山外营之，敌人必惧。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-121",
    "text": "于是武侯从之，兼车五百乘，骑三千匹，而破秦五十万众，此励士之功也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-122",
    "text": "此四德者，修之则兴，废之则衰，故成汤讨桀而夏民喜悦，周武伐纣而殷人不非。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-123",
    "text": "有不占而避之者六。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-124",
    "text": "天灶者，大谷之口；龙头者，大山之端。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-125",
    "text": "贪而忽名，可货而赂。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-126",
    "text": "车骑挑之，勿令得休。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-127",
    "text": "先战一日，吴起令三军曰：诸吏士当从受敌。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-128",
    "text": "举顺天人，故能然矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-129",
    "text": "凡此不如敌人，避之勿疑。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-130",
    "text": "必左青龙，右白虎，前朱雀，后玄武。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-131",
    "text": "轻变无谋，可劳而困。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-132",
    "text": "此谷战之法也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-133",
    "text": "车骑与徒，若车不得车，骑不得骑，徒不得徒，虽破军皆无功。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-134",
    "text": "夫人有耻，在大足以战，在小足以守矣。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-135",
    "text": "所谓见可而进，知难而退也。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-136",
    "text": "招摇在上，从事于下。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-137",
    "text": "上富而骄，下贫而怨，可离而间。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-138",
    "text": "登高四望，必得水情，知其广狭，尽其浅深，乃可为奇以胜之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-139",
    "text": "故战之日，其令不烦而威震天下。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "励士第六"
  },
  {
    "id": "wz-140",
    "text": "然战胜易，守胜难。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  },
  {
    "id": "wz-141",
    "text": "武侯问敌必可击之道。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "料敌第二"
  },
  {
    "id": "wz-142",
    "text": "将战之时，审候风所从来，风顺致呼而从之，风逆坚陈以待之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "治兵第三"
  },
  {
    "id": "wz-143",
    "text": "进退多疑，其众无依，可震而走。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "论将第四"
  },
  {
    "id": "wz-144",
    "text": "敌若绝水，半渡而薄之。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "应变第五"
  },
  {
    "id": "wz-145",
    "text": "是以数胜得天下者稀，以亡者众。",
    "source": "《吴子》",
    "book": "吴子",
    "chapter": "图国第一"
  }
]