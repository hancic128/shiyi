[
  {
    "id": "lj-1",
    "text": "敖不可长，欲不可从，志不可满，乐不可极。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼上第一"
  },
  {
    "id": "lj-2",
    "text": "凡奉者当心，提者当带。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼下第二"
  },
  {
    "id": "lj-3",
    "text": "公仪仲子之丧，檀弓免焉。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓上第三"
  },
  {
    "id": "lj-4",
    "text": "君之适长殇，车三乘；公之庶长殇，车一乘；大夫之适长殇，车一乘。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓下第四"
  },
  {
    "id": "lj-5",
    "text": "王者之制禄爵，公侯伯子男，凡五等。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "王制第五"
  },
  {
    "id": "lj-6",
    "text": "孟春之月，日在营室，昏参中，旦尾中。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "月令第六"
  },
  {
    "id": "lj-7",
    "text": "孔子曰：卿、大夫、士从摄主，北面，于西阶南。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曾子问第七"
  },
  {
    "id": "lj-8",
    "text": "文王之为世子，朝于王季，日三。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "文王世子第八"
  },
  {
    "id": "lj-9",
    "text": "昔者仲尼与于蜡宾，事毕，出游于观之上，喟然而叹。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼运第九"
  },
  {
    "id": "lj-10",
    "text": "礼器是故大备。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼器第十"
  },
  {
    "id": "lj-11",
    "text": "郊特牲，而社稷大牢。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "郊特牲第十一"
  },
  {
    "id": "lj-12",
    "text": "后王命冢宰，降德于众兆民。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "内则第十二"
  },
  {
    "id": "lj-13",
    "text": "天子玉藻，十有二旒，前后邃延，龙卷以祭。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "玉藻第十三"
  },
  {
    "id": "lj-14",
    "text": "昔者周公朝诸侯于明堂之位：天子负斧依南乡而立；三公，中阶之前，北面东上。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "明堂位第十四"
  },
  {
    "id": "lj-15",
    "text": "斩衰：括发以麻。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧服小记第十五"
  },
  {
    "id": "lj-16",
    "text": "礼：不王不禘。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "大传第十六"
  },
  {
    "id": "lj-17",
    "text": "闻始见君子者，辞曰：某固愿闻名于将命者。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "少仪第十七"
  },
  {
    "id": "lj-18",
    "text": "发虑宪，求善良，足以𫍲闻，不足以动众；就贤体远，足以动众，未足以化民。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "学记第十八"
  },
  {
    "id": "lj-19",
    "text": "凡音之起，由人心生也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "乐记第十九"
  },
  {
    "id": "lj-20",
    "text": "诸侯行而死于馆，则其复如于其国。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记上第二十"
  },
  {
    "id": "lj-21",
    "text": "有父之丧，如未没丧而母死，其除父之丧也，服其除服。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记下第二十一"
  },
  {
    "id": "lj-22",
    "text": "疾病，外内皆扫。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧大记第二十二"
  },
  {
    "id": "lj-23",
    "text": "祭法：有虞氏禘黄帝而郊喾，祖颛顼而宗尧。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭法第二十三"
  },
  {
    "id": "lj-24",
    "text": "祭不欲数，数则烦，烦则不敬。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭义第二十四"
  },
  {
    "id": "lj-25",
    "text": "凡治人之道，莫急于礼。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭统第二十五"
  },
  {
    "id": "lj-26",
    "text": "孔子曰：入其国，其教可知也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "经解第二十六"
  },
  {
    "id": "lj-27",
    "text": "君子之言礼，何其尊也？",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "哀公问第二十七"
  },
  {
    "id": "lj-28",
    "text": "仲尼燕居，子张、子贡、言游侍，纵言至于礼。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "仲尼燕居第二十八"
  },
  {
    "id": "lj-29",
    "text": "孔子闲居，子夏侍。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "孔子闲居第二十九"
  },
  {
    "id": "lj-30",
    "text": "子言之：君子之道，辟则坊与，坊民之所不足者也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "坊记第三十"
  },
  {
    "id": "lj-31",
    "text": "天命之谓性，率性之谓道，修道之谓教。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "中庸第三十一"
  },
  {
    "id": "lj-32",
    "text": "子言之：归乎！",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "表记第三十二"
  },
  {
    "id": "lj-33",
    "text": "’子曰：夫民，教之以德，齐之以礼，则民有格心；教之以政，齐之以刑，则民有遁心。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "缁衣第三十三"
  },
  {
    "id": "lj-34",
    "text": "奔丧之礼：始闻亲丧，以哭答使者，尽哀；问故，又哭尽哀。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "奔丧第三十四"
  },
  {
    "id": "lj-35",
    "text": "亲始死，鸡斯徒跣，扱上衽，交手哭。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "问丧第三十五"
  },
  {
    "id": "lj-36",
    "text": "有从重而轻，为妻之父母。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "服问第三十六"
  },
  {
    "id": "lj-37",
    "text": "斩衰何以服苴？",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "间传第三十七"
  },
  {
    "id": "lj-38",
    "text": "三年之丧何也？",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "三年问第三十八"
  },
  {
    "id": "lj-39",
    "text": "古者深衣，盖有制度，以应规、矩、绳、权、衡。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "深衣第三十九"
  },
  {
    "id": "lj-40",
    "text": "投壶之礼，主人奉矢，司射奉中，使人执壶。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "投壶第四十"
  },
  {
    "id": "lj-41",
    "text": "丘闻之也：君子之学也博，其服也乡；丘不知儒服。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "儒行第四十一"
  },
  {
    "id": "lj-42",
    "text": "大学之道，在明明德，在亲民，在止于至善。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "大学第四十二"
  },
  {
    "id": "lj-43",
    "text": "凡人之所以为人者，礼义也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "冠义第四十三"
  },
  {
    "id": "lj-44",
    "text": "昏礼者，将合二姓之好，上以事宗庙，而下以继后世也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "昏义第四十四"
  },
  {
    "id": "lj-45",
    "text": "乡饮酒之义：主人拜迎宾于庠门之外，入，三揖而后至阶，三让而后升，所以致尊让也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "乡饮酒义第四十五"
  },
  {
    "id": "lj-46",
    "text": "古者诸侯之射也，必先行燕礼；卿、大夫、士之射也，必先行乡饮酒之礼。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "射义第四十六"
  },
  {
    "id": "lj-47",
    "text": "古者周天子之官，有庶子官。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "燕义第四十七"
  },
  {
    "id": "lj-48",
    "text": "聘礼，上公七介，侯、伯五介，子、男三介，所以明贵贱也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "聘义第四十八"
  },
  {
    "id": "lj-49",
    "text": "凡礼之大体，体天地，法四时，则阴阳，顺人情，故谓之礼。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧服四制第四十九"
  },
  {
    "id": "lj-50",
    "text": "贤者狎而敬之，畏而爱之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼上第一"
  },
  {
    "id": "lj-51",
    "text": "执天子之器则上衡，国君则平衡，大夫则绥之，士则提之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼下第二"
  },
  {
    "id": "lj-52",
    "text": "仲子舍其孙而立其子，檀弓曰：何居？",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓上第三"
  },
  {
    "id": "lj-53",
    "text": "公之丧，诸达官之长，杖。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓下第四"
  },
  {
    "id": "lj-54",
    "text": "诸侯之上大夫卿，下大夫，上士中士下士，凡五等。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "王制第五"
  },
  {
    "id": "lj-55",
    "text": "其帝大皞，其神句芒。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "月令第六"
  },
  {
    "id": "lj-56",
    "text": "大祝裨冕，执束帛，升自西阶尽等，不升堂，命毋哭。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曾子问第七"
  },
  {
    "id": "lj-57",
    "text": "鸡初鸣而衣服，至于寝门外，问内竖之御者曰：今日安否何如？",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "文王世子第八"
  },
  {
    "id": "lj-58",
    "text": "仲尼之叹，盖叹鲁也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼运第九"
  },
  {
    "id": "lj-59",
    "text": "大备，盛德也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼器第十"
  },
  {
    "id": "lj-60",
    "text": "天子适诸侯，诸侯膳用犊；诸侯适天子，天子赐之礼大牢；贵诚之义也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "郊特牲第十一"
  },
  {
    "id": "lj-61",
    "text": "子事父母，鸡初鸣，咸盥漱，栉𫄳笄总，拂髦冠緌缨，端𫖒绅，搢笏。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "内则第十二"
  },
  {
    "id": "lj-62",
    "text": "玄端而朝日于东门之外，听朔于南门之外，闰月则阖门左扉，立于其中。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "玉藻第十三"
  },
  {
    "id": "lj-63",
    "text": "诸侯之位，阼阶之东，西面北上。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "明堂位第十四"
  },
  {
    "id": "lj-64",
    "text": "为母，括发以麻，免而以布。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧服小记第十五"
  },
  {
    "id": "lj-65",
    "text": "王者禘其祖之所自出，以其祖配之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "大传第十六"
  },
  {
    "id": "lj-66",
    "text": "适公卿之丧，则曰：听役于司徒。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "少仪第十七"
  },
  {
    "id": "lj-67",
    "text": "君子如欲化民成俗，其必由学乎！",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "学记第十八"
  },
  {
    "id": "lj-68",
    "text": "人心之动，物使之然也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "乐记第十九"
  },
  {
    "id": "lj-69",
    "text": "其輤有裧，缁布裳帷素锦以为屋而行。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记上第二十"
  },
  {
    "id": "lj-70",
    "text": "卒事，反丧服。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记下第二十一"
  },
  {
    "id": "lj-71",
    "text": "君大夫彻县，士去琴瑟。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧大记第二十二"
  },
  {
    "id": "lj-72",
    "text": "夏后氏亦禘黄帝而郊鲧，祖颛顼而宗禹。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭法第二十三"
  },
  {
    "id": "lj-73",
    "text": "祭不欲疏，疏则怠，怠则忘。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭义第二十四"
  },
  {
    "id": "lj-74",
    "text": "礼有五经，莫重于祭。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "祭统第二十五"
  },
  {
    "id": "lj-75",
    "text": "其为人也：温柔敦厚，诗教也；疏通知远，书教也；广博易良，乐教也；洁静精微，易教也；恭俭庄敬，礼教也；属辞比事，春秋教也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "经解第二十六"
  },
  {
    "id": "lj-76",
    "text": "孔子曰：丘也小人，不足以知礼。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "哀公问第二十七"
  },
  {
    "id": "lj-77",
    "text": "女三人者，吾语女礼，使女以礼周流无不遍也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "仲尼燕居第二十八"
  },
  {
    "id": "lj-78",
    "text": "孔子曰：夫民之父母乎，必达于礼乐之原，以致五至，而行三无，以横于天下。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "孔子闲居第二十九"
  },
  {
    "id": "lj-79",
    "text": "大为之坊，民犹逾之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "坊记第三十"
  },
  {
    "id": "lj-80",
    "text": "道也者，不可须臾离也，可离非道也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "中庸第三十一"
  },
  {
    "id": "lj-81",
    "text": "君子隐而显，不矜而庄，不厉而威，不言而信。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "表记第三十二"
  },
  {
    "id": "lj-82",
    "text": "故君民者，子以爱之，则民亲之；信以结之，则民不倍；恭以莅之，则民有孙心。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "缁衣第三十三"
  },
  {
    "id": "lj-83",
    "text": "遂行，日行百里，不以夜行。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "奔丧第三十四"
  },
  {
    "id": "lj-84",
    "text": "恻怛之心，痛疾之意，伤肾干肝焦肺，水浆不入口，三日不举火，故邻里为之糜粥以饮食之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "问丧第三十五"
  },
  {
    "id": "lj-85",
    "text": "有从无服而有服，公子之妻为公子之外兄弟。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "服问第三十六"
  },
  {
    "id": "lj-86",
    "text": "苴，恶貌也，所以首其内而见诸外也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "间传第三十七"
  },
  {
    "id": "lj-87",
    "text": "短毋见肤，长毋被土。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "深衣第三十九"
  },
  {
    "id": "lj-88",
    "text": "宾再拜受，主人般还，曰：辟。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "投壶第四十"
  },
  {
    "id": "lj-89",
    "text": "儒有衣冠中，动作慎，其大让如慢，小让如伪，大则如威，小则如愧，其难进而易退也，粥粥若无能也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "儒行第四十一"
  },
  {
    "id": "lj-90",
    "text": "知止而后有定，定而后能静，静而后能安，安而后能虑，虑而后能得。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "大学第四十二"
  },
  {
    "id": "lj-91",
    "text": "礼义之始，在于正容体、齐颜色、顺辞令。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "冠义第四十三"
  },
  {
    "id": "lj-92",
    "text": "故君子重之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "昏义第四十四"
  },
  {
    "id": "lj-93",
    "text": "盥洗扬觯，所以致洁也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "乡饮酒义第四十五"
  },
  {
    "id": "lj-94",
    "text": "故燕礼者，所以明君臣之义也；乡饮酒之礼者，所以明长幼之序也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "射义第四十六"
  },
  {
    "id": "lj-95",
    "text": "庶子官职诸侯、卿、大夫、士之庶子之卒，掌其戒令，与其教治，别其等，正其位。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "燕义第四十七"
  },
  {
    "id": "lj-96",
    "text": "介绍而传命，君子于其所尊弗敢质，敬之至也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "聘义第四十八"
  },
  {
    "id": "lj-97",
    "text": "訾之者，是不知礼之所由生也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧服四制第四十九"
  },
  {
    "id": "lj-98",
    "text": "爱而知其恶，憎而知其善。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼上第一"
  },
  {
    "id": "lj-99",
    "text": "凡执主器，执轻如不克。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曲礼下第二"
  },
  {
    "id": "lj-100",
    "text": "我未之前闻也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓上第三"
  },
  {
    "id": "lj-101",
    "text": "君于大夫，将葬，吊于宫；及出，命引之，三步则止。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "檀弓下第四"
  },
  {
    "id": "lj-102",
    "text": "天子之田方千里，公侯田方百里，伯七十里，子男五十里。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "王制第五"
  },
  {
    "id": "lj-103",
    "text": "其音角，律中大蔟。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "月令第六"
  },
  {
    "id": "lj-104",
    "text": "祝声三，告曰：‘某之子生，敢告。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "曾子问第七"
  },
  {
    "id": "lj-105",
    "text": "及日中，又至，亦如之。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "文王世子第八"
  },
  {
    "id": "lj-106",
    "text": "孔子曰：大道之行也，与三代之英，丘未之逮也，而有志焉。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼运第九"
  },
  {
    "id": "lj-107",
    "text": "礼释回，增美质；措则正，施则行。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "礼器第十"
  },
  {
    "id": "lj-108",
    "text": "故天子牲孕弗食也，祭帝弗用也。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "郊特牲第十一"
  },
  {
    "id": "lj-109",
    "text": "左右佩用，左佩纷帨、刀、砺、小觿、金燧，右佩玦、捍、管、遰、大觿、木燧，逼，屦着綦。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "内则第十二"
  },
  {
    "id": "lj-110",
    "text": "皮弁以日视朝，遂以食，日中而馂，奏而食。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "玉藻第十三"
  },
  {
    "id": "lj-111",
    "text": "诸伯之国，西阶之西，东面北上。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "明堂位第十四"
  },
  {
    "id": "lj-112",
    "text": "箭笄终丧三年。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧服小记第十五"
  },
  {
    "id": "lj-113",
    "text": "诸侯及其大祖，大夫士有大事，省于其君，干祫，及其高祖。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "大传第十六"
  },
  {
    "id": "lj-114",
    "text": "君将适他，臣如致金玉货贝于君，则曰：致马资于有司；敌者曰：赠从者。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "少仪第十七"
  },
  {
    "id": "lj-115",
    "text": "玉不琢，不成器；人不学，不知道。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "学记第十八"
  },
  {
    "id": "lj-116",
    "text": "感于物而动，故形于声。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "乐记第十九"
  },
  {
    "id": "lj-117",
    "text": "至于庙门，不毁墙遂入适所殡，唯輤为说于庙门外。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记上第二十"
  },
  {
    "id": "lj-118",
    "text": "虽诸父昆弟之丧，如当父母之丧，其除诸父昆弟之丧也，皆服其除丧之服。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "杂记下第二十一"
  },
  {
    "id": "lj-119",
    "text": "寝东首于北墉下。",
    "source": "《礼记》",
    "book": "礼记",
    "chapter": "丧大记第二十二"
  }
]