[
  {
    "id": "sgz-1",
    "text": "太祖武皇帝，沛国谯人也，姓曹，讳操，字孟德，汉相国参之后。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "武帝纪第一"
  },
  {
    "id": "sgz-2",
    "text": "文皇帝讳丕，字子桓，武帝太子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "文帝纪第二"
  },
  {
    "id": "sgz-3",
    "text": "明皇帝讳叡，字元仲，文帝太子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "明帝纪第三"
  },
  {
    "id": "sgz-4",
    "text": "齐王讳芳，字兰卿。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "少帝纪第四"
  },
  {
    "id": "sgz-5",
    "text": "易称男正位乎外，女正位乎内；男女正，天地之大义也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "后妃传第五"
  },
  {
    "id": "sgz-6",
    "text": "董卓字仲颖，陇西临洮人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "董二袁刘传第六"
  },
  {
    "id": "sgz-7",
    "text": "吕布字奉先，五原郡九原人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吕布张邈臧洪传第七"
  },
  {
    "id": "sgz-8",
    "text": "公孙瓒字伯珪，辽西令支人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二公孙陶四张传第八"
  },
  {
    "id": "sgz-9",
    "text": "夏侯惇字元让，沛国谯人，夏侯婴之后也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "诸夏侯曹传第九"
  },
  {
    "id": "sgz-10",
    "text": "荀彧字文若，颍川颍阴人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "荀彧荀攸贾诩传第十"
  },
  {
    "id": "sgz-11",
    "text": "袁涣字曜卿，陈郡扶乐人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "袁张凉国田王邴管传第十一"
  },
  {
    "id": "sgz-12",
    "text": "崔琰字季珪，清河东武城人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "崔毛徐何邢鲍司马传第十二"
  },
  {
    "id": "sgz-13",
    "text": "锺繇字元常，颍川长社人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "钟繇华歆王朗传第十三"
  },
  {
    "id": "sgz-14",
    "text": "程昱字仲德，东郡东阿人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "程郭董刘蒋刘传第十四"
  },
  {
    "id": "sgz-15",
    "text": "刘馥字元颖，沛国相人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘司马梁张温贾传第十五"
  },
  {
    "id": "sgz-16",
    "text": "任峻字伯达，河南中牟人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "任苏杜郑仓传第十六"
  },
  {
    "id": "sgz-17",
    "text": "张辽字文远，雁门马邑人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张乐于张徐传第十七"
  },
  {
    "id": "sgz-18",
    "text": "李典字曼成，山阳钜野人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二李臧文吕许典二庞阎传第十八"
  },
  {
    "id": "sgz-19",
    "text": "任城威王彰，字子文。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "任城陈萧王传第十九"
  },
  {
    "id": "sgz-20",
    "text": "丰愍王昂字子修。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "武文世王公传第二十"
  },
  {
    "id": "sgz-21",
    "text": "王粲字仲宣，山阳高平人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "王卫二刘傅传第二十一"
  },
  {
    "id": "sgz-22",
    "text": "桓阶字伯绪，长沙临湘人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "桓二陈徐卫卢传第二十二"
  },
  {
    "id": "sgz-23",
    "text": "和洽字阳士，汝南西平人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "和常杨杜赵裴传第二十三"
  },
  {
    "id": "sgz-24",
    "text": "韩暨字公至，南阳堵阳人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "韩崔高孙王传第二十四"
  },
  {
    "id": "sgz-25",
    "text": "辛毗字佐治，颍川阳翟人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "辛毗杨阜高堂隆传第二十五"
  },
  {
    "id": "sgz-26",
    "text": "满宠字伯宁，山阳昌邑人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "满田牵郭传第二十六"
  },
  {
    "id": "sgz-27",
    "text": "徐邈字景山，燕国蓟人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "徐胡二王传第二十七"
  },
  {
    "id": "sgz-28",
    "text": "王凌字彦云，太原祁人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "王毋丘诸葛邓钟传第二十八"
  },
  {
    "id": "sgz-29",
    "text": "华佗字元化，沛国谯人也，一名旉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "方技传第二十九"
  },
  {
    "id": "sgz-30",
    "text": "书载蛮夷猾夏，诗称猃狁孔炽，久矣其为中国患也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "乌丸鲜卑东夷传第三十"
  },
  {
    "id": "sgz-31",
    "text": "刘焉字君郎，江夏竟陵人也，汉鲁恭王之后裔，章帝元和中徙封竟陵，支庶家焉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘二牧传第一"
  },
  {
    "id": "sgz-32",
    "text": "先主姓刘，讳备，字玄德，涿郡涿县人，汉景帝子中山靖王胜之后也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "先主传第二"
  },
  {
    "id": "sgz-33",
    "text": "后主讳禅，字公嗣，先主子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "后主传第三"
  },
  {
    "id": "sgz-34",
    "text": "先主甘皇后，沛人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二主妃子传第四"
  },
  {
    "id": "sgz-35",
    "text": "诸葛亮字孔明，琅琊阳都人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "诸葛亮传第五"
  },
  {
    "id": "sgz-36",
    "text": "关羽字云长，本字长生，河东解人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "关张马黄赵传第六"
  },
  {
    "id": "sgz-37",
    "text": "庞统字士元，襄阳人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "庞统法正传第七"
  },
  {
    "id": "sgz-38",
    "text": "许靖字文休，汝南平舆人。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "许麋孙简伊秦传第八"
  },
  {
    "id": "sgz-39",
    "text": "董和字幼宰，南郡枝江人也，其先本巴郡江州人。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "董刘马陈董吕传第九"
  },
  {
    "id": "sgz-40",
    "text": "刘封者，本罗侯寇氏之子，长沙刘氏之甥也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘彭廖李刘魏杨传第十"
  },
  {
    "id": "sgz-41",
    "text": "霍峻字仲邈，南郡枝江人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "霍王向张杨费传第十一"
  },
  {
    "id": "sgz-42",
    "text": "杜微字国辅，梓潼涪人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "杜周杜许孟来尹李谯郤传第十二"
  },
  {
    "id": "sgz-43",
    "text": "黄权字公衡，巴西阆中人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "黄李吕马王张传第十三"
  },
  {
    "id": "sgz-44",
    "text": "蒋琬字公琰、零陵湘乡人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "蒋琬费祎姜维传第十四"
  },
  {
    "id": "sgz-45",
    "text": "邓芝字伯苗，义阳新野人，汉司徒禹之后也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "邓张宗杨传第十五"
  },
  {
    "id": "sgz-46",
    "text": "孙坚字文台，吴郡富春人，盖孙武之后也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "孙破虏讨逆传第一"
  },
  {
    "id": "sgz-47",
    "text": "孙权字仲谋。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吴主传第二"
  },
  {
    "id": "sgz-48",
    "text": "孙亮字子明，权少子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "三嗣主传第三"
  },
  {
    "id": "sgz-49",
    "text": "刘繇字正礼，东莱牟平人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘繇太史慈士燮传第四"
  },
  {
    "id": "sgz-50",
    "text": "孙破虏吴夫人，吴主权母也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "妃嫔传第五"
  },
  {
    "id": "sgz-51",
    "text": "孙静字幼台，坚季弟也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "宗室传第六"
  },
  {
    "id": "sgz-52",
    "text": "张昭字子布，彭城人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张顾诸葛步传第七"
  },
  {
    "id": "sgz-53",
    "text": "张纮字子纲，广陵人。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张严程阚薛传第八"
  },
  {
    "id": "sgz-54",
    "text": "周瑜字公瑾，庐江舒人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "周瑜鲁肃吕蒙传第九"
  },
  {
    "id": "sgz-55",
    "text": "程普字德谋，右北平土垠人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "程黄韩蒋周陈董甘凌徐潘丁传第十"
  },
  {
    "id": "sgz-56",
    "text": "朱治字君理，丹杨故鄣人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "朱治朱然吕范朱桓传第十一"
  },
  {
    "id": "sgz-57",
    "text": "虞翻字仲翔，会稽馀姚人也，太守王朗命为功曹。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "虞陆张骆陆吾朱传第十二"
  },
  {
    "id": "sgz-58",
    "text": "陆逊字伯言，吴郡吴人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "陆逊传第十三"
  },
  {
    "id": "sgz-59",
    "text": "孙登字子高，权长子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吴主五子传第十四"
  },
  {
    "id": "sgz-60",
    "text": "贺齐字公苗，会稽山阴人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "贺全吕周钟离传第十五"
  },
  {
    "id": "sgz-61",
    "text": "潘濬字承明，武陵汉寿人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "潘浚陆凯传第十六"
  },
  {
    "id": "sgz-62",
    "text": "是仪字子羽，北海营陵人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "是仪胡综传第十七"
  },
  {
    "id": "sgz-63",
    "text": "吴范字文则，会稽上虞人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吴范刘惇赵达传第十八"
  },
  {
    "id": "sgz-64",
    "text": "诸葛恪字元逊，瑾长子也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "诸葛滕二孙濮阳传第十九"
  },
  {
    "id": "sgz-65",
    "text": "王蕃字永元，庐江人也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "王楼贺韦华传第二十"
  },
  {
    "id": "sgz-66",
    "text": "桓帝世，曹腾为中常侍大长秋，封费亭侯。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "武帝纪第一"
  },
  {
    "id": "sgz-67",
    "text": "中平四年冬，生于谯。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "文帝纪第二"
  },
  {
    "id": "sgz-68",
    "text": "生而太祖爱之，常令在左右。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "明帝纪第三"
  },
  {
    "id": "sgz-69",
    "text": "明帝无子，养王及秦王询；宫省事秘，莫有知其所由来者。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "少帝纪第四"
  },
  {
    "id": "sgz-70",
    "text": "古先哲王，莫不明后妃之制，顺天地之德。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "后妃传第五"
  },
  {
    "id": "sgz-71",
    "text": "少好侠，尝游羌中，尽与诸豪帅相结。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "董二袁刘传第六"
  },
  {
    "id": "sgz-72",
    "text": "以骁武给并州。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吕布张邈臧洪传第七"
  },
  {
    "id": "sgz-73",
    "text": "为郡门下书佐。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二公孙陶四张传第八"
  },
  {
    "id": "sgz-74",
    "text": "年十四，就师学，人有辱其师者，惇杀之，由是以烈气闻。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "诸夏侯曹传第九"
  },
  {
    "id": "sgz-75",
    "text": "祖父淑，字季和，朗陵令。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "荀彧荀攸贾诩传第十"
  },
  {
    "id": "sgz-76",
    "text": "父滂，为汉司徒。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "袁张凉国田王邴管传第十一"
  },
  {
    "id": "sgz-77",
    "text": "少朴讷，好击剑，尚武事。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "崔毛徐何邢鲍司马传第十二"
  },
  {
    "id": "sgz-78",
    "text": "尝与族父瑜俱至洛阳，道遇相者，曰：此童有贵相，然当厄于水，努力慎之！",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "钟繇华歆王朗传第十三"
  },
  {
    "id": "sgz-79",
    "text": "长八尺三寸，美须髯。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "程郭董刘蒋刘传第十四"
  },
  {
    "id": "sgz-80",
    "text": "避乱扬州，建安初，说袁术将戚寄、秦翊，使率众与俱诣太祖。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘司马梁张温贾传第十五"
  },
  {
    "id": "sgz-81",
    "text": "汉末扰乱，关东皆震。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "任苏杜郑仓传第十六"
  },
  {
    "id": "sgz-82",
    "text": "本聂壹之后，以避怨变姓。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张乐于张徐传第十七"
  },
  {
    "id": "sgz-83",
    "text": "典从父干，有雄气，合宾客数千家在乘氏。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二李臧文吕许典二庞阎传第十八"
  },
  {
    "id": "sgz-84",
    "text": "少善射御，膂力过人，手格猛兽，不避险阻。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "任城陈萧王传第十九"
  },
  {
    "id": "sgz-85",
    "text": "弱冠举孝廉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "武文世王公传第二十"
  },
  {
    "id": "sgz-86",
    "text": "曾祖父龚，祖父畅，皆为汉三公。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "王卫二刘傅传第二十一"
  },
  {
    "id": "sgz-87",
    "text": "太守孙坚举阶孝廉，除尚书郎。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "桓二陈徐卫卢传第二十二"
  },
  {
    "id": "sgz-88",
    "text": "举孝廉，大将军辟，皆不就。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "和常杨杜赵裴传第二十三"
  },
  {
    "id": "sgz-89",
    "text": "同县豪右陈茂，谮暨父兄，畿至大辟。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "韩崔高孙王传第二十四"
  },
  {
    "id": "sgz-90",
    "text": "其先建武中，自陇西东迁。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "辛毗杨阜高堂隆传第二十五"
  },
  {
    "id": "sgz-91",
    "text": "年十八，为郡督邮。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "满田牵郭传第二十六"
  },
  {
    "id": "sgz-92",
    "text": "太祖平河朔，召为丞相军谋掾，试守奉高令，入为东曹议令史。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "徐胡二王传第二十七"
  },
  {
    "id": "sgz-93",
    "text": "叔父允，为汉司徒，诛董卓。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "王毋丘诸葛邓钟传第二十八"
  },
  {
    "id": "sgz-94",
    "text": "游学徐土，兼通数经。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "方技传第二十九"
  },
  {
    "id": "sgz-95",
    "text": "秦、汉以来，匈奴久为边害。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "乌丸鲜卑东夷传第三十"
  },
  {
    "id": "sgz-96",
    "text": "居阳城山，积学教授，举贤良方正，辟司徒府，历雒阳令、冀州刺史、南阳太守、宗正、太常。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘二牧传第一"
  },
  {
    "id": "sgz-97",
    "text": "胜子贞，元狩六年封涿县陆城亭侯。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "先主传第二"
  },
  {
    "id": "sgz-98",
    "text": "建安二十四年，先主为汉中王，立为王太子。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "后主传第三"
  },
  {
    "id": "sgz-99",
    "text": "先主临豫州，住小沛，纳以为妾。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "二主妃子传第四"
  },
  {
    "id": "sgz-100",
    "text": "汉司隶校尉诸葛丰后也。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "诸葛亮传第五"
  },
  {
    "id": "sgz-101",
    "text": "亡命奔涿郡。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "关张马黄赵传第六"
  },
  {
    "id": "sgz-102",
    "text": "少时朴钝，未有识者。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "庞统法正传第七"
  },
  {
    "id": "sgz-103",
    "text": "少与从弟劭俱知名，并有人伦臧否之称，而私情不协。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "许麋孙简伊秦传第八"
  },
  {
    "id": "sgz-104",
    "text": "汉末，和率宗族西迁，益州牧刘璋以为牛鞞、江原长、成都令。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "董刘马陈董吕传第九"
  },
  {
    "id": "sgz-105",
    "text": "先主至荆州，以未有继嗣，养封为子。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘彭廖李刘魏杨传第十"
  },
  {
    "id": "sgz-106",
    "text": "兄笃，于乡里合部曲数百人。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "霍王向张杨费传第十一"
  },
  {
    "id": "sgz-107",
    "text": "少受学于广汉任安。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "杜周杜许孟来尹李谯郤传第十二"
  },
  {
    "id": "sgz-108",
    "text": "少为郡吏，州牧刘璋召为主簿。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "黄李吕马王张传第十三"
  },
  {
    "id": "sgz-109",
    "text": "弱冠与外弟泉陵刘敏俱知名。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "蒋琬费祎姜维传第十四"
  },
  {
    "id": "sgz-110",
    "text": "汉末入蜀，未见知待。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "邓张宗杨传第十五"
  },
  {
    "id": "sgz-111",
    "text": "年十七，与父共载船至钱唐，会海贼胡玉等从匏里上掠取贾人财物，方于岸上分之，行旅皆住，船不敢进。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "孙破虏讨逆传第一"
  },
  {
    "id": "sgz-112",
    "text": "兄策既定诸郡，时权年十五，以为阳羡长。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "吴主传第二"
  },
  {
    "id": "sgz-113",
    "text": "权春秋高，而亮最少，故尤留意。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "三嗣主传第三"
  },
  {
    "id": "sgz-114",
    "text": "齐孝王少子封牟平侯，子孙家焉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "刘繇太史慈士燮传第四"
  },
  {
    "id": "sgz-115",
    "text": "本吴人，徙钱唐，早失父母，与弟景居。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "妃嫔传第五"
  },
  {
    "id": "sgz-116",
    "text": "坚始举事，静纠合乡曲及宗室五六百人以为保障，众咸附焉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "宗室传第六"
  },
  {
    "id": "sgz-117",
    "text": "少好学，善隶书，从白侯子安受左氏春秋，博览众书，与琅邪赵昱、东海王朗俱发名友善。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张顾诸葛步传第七"
  },
  {
    "id": "sgz-118",
    "text": "游学京都，还本郡，举茂才，公府辟，皆不就，避难江东。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "张严程阚薛传第八"
  },
  {
    "id": "sgz-119",
    "text": "从祖父景，景子忠，皆为汉太尉。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "周瑜鲁肃吕蒙传第九"
  },
  {
    "id": "sgz-120",
    "text": "初为州郡吏，有容貌计略，善于应对。",
    "source": "《三国志》",
    "book": "三国志",
    "chapter": "程黄韩蒋周陈董甘凌徐潘丁传第十"
  }
]